<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- AVPN (Task 9): APNs push. PRODUCTION — TestFlight И App Store используют production APNs
	     (оба distribution). Эмпирика: development-токен в TestFlight → 400 BadDeviceToken.
	     Для локального Xcode-debug по кабелю при необходимости временно ставить development. -->
	<key>aps-environment</key>
	<string>production</string>
	<!-- AVPN (Task 13): Universal Links переноса /transfer (apple-app-site-association хостит tribevpn.com) -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:tribevpn.com</string>
	</array>
	<key>com.apple.developer.networking.networkextension</key>
	<array>
		<string>packet-tunnel-provider</string>
	</array>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.hk.wellwon.zanaves</string>
	</array>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- AVPN (identity-anchor): ВЫДЕЛЕННАЯ Tribe keychain-группа для якоря идентичности (device_id +
	     WG-ключи + subscription_token). Первая в списке = дефолт для записи (QtKeychain пишет сюда).
	     Не требует регистрации на портале (keychain-группа под своим Team-префиксом — implicit).
	     Смысл: будущий Tribe-app (той же команды Q7DVH5MCWF, другой bundle — если старый забанят)
	     объявит ЭТУ ЖЕ группу первой и прочитает якорь → подписка устройства продолжится.
	     group.hk.wellwon.zanaves оставлен ВТОРЫМ read-fallback: чтение (SecItem без группы) ищет во
	     ВСЕХ группах app → старые якоря build ≤52 находятся, следующая запись мигрирует их в tribe. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)hk.wellwon.tribe</string>
		<string>$(AppIdentifierPrefix)group.hk.wellwon.zanaves</string>
	</array>
</dict>
</plist>
