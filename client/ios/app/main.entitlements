<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- AVPN (Task 9): APNs push. PRODUCTION — TestFlight И App Store используют production APNs
	     (оба distribution). Эмпирика: development-токен в TestFlight → 400 BadDeviceToken.
	     Для локального Xcode-debug по кабелю при необходимости временно ставить development. -->
	<key>aps-environment</key>
	<string>production</string>
	<!-- AVPN (Task 13): Universal Links переноса /transfer (apple-app-site-association хостит tribevpn.com) -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:tribevpn.com</string>
	</array>
	<key>com.apple.developer.networking.networkextension</key>
	<array>
		<string>packet-tunnel-provider</string>
	</array>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.hk.wellwon.zanaves</string>
	</array>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)group.hk.wellwon.zanaves</string>
	</array>
</dict>
</plist>
