<?xml version="1.0" encoding="utf-8"?>
<!-- AVPN (2026-11-16): Tribe launcher icon. Android 8+ draws this adaptive icon (not mipmap-*/icon.png),
     and Android 12+ builds the launch splash from it, so the Amnezia layers here showed the Amnezia logo. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/tribe_launcher_background" />
    <foreground android:drawable="@mipmap/tribe_launcher_foreground" />
    <monochrome android:drawable="@drawable/tribe_launcher_monochrome" />
</adaptive-icon>
