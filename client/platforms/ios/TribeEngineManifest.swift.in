import Foundation

// AVPN: generated from immutable Conan package metadata.  Do not hand-edit
// versions here; metadata/check_engine_lock.py verifies recipe/template parity.
enum TribeEngineManifest {
  private static func runtimeString(_ value: UnsafePointer<CChar>?) -> String? {
    guard let value else { return nil }
    defer { free(UnsafeMutableRawPointer(mutating: value)) }
    return String(cString: value)
  }

  private static func runtimeString(_ value: UnsafeMutablePointer<CChar>?) -> String? {
    guard let value else { return nil }
    defer { free(value) }
    return String(cString: value)
  }

  private static func runtimeEvidence(_ value: String?, declared: String,
                                      allowGoModulePrefix: Bool) -> String? {
    guard let value else { return nil }
    if value == declared { return declared }
    // debug.ReadBuildInfo reports a tagged Go module with exactly one leading
    // `v`; accept no other rewrite, suffix, whitespace, pseudo-version or hash.
    if allowGoModulePrefix && value == "v\(declared)" { return declared }
    return nil
  }

  // Xray's Apple C wrapper exposes a runtime version probe.  The ABI itself is
  // still compile-time locked; consumers reject an unknown status schema/ABI
  // instead of inferring compatibility from a version string.
  static func xrayRuntimeStatusCore() -> [String: Any] {
    let runtime = runtimeEvidence(runtimeString(LibXrayXrayVersion()),
                                  declared: "@AWG_APPLE_XRAY_CORE_VERSION@",
                                  allowGoModulePrefix: false)
    return [
      "adapter": "amnezia-libxray",
      "adapter_version": "@AWG_APPLE_XRAY_ADAPTER_VERSION@",
      "declared_core_version": "@AWG_APPLE_XRAY_CORE_VERSION@",
      "runtime_core_version": runtime.map { $0 as Any } ?? NSNull(),
      "runtime_version_probed": runtime != nil,
      "abi": "@AWG_APPLE_XRAY_SOCKET_ABI@"
    ]
  }

  static func awgRuntimeStatusCore() -> [String: Any] {
    let runtime = runtimeEvidence(runtimeString(wgVersion()),
                                  declared: "@AWG_APPLE_AWG_CORE_VERSION@",
                                  allowGoModulePrefix: true)
    return [
      "adapter": "awg-apple",
      "adapter_version": "@AWG_APPLE_ADAPTER_VERSION@",
      "declared_core_version": "@AWG_APPLE_AWG_CORE_VERSION@",
      "runtime_core_version": runtime.map { $0 as Any } ?? NSNull(),
      "runtime_version_probed": runtime != nil,
      "abi": "awg-apple-c-uapi-v3.1"
    ]
  }

  // `activeProtocol` is deliberately not serialized: the pre-connect inventory
  // describes every embedded engine and must match RuntimeEngineManifest's
  // exact, closed schema.  Keeping the argument avoids an IPC call-site ABI
  // change while older extensions are upgraded.
  static func payload(activeProtocol _: TunnelProtoType?) -> [String: Any] {
    let awgRuntime = runtimeEvidence(runtimeString(wgVersion()),
                                     declared: "@AWG_APPLE_AWG_CORE_VERSION@",
                                     allowGoModulePrefix: true)
    let xrayRuntime = runtimeEvidence(runtimeString(LibXrayXrayVersion()),
                                      declared: "@AWG_APPLE_XRAY_CORE_VERSION@",
                                      allowGoModulePrefix: false)
    let awg: [String: Any] = [
      "protocol": "awg",
      "adapter": "awg-apple",
      "adapterVersion": "@AWG_APPLE_ADAPTER_VERSION@",
      "sourceCommit": "@AWG_APPLE_SOURCE_COMMIT@",
      "declaredCoreVersion": "@AWG_APPLE_AWG_CORE_VERSION@",
      "runtimeCoreVersion": awgRuntime.map { $0 as Any } ?? NSNull(),
      "runtimeVersionProbed": awgRuntime != nil,
      "versionEvidence": awgRuntime == nil ? "compile_time_lock_only" : "runtime_api",
      "abi": "awg-apple-c-uapi-v3.1",
      "capabilities": ["awg.random_trailers", "awg.disable_cookies", "uapi.readback",
                       "tribe.split_dns", "tribe.warmup", "tribe.rebind",
                       "tribe.guarded_settings_owner"]
    ]
    let xray: [String: Any] = [
      "protocol": "xray",
      "adapter": "amnezia-libxray",
      "adapterVersion": "@AWG_APPLE_XRAY_ADAPTER_VERSION@",
      "sourceCommit": "@AWG_APPLE_XRAY_SOURCE_COMMIT@",
      "declaredCoreVersion": "@AWG_APPLE_XRAY_CORE_VERSION@",
      "runtimeCoreVersion": xrayRuntime.map { $0 as Any } ?? NSNull(),
      "runtimeVersionProbed": xrayRuntime != nil,
      "versionEvidence": xrayRuntime == nil ? "compile_time_lock_only" : "runtime_api",
      "abi": "@AWG_APPLE_XRAY_SOCKET_ABI@",
      "capabilities": ["xray.vless.reality.vision.tcp", "xray.embedded", "xray.runtime_version",
                       "xray.socket_callback", "xray.socket_protection_result",
                       "tribe.guarded_settings_owner"]
    ]
    return [
      "type": "engine_manifest_v1",
      "schema": 1,
      "app": ["version": "@CMAKE_PROJECT_VERSION@", "build": @CMAKE_PROJECT_VERSION_TWEAK@],
      "engines": [awg, xray]
    ]
  }
}
