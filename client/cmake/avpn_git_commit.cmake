# AVPN build label: writes the commit of the source tree into a header, at configure time and on every build.
# Script mode: cmake -DSRC=<source dir> -DOUT=<header> -P avpn_git_commit.cmake
# The header is rewritten only when the label changes, so a build of the same commit recompiles nothing.
# Label: `git rev-parse --short HEAD` (as upstream), "+dirty" when tracked files differ from HEAD (the build
# carries uncommitted changes), "unknown" outside a git checkout.
if(NOT SRC OR NOT OUT)
    message(FATAL_ERROR "avpn_git_commit.cmake: SRC and OUT are required")
endif()

execute_process(
    COMMAND git rev-parse --short HEAD
    WORKING_DIRECTORY "${SRC}"
    OUTPUT_VARIABLE AVPN_LABEL
    OUTPUT_STRIP_TRAILING_WHITESPACE
    ERROR_QUIET
    RESULT_VARIABLE AVPN_RC)
if(NOT AVPN_RC EQUAL 0 OR AVPN_LABEL STREQUAL "")
    set(AVPN_LABEL "unknown")
else()
    execute_process(
        COMMAND git diff --quiet --ignore-submodules HEAD --
        WORKING_DIRECTORY "${SRC}"
        RESULT_VARIABLE AVPN_DIRTY
        OUTPUT_QUIET
        ERROR_QUIET)
    if(AVPN_DIRTY EQUAL 1)
        string(APPEND AVPN_LABEL "+dirty")
    endif()
endif()

# The global -DGIT_COMMIT_HASH of client/CMakeLists.txt is fixed at configure time; this header is force-included
# after it in the files that print the label, so its value wins.
set(AVPN_CONTENT "// Generated by client/cmake/avpn_git_commit.cmake on every build - do not edit.\n#pragma once\n#undef GIT_COMMIT_HASH\n#define GIT_COMMIT_HASH \"${AVPN_LABEL}\"\n")
set(AVPN_OLD "")
if(EXISTS "${OUT}")
    file(READ "${OUT}" AVPN_OLD)
endif()
if(NOT AVPN_OLD STREQUAL AVPN_CONTENT)
    file(WRITE "${OUT}" "${AVPN_CONTENT}")
endif()
