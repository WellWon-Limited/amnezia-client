<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Produce an App Store-connectable IPA locally.  CI deliberately never
	     selects destination=upload and has no upload step. -->
	<key>destination</key>
	<string>export</string>
	<key>distributionBundleIdentifier</key>
	<string>hk.wellwon.vpn</string>
	<key>generateAppStoreInformation</key>
	<false/>
	<key>manageAppVersionAndBuildNumber</key>
	<false/>
	<key>method</key>
	<string>app-store-connect</string>
	<key>signingStyle</key>
	<string>manual</string>
	<!-- CI copies this reviewed file to RUNNER_TEMP and inserts the two
	     already SHA-pinned profile UUIDs. The checked-in source stays free of
	     renewable profile identifiers while the executable map is closed. -->
	<key>provisioningProfiles</key>
	<dict/>
	<key>stripSwiftSymbols</key>
	<true/>
	<key>teamID</key>
	<string>Q7DVH5MCWF</string>
</dict>
</plist>
