+/* SPDX-License-Identifier: MIT */
+
+package main
+
+import "golang.org/x/sys/unix"
+
+// tribeProbeBindFd pins the session's UDP socket to the physical interface (SO_BINDTODEVICE).
+func tribeProbeBindFd(fd int, _ bool, _ int, name string) error {
+	return unix.BindToDevice(fd, name)
+}
