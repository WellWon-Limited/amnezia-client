diff --git a/main_tribe_probe_test.go b/main_tribe_probe_test.go
new file mode 100644
index 0000000..931e772
--- /dev/null
+++ b/main_tribe_probe_test.go
@@ -0,0 +1,190 @@
+//go:build darwin || linux
+
+/* SPDX-License-Identifier: MIT */
+
+package main
+
+// AVPN (awg-go patch 0001): `probe` against a userspace node on 127.0.0.1 (a device on its own
+// netstack with an HTTPS server inside it); nothing leaves the machine.
+
+import (
+	"bufio"
+	"context"
+	"crypto/ecdh"
+	"crypto/rand"
+	"crypto/tls"
+	"crypto/x509"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"net/netip"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/amnezia-vpn/amneziawg-go/v3/conn"
+	"github.com/amnezia-vpn/amneziawg-go/v3/device"
+	"github.com/amnezia-vpn/amneziawg-go/v3/tun/netstack"
+)
+
+var (
+	tpAPI    = netip.MustParseAddr("203.0.113.10")
+	tpEcho   = netip.MustParseAddr("10.8.0.1")
+	tpClient = netip.MustParseAddr("10.8.0.2")
+)
+
+func tpKey(t *testing.T) (priv, pub string) {
+	k, err := ecdh.X25519().GenerateKey(rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return hex.EncodeToString(k.Bytes()), hex.EncodeToString(k.PublicKey().Bytes())
+}
+
+const tpParams = "jc=4\njmin=40\njmax=70\ns1=15\ns2=18\ns3=20\ns4=0\nh1=123456\nh2=234567\nh3=345678\nh4=456789\n"
+
+type tpNode struct {
+	pub  string
+	port int
+	pool *x509.CertPool
+}
+
+func tpStartNode(t *testing.T, clientPub string) *tpNode {
+	t.Helper()
+	priv, pub := tpKey(t)
+	uc, err := net.ListenUDP("udp4", &net.UDPAddr{IP: net.IPv4(127, 0, 0, 1)})
+	if err != nil {
+		t.Fatal(err)
+	}
+	port := uc.LocalAddr().(*net.UDPAddr).Port
+	uc.Close()
+	tdev, tnet, err := netstack.CreateNetTUN([]netip.Addr{tpEcho, tpAPI}, nil, 1280)
+	if err != nil {
+		t.Fatal(err)
+	}
+	dev := device.NewDevice(tdev, conn.NewStdNetBind(), &device.Logger{Verbosef: device.DiscardLogf, Errorf: device.DiscardLogf})
+	if err := dev.IpcSet(fmt.Sprintf("private_key=%s\nlisten_port=%d\n%spublic_key=%s\nallowed_ip=%s/32\n", priv, port, tpParams, clientPub, tpClient)); err != nil {
+		t.Fatal(err)
+	}
+	dev.Up()
+	ts := httptest.NewUnstartedServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		io.WriteString(w, strings.Repeat("x", 65536))
+	}))
+	ts.StartTLS()
+	ln, err := tnet.ListenTCPAddrPort(netip.AddrPortFrom(tpAPI, 443))
+	if err != nil {
+		t.Fatal(err)
+	}
+	hs := &http.Server{Handler: ts.Config.Handler, TLSConfig: ts.TLS.Clone()}
+	go hs.Serve(tls.NewListener(ln, hs.TLSConfig))
+	pool := x509.NewCertPool()
+	pool.AddCert(ts.Certificate())
+	t.Cleanup(func() { hs.Close(); ts.Close(); dev.Close() })
+	return &tpNode{pub: pub, port: port, pool: pool}
+}
+
+// tpRun starts a session over pipes; it returns the status line and the stream.
+func tpRun(t *testing.T, job tribeProbeJob) (tribeProbeStatus, *bufio.Reader, io.WriteCloser, chan error) {
+	t.Helper()
+	inR, inW := io.Pipe()
+	outR, outW := io.Pipe()
+	done := make(chan error, 1)
+	go func() { done <- tribeProbeRun(context.Background(), inR, outW); outW.Close() }()
+	raw, _ := json.Marshal(job)
+	go inW.Write(append(raw, '\n'))
+	br := bufio.NewReader(outR)
+	line, err := br.ReadBytes('\n')
+	if err != nil {
+		t.Fatal(err)
+	}
+	var st tribeProbeStatus
+	if err := json.Unmarshal(line, &st); err != nil {
+		t.Fatalf("status %q", line)
+	}
+	return st, br, inW, done
+}
+
+type tpPipeConn struct {
+	r *bufio.Reader
+	w io.WriteCloser
+}
+
+func (c tpPipeConn) Read(p []byte) (int, error)     { return c.r.Read(p) }
+func (c tpPipeConn) Write(p []byte) (int, error)    { return c.w.Write(p) }
+func (c tpPipeConn) Close() error                   { return c.w.Close() }
+func (tpPipeConn) LocalAddr() net.Addr              { return &net.TCPAddr{} }
+func (tpPipeConn) RemoteAddr() net.Addr             { return &net.TCPAddr{} }
+func (tpPipeConn) SetDeadline(time.Time) error      { return nil }
+func (tpPipeConn) SetReadDeadline(time.Time) error  { return nil }
+func (tpPipeConn) SetWriteDeadline(time.Time) error { return nil }
+
+func TestTribeProbe(t *testing.T) {
+	cpriv, cpub := tpKey(t)
+	n := tpStartNode(t, cpub)
+	uapi := func(n *tpNode) string {
+		return fmt.Sprintf("private_key=%s\nlisten_port=0\nreplace_peers=true\n%spublic_key=%s\nendpoint=127.0.0.1:%d\nallowed_ip=%s/32\nallowed_ip=%s/32\npersistent_keepalive_interval=25\n",
+			cpriv, tpParams, n.pub, n.port, tpAPI, tpEcho)
+	}
+	lo, _ := net.InterfaceByName("lo0")
+	if lo == nil {
+		lo, _ = net.InterfaceByName("lo")
+	}
+	job := tribeProbeJob{UAPI: uapi(n), Address: []string{tpClient.String() + "/32"}, EchoTarget: tpEcho.String(), Echoes: 1,
+		HandshakeMs: 1500, PeerKey: n.pub}
+	if lo != nil {
+		job.BoundIfName = lo.Name // bound to the loopback interface: the node is on 127.0.0.1
+	}
+	st, br, w, done := tpRun(t, job)
+	if !st.HandshakeOK || st.HandshakeMs < 0 || st.EchoSent != 1 || st.Error != "" {
+		t.Fatalf("status %+v", st)
+	}
+	fmt.Fprintf(w, `{"connect":"%s:443"}`+"\n", tpAPI)
+	line, _ := br.ReadBytes('\n')
+	if !strings.Contains(string(line), `"connected":true`) {
+		t.Fatalf("connect: %s", line)
+	}
+	tc := tls.Client(tpPipeConn{br, w}, &tls.Config{ServerName: "example.com", RootCAs: n.pool})
+	fmt.Fprintf(tc, "GET /v1/probe HTTP/1.1\r\nHost: example.com\r\nConnection: close\r\n\r\n")
+	resp, err := http.ReadResponse(bufio.NewReader(tc), nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	body, _ := io.ReadAll(resp.Body)
+	if resp.StatusCode != 200 || len(body) != 65536 {
+		t.Fatalf("status %d body %d", resp.StatusCode, len(body))
+	}
+	w.Close()
+	select {
+	case <-done:
+	case <-time.After(3 * time.Second):
+		t.Fatal("the session did not end with its stdin")
+	}
+	t.Logf("handshake %d ms, echoes %d/%d (%d bytes), 64 KiB through the tunnel", st.HandshakeMs, st.EchoReplies, st.EchoSent, st.EchoBytes)
+
+	// A node that does not know the key: no handshake, and the session ends.
+	_, otherPub := tpKey(t)
+	stranger := tpStartNode(t, otherPub)
+	job.UAPI, job.PeerKey, job.HandshakeMs = uapi(stranger), stranger.pub, 300
+	st, _, w, done = tpRun(t, job)
+	w.Close()
+	if st.HandshakeOK || st.HandshakeMs != -1 || st.Error != "" {
+		t.Fatalf("unknown key: %+v", st)
+	}
+	<-done
+	// A malformed job and a binding that cannot work.
+	st, _, w, _ = tpRun(t, tribeProbeJob{UAPI: "x"})
+	w.Close()
+	if st.Error != "config" {
+		t.Fatalf("bad job: %+v", st)
+	}
+	job.BoundIfName, job.BoundIf = "", 65000
+	st, _, w, _ = tpRun(t, job)
+	w.Close()
+	if st.Error != "bind_failed" {
+		t.Fatalf("bad interface: %+v", st)
+	}
+}
