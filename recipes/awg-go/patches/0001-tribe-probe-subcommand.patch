diff --git a/main_tribe_probe.go b/main_tribe_probe.go
new file mode 100644
index 0000000..6a8fbed
--- /dev/null
+++ b/main_tribe_probe.go
@@ -0,0 +1,300 @@
+//go:build !windows
+
+/* SPDX-License-Identifier: MIT */
+
+package main
+
+// AVPN (awg-go patch 0001): `amneziawg-go probe` - one AmneziaWG mini-session for the Scanner's
+// probe engine in the macOS (Linux) service (awg-probe-plan.md §3, contract "One awg_mini
+// session"). The live tunnel is this same binary in another process; a probe never touches it.
+//
+// A userspace device on an in-memory netstack (no system interface, no route, no DNS), its UDP
+// socket bound to the physical interface BEFORE its first packet (IP_BOUND_IF / SO_BINDTODEVICE;
+// without it the service's UDP to the node would enter the live tunnel). Nothing is logged.
+// Protocol on stdin / stdout (protocol tribe-awg-probe-v1):
+//
+//	in  1: {"uapi": SECRET, "address": ["10.8.0.2/32"], "mtu": 1280, "bound_if": <index>|0,
+//	        "bound_if_name": "en0"|"", "prime_echo_target": "10.8.0.1"|"", "prime_echoes": 1,
+//	        "handshake_ms": 1500, "peer_key": "<hex>"}
+//	out 1: {"handshake_ok": bool, "handshake_ms": n|-1, "echo_sent": n, "echo_replies": n,
+//	        "echo_bytes": n, "error": ""|"config"|"bind_failed"|"internal"}
+//	in  2: {"connect": "ip:port"}            (only after a handshake)
+//	out 2: {"connected": bool, "error": ""|"dial"}
+//	then:  raw bytes both ways between stdin / stdout and that TCP connection inside the tunnel.
+//
+// The process ends when stdin closes or the connection ends; the engine kills it at its deadline.
+
+import (
+	"bufio"
+	"context"
+	"encoding/json"
+	"errors"
+	"io"
+	"net"
+	"net/netip"
+	"os"
+	"strconv"
+	"strings"
+	"time"
+
+	"github.com/amnezia-vpn/amneziawg-go/v3/conn"
+	"github.com/amnezia-vpn/amneziawg-go/v3/device"
+	"github.com/amnezia-vpn/amneziawg-go/v3/tun/netstack"
+	"golang.org/x/net/icmp"
+	"golang.org/x/net/ipv4"
+	"golang.org/x/net/ipv6"
+)
+
+const tribeProbeABI = "tribe-awg-probe-v1"
+
+type tribeProbeJob struct {
+	UAPI        string   `json:"uapi"`
+	Address     []string `json:"address"`
+	MTU         int      `json:"mtu"`
+	BoundIf     int      `json:"bound_if"`
+	BoundIfName string   `json:"bound_if_name"`
+	EchoTarget  string   `json:"prime_echo_target"`
+	Echoes      int      `json:"prime_echoes"`
+	HandshakeMs int      `json:"handshake_ms"`
+	PeerKey     string   `json:"peer_key"`
+}
+
+type tribeProbeStatus struct {
+	HandshakeOK bool   `json:"handshake_ok"`
+	HandshakeMs int64  `json:"handshake_ms"`
+	EchoSent    int    `json:"echo_sent"`
+	EchoReplies int    `json:"echo_replies"`
+	EchoBytes   int64  `json:"echo_bytes"`
+	Error       string `json:"error"`
+}
+
+func tribeProbeMain(args []string) int {
+	if len(args) == 1 && args[0] == "--abi" {
+		os.Stdout.WriteString(tribeProbeABI + "\n")
+		return 0
+	}
+	if err := tribeProbeRun(context.Background(), os.Stdin, os.Stdout); err != nil {
+		return 1
+	}
+	return 0
+}
+
+// tribeProbeRun runs one session over r / w (the process's stdin / stdout, or pipes in a test).
+func tribeProbeRun(ctx context.Context, r io.Reader, w io.Writer) error {
+	br := bufio.NewReader(r)
+	line, err := br.ReadBytes('\n')
+	if err != nil {
+		return err
+	}
+	var job tribeProbeJob
+	st := tribeProbeStatus{HandshakeMs: -1}
+	send := func(v any) error {
+		raw, _ := json.Marshal(v)
+		_, err := w.Write(append(raw, '\n'))
+		return err
+	}
+	if json.Unmarshal(line, &job) != nil || job.UAPI == "" || len(job.PeerKey) != 64 || len(job.Address) == 0 {
+		st.Error = "config"
+		return send(st)
+	}
+	var addrs []netip.Addr
+	for _, a := range job.Address {
+		p, err := netip.ParsePrefix(strings.TrimSpace(a))
+		if err != nil {
+			ad, aerr := netip.ParseAddr(strings.TrimSpace(a))
+			if aerr != nil {
+				st.Error = "config"
+				return send(st)
+			}
+			p = netip.PrefixFrom(ad, ad.BitLen())
+		}
+		addrs = append(addrs, p.Addr())
+	}
+	mtu := job.MTU
+	if mtu <= 0 {
+		mtu = 1280
+	}
+	tdev, tnet, err := netstack.CreateNetTUN(addrs, nil, mtu)
+	if err != nil {
+		st.Error = "config"
+		return send(st)
+	}
+	bind := conn.NewStdNetBind()
+	dev := device.NewDevice(tdev, bind, &device.Logger{Verbosef: device.DiscardLogf, Errorf: device.DiscardLogf})
+	defer dev.Close()
+	var uapi strings.Builder
+	for _, l := range strings.Split(job.UAPI, "\n") {
+		if !strings.HasPrefix(strings.TrimSpace(l), "persistent_keepalive_interval=") {
+			uapi.WriteString(l + "\n")
+		}
+	}
+	if err := dev.IpcSet(uapi.String()); err != nil {
+		st.Error = "config"
+		return send(st)
+	}
+	if err := dev.Up(); err != nil {
+		st.Error = "bind_failed"
+		return send(st)
+	}
+	if err := tribeProbeBind(bind, job.BoundIf, job.BoundIfName); err != nil {
+		st.Error = "bind_failed"
+		return send(st)
+	}
+	t0 := time.Now()
+	if err := dev.IpcSet("public_key=" + job.PeerKey + "\nupdate_only=true\npersistent_keepalive_interval=1\n"); err != nil {
+		st.Error = "config"
+		return send(st)
+	}
+	timeout := time.Duration(job.HandshakeMs) * time.Millisecond
+	if timeout <= 0 {
+		timeout = 1500 * time.Millisecond
+	}
+	for deadline := t0.Add(timeout); ; time.Sleep(5 * time.Millisecond) {
+		if tribeProbeHandshaken(dev, job.PeerKey) {
+			st.HandshakeOK, st.HandshakeMs = true, time.Since(t0).Milliseconds()
+			break
+		}
+		if !time.Now().Before(deadline) {
+			break
+		}
+	}
+	_ = dev.IpcSet("public_key=" + job.PeerKey + "\nupdate_only=true\npersistent_keepalive_interval=0\n")
+	if st.HandshakeOK && job.Echoes > 0 {
+		if target, err := netip.ParseAddr(job.EchoTarget); err == nil {
+			st.EchoSent, st.EchoReplies, st.EchoBytes = tribeProbeEcho(ctx, tnet, addrs[0], target, job.Echoes)
+		}
+	}
+	if err := send(st); err != nil || !st.HandshakeOK {
+		return err
+	}
+	line, err = br.ReadBytes('\n')
+	if err != nil {
+		return nil // the engine did not want the data probe
+	}
+	var req struct {
+		Connect string `json:"connect"`
+	}
+	ap, perr := netip.AddrPort{}, json.Unmarshal(line, &req)
+	if perr == nil {
+		ap, perr = netip.ParseAddrPort(req.Connect)
+	}
+	if perr != nil {
+		return send(map[string]any{"connected": false, "error": "config"})
+	}
+	dctx, cancel := context.WithTimeout(ctx, 10*time.Second)
+	c, err := tnet.DialContextTCPAddrPort(dctx, ap)
+	cancel()
+	if err != nil {
+		return send(map[string]any{"connected": false, "error": "dial"})
+	}
+	defer c.Close()
+	if err := send(map[string]any{"connected": true, "error": ""}); err != nil {
+		return err
+	}
+	done := make(chan struct{}, 2)
+	go func() { io.Copy(c, br); c.CloseWrite(); done <- struct{}{} }()
+	go func() { io.Copy(w, c); done <- struct{}{} }()
+	<-done
+	return nil
+}
+
+func tribeProbeBind(bind conn.Bind, index int, name string) error {
+	peek, ok := bind.(conn.PeekLookAtSocketFd)
+	if !ok {
+		return errors.New("bind without socket access")
+	}
+	if index <= 0 && name == "" {
+		return nil // the engine allows an unbound session only where its platform does
+	}
+	if index <= 0 || name == "" {
+		var ifc *net.Interface
+		var err error
+		if index > 0 {
+			ifc, err = net.InterfaceByIndex(index)
+		} else {
+			ifc, err = net.InterfaceByName(name)
+		}
+		if err != nil {
+			return err
+		}
+		index, name = ifc.Index, ifc.Name
+	}
+	fd4, err4 := peek.PeekLookAtSocketFd4()
+	if err4 == nil {
+		if err := tribeProbeBindFd(fd4, false, index, name); err != nil {
+			return err
+		}
+	}
+	fd6, err6 := peek.PeekLookAtSocketFd6()
+	if err6 == nil {
+		if err := tribeProbeBindFd(fd6, true, index, name); err != nil {
+			return err
+		}
+	}
+	if err4 != nil && err6 != nil {
+		return errors.New("no socket")
+	}
+	return nil
+}
+
+func tribeProbeHandshaken(dev *device.Device, peerKey string) bool {
+	text, err := dev.IpcGet()
+	if err != nil {
+		return false
+	}
+	in := false
+	for _, l := range strings.Split(text, "\n") {
+		k, v, _ := strings.Cut(l, "=")
+		switch k {
+		case "public_key":
+			in = v == peerKey
+		case "last_handshake_time_sec":
+			if in {
+				n, _ := strconv.ParseInt(v, 10, 64)
+				return n > 0
+			}
+		}
+	}
+	return false
+}
+
+func tribeProbeEcho(ctx context.Context, tnet *netstack.Net, local, target netip.Addr, n int) (sent, replies int, wire int64) {
+	pc, err := tnet.DialPingAddr(local, target)
+	if err != nil {
+		return
+	}
+	defer pc.Close()
+	hdr, proto := int64(20), 1
+	var typ icmp.Type = ipv4.ICMPTypeEcho
+	if target.Is6() {
+		hdr, proto, typ = 40, 58, ipv6.ICMPTypeEchoRequest
+	}
+	buf := make([]byte, 1500)
+	for i := 1; i <= n && ctx.Err() == nil; i++ {
+		raw, err := (&icmp.Message{Type: typ, Body: &icmp.Echo{ID: 0x7462, Seq: i, Data: make([]byte, 56)}}).Marshal(nil)
+		if err != nil {
+			return
+		}
+		end := time.Now().Add(150 * time.Millisecond)
+		pc.SetDeadline(end)
+		if _, err := pc.Write(raw); err != nil {
+			continue
+		}
+		sent++
+		wire += hdr + int64(len(raw))
+		for time.Now().Before(end) {
+			m, err := pc.Read(buf)
+			if err != nil {
+				break
+			}
+			if reply, err := icmp.ParseMessage(proto, buf[:m]); err == nil {
+				if e, ok := reply.Body.(*icmp.Echo); ok && e.Seq == i {
+					replies++
+					wire += hdr + int64(m)
+					break
+				}
+			}
+		}
+	}
+	return
+}
