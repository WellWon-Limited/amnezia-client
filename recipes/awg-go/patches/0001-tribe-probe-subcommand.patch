+/* SPDX-License-Identifier: MIT */
+
+package main
+
+import "golang.org/x/sys/unix"
+
+// tribeProbeBindFd pins the session's UDP socket to the physical interface (IP_BOUND_IF /
+// IPV6_BOUND_IF): its packets leave through it whatever the routing table (the live utun) says.
+func tribeProbeBindFd(fd int, v6 bool, index int, _ string) error {
+	if v6 {
+		return unix.SetsockoptInt(fd, unix.IPPROTO_IPV6, unix.IPV6_BOUND_IF, index)
+	}
+	return unix.SetsockoptInt(fd, unix.IPPROTO_IP, unix.IP_BOUND_IF, index)
+}
