diff --git a/tribescan.go b/tribescan.go
new file mode 100644
index 0000000..e280890
--- /dev/null
+++ b/tribescan.go
@@ -0,0 +1,75 @@
+package main
+
+// AVPN (amnezia-xray-bindings 1.4.0-tribe.1, patch 0001): C exports of the tribe-scan-v1 probe
+// engine (package tribescan, shared engine patch ../amnezia-libxray/patches/0012-tribe-scan-engine.patch)
+// for the desktop service. A probe instance is a SECOND core in the service's Go runtime, next to
+// and independent of the amnezia_xray_configure/start singleton; it never touches `server`.
+//
+// Socket protection is the probe's OWN: the service passes host_options.bind_interface[_index]
+// (required on macOS) and every probe socket - each outbound's, DNS, the reach dial - is bound to that
+// interface in Go (IP_BOUND_IF / IPV6_BOUND_IF, SO_BINDTODEVICE on Linux, IP_UNICAST_IF on Windows)
+// instead of passing the callback registered with amnezia_xray_setsockcallback (core 0011,
+// ContextWithSocketProtector). A probe never enters a tunnel that owns the default route; a failed
+// bind is the probe's error "bind_failed".
+// HTTPS is Go's own crypto/tls with the system roots: the service needs no TLS stack.
+
+/*
+#include <stdint.h>
+#include <stdlib.h>
+*/
+import "C"
+
+import (
+	"crypto/x509"
+	"runtime"
+
+	"xray_binding/tribescan"
+)
+
+var tribeScanTestRootCAs *x509.CertPool // test seam; nil in production (system roots)
+
+// tribeScanPlatform is the service's platform for one message. awg_mini is offered only when the
+// host options name the probe binary (`"awg_probe_binary": "/abs/path/amneziawg-go"`, built with
+// recipes/awg-go option tribe_probe): 4 sessions at once, each a child process (tribescan_awg.go).
+func tribeScanPlatform(hostOptionsJSON string) tribescan.Platform {
+	name := map[string]string{"darwin": "macos", "windows": "windows", "linux": "linux"}[runtime.GOOS]
+	p := tribescan.Platform{
+		Name:    name,
+		MaxFull: 2, // plan §2.4: composites two at a time
+		MaxLeg:  6, // legs share one instance per batch of 24
+		// macOS: the service must bind probe sockets to the uplink (a live AWG/Xray tunnel owns the
+		// default route); Windows/Linux may.
+		RequireBindInterface: runtime.GOOS == "darwin",
+		CanVerifyComposite:   true,
+		FootprintMB:          tribeScanFootprintMB,
+		RootCAs:              tribeScanTestRootCAs,
+	}
+	if bin := tribeScanAwgBinary(hostOptionsJSON); bin != "" {
+		p.Awg, p.MaxAwg = awgExecOpener(bin), 4
+	}
+	return p
+}
+
+func tribeScanMessageJSON(messageJSON, hostOptionsJSON string) string {
+	return tribescan.Message(messageJSON, hostOptionsJSON, tribeScanPlatform(hostOptionsJSON))
+}
+
+// amnezia_xray_scan_message: one tribe-scan-v1 message (scan_caps / scan_start / scan_add /
+// scan_poll / scan_freeze / scan_cancel) and its reply; host options (NULL = none): scan_start reads
+// {"bind_interface": "en0"} or {"bind_interface_index": n} (required on macOS), "awg_live_peer"
+// and "awg_probe_binary"; every message may carry "gen". scan_caps reads "awg_probe_binary" too.
+// Returns JSON (free with amnezia_xray_free). Never blocks on the network; a scan_start that
+// replaces a running scan waits up to 3 s.
+//
+//export amnezia_xray_scan_message
+func amnezia_xray_scan_message(cMessage *C.char, cHostOptions *C.char) *C.char {
+	return C.CString(tribeScanMessageJSON(C.GoString(cMessage), C.GoString(cHostOptions)))
+}
+
+// amnezia_xray_scan_stop_all: end the running scan (reason tunnel_stopped) and wait up to waitMs
+// (max 10000) until every probe instance is closed. {"stopped":bool}.
+//
+//export amnezia_xray_scan_stop_all
+func amnezia_xray_scan_stop_all(waitMs C.int64_t) *C.char {
+	return C.CString(tribescan.StopAllJSON(int64(waitMs)))
+}
diff --git a/tribescan_awg.go b/tribescan_awg.go
new file mode 100644
index 0000000..4fd04ae
--- /dev/null
+++ b/tribescan_awg.go
@@ -0,0 +1,175 @@
+//go:build darwin || linux
+
+package main
+
+// AVPN (amnezia-xray-bindings, patch 0001): awg_mini in the service. The live AmneziaWG tunnel is
+// the `amneziawg-go` daemon; each probe session runs in its own child `amneziawg-go probe`
+// (recipes/awg-go option tribe_probe, protocol tribe-awg-probe-v1), so a session never shares a
+// process with the live device. The engine here schedules it (pool, shared byte gate, spacing, one
+// per node, never the live peer) and runs the data probe over the child's stdin / stdout, which the
+// child pipes to its TCP connection inside the tunnel. The child is killed at the probe's deadline,
+// on cancel and on Close.
+
+import (
+	"bufio"
+	"context"
+	"encoding/json"
+	"errors"
+	"io"
+	"net"
+	"net/netip"
+	"os"
+	"os/exec"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"xray_binding/tribescan"
+)
+
+// tribeScanAwgBinary is the host option naming the probe binary (absolute path).
+func tribeScanAwgBinary(hostOptionsJSON string) string {
+	var o struct {
+		Binary string `json:"awg_probe_binary"`
+	}
+	if json.Unmarshal([]byte(hostOptionsJSON), &o) != nil || !strings.HasPrefix(o.Binary, "/") {
+		return ""
+	}
+	if st, err := os.Stat(o.Binary); err != nil || st.IsDir() || st.Mode()&0o111 == 0 {
+		return ""
+	}
+	return o.Binary
+}
+
+// awgExecChildren counts the probe children alive (started and not yet reaped).
+var awgExecChildren atomic.Int64
+
+// The engine's LiveWork and stop reply ("children") count them.
+func init() { tribescan.SetRunnerLive(nil, awgExecChildren.Load) }
+
+type awgExecSession struct {
+	cmd  *exec.Cmd
+	in   io.WriteCloser
+	out  *bufio.Reader
+	once sync.Once
+	st   struct {
+		HandshakeOK bool   `json:"handshake_ok"`
+		HandshakeMs int64  `json:"handshake_ms"`
+		EchoSent    int    `json:"echo_sent"`
+		EchoReplies int    `json:"echo_replies"`
+		EchoBytes   int64  `json:"echo_bytes"`
+		Error       string `json:"error"`
+	}
+}
+
+func awgExecOpener(binary string) tribescan.AwgOpener {
+	return func(ctx context.Context, job tribescan.AwgJob) (tribescan.AwgSession, error) {
+		cmd := exec.Command(binary, "probe")
+		cmd.Stderr = nil // the child logs nothing; whatever it might print never reaches a log
+		in, err := cmd.StdinPipe()
+		if err != nil {
+			return nil, err
+		}
+		out, err := cmd.StdoutPipe()
+		if err != nil {
+			return nil, err
+		}
+		if err := cmd.Start(); err != nil {
+			return nil, err
+		}
+		awgExecChildren.Add(1)
+		s := &awgExecSession{cmd: cmd, in: in, out: bufio.NewReader(out)}
+		// The probe's deadline, a cancel or a stop kills the child (the job's context ends when the
+		// session's job returns, so the registration never outlives it).
+		context.AfterFunc(ctx, func() { s.Close() })
+		var addrs []string
+		for _, p := range job.Addresses {
+			addrs = append(addrs, p.String())
+		}
+		target := ""
+		if job.EchoTarget.IsValid() {
+			target = job.EchoTarget.String()
+		}
+		raw, _ := json.Marshal(map[string]any{"uapi": job.UAPI, "address": addrs, "mtu": job.MTU, "bound_if": job.BoundIf,
+			"prime_echo_target": target, "prime_echoes": job.Echoes, "handshake_ms": job.Handshake.Milliseconds(),
+			"peer_key": job.PeerKey})
+		if _, err := in.Write(append(raw, '\n')); err != nil {
+			s.Close()
+			return nil, err
+		}
+		line, err := s.out.ReadBytes('\n')
+		if err != nil || json.Unmarshal(line, &s.st) != nil {
+			s.Close()
+			if ctx.Err() != nil {
+				return nil, ctx.Err()
+			}
+			return nil, errors.New("awg probe: no status")
+		}
+		switch s.st.Error {
+		case "":
+		case "config":
+			s.Close()
+			return nil, tribescan.ErrAwgConfig
+		case "bind_failed":
+			s.Close()
+			return nil, tribescan.ErrAwgBind
+		default:
+			s.Close()
+			return nil, errors.New("awg probe: " + s.st.Error)
+		}
+		return s, nil
+	}
+}
+
+func (s *awgExecSession) HandshakeOK() bool  { return s.st.HandshakeOK }
+func (s *awgExecSession) HandshakeMs() int64 { return s.st.HandshakeMs }
+func (s *awgExecSession) Echoes() (int, int, int64) {
+	return s.st.EchoSent, s.st.EchoReplies, s.st.EchoBytes
+}
+
+func (s *awgExecSession) DialTCP(ctx context.Context, addr netip.AddrPort) (net.Conn, error) {
+	stop := context.AfterFunc(ctx, func() { s.Close() })
+	defer stop()
+	raw, _ := json.Marshal(map[string]string{"connect": addr.String()})
+	if _, err := s.in.Write(append(raw, '\n')); err != nil {
+		return nil, err
+	}
+	line, err := s.out.ReadBytes('\n')
+	if err != nil {
+		return nil, err
+	}
+	var r struct {
+		Connected bool `json:"connected"`
+	}
+	if json.Unmarshal(line, &r) != nil || !r.Connected {
+		return nil, errors.New("awg probe: no connection")
+	}
+	return &awgExecConn{s: s}, nil
+}
+
+// Close kills the child at once (SIGKILL: a hung child cannot delay a stop) and reaps it; a
+// concurrent Close waits until it is reaped, so a session is gone when its job ends.
+func (s *awgExecSession) Close() error {
+	s.once.Do(func() {
+		s.in.Close()
+		if s.cmd.Process != nil {
+			s.cmd.Process.Kill()
+		}
+		s.cmd.Wait()
+		awgExecChildren.Add(-1)
+	})
+	return nil
+}
+
+// awgExecConn is the probe's stream: the child's stdout / stdin. Deadlines are the engine's watchdog.
+type awgExecConn struct{ s *awgExecSession }
+
+func (c *awgExecConn) Read(p []byte) (int, error)       { return c.s.out.Read(p) }
+func (c *awgExecConn) Write(p []byte) (int, error)      { return c.s.in.Write(p) }
+func (c *awgExecConn) Close() error                     { return c.s.Close() }
+func (c *awgExecConn) LocalAddr() net.Addr              { return &net.TCPAddr{} }
+func (c *awgExecConn) RemoteAddr() net.Addr             { return &net.TCPAddr{} }
+func (c *awgExecConn) SetDeadline(time.Time) error      { return nil }
+func (c *awgExecConn) SetReadDeadline(time.Time) error  { return nil }
+func (c *awgExecConn) SetWriteDeadline(time.Time) error { return nil }
