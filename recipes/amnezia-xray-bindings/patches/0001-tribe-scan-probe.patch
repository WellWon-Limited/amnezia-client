@@ -0,0 +1,146 @@
+//go:build tribescan_testkit
+
+package main
+
+// Gate of the bindings scan export (patch 0001), -race: probes run while the service's singleton
+// core (amnezia_xray_configure/start/stop: core.LoadConfig("json") + core.New + Start + Close) is
+// restarted, with a process-wide dialer controller registered the way amnezia_xray_setsockcallback
+// does it, and every probe socket bound to the loopback interface by host_options.bind_interface.
+
+import (
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"runtime"
+	"sync"
+	"sync/atomic"
+	"syscall"
+	"testing"
+	"time"
+
+	clog "github.com/xtls/xray-core/common/log"
+	"github.com/xtls/xray-core/core"
+	"github.com/xtls/xray-core/transport/internet"
+
+	"xray_binding/tribescan"
+)
+
+type tribeScanQuiet struct{}
+
+func (tribeScanQuiet) Handle(clog.Message) {}
+
+var tribeScanControllerOnce sync.Once
+var tribeScanControllerCalls atomic.Int64
+
+func tribeScanLoopback() string {
+	if runtime.GOOS == "linux" {
+		return "lo"
+	}
+	return "lo0"
+}
+
+func tribeScanRunExport(t *testing.T, req, opts string) *tribescan.KitResult {
+	t.Helper()
+	r := &tribescan.KitResult{}
+	raw := tribeScanMessageJSON(req, opts)
+	if json.Unmarshal([]byte(raw), &r.Ack); r.Ack.Type != "scan_ack" {
+		json.Unmarshal([]byte(raw), &r.Err)
+		r.Final = tribescan.Progress{Done: true, Reason: r.Err.Error}
+		return r
+	}
+	r.ScanID = r.Ack.ScanID
+	return tribescan.KitPoll(t, r, 30*time.Second, time.Now())
+}
+
+func TestTribeScanBindingsExport(t *testing.T) {
+	clog.RegisterHandler(tribeScanQuiet{})
+	srv := tribescan.NewProbeServer(t)
+	vless := tribescan.StartVlessServer(t, srv.Port)
+	tribeScanTestRootCAs = srv.Pool
+	t.Cleanup(func() { tribescan.StopAllWait(5 * time.Second); tribeScanTestRootCAs = nil })
+	tribeScanControllerOnce.Do(func() { // as amnezia_xray_setsockcallback (append-only, process-wide)
+		internet.RegisterDialerController(func(network, address string, c syscall.RawConn) error {
+			if address == fmt.Sprintf("127.0.0.1:%d", vless) {
+				tribeScanControllerCalls.Add(1)
+			}
+			return nil
+		})
+	})
+	opts := fmt.Sprintf(`{"bind_interface":%q}`, tribeScanLoopback())
+	var cands []map[string]any
+	for i := 0; i < 3; i++ {
+		cands = append(cands, tribescan.KitFullCandidate(fmt.Sprintf("full%d", i), vless))
+		cands = append(cands, tribescan.KitLegCandidate(fmt.Sprintf("leg%d", i), tribescan.VlessOutbound("proxy", vless), nil, nil))
+	}
+	req := func(id string) string { return tribescan.KitRequest(id, srv.Base(), nil, 30000, cands...) }
+
+	if runtime.GOOS == "darwin" {
+		if r := tribeScanRunExport(t, req("no-bind"), ""); r.Err.Error != "bad_request" {
+			t.Fatalf("macOS without bind_interface: %+v", r.Err)
+		}
+	}
+	var caps tribescan.Caps
+	json.Unmarshal([]byte(tribeScanMessageJSON(`{"action":"scan_caps"}`, "")), &caps)
+	if caps.MaxFullConcurrent != 2 || caps.MaxLegConcurrent != 6 || !caps.CanVerifyComposite || caps.NeedsVPN {
+		t.Fatalf("caps %+v", caps)
+	}
+	before := tribeScanControllerCalls.Load()
+	r := tribeScanRunExport(t, req("steady"), opts)
+	if r.Final.Reason != tribescan.ReasonComplete || len(r.Data()) != 6 {
+		t.Fatalf("steady %+v %+v", r.Final, r.Err)
+	}
+	// The service's own callback (amnezia_xray_setsockcallback) is bypassed: probe sockets are bound
+	// by the probe's protector (review F3).
+	if tribeScanControllerCalls.Load() != before {
+		t.Fatalf("%d probe sockets passed the service's process-wide callback", tribeScanControllerCalls.Load()-before)
+	}
+
+	// The service's singleton tunnel core restarts while probes run.
+	raw, _ := json.Marshal(tribescan.TunnelConfig(vless, tribescan.FreePort(t)))
+	srv.SetMode("slow_first_byte", false)
+	srv.Delay.Store(150)
+	var restarts atomic.Int32
+	stop := make(chan struct{})
+	var wg sync.WaitGroup
+	wg.Add(1)
+	go func() {
+		defer wg.Done()
+		for {
+			select {
+			case <-stop:
+				return
+			default:
+			}
+			cfg, err := core.LoadConfig("json", bytes.NewReader(raw))
+			if err != nil {
+				t.Error(err)
+				return
+			}
+			inst, err := core.New(cfg)
+			if err != nil || inst.Start() != nil {
+				t.Error("tunnel core did not start")
+				return
+			}
+			time.Sleep(15 * time.Millisecond)
+			inst.Close()
+			restarts.Add(1)
+		}
+	}()
+	for i := 0; i < 3; i++ {
+		r := tribeScanRunExport(t, req(fmt.Sprintf("churn%d", i)), opts)
+		for _, d := range r.Data() {
+			if d.Error != "" || d.ShaOK == nil || !*d.ShaOK {
+				t.Fatalf("scan %d during tunnel restarts: %+v", i, d)
+			}
+		}
+	}
+	close(stop)
+	wg.Wait()
+	t.Logf("tunnel restarts during 3 scans: %d; controller calls %d", restarts.Load(), tribeScanControllerCalls.Load())
+	if restarts.Load() < 10 || tribescan.LiveInstances() != 0 {
+		t.Fatalf("restarts %d live %d", restarts.Load(), tribescan.LiveInstances())
+	}
+	if mb := tribeScanFootprintMB(); runtime.GOOS == "darwin" && mb <= 0 {
+		t.Fatalf("footprint %v", mb)
+	}
+}
