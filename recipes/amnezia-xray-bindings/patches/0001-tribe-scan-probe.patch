diff --git a/tribescan_awg_test.go b/tribescan_awg_test.go
new file mode 100644
index 0000000..9ab0758
--- /dev/null
+++ b/tribescan_awg_test.go
@@ -0,0 +1,128 @@
+//go:build tribescan_testkit && (darwin || linux)
+
+package main
+
+// The service's awg_mini path (tribescan_awg.go) against a stand-in child: this test binary run as
+// `<binary> probe` speaks tribe-awg-probe-v1 and "tunnels" by dialling the kit server directly
+// (the real child, `amneziawg-go probe`, is the awg-go recipe's own gate). Checks the protocol,
+// the data probe over the child's pipes, the refusals, and that every child is reaped.
+
+import (
+	"bufio"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net"
+	"os"
+	"strings"
+	"testing"
+	"time"
+
+	"xray_binding/tribescan"
+)
+
+func init() {
+	if os.Getenv("TRIBESCAN_FAKE_AWG_CHILD") == "1" && len(os.Args) > 1 && os.Args[1] == "probe" {
+		os.Exit(tribeScanFakeAwgChild())
+	}
+}
+
+func tribeScanFakeAwgChild() int {
+	br := bufio.NewReader(os.Stdin)
+	line, err := br.ReadBytes('\n')
+	if err != nil {
+		return 1
+	}
+	var job struct {
+		PeerKey string `json:"peer_key"`
+		BoundIf int    `json:"bound_if"`
+		Echoes  int    `json:"prime_echoes"`
+	}
+	json.Unmarshal(line, &job)
+	if strings.HasPrefix(job.PeerKey, "ff") { // a node that never answers
+		fmt.Println(`{"handshake_ok":false,"handshake_ms":-1,"echo_sent":0,"echo_replies":0,"echo_bytes":0,"error":""}`)
+		return 0
+	}
+	if job.BoundIf == 0 {
+		fmt.Println(`{"handshake_ok":false,"handshake_ms":-1,"echo_sent":0,"echo_replies":0,"echo_bytes":0,"error":"bind_failed"}`)
+		return 0
+	}
+	fmt.Printf(`{"handshake_ok":true,"handshake_ms":4,"echo_sent":%d,"echo_replies":%d,"echo_bytes":%d,"error":""}`+"\n",
+		job.Echoes, job.Echoes, 168*job.Echoes)
+	line, err = br.ReadBytes('\n')
+	if err != nil {
+		return 0
+	}
+	var req struct {
+		Connect string `json:"connect"`
+	}
+	json.Unmarshal(line, &req)
+	c, err := net.Dial("tcp", req.Connect)
+	if err != nil {
+		fmt.Println(`{"connected":false,"error":"dial"}`)
+		return 0
+	}
+	fmt.Println(`{"connected":true,"error":""}`)
+	done := make(chan struct{}, 2)
+	go func() { io.Copy(c, br); c.(*net.TCPConn).CloseWrite(); done <- struct{}{} }()
+	go func() { io.Copy(os.Stdout, c); done <- struct{}{} }()
+	<-done
+	return 0
+}
+
+func tribeScanAwgCand(id, peerKey string, port int) map[string]any {
+	uapi := fmt.Sprintf("private_key=%s\nlisten_port=0\npublic_key=%s\nendpoint=127.0.0.1:51820\nallowed_ip=127.0.0.1/32\n",
+		strings.Repeat("11", 32), peerKey)
+	cfg, _ := json.Marshal(map[string]any{"uapi": uapi, "probe": map[string]any{"host": "example.com", "ip": "127.0.0.1", "port": port},
+		"prime_echo_target": "10.8.0.1", "bound_if": nil, "address": "10.8.0.2/32"})
+	return map[string]any{"id": id, "kind": tribescan.KindAwgMini, "config": string(cfg), "entry": nil, "reach_at_ms": -1,
+		"profile_id": nil, "early_retry": false, "dns_plan": false, "cost_bytes": 90000}
+}
+
+func TestTribeScanBindingsAwgChild(t *testing.T) {
+	srv := tribescan.NewProbeServer(t)
+	tribeScanTestRootCAs = srv.Pool
+	t.Cleanup(func() { tribescan.StopAllWait(5 * time.Second); tribeScanTestRootCAs = nil })
+	t.Setenv("TRIBESCAN_FAKE_AWG_CHILD", "1")
+	self, err := os.Executable()
+	if err != nil {
+		t.Fatal(err)
+	}
+	// Without the binary the service offers no awg_mini.
+	var caps tribescan.Caps
+	json.Unmarshal([]byte(tribeScanMessageJSON(`{"action":"scan_caps"}`, "")), &caps)
+	if caps.MaxAwgConcurrent != 0 {
+		t.Fatalf("caps without a probe binary: %+v", caps)
+	}
+	opts := fmt.Sprintf(`{"bind_interface":%q,"awg_probe_binary":%q}`, tribeScanLoopback(), self)
+	json.Unmarshal([]byte(tribeScanMessageJSON(`{"action":"scan_caps"}`, opts)), &caps)
+	if caps.MaxAwgConcurrent != 4 || caps.Kinds[len(caps.Kinds)-1] != tribescan.KindAwgMini {
+		t.Fatalf("caps with a probe binary: %+v", caps)
+	}
+	key := func(b byte) string { return strings.Repeat(fmt.Sprintf("%02x", b), 32) }
+	before := tribescan.OpenFDs()
+	req := tribescan.KitRequest("awg-child", srv.Base(), map[string]any{"awg_concurrency": 4, "concurrency": 0, "awg_prime_echoes": 1}, 30000,
+		tribeScanAwgCand("n1", key(1), srv.Port), tribeScanAwgCand("n2", key(2), srv.Port), tribeScanAwgCand("silent", key(0xff), srv.Port))
+	r := tribeScanRunExport(t, req, opts)
+	for _, id := range []string{"n1", "n2"} {
+		d, _ := r.DataByID(id)
+		if d.Error != "" || d.ShaOK == nil || !*d.ShaOK || d.HandshakeOK == nil || !*d.HandshakeOK || d.EchoSent == nil || *d.EchoSent != 1 {
+			raw, _ := json.Marshal(d)
+			t.Fatalf("%s: %s", id, raw)
+		}
+	}
+	if d, _ := r.DataByID("silent"); d.Error != tribescan.ErrDial {
+		t.Fatalf("silent node: %+v", d)
+	}
+	// The interface binding is the child's: without one it reports bind_failed.
+	r = tribeScanRunExport(t, tribescan.KitRequest("awg-child-unbound", srv.Base(), map[string]any{"awg_concurrency": 4, "concurrency": 0}, 30000,
+		tribeScanAwgCand("u", key(3), srv.Port)), fmt.Sprintf(`{"awg_probe_binary":%q}`, self))
+	if r.Err.Error == "" {
+		if d, _ := r.DataByID("u"); d.Error != tribescan.ErrBindFailed {
+			t.Fatalf("unbound child: %+v", d)
+		}
+	}
+	if fd := tribescan.OpenFDs(); before >= 0 && fd > before+2 {
+		t.Fatalf("fds %d after the children, %d before", fd, before)
+	}
+}
diff --git a/tribescan_darwin.go b/tribescan_darwin.go
new file mode 100644
index 0000000..800b958
--- /dev/null
+++ b/tribescan_darwin.go
@@ -0,0 +1,21 @@
+//go:build darwin
+
+package main
+
+// AVPN (patch 0001): the service's physical footprint for progress.mem_mb.
+
+/*
+#include <mach/mach.h>
+
+static double amnezia_xray_scan_footprint_mb(void) {
+	task_vm_info_data_t info;
+	mach_msg_type_number_t count = TASK_VM_INFO_COUNT;
+	if (task_info(mach_task_self(), TASK_VM_INFO, (task_info_t)&info, &count) != KERN_SUCCESS) {
+		return -1;
+	}
+	return (double)info.phys_footprint / (1024.0 * 1024.0);
+}
+*/
+import "C"
+
+func tribeScanFootprintMB() float64 { return float64(C.amnezia_xray_scan_footprint_mb()) }
