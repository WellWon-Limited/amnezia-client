diff --git a/tribescan_stop_test.go b/tribescan_stop_test.go
new file mode 100644
index 0000000..3faffca
--- /dev/null
+++ b/tribescan_stop_test.go
@@ -0,0 +1,61 @@
+//go:build tribescan_testkit && (darwin || linux)
+
+package main
+
+// The service's probe child that hangs (never answers, ignores its stdin) cannot hold a stop:
+// StopAll kills it and reaps it before it returns true.
+
+import (
+	"bufio"
+	"encoding/json"
+	"fmt"
+	"os"
+	"strings"
+	"testing"
+	"time"
+
+	"xray_binding/tribescan"
+)
+
+func init() {
+	if os.Getenv("TRIBESCAN_HUNG_AWG_CHILD") == "1" && len(os.Args) > 1 && os.Args[1] == "probe" {
+		bufio.NewReader(os.Stdin).ReadBytes('\n')
+		select {} // hung: no status, ever
+	}
+}
+
+func TestTribeScanStopAllHungChild(t *testing.T) {
+	srv := tribescan.NewProbeServer(t)
+	t.Cleanup(func() { tribescan.StopAllWait(5 * time.Second) })
+	t.Setenv("TRIBESCAN_HUNG_AWG_CHILD", "1")
+	self, err := os.Executable()
+	if err != nil {
+		t.Fatal(err)
+	}
+	plat := tribescan.Platform{Name: "test", MaxAwg: 4, Awg: awgExecOpener(self), RootCAs: srv.Pool}
+	uapi := fmt.Sprintf("private_key=%s\nlisten_port=0\nreplace_peers=true\npublic_key=%s\nendpoint=127.0.0.1:51820\nreplace_allowed_ips=true\nallowed_ip=127.0.0.1/32\n",
+		strings.Repeat("11", 32), strings.Repeat("22", 32))
+	cfg, _ := json.Marshal(map[string]any{"uapi": uapi, "address": "10.8.0.2/32", "probe": map[string]any{"host": "example.com", "ip": "127.0.0.1", "port": srv.Port},
+		"prime_echo_target": nil, "bound_if": nil})
+	cand := map[string]any{"id": "hung", "kind": tribescan.KindAwgMini, "config": string(cfg), "entry": nil, "reach_at_ms": -1,
+		"profile_id": nil, "early_retry": false, "dns_plan": false, "cost_bytes": 90000}
+	var ack tribescan.Ack
+	tribescan.KitMessage(t, tribescan.KitRequest("hung-child", srv.Base(), map[string]any{"awg_concurrency": 2, "concurrency": 0,
+		"awg_handshake_ms": 5000, "total_ms": 30000}, 60000, cand), "", plat, &ack)
+	for end := time.Now().Add(5 * time.Second); awgExecChildren.Load() != 1; time.Sleep(5 * time.Millisecond) {
+		if time.Now().After(end) {
+			t.Fatalf("child not started: %+v", ack)
+		}
+	}
+	if w := tribescan.LiveWork(); w.Children != 1 { // the runner's count reaches LiveWork and the stop reply
+		t.Fatalf("LiveWork with one child: %+v", w)
+	}
+	t0 := time.Now()
+	if !tribescan.StopAll(3 * time.Second) {
+		t.Fatal("StopAll timed out on a hung child")
+	}
+	if n := awgExecChildren.Load(); n != 0 || tribescan.LiveWork() != (tribescan.Work{}) {
+		t.Fatalf("StopAll returned true with %d children, %+v alive", n, tribescan.LiveWork())
+	}
+	t.Logf("hung child killed and reaped %v after the stop", time.Since(t0))
+}
