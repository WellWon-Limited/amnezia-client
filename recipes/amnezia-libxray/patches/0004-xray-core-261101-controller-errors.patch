+package internet
+
+import (
+	"context"
+	"errors"
+	"syscall"
+	"testing"
+
+	"github.com/xtls/xray-core/common/net"
+)
+
+type tribeTestRawConn struct{}
+
+func (tribeTestRawConn) Control(callback func(uintptr)) error { callback(7); return nil }
+func (tribeTestRawConn) Read(func(uintptr) bool) error        { return nil }
+func (tribeTestRawConn) Write(func(uintptr) bool) error       { return nil }
+
+// TestTribeExternalControllerErrorsArePropagated pins the fail-closed contract
+// of every socket path an external (protect) controller sees: the listener
+// path (patched here) and both system dialer paths (upstream since 261101).
+func TestTribeExternalControllerErrorsArePropagated(t *testing.T) {
+	want := errors.New("protect rejected")
+	controllers := []func(string, string, syscall.RawConn) error{
+		func(string, string, syscall.RawConn) error { return want },
+	}
+	if got := applyExternalControllers(controllers, "tcp", "127.0.0.1:1", tribeTestRawConn{}); !errors.Is(got, want) {
+		t.Fatalf("controller error was not propagated: %v", got)
+	}
+	control := getControlFunc(nil, nil, controllers)
+	if got := control("tcp", "127.0.0.1:1", tribeTestRawConn{}); !errors.Is(got, want) {
+		t.Fatalf("listener controller error was not propagated: %v", got)
+	}
+
+	ControllersLock.Lock()
+	saved := Controllers
+	Controllers = controllers
+	ControllersLock.Unlock()
+	defer func() {
+		ControllersLock.Lock()
+		Controllers = saved
+		ControllersLock.Unlock()
+	}()
+	dialer := &DefaultSystemDialer{}
+	for _, dest := range []net.Destination{
+		net.TCPDestination(net.LocalHostIP, net.Port(9)),
+		net.UDPDestination(net.LocalHostIP, net.Port(9)),
+	} {
+		conn, err := dialer.Dial(context.Background(), nil, dest, nil)
+		if conn != nil {
+			conn.Close()
+		}
+		if !errors.Is(err, want) {
+			t.Fatalf("dialer controller error was not propagated for %v: %v", dest, err)
+		}
+	}
+}
