diff --git a/transport/internet/tribe_controller_test.go b/transport/internet/tribe_controller_test.go
new file mode 100644
index 000000000..f32878ac5
--- /dev/null
+++ b/transport/internet/tribe_controller_test.go
@@ -0,0 +1,27 @@
+package internet
+
+import (
+	"errors"
+	"syscall"
+	"testing"
+)
+
+type tribeTestRawConn struct{}
+
+func (tribeTestRawConn) Control(callback func(uintptr)) error { callback(7); return nil }
+func (tribeTestRawConn) Read(func(uintptr) bool) error        { return nil }
+func (tribeTestRawConn) Write(func(uintptr) bool) error       { return nil }
+
+func TestTribeExternalControllerErrorsArePropagated(t *testing.T) {
+	want := errors.New("protect rejected")
+	controllers := []func(string, string, syscall.RawConn) error{
+		func(string, string, syscall.RawConn) error { return want },
+	}
+	if got := applyExternalControllers(controllers, "tcp", "127.0.0.1:1", tribeTestRawConn{}); !errors.Is(got, want) {
+		t.Fatalf("dial controller error was not propagated: %v", got)
+	}
+	control := getControlFunc(nil, nil, controllers)
+	if got := control("tcp", "127.0.0.1:1", tribeTestRawConn{}); !errors.Is(got, want) {
+		t.Fatalf("listener controller error was not propagated: %v", got)
+	}
+}
