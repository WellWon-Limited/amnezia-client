+// applyExternalControllers is deliberately fail-closed. A controller is the
+// platform's only opportunity to move a socket outside the VPN before the
+// socket starts carrying Xray traffic; logging and continuing can leak it.
+func applyExternalControllers(controllers []func(network, address string, c syscall.RawConn) error, network, address string, c syscall.RawConn) error {
+	for _, controller := range controllers {
+		if err := controller(network, address, c); err != nil {
+			return err
+		}
+	}
+	return nil
+}
