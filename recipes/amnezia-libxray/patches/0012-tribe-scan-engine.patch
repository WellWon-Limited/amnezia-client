+//go:build tribescan_testkit
+
+package tribescan
+
+// Test kit of the probe engine (build tag tribescan_testkit; never in a production archive): a
+// local HTTPS server that implements GET /v1/probe and its failure modes, a local VLESS server
+// core that every probe instance reaches through a real outbound, a TCP gate that refuses
+// connections until it opens (a guarded provider profile's first second), and tunnel-like client
+// configs. The host export tests (awg-apple, xray-bindings) use it through the same tag.
+
+import (
+	"context"
+	"crypto/sha256"
+	"crypto/x509"
+	"encoding/binary"
+	"encoding/hex"
+	"encoding/json"
+	"encoding/pem"
+	"fmt"
+	"io"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"net/netip"
+	"os"
+	"regexp"
+	"runtime"
+	"strconv"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"syscall"
+	"testing"
+	"time"
+
+	"github.com/xtls/xray-core/core"
+	"github.com/xtls/xray-core/transport/internet"
+)
+
+// KitUUID is the user of the local VLESS server.
+const KitUUID = "6f1d2c3b-4a59-4e6d-8c7b-1a2b3c4d5e6f"
+
+// KitToken is a well-formed scan token for the local server.
+const KitToken = "tsc1.local-test-token"
+
+// Server answer facts.
+const (
+	KitEgressClass = "tribe-node"
+	KitEgressNode  = "9"
+	KitEgressAsn   = "64500"
+	KitNetToken    = "egressTok1"
+)
+
+// kitBody is the tribe-probe-v1 body, written independently of body.go (contract text).
+func kitBody(nonce string, n int) []byte {
+	out := make([]byte, 0, n+32)
+	for i := uint32(0); len(out) < n; i++ {
+		h := sha256.New()
+		h.Write([]byte("tribe-probe-v1"))
+		h.Write([]byte{0})
+		h.Write([]byte(nonce))
+		h.Write([]byte{0})
+		var be [4]byte
+		binary.BigEndian.PutUint32(be[:], i)
+		h.Write(be[:])
+		out = h.Sum(out)
+	}
+	return out[:n]
+}
+
+// Seen is one request the probe server received.
+type Seen struct {
+	RemoteAddr    string
+	Bytes         int
+	Nonce         string
+	ProfileID     string
+	Authorization string
+	AccessToken   string
+	AccessAsn     string
+	At            time.Time
+}
+
+// ProbeServer implements GET /v1/probe like the backend (scan.py / routers/scan.py) plus failure
+// modes for the sized request.
+type ProbeServer struct {
+	Srv     *httptest.Server
+	Port    int
+	Pool    *x509.CertPool
+	Delay   atomic.Int64 // ms before the headers in mode slow_first_byte
+	stalled atomic.Int32
+
+	mu          sync.Mutex
+	mode        string
+	allRequests bool // the mode applies to the warm-up request too
+	seen        []Seen
+	inflight    atomic.Int32
+	maxInflight atomic.Int32
+	dohQueries  atomic.Int32
+	netinfo     atomic.Int32
+	release     chan struct{}
+}
+
+var nonceRE = regexp.MustCompile(`^[A-Za-z0-9._-]{8,64}$`)
+
+// NewProbeServer starts the server (closed by t.Cleanup).
+func NewProbeServer(t testing.TB) *ProbeServer {
+	p := NewProbeServerStandalone()
+	t.Cleanup(p.Close)
+	return p
+}
+
+// NewProbeServerStandalone is NewProbeServer outside a test (a helper process); Close ends it.
+func NewProbeServerStandalone() *ProbeServer {
+	p := &ProbeServer{mode: "ok", release: make(chan struct{})}
+	p.Srv = httptest.NewUnstartedServer(http.HandlerFunc(p.handle))
+	p.Srv.StartTLS()
+	p.Pool = x509.NewCertPool()
+	p.Pool.AddCert(p.Srv.Certificate())
+	_, port, _ := net.SplitHostPort(p.Srv.Listener.Addr().String())
+	p.Port, _ = strconv.Atoi(port)
+	SetDirectAddr(fmt.Sprintf("127.0.0.1:%d", p.Port)) // the direct check never leaves this machine
+	return p
+}
+
+// Stalled counts the sized bodies held in mode "stall" after their first 32 KiB were sent.
+func (p *ProbeServer) Stalled() int32 { return p.stalled.Load() }
+
+// Sized counts the sized requests (bytes above the warm-up's 1024) the server has seen.
+func (p *ProbeServer) Sized() int {
+	n := 0
+	for _, s := range p.Seen() {
+		if s.Bytes > 1024 {
+			n++
+		}
+	}
+	return n
+}
+
+// KitWaitFor polls cond every 5 ms until it holds; past timeout the test fails (no fixed sleeps:
+// a loaded machine only makes it slower, never wrong).
+func KitWaitFor(t testing.TB, what string, timeout time.Duration, cond func() bool) {
+	t.Helper()
+	for end := time.Now().Add(timeout); !cond(); time.Sleep(5 * time.Millisecond) {
+		if time.Now().After(end) {
+			t.Fatalf("waited %v for %s", timeout, what)
+		}
+	}
+}
+
+// KitPollUntil polls a scan (since 0) until cond holds for its progress, and returns it.
+func KitPollUntil(t testing.TB, scanID, what string, timeout time.Duration, cond func(Progress) bool) Progress {
+	t.Helper()
+	var p Progress
+	KitWaitFor(t, what, timeout, func() bool {
+		p = Progress{}
+		KitMessage(t, fmt.Sprintf(`{"action":"scan_poll","scan_id":%q,"since":0}`, scanID), "", Platform{}, &p)
+		return cond(p)
+	})
+	return p
+}
+
+// Close ends the server and its connections.
+func (p *ProbeServer) Close() {
+	p.Release()
+	p.Srv.CloseClientConnections()
+	p.Srv.Close()
+}
+
+// CertPEM is the server's certificate (for a pool in another process: PoolFromPEM).
+func (p *ProbeServer) CertPEM() string {
+	return string(pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: p.Srv.Certificate().Raw}))
+}
+
+// PoolFromPEM is a root pool holding the certificates in text.
+func PoolFromPEM(text string) *x509.CertPool {
+	pool := x509.NewCertPool()
+	pool.AppendCertsFromPEM([]byte(text))
+	return pool
+}
+
+// SetDirectAddr points the host's direct access check at addr (the kit's server, or a closed port
+// to play an access network that cannot reach the probe host).
+func SetDirectAddr(addr string) { directDialOverride.Store(&addr) }
+
+// SetCloseInstanceHook runs h before every probe instance close (nil: none) - a slow close.
+func SetCloseInstanceHook(h func()) {
+	if h == nil {
+		closeInstanceHook.Store(nil)
+		return
+	}
+	closeInstanceHook.Store(&h)
+}
+
+// SetDirectResolve replaces the system resolver of the direct access attempts (nil: the system's).
+func SetDirectResolve(f func(ctx context.Context, host string) ([]netip.Addr, error)) {
+	if f == nil {
+		directResolve.Store(nil)
+		return
+	}
+	directResolve.Store(&f)
+}
+
+// NetinfoCalls counts /v1/netinfo requests (the direct checks).
+func (p *ProbeServer) NetinfoCalls() int32 { return p.netinfo.Load() }
+
+// Base is the probe_base a scan uses: the certificate's name; the VLESS server sends every
+// stream to this server whatever the name.
+func (p *ProbeServer) Base() string { return fmt.Sprintf("https://example.com:%d", p.Port) }
+
+// SetMode switches the behaviour of the sized request (all=true: of every request).
+func (p *ProbeServer) SetMode(mode string, all bool) {
+	p.mu.Lock()
+	p.mode, p.allRequests = mode, all
+	p.mu.Unlock()
+}
+
+// Release unblocks handlers parked by mode stall / hang.
+func (p *ProbeServer) Release() {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	select {
+	case <-p.release:
+	default:
+		close(p.release)
+	}
+}
+
+// Seen returns the requests so far.
+func (p *ProbeServer) Seen() []Seen {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	return append([]Seen(nil), p.seen...)
+}
+
+// DoHQueries counts /dns-query requests.
+func (p *ProbeServer) DoHQueries() int32 { return p.dohQueries.Load() }
+
+// MaxInflight is the highest number of requests handled at once.
+func (p *ProbeServer) MaxInflight() int32 { return p.maxInflight.Load() }
+
+func (p *ProbeServer) handle(w http.ResponseWriter, r *http.Request) {
+	if r.URL.Path == "/v1/netinfo" { // the host's direct access check
+		p.netinfo.Add(1)
+		w.Header().Set("X-Tribe-Api", "1")
+		if !strings.HasPrefix(r.Header.Get("Authorization"), "Bearer tsc1.") {
+			writeJSON(w, http.StatusUnauthorized, `{"code":"scan_token_invalid"}`)
+			return
+		}
+		writeJSON(w, http.StatusOK, `{"type":"netinfo","asn":12389,"net_token":"accessTok9"}`)
+		return
+	}
+	n := p.inflight.Add(1)
+	defer p.inflight.Add(-1)
+	for seen := p.maxInflight.Load(); n > seen && !p.maxInflight.CompareAndSwap(seen, n); seen = p.maxInflight.Load() {
+	}
+	if r.URL.Path == "/dns-query" { // RFC 8484 POST for the DoH resolver of a leg's DNS plan
+		q, _ := io.ReadAll(io.LimitReader(r.Body, 4096))
+		p.dohQueries.Add(1)
+		w.Header().Set("Content-Type", "application/dns-message")
+		w.Write(kitDNSAnswer(q, false))
+		return
+	}
+	w.Header().Set("X-Tribe-Api", "1")
+	if r.URL.Path != "/v1/probe" {
+		w.WriteHeader(http.StatusNotFound)
+		return
+	}
+	q := r.URL.Query()
+	size, err := strconv.Atoi(q.Get("bytes"))
+	nonce := q.Get("nonce")
+	auth := r.Header.Get("Authorization")
+	p.mu.Lock()
+	p.seen = append(p.seen, Seen{RemoteAddr: r.RemoteAddr, Bytes: size, Nonce: nonce,
+		ProfileID: q.Get("profile_id"), Authorization: auth,
+		AccessToken: r.Header.Get("X-Tribe-Access-Net-Token"), AccessAsn: r.Header.Get("X-Tribe-Access-Asn"),
+		At: time.Now()})
+	mode := p.mode
+	if !p.allRequests && size <= 1024 {
+		mode = "ok"
+	}
+	release := p.release
+	p.mu.Unlock()
+	if !strings.HasPrefix(auth, "Bearer tsc1.") {
+		writeJSON(w, http.StatusUnauthorized, `{"code":"scan_token_invalid"}`)
+		return
+	}
+	if err != nil || !nonceRE.MatchString(nonce) {
+		writeJSON(w, http.StatusUnprocessableEntity, `{"code":"invalid_request"}`)
+		return
+	}
+	size = max(1024, min(size, 1<<20))
+	body := kitBody(nonce, size)
+	set := func(n int) {
+		h := w.Header()
+		h.Set("Content-Length", strconv.Itoa(n))
+		h.Set("Content-Type", "application/octet-stream")
+		h.Set("Content-Encoding", "identity")
+		h.Set("Cache-Control", "no-store, no-transform")
+		h.Set("X-Tribe-Probe-Len", strconv.Itoa(n))
+		sum := sha256.Sum256(body)
+		h.Set("X-Tribe-Probe-Sha256", hex.EncodeToString(sum[:]))
+		h.Set("X-Tribe-Probe-Nonce", nonce)
+		h.Set("X-Tribe-Egress-Class", KitEgressClass)
+		h.Set("X-Tribe-Egress-Asn", KitEgressAsn)
+		h.Set("X-Tribe-Net-Token", KitNetToken)
+		h.Set("X-Tribe-Egress-Node", KitEgressNode)
+	}
+	switch mode {
+	case "ok":
+		set(size)
+		w.Write(body)
+	case "wrong_digest":
+		set(size)
+		body[size/2] ^= 0xff
+		w.Write(body)
+	case "short":
+		set(size)
+		w.Write(body[:size/2]) // net/http closes the connection: the client sees an early EOF
+	case "oversize":
+		set(size + 100)
+		w.Write(append(body, make([]byte, 100)...))
+	case "slow_first_byte":
+		select {
+		case <-time.After(time.Duration(p.Delay.Load()) * time.Millisecond):
+		case <-release:
+		}
+		set(size)
+		w.Write(body)
+	case "stall":
+		set(size)
+		w.Write(body[:32<<10])
+		w.(http.Flusher).Flush()
+		p.stalled.Add(1)
+		select {
+		case <-release:
+		case <-time.After(20 * time.Second):
+		}
+	case "401":
+		writeJSON(w, http.StatusUnauthorized, `{"code":"scan_token_invalid"}`)
+	case "429":
+		w.Header().Set("Retry-After", "30")
+		writeJSON(w, http.StatusTooManyRequests, `{"code":"budget_exhausted","retry_after_s":30}`)
+	case "404":
+		w.WriteHeader(http.StatusNotFound)
+	case "redirect":
+		http.Redirect(w, r, "https://example.net/v1/probe", http.StatusFound)
+	case "portal":
+		w.Header().Del("X-Tribe-Api")
+		w.Header().Set("Content-Type", "text/html")
+		w.Write([]byte("<html>login</html>"))
+	default:
+		panic("unknown mode " + mode)
+	}
+}
+
+func writeJSON(w http.ResponseWriter, status int, body string) {
+	w.Header().Set("Content-Type", "application/json")
+	w.WriteHeader(status)
+	io.WriteString(w, body)
+}
+
+// FreePort returns a loopback TCP port that was free a moment ago.
+func FreePort(t testing.TB) int {
+	t.Helper()
+	ln, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer ln.Close()
+	return ln.Addr().(*net.TCPAddr).Port
+}
+
+// StartCore builds and starts a core instance from a JSON config without its log app (loadCore),
+// so test servers do not replace the process-wide log handler either.
+func StartCore(t testing.TB, cfg map[string]any) *core.Instance {
+	t.Helper()
+	c, err := loadCore(cfg)
+	if err != nil {
+		t.Fatalf("server config: %v", err)
+	}
+	inst, err := core.New(c)
+	if err != nil {
+		t.Fatalf("server core: %v", err)
+	}
+	if err := inst.Start(); err != nil {
+		t.Fatalf("server start: %v", err)
+	}
+	t.Cleanup(func() { inst.Close() })
+	return inst
+}
+
+// StartServerCore is StartCore for the kit's own servers: their sockets run an allow-all protector
+// instead of the process-wide controllers, so a test may arm a rejecting tunnel callback.
+func StartServerCore(t testing.TB, cfg map[string]any) *core.Instance {
+	t.Helper()
+	c, err := loadCore(cfg)
+	if err != nil {
+		t.Fatalf("server config: %v", err)
+	}
+	allow := func(string, string, syscall.RawConn) error { return nil }
+	inst, err := core.NewWithContext(internet.ContextWithSocketProtector(context.Background(), allow), c)
+	if err != nil {
+		t.Fatalf("server core: %v", err)
+	}
+	if err := inst.Start(); err != nil {
+		t.Fatalf("server start: %v", err)
+	}
+	t.Cleanup(func() { inst.Close() })
+	return inst
+}
+
+// StartVlessServer starts a VLESS (no TLS) server core on loopback. Its freedom outbound resolves
+// the certificate names (example.com, example.net) to 127.0.0.1 with its own DNS hosts table, so
+// probe streams reach the local probe server and DNS queries the local resolvers. Returns its port.
+func StartVlessServer(t testing.TB, _ int) int {
+	port := FreePort(t)
+	StartServerCore(t, map[string]any{
+		"dns": map[string]any{"hosts": map[string]any{"example.com": "127.0.0.1", "example.net": "127.0.0.1"}},
+		"inbounds": []any{map[string]any{"listen": "127.0.0.1", "port": port, "protocol": "vless",
+			"settings": map[string]any{"clients": []any{map[string]any{"id": KitUUID}}, "decryption": "none"}}},
+		"outbounds": []any{map[string]any{"protocol": "freedom", "settings": map[string]any{
+			"domainStrategy": "UseIPv4",
+			"finalRules":     []any{map[string]any{"action": "allow"}}}}},
+	})
+	return port
+}
+
+// kitDNSAnswer answers any query with one A record 127.0.0.1 (or garbage when bad is set).
+func kitDNSAnswer(q []byte, bad bool) []byte {
+	if len(q) < 12 {
+		return nil
+	}
+	if bad {
+		return []byte{q[0] ^ 0xff, q[1], 0x81, 0x80}
+	}
+	end := 12
+	for end < len(q) && q[end] != 0 {
+		end += int(q[end]) + 1
+	}
+	end += 5 // root + QTYPE + QCLASS
+	if end > len(q) {
+		return nil
+	}
+	a := append([]byte{}, q[:end]...)
+	a[2], a[3] = 0x81, 0x80 // QR RD RA, NOERROR
+	a[6], a[7] = 0, 1       // ANCOUNT 1
+	a = append(a, 0xc0, 0x0c, 0, 1, 0, 1, 0, 0, 0, 60, 0, 4, 127, 0, 0, 1)
+	return a
+}
+
+// KitDNS is a local resolver on UDP and TCP (same port number not guaranteed).
+type KitDNS struct {
+	UDPPort, TCPPort int
+	UDPQueries       atomic.Int32
+	TCPQueries       atomic.Int32
+	Bad              atomic.Bool // answer with a wrong id
+	Silent           atomic.Bool // never answer
+}
+
+// NewKitDNS starts the resolvers (closed by t.Cleanup).
+func NewKitDNS(t testing.TB) *KitDNS {
+	d := &KitDNS{}
+	pc, err := net.ListenPacket("udp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	ln, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { pc.Close(); ln.Close() })
+	d.UDPPort = pc.LocalAddr().(*net.UDPAddr).Port
+	d.TCPPort = ln.Addr().(*net.TCPAddr).Port
+	go func() {
+		buf := make([]byte, 2048)
+		for {
+			n, from, err := pc.ReadFrom(buf)
+			if err != nil {
+				return
+			}
+			d.UDPQueries.Add(1)
+			if !d.Silent.Load() {
+				pc.WriteTo(kitDNSAnswer(buf[:n], d.Bad.Load()), from)
+			}
+		}
+	}()
+	go func() {
+		for {
+			c, err := ln.Accept()
+			if err != nil {
+				return
+			}
+			go func() {
+				defer c.Close()
+				var hdr [2]byte
+				if _, err := io.ReadFull(c, hdr[:]); err != nil {
+					return
+				}
+				q := make([]byte, binary.BigEndian.Uint16(hdr[:]))
+				if _, err := io.ReadFull(c, q); err != nil {
+					return
+				}
+				d.TCPQueries.Add(1)
+				if d.Silent.Load() {
+					io.Copy(io.Discard, c)
+					return
+				}
+				a := kitDNSAnswer(q, d.Bad.Load())
+				c.Write(append(binary.BigEndian.AppendUint16(nil, uint16(len(a))), a...))
+			}()
+		}
+	}()
+	return d
+}
+
+// Gate is a TCP proxy that, while closed, accepts and at once closes every connection (the
+// first second of a guarded provider profile); open, it relays to the target.
+type Gate struct {
+	ln       net.Listener
+	target   string
+	open     atomic.Bool
+	Refused  atomic.Int32
+	Relayed  atomic.Int32
+	mu       sync.Mutex
+	refusals []time.Time
+}
+
+// NewGate starts a closed gate in front of 127.0.0.1:targetPort.
+func NewGate(t testing.TB, targetPort int) *Gate {
+	ln, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	g := &Gate{ln: ln, target: fmt.Sprintf("127.0.0.1:%d", targetPort)}
+	t.Cleanup(func() { ln.Close() })
+	go g.serve()
+	return g
+}
+
+// Port of the gate.
+func (g *Gate) Port() int { return g.ln.Addr().(*net.TCPAddr).Port }
+
+// Open lets connections through.
+func (g *Gate) Open() { g.open.Store(true) }
+
+// OpenAfter opens the gate after d.
+func (g *Gate) OpenAfter(d time.Duration) { time.AfterFunc(d, g.Open) }
+
+// Refusals returns the times of the refused connections.
+func (g *Gate) Refusals() []time.Time {
+	g.mu.Lock()
+	defer g.mu.Unlock()
+	return append([]time.Time(nil), g.refusals...)
+}
+
+func (g *Gate) serve() {
+	for {
+		c, err := g.ln.Accept()
+		if err != nil {
+			return
+		}
+		if !g.open.Load() {
+			g.Refused.Add(1)
+			g.mu.Lock()
+			g.refusals = append(g.refusals, time.Now())
+			g.mu.Unlock()
+			c.Close()
+			continue
+		}
+		g.Relayed.Add(1)
+		go func() {
+			defer c.Close()
+			up, err := net.Dial("tcp", g.target)
+			if err != nil {
+				return
+			}
+			defer up.Close()
+			go func() { io.Copy(up, c); up.(*net.TCPConn).CloseWrite() }()
+			io.Copy(c, up)
+		}()
+	}
+}
+
+// VlessOutbound is a VLESS outbound to 127.0.0.1:port.
+func VlessOutbound(tag string, port int) map[string]any {
+	return map[string]any{"tag": tag, "protocol": "vless", "settings": map[string]any{
+		"vnext": []any{map[string]any{"address": "127.0.0.1", "port": port,
+			"users": []any{map[string]any{"id": KitUUID, "encryption": "none"}}}}}}
+}
+
+// TunnelConfig is shaped like the client's tunnel config: a password SOCKS inbound tagged socks-in
+// (on socksPort; the probe must never listen there), "block" FIRST (the default outbound when no
+// rule matches), "proxy" (VLESS to vlessPort), "direct", and a routing rule that sends socks-in
+// to proxy. A probe that loses the inbound tag lands in "block" and fails.
+func TunnelConfig(vlessPort, socksPort int) map[string]any {
+	return map[string]any{
+		"log": map[string]any{"loglevel": "warning"},
+		"inbounds": []any{map[string]any{"tag": "socks-in", "listen": "127.0.0.1", "port": socksPort,
+			"protocol": "socks", "settings": map[string]any{"auth": "password", "udp": true,
+				"accounts": []any{map[string]any{"user": "u", "pass": "p"}}}}},
+		"outbounds": []any{
+			map[string]any{"tag": "block", "protocol": "blackhole"},
+			VlessOutbound("proxy", vlessPort),
+			map[string]any{"tag": "direct", "protocol": "freedom"},
+		},
+		"routing": map[string]any{"rules": []any{
+			map[string]any{"type": "field", "inboundTag": []any{"socks-in"}, "outboundTag": "proxy"},
+		}},
+		"stats":  map[string]any{},
+		"policy": map[string]any{"system": map[string]any{"statsOutboundUplink": true, "statsOutboundDownlink": true}},
+	}
+}
+
+// KitFullCandidate is an xray_full candidate whose tunnel-shaped profile reaches vlessPort.
+func KitFullCandidate(id string, vlessPort int) map[string]any {
+	raw, _ := json.Marshal(TunnelConfig(vlessPort, 10808))
+	return map[string]any{"id": id, "kind": KindXrayFull, "config": string(raw), "entry": nil, "reach_at_ms": -1,
+		"profile_id": nil, "early_retry": true, "dns_plan": false, "cost_bytes": 83456}
+}
+
+// KitLegCandidate is an xray_leg candidate: config {"outbound": ob, "dns": dns} (+ extra keys).
+func KitLegCandidate(id string, ob map[string]any, dns []any, extra map[string]any) map[string]any {
+	cfg := map[string]any{"outbound": ob}
+	if dns != nil {
+		cfg["dns"] = dns
+	}
+	for k, v := range extra {
+		cfg[k] = v
+	}
+	raw, _ := json.Marshal(cfg)
+	return map[string]any{"id": id, "kind": KindXrayLeg, "config": string(raw), "entry": nil, "reach_at_ms": -1,
+		"profile_id": nil, "early_retry": true, "dns_plan": dns != nil, "cost_bytes": 83456}
+}
+
+// KitRequest is a scan_start message. limits overrides the kit defaults; the keys "max_bytes",
+// "bytes" and "warm_bytes" go to their places.
+func KitRequest(scanID, base string, limits map[string]any, deadlineMs int64, candidates ...map[string]any) string {
+	l := map[string]any{"stage1_sockets": 16, "stage1_stagger_ms": 0, "per_entry_ip": 2, "entry_ip_spacing_ms": 0,
+		"stage1_timeout_ms": 1500, "concurrency": 4, "leg_concurrency": 6, "awg_concurrency": 0, "ttfb_ms": 3000,
+		"stall_ms": 1500, "stall_after_bytes": 16384, "total_ms": 5000}
+	probe := map[string]any{"base": base, "path": "/v1/probe", "token": KitToken, "warm_bytes": 1024, "bytes": 65536,
+		"access_asn": 12389, "access_net_token": "accessTok1"}
+	var maxBytes any
+	for k, v := range limits {
+		switch k {
+		case "max_bytes":
+			maxBytes = v
+		case "bytes", "warm_bytes":
+			probe[k] = v
+		default:
+			l[k] = v
+		}
+	}
+	list := make([]any, 0, len(candidates))
+	for _, c := range candidates {
+		list = append(list, c)
+	}
+	raw, _ := json.Marshal(map[string]any{"action": "scan_start", "version": Version, "scan_id": scanID,
+		"deadline_ms": deadlineMs, "max_bytes": maxBytes, "limits": l, "probe": probe, "candidates": list})
+	return string(raw)
+}
+
+// KitResult is a whole scan read through scan_poll.
+type KitResult struct {
+	ScanID  string
+	Ack     Ack
+	Err     ErrorReply
+	Items   []Item
+	Final   Progress
+	Phases  []string
+	Polls   int
+	Elapsed time.Duration
+}
+
+// Data returns the data items.
+func (r *KitResult) Data() []Item {
+	var out []Item
+	for _, it := range r.Items {
+		if it.Stage == "data" {
+			out = append(out, it)
+		}
+	}
+	return out
+}
+
+// Reach returns the reach items.
+func (r *KitResult) Reach() []Item {
+	var out []Item
+	for _, it := range r.Items {
+		if it.Stage == "reach" {
+			out = append(out, it)
+		}
+	}
+	return out
+}
+
+// DataByID returns a candidate's data item.
+func (r *KitResult) DataByID(id string) (Item, bool) {
+	for _, it := range r.Items {
+		if it.Stage == "data" && it.ID == id {
+			return it, true
+		}
+	}
+	return Item{}, false
+}
+
+// KitMessage sends one request through Message and decodes the reply into out.
+func KitMessage(t testing.TB, req, opts string, plat Platform, out any) string {
+	t.Helper()
+	raw := Message(req, opts, plat)
+	if out != nil {
+		if err := json.Unmarshal([]byte(raw), out); err != nil {
+			t.Fatalf("reply %s: %v", raw, err)
+		}
+	}
+	return raw
+}
+
+// KitRun starts a scan and polls it to the end.
+func KitRun(t testing.TB, request, options string, plat Platform, timeout time.Duration) *KitResult {
+	t.Helper()
+	start := time.Now()
+	r := &KitResult{}
+	raw := KitMessage(t, request, options, plat, &r.Ack)
+	if r.Ack.Type != "scan_ack" {
+		json.Unmarshal([]byte(raw), &r.Err)
+		r.Final = Progress{Done: true, Reason: r.Err.Error}
+		return r
+	}
+	r.ScanID = r.Ack.ScanID
+	return KitPoll(t, r, timeout, start)
+}
+
+// KitPoll polls a started scan to the end (since = the last seen seq).
+func KitPoll(t testing.TB, r *KitResult, timeout time.Duration, start time.Time) *KitResult {
+	t.Helper()
+	var since int64
+	for deadline := time.Now().Add(timeout); ; {
+		if time.Now().After(deadline) {
+			StopAll(5 * time.Second)
+			t.Fatalf("scan %s did not finish in %v", r.ScanID, timeout)
+		}
+		var p Progress
+		raw := KitMessage(t, fmt.Sprintf(`{"action":"scan_poll","scan_id":%q,"since":%d}`, r.ScanID, since), "", Platform{}, &p)
+		r.Polls++
+		if p.Type != "scan_progress" {
+			t.Fatalf("poll: %s", raw)
+		}
+		for _, it := range p.Items {
+			if it.Seq != since+1 {
+				t.Fatalf("seq %d after %d", it.Seq, since)
+			}
+			since = it.Seq
+			r.Items = append(r.Items, it)
+		}
+		if p.Seq != since {
+			t.Fatalf("progress seq %d, items up to %d", p.Seq, since)
+		}
+		if n := len(r.Phases); n == 0 || r.Phases[n-1] != p.Phase {
+			r.Phases = append(r.Phases, p.Phase)
+		}
+		if p.Done {
+			r.Final = p
+			r.Elapsed = time.Since(start)
+			return r
+		}
+		time.Sleep(10 * time.Millisecond)
+	}
+}
+
+// OpenFDs counts this process's open file descriptors (-1 where /dev/fd is absent).
+func OpenFDs() int {
+	entries, err := os.ReadDir("/dev/fd")
+	if err != nil {
+		return -1
+	}
+	return len(entries)
+}
+
+// Settle waits until the goroutine count is at most limit (or timeout) and returns it.
+func Settle(limit int, timeout time.Duration) int {
+	deadline := time.Now().Add(timeout)
+	for {
+		n := runtime.NumGoroutine()
+		if n <= limit || time.Now().After(deadline) {
+			return n
+		}
+		time.Sleep(50 * time.Millisecond)
+	}
+}
+
+// WaitNoInstances waits until no probe instance is alive (cancel does not wait).
+func WaitNoInstances(timeout time.Duration) bool {
+	for deadline := time.Now().Add(timeout); LiveInstances() != 0; time.Sleep(10 * time.Millisecond) {
+		if time.Now().After(deadline) {
+			return false
+		}
+	}
+	return true
+}
+
+// StopAllWait is StopAll that also waits for the stop's closing access attempt and final totals,
+// so a test's last scan never reaches the next test's server.
+func StopAllWait(wait time.Duration) bool {
+	current.Lock()
+	s := current.scan
+	current.Unlock()
+	if s == nil {
+		return true
+	}
+	StopAll(wait)
+	select {
+	case <-s.stopped:
+		return true
+	case <-time.After(wait):
+		return false
+	}
+}
+
+// KitPollFinal polls a scan until its final progress (final: true) and returns it.
+func KitPollFinal(t testing.TB, scanID string, timeout time.Duration) Progress {
+	t.Helper()
+	for deadline := time.Now().Add(timeout); ; {
+		var p Progress
+		raw := KitMessage(t, fmt.Sprintf(`{"action":"scan_poll","scan_id":%q,"since":0}`, scanID), "", Platform{}, &p)
+		if p.Type != "scan_progress" {
+			t.Fatalf("poll: %s", raw)
+		}
+		if p.Final {
+			if !p.Done || p.BytesReserved != 0 {
+				t.Fatalf("final progress not done or still reserved: %s", raw)
+			}
+			return p
+		}
+		if time.Now().After(deadline) {
+			t.Fatalf("scan %s gave no final progress in %v: %s", scanID, timeout, raw)
+		}
+		time.Sleep(10 * time.Millisecond)
+	}
+}
+
+// KitStop ends a scan the way the app does - scan_freeze, then scan_cancel - and polls its final
+// progress.
+func KitStop(t testing.TB, scanID string, timeout time.Duration) (FreezeAck, Ack, Progress) {
+	t.Helper()
+	var fa FreezeAck
+	var ack Ack
+	KitMessage(t, fmt.Sprintf(`{"action":"scan_freeze","scan_id":%q}`, scanID), "", Platform{}, &fa)
+	KitMessage(t, fmt.Sprintf(`{"action":"scan_cancel","scan_id":%q}`, scanID), "", Platform{}, &ack)
+	return fa, ack, KitPollFinal(t, scanID, timeout)
+}
diff --git a/tribescan/vectors_test.go b/tribescan/vectors_test.go
new file mode 100644
index 0000000..9e20492
--- /dev/null
+++ b/tribescan/vectors_test.go
@@ -0,0 +1,282 @@
+package tribescan
+
+// Replays the app's shared vectors (client/core/serviceEngine/tests/vectors/scan_host_vectors.json,
+// kept equal to ScanHostContract.h by tests/scan_vectors_check.cpp): every request vector must
+// decode here exactly as scanDecodeRequest decodes it (the same fields, the same refusal and
+// detail), and every valid reply vector must pass through this host's reply types unchanged.
+// File: $TRIBE_SCAN_VECTORS, else testdata/scan_host_vectors.json (the recipes copy it there).
+
+import (
+	"encoding/json"
+	"fmt"
+	"os"
+	"path/filepath"
+	"reflect"
+	"sort"
+	"strings"
+	"testing"
+	"unicode/utf16"
+)
+
+type vectorFile struct {
+	Schema   int             `json:"schema"`
+	Version  string          `json:"version"`
+	Requests []vectorRequest `json:"requests"`
+	Replies  []vectorReply   `json:"replies"`
+	ByteGate []struct {
+		Name     string `json:"name"`
+		MaxBytes int64  `json:"max_bytes"`
+		Ops      []struct {
+			Op     string `json:"op"`
+			ID     string `json:"id"`
+			Bytes  int64  `json:"bytes"`
+			Expect struct {
+				OK       bool  `json:"ok"`
+				Reserved int64 `json:"reserved"`
+				Spent    int64 `json:"spent"`
+			} `json:"expect"`
+		} `json:"ops"`
+	} `json:"byte_gate"`
+}
+
+type vectorRequest struct {
+	Name   string          `json:"name"`
+	JSON   json.RawMessage `json:"json"`
+	Expect struct {
+		Decoded json.RawMessage `json:"decoded"`
+		Error   string          `json:"error"`
+		Detail  string          `json:"detail"`
+	} `json:"expect"`
+}
+
+type vectorReply struct {
+	Name   string          `json:"name"`
+	JSON   json.RawMessage `json:"json"`
+	Expect struct {
+		Error string `json:"error"`
+		Kind  string `json:"kind"`
+	} `json:"expect"`
+}
+
+func vectorsPath() string {
+	if p := os.Getenv("TRIBE_SCAN_VECTORS"); p != "" {
+		return p
+	}
+	return filepath.Join("testdata", "scan_host_vectors.json")
+}
+
+// rawBytes: a vector's "json" is the message object itself, or a string holding raw bytes.
+func rawBytes(v json.RawMessage) []byte {
+	var s string
+	if json.Unmarshal(v, &s) == nil {
+		return []byte(s)
+	}
+	return v
+}
+
+func utf16Len(s string) int { return len(utf16.Encode([]rune(s))) }
+
+func candidateSummary(c *Candidate) map[string]any {
+	entry := ""
+	if c.EntryIP != "" {
+		entry = fmt.Sprintf("%s:%d", c.EntryIP, c.EntryPort)
+	}
+	out := map[string]any{"config_len": utf16Len(c.Config), "cost_bytes": c.CostBytes, "dns_plan": c.DNSPlan,
+		"early_retry": c.EarlyRetry, "entry": entry, "id": c.ID, "kind": c.Kind, "profile_id": c.ProfileID,
+		"reach_at_ms": c.ReachAtMs}
+	// The later optional fields join the summary only when set (as the app's vectors record them).
+	if c.Bytes > 0 {
+		out["bytes"] = c.Bytes
+	}
+	if c.TotalMs > 0 {
+		out["total_ms"] = c.TotalMs
+	}
+	return out
+}
+
+func requestSummary(r *Request) map[string]any {
+	out := map[string]any{"action": r.Action}
+	cands := func(list []*Candidate) []any {
+		res := []any{}
+		for _, c := range list {
+			res = append(res, candidateSummary(c))
+		}
+		return res
+	}
+	switch r.Action {
+	case "scan_poll":
+		out["scan_id"], out["since"] = r.ScanID, r.Since
+	case "scan_cancel", "scan_freeze":
+		out["scan_id"] = r.ScanID
+	case "scan_add":
+		out["scan_id"], out["candidates"] = r.ScanID, cands(r.Candidates)
+	case "scan_start":
+		s := r.Start
+		l := s.Limits
+		out["scan_id"], out["candidates"], out["deadline_ms"], out["max_bytes"] = r.ScanID, cands(s.Candidates), s.DeadlineMs, s.MaxBytes
+		out["limits"] = map[string]any{"stage1_sockets": l.Stage1Sockets, "stage1_stagger_ms": l.Stage1StaggerMs,
+			"per_entry_ip": l.PerEntryIP, "entry_ip_spacing_ms": l.EntryIPSpacingMs, "stage1_timeout_ms": l.Stage1TimeoutMs,
+			"concurrency": l.Concurrency, "leg_concurrency": l.LegConcurrency, "awg_concurrency": l.AwgConcurrency,
+			"ttfb_ms": l.TTFBMs, "stall_ms": l.StallMs, "stall_after_bytes": l.StallAfterBytes, "total_ms": l.TotalMs,
+			"awg_handshake_ms": l.AwgHandshakeMs, "awg_prime_echoes": l.AwgPrimeEchoes, "awg_spacing_ms": l.AwgSpacingMs,
+			"netinfo_cost_bytes": l.NetinfoCostBytes}
+		out["probe"] = map[string]any{"access_asn": s.AccessAsn, "access_net_token_len": utf16Len(s.AccessNetToken),
+			"base": s.ProbeBase, "bytes": s.Bytes, "path": s.ProbePath, "netinfo_path": s.NetinfoPath,
+			"token_len": utf16Len(s.Token), "warm_bytes": s.WarmBytes}
+		if len(s.BaseIPs) > 0 {
+			out["probe_base_ips"] = s.BaseIPs
+		}
+	}
+	return out
+}
+
+// normalize turns a value into its JSON-decoded form (numbers as float64).
+func normalize(v any) any {
+	raw, _ := json.Marshal(v)
+	var out any
+	_ = json.Unmarshal(raw, &out)
+	return out
+}
+
+// subset reports the first path where want's content is missing from or different in got.
+func subset(want, got any, path string) string { return subsetOpt(want, got, path, false) }
+
+// subsetOpt with unknownOK: a key this host's types do not have is fine (the vector says unknown
+// fields are ignored).
+func subsetOpt(want, got any, path string, unknownOK bool) string {
+	switch w := want.(type) {
+	case map[string]any:
+		g, ok := got.(map[string]any)
+		if !ok {
+			return path + ": not an object"
+		}
+		keys := make([]string, 0, len(w))
+		for k := range w {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		for _, k := range keys {
+			gv, present := g[k]
+			if !present {
+				if w[k] == nil || unknownOK {
+					continue // null and absent decode alike; unknown keys are ignored
+				}
+				return path + "." + k + ": missing"
+			}
+			if d := subsetOpt(w[k], gv, path+"."+k, unknownOK); d != "" {
+				return d
+			}
+		}
+		return ""
+	case []any:
+		g, ok := got.([]any)
+		if !ok || len(g) != len(w) {
+			return path + ": array differs"
+		}
+		for i := range w {
+			if d := subsetOpt(w[i], g[i], fmt.Sprintf("%s[%d]", path, i), unknownOK); d != "" {
+				return d
+			}
+		}
+		return ""
+	default:
+		if !reflect.DeepEqual(want, got) {
+			return fmt.Sprintf("%s: %v != %v", path, want, got)
+		}
+		return ""
+	}
+}
+
+func TestTribeScanSharedVectors(t *testing.T) {
+	raw, err := os.ReadFile(vectorsPath())
+	if err != nil {
+		t.Skipf("shared vectors not present (%v); set TRIBE_SCAN_VECTORS", err)
+	}
+	var vf vectorFile
+	if err := json.Unmarshal(raw, &vf); err != nil {
+		t.Fatalf("vectors: %v", err)
+	}
+	if vf.Version != Version {
+		t.Fatalf("vectors are for %q, this host speaks %q", vf.Version, Version)
+	}
+	for _, v := range vf.Requests {
+		req, werr := DecodeRequest(rawBytes(v.JSON))
+		if v.Expect.Error != "" {
+			if werr == nil || werr.Code != v.Expect.Error || (v.Expect.Detail != "" && werr.Detail != v.Expect.Detail) {
+				t.Errorf("request %s: want %s/%s, got %v", v.Name, v.Expect.Error, v.Expect.Detail, werr)
+			}
+			continue
+		}
+		if werr != nil {
+			t.Errorf("request %s: refused %v", v.Name, werr)
+			continue
+		}
+		var want any
+		_ = json.Unmarshal(v.Expect.Decoded, &want)
+		got := normalize(requestSummary(req))
+		if !reflect.DeepEqual(want, got) {
+			wantRaw, _ := json.Marshal(want)
+			gotRaw, _ := json.Marshal(got)
+			t.Errorf("request %s:\n want %s\n  got %s", v.Name, wantRaw, gotRaw)
+		}
+	}
+	replies := 0
+	for _, v := range vf.Replies {
+		if v.Expect.Error == "malformed" || (v.Expect.Error != "" && v.Expect.Kind != "error") {
+			continue // malformed replies test the app's decoder, not this encoder
+		}
+		var vec any
+		if json.Unmarshal(v.JSON, &vec) != nil {
+			continue
+		}
+		var typed any
+		switch m, _ := vec.(map[string]any); {
+		case m == nil:
+			continue
+		case m["error"] != nil:
+			typed = &ErrorReply{}
+		case m["type"] == "scan_caps":
+			typed = &Caps{}
+		case m["type"] == "scan_ack":
+			typed = &Ack{}
+		case m["type"] == "scan_freeze_ack":
+			typed = &FreezeAck{}
+		case m["type"] == "scan_progress":
+			typed = &Progress{}
+		default:
+			continue
+		}
+		if err := json.Unmarshal(v.JSON, typed); err != nil {
+			t.Errorf("reply %s does not fit this host's types: %v", v.Name, err)
+			continue
+		}
+		if d := subsetOpt(vec, normalize(typed), v.Name, strings.Contains(v.Name, "unknown_field")); d != "" {
+			t.Errorf("reply %s changes through this host's types: %s", v.Name, d)
+		}
+		replies++
+	}
+	for _, g := range vf.ByteGate {
+		gate := NewByteGate(g.MaxBytes)
+		for i, op := range g.Ops {
+			ok := true
+			switch op.Op {
+			case "admit":
+				ok = gate.Admit(op.ID, op.Bytes)
+			case "finish":
+				gate.Finish(op.ID, op.Bytes)
+			case "charge":
+				ok = gate.Charge(op.Bytes)
+			case "freeze":
+				gate.Freeze()
+			default:
+				t.Fatalf("byte_gate %s: op %q", g.Name, op.Op)
+			}
+			if ok != op.Expect.OK || gate.Reserved() != op.Expect.Reserved || gate.Spent() != op.Expect.Spent {
+				t.Errorf("byte_gate %s op %d (%s %s %d): ok=%v reserved=%d spent=%d, want %+v",
+					g.Name, i, op.Op, op.ID, op.Bytes, ok, gate.Reserved(), gate.Spent(), op.Expect)
+			}
+		}
+	}
+	t.Logf("replayed %d request vectors, %d reply vectors and %d byte_gate cases (schema %d)",
+		len(vf.Requests), replies, len(vf.ByteGate), vf.Schema)
+}
