+
+// An Xray stream ends with the dial's context, which carries the job deadline and the scan's stop:
+// it can close the stream before the watchdog's next tick. The verdict must be the watchdog's all
+// the same: total_timeout (stalled mid-body), ttfb_timeout (nothing came back), the stop code - never
+// short / http / dial from the truncated read. The stand-in stream closes exactly when the dial's
+// context ends, i.e. (almost) always before the 20 ms watchdog tick.
+func TestTribeScanDeadlineVerdict(t *testing.T) {
+	e := newKitEnv(t)
+	defer e.srv.SetMode("ok", false)
+	defer e.srv.Release() // no handler stays parked for the server's close
+	req, werr := DecodeRequest([]byte(KitRequest("s-verdict", e.srv.Base(),
+		map[string]any{"stall_ms": 10000, "ttfb_ms": 10000, "total_ms": 30000}, 60000, KitFullCandidate("c", e.vless))))
+	if werr != nil {
+		t.Fatal(werr)
+	}
+	dial := func(ctx context.Context) (net.Conn, error) {
+		c, err := net.Dial("tcp", fmt.Sprintf("127.0.0.1:%d", e.srv.Port))
+		if err == nil {
+			context.AfterFunc(ctx, func() { c.Close() }) // like core.Dial's link: ends with the dial's context
+		}
+		return c, err
+	}
+	run := func(s *Scan, budget time.Duration) attemptOut {
+		return s.attempt(dial, ErrDial, "example.com", e.srv.Base(), s.req.Candidates[0], time.Now().Add(budget), -1)
+	}
+	newTestScan := func() *Scan {
+		s := newScan(req.Start, HostOptions{}, e.plat)
+		t.Cleanup(func() { s.teardown(ReasonCancelled); s.releaseTerms() })
+		return s
+	}
+	cases := []struct {
+		name, mode string
+		all        bool
+		stop       bool
+		want       string
+		read       bool // plaintext came back before the end
+	}{
+		{name: "stalled mid-body at the deadline", mode: "stall", want: ErrTotal, read: true},
+		{name: "nothing back at the deadline", mode: "slow_first_byte", all: true, want: ErrTTFB},
+		{name: "scan stopped mid-body", mode: "stall", stop: true, want: ErrCancelled, read: true},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			e.srv.SetMode(c.mode, c.all)
+			e.srv.Delay.Store(20000)
+			for i := 0; i < 10; i++ {
+				s := newTestScan()
+				budget := time.Duration(300+20*i) * time.Millisecond
+				if c.stop {
+					budget = 30 * time.Second
+					time.AfterFunc(time.Duration(300+20*i)*time.Millisecond, func() { s.abort(ReasonCancelled) })
+				}
+				out := run(s, budget)
+				if out.item.Error != c.want || (out.read > 0) != c.read || deref(out.item.ShaOK) {
+					t.Fatalf("run %d: want %s (read %v), got %q read=%d", i, c.want, c.read, out.item.Error, out.read)
+				}
+			}
+		})
+	}
+	assertNoInstances(t)
+}
