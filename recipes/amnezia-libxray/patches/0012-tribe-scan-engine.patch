+// Review F3: probe sockets never reach the process-wide controllers (the tunnel's protect callback,
+// whose failure handler cancels the iOS tunnel). A failing probe protector fails those probes only
+// ("bind_failed") while a live core keeps dialing through the process-wide controller.
+func TestTribeScanProbeProtectionIsItsOwn(t *testing.T) {
+	e := newKitEnv(t)
+	var liveCalls atomic.Int32
+	vlessAddr := fmt.Sprintf("127.0.0.1:%d", e.vless)
+	setProcessController(t, func(address string) {
+		if address == vlessAddr { // a dial towards the VLESS server: the live tunnel's, or a leaked probe's
+			liveCalls.Add(1)
+		}
+	})
+	socksPort := FreePort(t)
+	StartCore(t, TunnelConfig(e.vless, socksPort)) // the live core
+	tunnelFetch(t, socksPort, e.srv)
+	if liveCalls.Load() == 0 {
+		t.Fatal("the live core's dial did not pass the process-wide controller")
+	}
+	var protectCalls atomic.Int32
+	for _, fail := range []bool{true, false} {
+		plat := e.plat
+		plat.RequireProtection = true
+		plat.Protect = func(network, address string, fd uintptr) error {
+			protectCalls.Add(1)
+			if fail {
+				return errors.New("bind failed (test)")
+			}
+			return nil
+		}
+		before, calls := liveCalls.Load(), protectCalls.Load()
+		r := KitRun(t, KitRequest(fmt.Sprintf("s-own-%v", fail), e.srv.Base(), nil, 15000, KitFullCandidate("full", e.vless),
+			KitLegCandidate("leg", VlessOutbound("p", e.vless), nil, nil)), "", plat, 20*time.Second)
+		if liveCalls.Load() != before {
+			t.Fatalf("fail=%v: %d probe sockets reached the process-wide controller", fail, liveCalls.Load()-before)
+		}
+		if protectCalls.Load() == calls {
+			t.Fatalf("fail=%v: the probe protector was never called", fail)
+		}
+		for _, d := range r.Data() {
+			if (fail && d.Error != ErrBindFailed) || (!fail && d.Error != "") {
+				t.Fatalf("fail=%v: %+v", fail, d)
+			}
+		}
+		tunnelFetch(t, socksPort, e.srv) // the live core keeps working
+	}
+	// No protection offered on a host that needs one: no_vpn, nothing dialled.
+	plat := e.plat
+	plat.RequireProtection = true
+	var er ErrorReply
+	KitMessage(t, KitRequest("s-unprotected", e.srv.Base(), nil, 5000, KitFullCandidate("a", e.vless)), "", plat, &er)
+	if er.Error != "no_vpn" {
+		t.Fatalf("%+v", er)
+	}
+}
+
+func TestTribeScanBindInterface(t *testing.T) {
+	lo := map[string]string{"darwin": "lo0", "ios": "lo0", "linux": "lo"}[runtime.GOOS]
+	if lo == "" {
+		t.Skip("no loopback interface name for " + runtime.GOOS)
+	}
+	e := newKitEnv(t)
+	r := KitRun(t, KitRequest("s-bind", e.srv.Base(), nil, 15000, KitFullCandidate("a", e.vless), KitLegCandidate("l", VlessOutbound("p", e.vless), nil, nil)),
+		fmt.Sprintf(`{"bind_interface":%q}`, lo), e.plat, 20*time.Second)
+	for _, d := range r.Data() {
+		if d.Error != "" {
+			t.Fatalf("bound to %s: %+v", lo, d)
+		}
+	}
+	if iface, err := net.InterfaceByName(lo); err == nil {
+		r = KitRun(t, KitRequest("s-bind-index", e.srv.Base(), nil, 15000, KitFullCandidate("a", e.vless)),
+			fmt.Sprintf(`{"bind_interface_index":%d}`, iface.Index), e.plat, 20*time.Second)
+		if d := r.Data(); len(d) != 1 || d[0].Error != "" {
+			t.Fatalf("bound to index %d: %+v", iface.Index, d)
+		}
+	}
+	// An interface that does not exist: every socket of the probe instances fails closed.
+	r = KitRun(t, KitRequest("s-bind-none", e.srv.Base(), map[string]any{"total_ms": 1500}, 15000,
+		KitFullCandidate("a", e.vless), KitLegCandidate("l", VlessOutbound("p", e.vless), nil, nil)), `{"bind_interface":"utun987"}`, e.plat, 20*time.Second)
+	for _, d := range r.Data() {
+		if d.Error != ErrBindFailed || deref(d.ShaOK) {
+			t.Fatalf("an unbindable interface still carried data: %+v", d)
+		}
+	}
+	// The reach dial is bound too.
+	up := KitFullCandidate("a", e.vless)
+	up["entry"] = map[string]any{"ip": "127.0.0.1", "port": e.vless}
+	up["reach_at_ms"] = 0
+	r = KitRun(t, KitRequest("s-bind-reach", e.srv.Base(), nil, 15000, up), `{"bind_interface":"utun987"}`, e.plat, 20*time.Second)
+	if len(r.Reach()) != 1 || deref(r.Reach()[0].OK) || len(r.Data()) != 0 {
+		t.Fatalf("reach through an unbindable interface: %+v", r.Items)
+	}
+}
+
+// The tunnel's process-wide state is untouched: its log handler stays installed and its own
+// outbound counters do not count probe bytes.
+func TestTribeScanLeavesTunnelStateAlone(t *testing.T) {
+	e := newKitEnv(t)
+	h := &kitLogHandler{}
+	clog.RegisterHandler(h)
+	defer clog.RegisterHandler(&kitLogHandler{})
+	socksPort := FreePort(t)
+	tunnel := StartCore(t, TunnelConfig(e.vless, socksPort))
+	manager := tunnel.GetFeature(stats.ManagerType()).(stats.Manager)
+	counter := func() int64 {
+		if c := manager.GetCounter("outbound>>>proxy>>>traffic>>>downlink"); c != nil {
+			return c.Value()
+		}
+		return -1
+	}
+	tunnelFetch(t, socksPort, e.srv)
+	before := counter()
+	for settled := time.Now(); time.Since(settled) < 300*time.Millisecond; time.Sleep(20 * time.Millisecond) {
+		if now := counter(); now != before { // the close alert of that TLS session arrives late
+			before, settled = now, time.Now()
+		}
+	}
+	if before <= 0 {
+		t.Fatalf("tunnel counter %d", before)
+	}
+	r := KitRun(t, KitRequest("s-isolation", e.srv.Base(), nil, 15000, KitFullCandidate("a", e.vless), KitLegCandidate("b", VlessOutbound("p", e.vless), nil, nil)), "", e.plat, 20*time.Second)
+	for _, d := range r.Data() {
+		if d.Error != "" {
+			t.Fatalf("%+v", d)
+		}
+	}
+	if after := counter(); after != before {
+		t.Fatalf("probe bytes reached the tunnel's counters: %d -> %d", before, after)
+	}
+	tunnelFetch(t, socksPort, e.srv) // the tunnel still carries traffic
+	h.n.Store(0)
+	clog.Record(&clog.GeneralMessage{Severity: clog.Severity_Warning, Content: "still ours"})
+	if h.n.Load() != 1 {
+		t.Fatal("a probe instance replaced the process-wide log handler")
+	}
+}
+
+// tunnelFetch downloads one probe body through the tunnel's own SOCKS5 inbound.
+func tunnelFetch(t *testing.T, socksPort int, srv *ProbeServer) {
+	t.Helper()
+	c, err := net.DialTimeout("tcp", fmt.Sprintf("127.0.0.1:%d", socksPort), 3*time.Second)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer c.Close()
+	c.SetDeadline(time.Now().Add(10 * time.Second))
+	c.Write([]byte{5, 1, 2})
+	var greet [2]byte
+	io.ReadFull(c, greet[:])
+	c.Write([]byte{1, 1, 'u', 1, 'p'})
+	var auth [2]byte
+	io.ReadFull(c, auth[:])
+	host := "example.com"
+	req := append([]byte{5, 1, 0, 3, byte(len(host))}, host...)
+	req = append(req, byte(srv.Port>>8), byte(srv.Port))
+	c.Write(req)
+	var rep [10]byte
+	if _, err := io.ReadFull(c, rep[:]); err != nil || rep[1] != 0 {
+		t.Fatalf("socks connect %v %v", rep, err)
+	}
+	tc := tls.Client(c, &tls.Config{ServerName: "example.com", RootCAs: srv.Pool})
+	fmt.Fprintf(tc, "GET /v1/probe?bytes=4096&nonce=tunnel-fetch HTTP/1.1\r\nHost: example.com\r\nAuthorization: Bearer %s\r\nConnection: close\r\n\r\n", KitToken)
+	resp, err := http.ReadResponse(bufio.NewReader(tc), nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	n, _ := io.Copy(io.Discard, resp.Body)
+	resp.Body.Close()
+	if n != 4096 {
+		t.Fatalf("tunnel fetch %d bytes", n)
+	}
+}
+
+// The direct check of an access network that cannot reach the probe host: network_error, both ends.
+func TestTribeScanDirectCheckNetworkError(t *testing.T) {
+	e := newKitEnv(t)
+	SetDirectAddr(fmt.Sprintf("127.0.0.1:%d", FreePort(t))) // nothing listens: no HTTP at all
+	defer SetDirectAddr(fmt.Sprintf("127.0.0.1:%d", e.srv.Port))
+	gen := `{"gen":{"source":"test","epoch":"5eed5eed5eed5eed","counter":3}}`
+	r := KitRun(t, KitRequest("s-direct-down", e.srv.Base(), nil, 10000, KitFullCandidate("a", e.vless)), gen, e.plat, 20*time.Second)
+	_, _, fin := KitStop(t, "s-direct-down", 5*time.Second)
+	a, c := fin.Access, fin.AccessClose
+	if a == nil || c == nil || !a.Attempted || a.HTTPAnswered || c.HTTPAnswered || a.Asn != nil || c.NetToken != nil ||
+		r.Data()[0].Error != "" || a.Gen == nil || a.Gen.Counter != 3 || fin.Gen == nil {
+		t.Fatalf("access %+v close %+v data %+v", a, c, r.Data())
+	}
+	// No HTTP answer: what a socket that got nothing back costs, both attempts.
+	if spent := fin.BytesSpent - deref(r.Data()[0].SpentBytes); spent != 2*512 {
+		t.Fatalf("attempts charged %d", spent)
+	}
+	raw, _ := json.Marshal(fin)
+	if !strings.Contains(string(raw), `"access":{"attempted":true,"http_answered":false,"asn":null,"net_token":null,"at_ms":`) ||
+		!strings.Contains(string(raw), `"gen":{"source":"test","epoch":"5eed5eed5eed5eed","counter":3}}`) {
+		t.Fatalf("wire %s", raw)
+	}
+}
