+func assertNothingAlive(t *testing.T, what string, extra ...func() int64) {
+	t.Helper()
+	if w := LiveWork(); w != (Work{}) {
+		t.Fatalf("%s: StopAll returned true with %+v alive", what, w)
+	}
+	for i, f := range extra {
+		if n := f(); n != 0 {
+			t.Fatalf("%s: %d still open (check %d)", what, n, i)
+		}
+	}
+}
+
+// After StopAll returns true nothing of the scan is alive: no instance, job, session, closing
+// leg instance or access attempt (counted, not slept for). On a timeout it returns false, the
+// teardown goes on, and scan_start is refused until it has finished.
+func TestTribeScanStopAllNothingAlive(t *testing.T) {
+	e := newKitEnv(t)
+	goBefore := runtime.NumGoroutine() // the kit servers are up already
+	stalled := func() { e.srv.SetMode("stall", false) }
+	defer e.srv.SetMode("ok", false)
+	limits := map[string]any{"stall_ms": 10000, "total_ms": 30000, "ttfb_ms": 15000, "concurrency": 1, "leg_concurrency": 3,
+		"awg_concurrency": 2}
+	waitFor := func(what string, cond func() bool) {
+		t.Helper()
+		for end := time.Now().Add(5 * time.Second); !cond(); time.Sleep(5 * time.Millisecond) {
+			if time.Now().After(end) {
+				t.Fatalf("waiting for %s", what)
+			}
+		}
+	}
+
+	t.Run("during an AmneziaWG session", func(t *testing.T) {
+		stalled()
+		f := &fakeAwg{}
+		plat := e.plat
+		plat.Awg, plat.MaxAwg = f.Open, 2
+		var ack Ack
+		KitMessage(t, KitRequest("stop-awg", e.srv.Base(), limits, 60000, kitAwgCandidate("w1", 1, e.srv.Port),
+			kitAwgCandidate("w2", 2, e.srv.Port)), "", plat, &ack)
+		waitFor("two sessions mid-transfer", func() bool { f.mu.Lock(); defer f.mu.Unlock(); return len(f.opens) == 2 && len(e.srv.Seen()) >= 2 })
+		if !StopAll(5 * time.Second) {
+			t.Fatal("StopAll timed out")
+		}
+		f.mu.Lock()
+		open := len(f.opens) - int(f.closed.Load())
+		f.mu.Unlock()
+		assertNothingAlive(t, "awg", func() int64 { return int64(open) })
+	})
+	t.Run("during leg cleanup", func(t *testing.T) {
+		stalled()
+		SetCloseInstanceHook(func() { time.Sleep(300 * time.Millisecond) }) // a slow instance close
+		defer SetCloseInstanceHook(nil)
+		var ack Ack
+		KitMessage(t, KitRequest("stop-legs", e.srv.Base(), limits, 60000, KitLegCandidate("l1", VlessOutbound("p", e.vless), nil, nil),
+			KitLegCandidate("l2", VlessOutbound("p", e.vless), nil, nil)), "", e.plat, &ack)
+		waitFor("the leg instance up", func() bool { return LiveInstances() == 1 && len(e.srv.Seen()) >= 2 })
+		if !StopAll(5 * time.Second) {
+			t.Fatal("StopAll timed out")
+		}
+		assertNothingAlive(t, "legs")
+	})
+	t.Run("during the closing access attempt (black hole)", func(t *testing.T) {
+		e.srv.SetMode("ok", false)
+		r := KitRun(t, KitRequest("stop-close", e.srv.Base(), map[string]any{"stage1_timeout_ms": 10000}, 60000, KitFullCandidate("a", e.vless)),
+			"", e.plat, 20*time.Second)
+		if r.Final.Access == nil || !r.Final.Access.HTTPAnswered {
+			t.Fatalf("opening: %+v", r.Final.Access)
+		}
+		hole, err := net.Listen("tcp4", "127.0.0.1:0") // accepts, never answers TLS
+		if err != nil {
+			t.Fatal(err)
+		}
+		defer hole.Close()
+		go func() {
+			for {
+				c, err := hole.Accept()
+				if err != nil {
+					return
+				}
+				defer c.Close()
+			}
+		}()
+		SetDirectAddr(hole.Addr().String())
+		defer SetDirectAddr(fmt.Sprintf("127.0.0.1:%d", e.srv.Port))
+		var ack Ack
+		KitMessage(t, `{"action":"scan_cancel","scan_id":"stop-close"}`, "", e.plat, &ack)
+		waitFor("the closing attempt in flight", func() bool { return LiveWork().Access == 1 })
+		t0 := time.Now()
+		if !StopAll(3 * time.Second) {
+			t.Fatal("StopAll timed out")
+		}
+		assertNothingAlive(t, "closing attempt")
+		if time.Since(t0) > time.Second {
+			t.Fatalf("the stop waited %v for the black hole", time.Since(t0))
+		}
+		fin := KitPollFinal(t, "stop-close", time.Second)
+		if fin.AccessClose != nil || fin.Access == nil {
+			t.Fatalf("a cancelled closing attempt is not an attempt: %+v", fin.AccessClose)
+		}
+	})
+	t.Run("timeout: false, teardown goes on, starts refused until it is done", func(t *testing.T) {
+		stalled()
+		// Longer than a scan_start waits for a teardown (3 s): that start is refused.
+		SetCloseInstanceHook(func() { time.Sleep(3500 * time.Millisecond) })
+		defer SetCloseInstanceHook(nil)
+		var ack Ack
+		KitMessage(t, KitRequest("stop-slow", e.srv.Base(), limits, 60000, KitLegCandidate("l", VlessOutbound("p", e.vless), nil, nil)), "", e.plat, &ack)
+		waitFor("the leg instance up", func() bool { return LiveInstances() == 1 && len(e.srv.Seen()) >= 1 })
+		// The reply names what is still alive: the leg instance, closing in the background.
+		stop := StopAllJSON(200)
+		var got map[string]any
+		if json.Unmarshal([]byte(stop), &got) != nil || got["stopped"] != false || got["instances"] != float64(1) ||
+			len(got) != 7 || !strings.HasPrefix(stop, `{"stopped":false,"instances":1,"jobs":`) {
+			t.Fatalf("StopAll during a slow close: %s", stop)
+		}
+		for _, k := range []string{"jobs", "closers", "attempts", "awg", "children"} {
+			if _, ok := got[k].(float64); !ok {
+				t.Fatalf("stop reply without %s: %s", k, stop)
+			}
+		}
+		if got["awg"] != float64(0) || got["children"] != float64(0) || got["attempts"] != float64(0) {
+			t.Fatalf("stop reply counts what is not there: %s", stop)
+		}
+		raw := KitMessage(t, KitRequest("stop-next", e.srv.Base(), nil, 10000, KitFullCandidate("n", e.vless)), "", e.plat, nil)
+		if raw != `{"error":"internal","detail":"stopping"}` {
+			t.Fatalf("a start during the teardown: %s", raw)
+		}
+		if LiveWork() == (Work{}) {
+			t.Fatal("the teardown was not going on")
+		}
+		if !StopAll(5 * time.Second) {
+			t.Fatal("the second StopAll timed out")
+		}
+		assertNothingAlive(t, "after the slow teardown")
+		e.srv.SetMode("ok", false)
+		SetCloseInstanceHook(nil)
+		r := KitRun(t, KitRequest("stop-after", e.srv.Base(), nil, 10000, KitFullCandidate("n", e.vless)), "", e.plat, 20*time.Second)
+		if d, _ := r.DataByID("n"); d.Error != "" {
+			t.Fatalf("a start after the teardown: %+v %+v", d, r.Err)
+		}
+	})
+	t.Run("host_epoch: starts and adds of an older epoch are refused", func(t *testing.T) {
+		e.srv.SetMode("ok", false)
+		current.Lock()
+		base := current.epoch // process-wide: another test (or -count) may have raised it
+		current.Unlock()
+		ep := func(n int64) string { return fmt.Sprintf(`{"host_epoch":%d}`, base+n) }
+		if raw := Message(`{"action":"scan_stop_all","wait_ms":3000}`, ep(5), e.plat); raw != `{"stopped":true}` {
+			t.Fatalf("stop_all: %s", raw)
+		}
+		live := LiveWork()
+		raw := KitMessage(t, KitRequest("ep-old", e.srv.Base(), nil, 10000, KitFullCandidate("a", e.vless)), ep(4), e.plat, nil)
+		if raw != `{"error":"stale_epoch","detail":"host_epoch"}` || LiveWork() != live {
+			t.Fatalf("an older epoch: %s", raw)
+		}
+		var ack Ack
+		KitMessage(t, KitRequest("ep-now", e.srv.Base(), nil, 10000), ep(5), e.plat, &ack)
+		if ack.Type != "scan_ack" {
+			t.Fatalf("the current epoch: %+v", ack)
+		}
+		raw = KitMessage(t, fmt.Sprintf(`{"action":"scan_add","scan_id":"ep-now","candidates":[%s]}`, mustJSON(KitFullCandidate("b", e.vless))),
+			ep(3), e.plat, nil)
+		if !strings.Contains(raw, `"stale_epoch"`) {
+			t.Fatalf("an add of an older epoch: %s", raw)
+		}
+		KitMessage(t, KitRequest("ep-none", e.srv.Base(), nil, 10000), "", e.plat, &ack) // no epoch: no check
+		if ack.Type != "scan_ack" {
+			t.Fatalf("without an epoch: %+v", ack)
+		}
+		StopAll(5 * time.Second)
+	})
+	if !StopAll(5 * time.Second) {
+		t.Fatal("final StopAll")
+	}
+	e.srv.Srv.CloseClientConnections()
+	if n := Settle(goBefore+8, 5*time.Second); n > goBefore+8 {
+		buf := make([]byte, 1<<20)
+		t.Fatalf("goroutines %d after, %d before:\n%s", n, goBefore, buf[:runtime.Stack(buf, true)])
+	}
+}
+
+// Review F2 (followup 2): a host stop with a newer host_epoch (the iOS adapter's backend-restart hook,
+// which does not take the host's lifecycle gate) while a replacing scan_start waits for the old
+// scan's teardown. Before the fix the stop returned true, the waiting start then found the old scan
+// still current and installed its own - a scan right after the stop meant to forbid it. The start
+// must install nothing: stale_epoch for an older epoch, internal/stopping for a stop without one.
+// Ordered by hooks (the old scan's instance close held, the start's wait signalled), not sleeps.
+func TestTribeScanStopRacesStart(t *testing.T) {
+	e := newKitEnv(t)
+	e.srv.SetMode("stall", false)
+	defer e.srv.SetMode("ok", false)
+	limits := map[string]any{"stall_ms": 10000, "total_ms": 30000, "ttfb_ms": 15000, "concurrency": 1}
+	current.Lock()
+	base := current.epoch // process-wide: earlier tests may have raised it
+	current.Unlock()
+	opts := func(ep int64) string { return fmt.Sprintf(`{"host_epoch":%d}`, ep) }
+	epochNow := func() int64 { current.Lock(); defer current.Unlock(); return current.epoch }
+	unknown := func(id string) bool {
+		return strings.Contains(Message(fmt.Sprintf(`{"action":"scan_poll","scan_id":%q,"since":0}`, id), "", e.plat), `"unknown_scan"`)
+	}
+	// race runs: scan A (epoch ep) with a live instance and a stalled probe; its instance close held;
+	// start B (epoch epB, opts) replaces it and waits; then stop() runs; A's close is let go.
+	race := func(t *testing.T, aID, bID string, ep int64, bOpts string, stop func() string, stopRecorded func() bool) (b, st string) {
+		t.Helper()
+		var ack Ack
+		stalled := e.srv.Stalled()
+		KitMessage(t, KitRequest(aID, e.srv.Base(), limits, 60000, KitFullCandidate("a", e.vless)), opts(ep), e.plat, &ack)
+		if ack.Type != "scan_ack" {
+			t.Fatalf("scan A: %+v", ack)
+		}
+		KitWaitFor(t, "A's probe stalled on its instance", 5*time.Second, func() bool { return LiveInstances() == 1 && e.srv.Stalled() > stalled })
+		release := make(chan struct{})
+		var closing sync.Once
+		closingCh := make(chan struct{})
+		SetCloseInstanceHook(func() { closing.Do(func() { close(closingCh) }); <-release })
+		defer SetCloseInstanceHook(nil)
+		var waiting sync.Once
+		waitingCh := make(chan struct{})
+		hook := func() { waiting.Do(func() { close(waitingCh) }) }
+		startWaitHook.Store(&hook)
+		defer startWaitHook.Store(nil)
+		bReply := make(chan string, 1)
+		go func() {
+			bReply <- Message(KitRequest(bID, e.srv.Base(), limits, 60000, KitFullCandidate("b", e.vless)), bOpts, e.plat)
+		}()
+		<-waitingCh // B tore A down and waits for it
+		<-closingCh // A's instance close is held
+		stopReply := make(chan string, 1)
+		go func() { stopReply <- stop() }()
+		KitWaitFor(t, "the stop recorded", 5*time.Second, stopRecorded)
+		close(release)
+		return <-bReply, <-stopReply
+	}
+
+	t.Run("stop with a newer epoch while the start waits", func(t *testing.T) {
+		b, st := race(t, "f2-a", "f2-b", base+1, opts(base+1),
+			func() string { return Message(`{"action":"scan_stop_all","wait_ms":5000}`, opts(base+2), e.plat) },
+			func() bool { return epochNow() == base+2 })
+		if b != `{"error":"stale_epoch","detail":"host_epoch"}` || st != `{"stopped":true}` {
+			t.Fatalf("start B: %s, stop: %s", b, st)
+		}
+		assertNothingAlive(t, "after the stop")
+		if !unknown("f2-b") {
+			t.Fatal("B installed a scan")
+		}
+		if LiveWork() != (Work{}) {
+			t.Fatalf("B opened %+v", LiveWork())
+		}
+	})
+	t.Run("the stop first, then the older start", func(t *testing.T) {
+		if raw := Message(`{"action":"scan_stop_all","wait_ms":5000}`, opts(base+3), e.plat); raw != `{"stopped":true}` {
+			t.Fatalf("stop: %s", raw)
+		}
+		raw := Message(KitRequest("f2-c", e.srv.Base(), limits, 60000, KitFullCandidate("c", e.vless)), opts(base+2), e.plat)
+		if raw != `{"error":"stale_epoch","detail":"host_epoch"}` || !unknown("f2-c") {
+			t.Fatalf("start C after the stop: %s", raw)
+		}
+		assertNothingAlive(t, "after the refused start")
+	})
+	t.Run("stop without an epoch while the start waits", func(t *testing.T) {
+		var stops uint64
+		current.Lock()
+		stops = current.stops
+		current.Unlock()
+		b, st := race(t, "f2-d", "f2-e", base+3, opts(base+3),
+			func() string { return StopAllJSON(5000) },
+			func() bool { current.Lock(); defer current.Unlock(); return current.stops > stops })
+		if b != `{"error":"internal","detail":"stopping"}` || st != `{"stopped":true}` {
+			t.Fatalf("start E: %s, stop: %s", b, st)
+		}
+		assertNothingAlive(t, "after the plain stop")
+		if !unknown("f2-e") {
+			t.Fatal("E installed a scan")
+		}
+	})
+	// A start of the current epoch after the stops works.
+	e.srv.SetMode("ok", false)
+	r := KitRun(t, KitRequest("f2-after", e.srv.Base(), nil, 10000, KitFullCandidate("n", e.vless)), opts(base+3), e.plat, 20*time.Second)
+	if d, _ := r.DataByID("n"); d.Error != "" {
+		t.Fatalf("a start after the stops: %+v %+v", d, r.Err)
+	}
+}
+
+// Review F3 (followup 2): a stop carries the host epoch it was issued in; it ends the scan work of that
+// epoch or older and never work the host started after it (a newer epoch) - a stop delayed on its way to
+// the engine (the iOS adapter's backend-restart stop runs on its own thread, awaited at most 600 ms) must
+// not kill the scan the host started after a later stop. Its reply is about its own epoch: nothing of that
+// epoch or older alive -> {"stopped":true}. An equal epoch is covered (the desktop service's app stop and
+// teardown check carry the current, unbumped epoch of the scan they end); a stop without an epoch ends
+// everything. Ordered by hooks (an instance close held, the start's wait signalled), not sleeps.
+func TestTribeScanStaleStop(t *testing.T) {
+	e := newKitEnv(t)
+	e.srv.SetMode("stall", false)
+	defer e.srv.SetMode("ok", false)
+	limits := map[string]any{"stall_ms": 10000, "total_ms": 30000, "ttfb_ms": 15000, "concurrency": 1}
+	current.Lock()
+	base := current.epoch // process-wide: earlier tests may have raised it
+	current.Unlock()
+	opts := func(ep int64) string { return fmt.Sprintf(`{"host_epoch":%d}`, ep) }
+	stopAt := func(ep int64, waitMs int) string {
+		return Message(fmt.Sprintf(`{"action":"scan_stop_all","wait_ms":%d}`, waitMs), opts(ep), e.plat)
+	}
+	poll := func(id string) Progress {
+		var p Progress
+		KitMessage(t, fmt.Sprintf(`{"action":"scan_poll","scan_id":%q,"since":0}`, id), "", e.plat, &p)
+		return p
+	}
+	startStalled := func(t *testing.T, id string, ep int64) {
+		t.Helper()
+		var ack Ack
+		stalled := e.srv.Stalled()
+		KitMessage(t, KitRequest(id, e.srv.Base(), limits, 60000, KitFullCandidate("a", e.vless)), opts(ep), e.plat, &ack)
+		if ack.Type != "scan_ack" {
+			t.Fatalf("start %s: %+v", id, ack)
+		}
+		KitWaitFor(t, id+" stalled on its instance", 5*time.Second, func() bool { return LiveInstances() == 1 && e.srv.Stalled() > stalled })
+	}
+
+	t.Run("a stale stop after a newer scan is installed", func(t *testing.T) {
+		if raw := stopAt(base+2, 3000); raw != `{"stopped":true}` {
+			t.Fatalf("stop %d: %s", base+2, raw)
+		}
+		startStalled(t, "r3-new", base+2)
+		live := LiveWork()
+		if raw := stopAt(base+1, 3000); raw != `{"stopped":true}` { // nothing of its epoch or older is alive
+			t.Fatalf("stale stop: %s", raw)
+		}
+		if p := poll("r3-new"); p.Done || LiveWork() != live || LiveInstances() != 1 {
+			t.Fatalf("the stale stop touched the newer scan: %+v, %+v", p, LiveWork())
+		}
+		// The same epoch is covered: the scan ends.
+		if raw := stopAt(base+2, 3000); raw != `{"stopped":true}` {
+			t.Fatalf("equal-epoch stop: %s", raw)
+		}
+		if p := poll("r3-new"); !p.Done || p.Reason != ReasonTunnelStopped {
+			t.Fatalf("an equal-epoch stop left the scan: %+v", p)
+		}
+		assertNothingAlive(t, "after the equal-epoch stop")
+	})
+	t.Run("a stale stop while a newer start waits", func(t *testing.T) {
+		startStalled(t, "r3-a", base+3)
+		release := make(chan struct{})
+		var closing sync.Once
+		closingCh := make(chan struct{})
+		SetCloseInstanceHook(func() { closing.Do(func() { close(closingCh) }); <-release })
+		defer SetCloseInstanceHook(nil)
+		var waiting sync.Once
+		waitingCh := make(chan struct{})
+		hook := func() { waiting.Do(func() { close(waitingCh) }) }
+		startWaitHook.Store(&hook)
+		defer startWaitHook.Store(nil)
+		bReply := make(chan string, 1)
+		go func() {
+			bReply <- Message(KitRequest("r3-b", e.srv.Base(), limits, 60000, KitFullCandidate("b", e.vless)), opts(base+3), e.plat)
+		}()
+		<-waitingCh // B tore A down and waits for it
+		<-closingCh // A's instance close is held
+		// A stop of an older epoch: nothing of its epoch is alive (A is base+3), so it answers at once -
+		// it never waits for A's teardown - and B keeps waiting.
+		if raw := stopAt(base+2, 3000); raw != `{"stopped":true}` {
+			t.Fatalf("stale stop during the wait: %s", raw)
+		}
+		select {
+		case b := <-bReply:
+			t.Fatalf("the stale stop cancelled the waiting start: %s", b)
+		default:
+		}
+		close(release)
+		var ack Ack
+		if b := <-bReply; json.Unmarshal([]byte(b), &ack) != nil || ack.Type != "scan_ack" {
+			t.Fatalf("start B after A's teardown: %s", b)
+		}
+		SetCloseInstanceHook(nil)
+		if raw := stopAt(base+3, 3000); raw != `{"stopped":true}` {
+			t.Fatalf("stop of B's epoch: %s", raw)
+		}
+		assertNothingAlive(t, "after B's stop")
+	})
+	t.Run("an equal-epoch stop while a start of that epoch waits", func(t *testing.T) {
+		startStalled(t, "r3-c", base+4)
+		release := make(chan struct{})
+		var closing sync.Once
+		closingCh := make(chan struct{})
+		SetCloseInstanceHook(func() { closing.Do(func() { close(closingCh) }); <-release })
+		defer SetCloseInstanceHook(nil)
+		var waiting sync.Once
+		waitingCh := make(chan struct{})
+		hook := func() { waiting.Do(func() { close(waitingCh) }) }
+		startWaitHook.Store(&hook)
+		defer startWaitHook.Store(nil)
+		bReply := make(chan string, 1)
+		go func() {
+			bReply <- Message(KitRequest("r3-d", e.srv.Base(), limits, 60000, KitFullCandidate("d", e.vless)), opts(base+4), e.plat)
+		}()
+		<-waitingCh
+		<-closingCh
+		stopReply := make(chan string, 1)
+		go func() { stopReply <- stopAt(base+4, 5000) }()
+		if b := <-bReply; b != `{"error":"internal","detail":"stopping"}` { // cancelled at once, before A is gone
+			t.Fatalf("a start waiting across a stop of its own epoch: %s", b)
+		}
+		close(release)
+		if st := <-stopReply; st != `{"stopped":true}` {
+			t.Fatalf("stop: %s", st)
+		}
+		assertNothingAlive(t, "after the equal-epoch stop")
+		if !strings.Contains(Message(`{"action":"scan_poll","scan_id":"r3-d","since":0}`, "", e.plat), `"unknown_scan"`) {
+			t.Fatal("the cancelled start installed a scan")
+		}
+	})
+	t.Run("a stop without an epoch ends every epoch", func(t *testing.T) {
+		startStalled(t, "r3-e", base+50)
+		if raw := StopAllJSON(3000); raw != `{"stopped":true}` {
+			t.Fatalf("plain stop: %s", raw)
+		}
+		if p := poll("r3-e"); !p.Done || p.Reason != ReasonTunnelStopped {
+			t.Fatalf("the plain stop left a newer-epoch scan: %+v", p)
+		}
+		assertNothingAlive(t, "after the plain stop")
+	})
+}
+
+// The stop reply's shape: {"stopped":true} exactly, or false with the live counts as top-level
+// numbers in a fixed order; the runner's own counts (SetRunnerLive) are part of LiveWork.
+func TestTribeScanStopReplyShape(t *testing.T) {
+	if raw := stopReplyFalse(Work{Instances: 1, Jobs: 2, Closers: 1, Access: 3, Awg: 4, Children: 5}); raw !=
+		`{"stopped":false,"instances":1,"jobs":2,"closers":1,"attempts":3,"awg":4,"children":5}` {
+		t.Fatalf("false reply: %s", raw)
+	}
+	if raw := StopAllJSON(1000); raw != `{"stopped":true}` { // nothing running
+		t.Fatalf("true reply: %s", raw)
+	}
+	SetRunnerLive(func() int64 { return 2 }, func() int64 { return 3 })
+	w := LiveWork()
+	SetRunnerLive(nil, nil)
+	if w.Awg != 2 || w.Children != 3 || LiveWork() != (Work{}) {
+		t.Fatalf("runner counts: %+v, after unregistering %+v", w, LiveWork())
+	}
+}
+
+func mustJSON(v any) string {
+	raw, _ := json.Marshal(v)
+	return string(raw)
+}
