+func TestTribeScanReachStage(t *testing.T) {
+	e := newKitEnv(t)
+	open, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer open.Close()
+	var mu sync.Mutex
+	var accepts []time.Time
+	go func() {
+		for {
+			c, err := open.Accept()
+			if err != nil {
+				return
+			}
+			mu.Lock()
+			accepts = append(accepts, time.Now())
+			mu.Unlock()
+			c.Close()
+		}
+	}()
+	openPort := open.Addr().(*net.TCPAddr).Port
+	withEntry := func(id string, port int, at int64) map[string]any {
+		c := KitFullCandidate(id, e.vless)
+		c["entry"] = map[string]any{"ip": "127.0.0.1", "port": port}
+		c["reach_at_ms"] = at
+		return c
+	}
+	t0 := time.Now()
+	r := KitRun(t, KitRequest("s-reach", e.srv.Base(), map[string]any{"entry_ip_spacing_ms": 200}, 15000,
+		withEntry("up", openPort, 0), withEntry("late", openPort, 400), withEntry("down", FreePort(t), 0),
+		KitFullCandidate("composite", e.vless)), "", e.plat, 20*time.Second)
+	reach := map[string]Item{}
+	for _, it := range r.Reach() {
+		reach[it.ID] = it
+	}
+	if len(reach) != 3 || !deref(reach["up"].OK) || !deref(reach["late"].OK) || deref(reach["down"].OK) ||
+		reach["down"].Error != ErrReachRefused || reach["up"].Error != "" {
+		t.Fatalf("reach %+v", r.Reach())
+	}
+	if _, ok := r.DataByID("down"); ok {
+		t.Fatal("an unreachable candidate was probed")
+	}
+	for _, id := range []string{"up", "late", "composite"} {
+		if d, ok := r.DataByID(id); !ok || d.Error != "" {
+			t.Fatalf("%s: %+v", id, d)
+		}
+	}
+	mu.Lock()
+	defer mu.Unlock()
+	if len(accepts) != 2 || accepts[1].Sub(t0) < 400*time.Millisecond {
+		t.Fatalf("reach_at_ms not respected: %v", accepts)
+	}
+	// Opens to one IP are spaced: reach of "down" (same IP) and the data connections follow it too.
+	if r.Phases[0] != PhaseReach || r.Phases[len(r.Phases)-1] != PhaseDone {
+		t.Fatalf("phases %v", r.Phases)
+	}
+}
