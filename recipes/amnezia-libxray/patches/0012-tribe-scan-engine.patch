index 0000000..3d31454
--- /dev/null
+++ b/tribescan/awg.go
@@ -0,0 +1,309 @@
+package tribescan
+
+// awg_mini (awg-probe-plan.md §3, contract "One awg_mini session"): the engine schedules the
+// session like any probe - its own pool, the shared byte gate, queue order, the memory guard - and
+// asks the host's runner (Platform.Awg) for a userspace AmneziaWG device on an in-memory netstack with
+// the device's OWN key. Over that session it runs the same data probe as for Xray (one TLS connection
+// to probe.ip:port with probe.host as the TLS name and Host, warm-up then the sized GET, digest
+// checked here). Rules kept here, before the runner is asked: at most one session per node in a scan,
+// never the live tunnel's peer (host option awg_live_peer), initiations at least awg_spacing_ms
+// apart. The session is closed on every path.
+
+import (
+	"context"
+	"encoding/base64"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"net"
+	"net/netip"
+	"strings"
+	"time"
+)
+
+// AwgJob is what the runner needs for one session. UAPI is SECRET.
+type AwgJob struct {
+	UAPI      string         // interface + peer lines (listen_port=0, no keepalive), the device's own key
+	Addresses []netip.Prefix // the device's tunnel address(es) inside the node (config "address")
+	MTU       int            // 0 = 1280
+	// Prime echoes (diagnostic): Echoes ICMP echoes to EchoTarget after the handshake, 150 ms each.
+	EchoTarget netip.Addr
+	Echoes     int
+	Handshake  time.Duration // awg_handshake_ms: no handshake within it = handshake_ok false
+	Spacing    time.Duration // awg_spacing_ms: the runner keeps its initiations at least this far apart
+	PeerKey    string        // the node's public key (hex), the runner's registry key
+	// BoundIf is the physical interface index for the session's UDP socket (0 = Protect only).
+	BoundIf int
+	// Protect runs on every UDP socket of the session before its first packet: the probe's own
+	// protection (interface binding, the host's probe protector). An error fails this probe only
+	// (bind_failed), never the tunnel.
+	Protect func(network string, fd uintptr) error
+}
+
+// AwgSession is one open session. Open returns it once the handshake succeeded or timed out.
+type AwgSession interface {
+	HandshakeOK() bool
+	HandshakeMs() int64 // -1 = none
+	Echoes() (sent, replies int, wireBytes int64)
+	// DialTCP opens the probe's TCP connection inside the tunnel (no DNS inside the session).
+	DialTCP(ctx context.Context, addr netip.AddrPort) (net.Conn, error)
+	Close() error
+}
+
+// AwgOpener opens a session or fails with ErrAwgConfig / ErrAwgBind / another error (internal).
+// It must return promptly when ctx ends.
+type AwgOpener func(ctx context.Context, job AwgJob) (AwgSession, error)
+
+var (
+	ErrAwgConfig = errors.New("awg: bad config")
+	ErrAwgBind   = errors.New("awg: socket protection failed")
+	ErrAwgBusy   = errors.New("awg: a session to this node is open")
+)
+
+// awgConfig is the candidate's config.
+type awgConfig struct {
+	UAPI  string `json:"uapi"`
+	Probe struct {
+		Host string `json:"host"`
+		IP   string `json:"ip"`
+		Port int    `json:"port"`
+	} `json:"probe"`
+	PrimeEchoTarget *string `json:"prime_echo_target"`
+	BoundIf         *int    `json:"bound_if"`
+	// The device's tunnel address ("100.64.0.250/32"; a list is accepted too) and the node's MTU.
+	Address json.RawMessage `json:"address"`
+	MTU     int             `json:"mtu"`
+}
+
+type awgPlan struct {
+	job      AwgJob
+	host     string // TLS name and Host
+	addr     netip.AddrPort
+	endpoint string
+}
+
+// parseAwg validates an awg_mini config; the node identity is the first peer's public key.
+func parseAwg(c *Candidate, l Limits) (*awgPlan, bool) {
+	var cfg awgConfig
+	if json.Unmarshal([]byte(c.Config), &cfg) != nil || cfg.UAPI == "" || len(cfg.UAPI) > 64*1024 {
+		return nil, false
+	}
+	p := &awgPlan{host: cfg.Probe.Host}
+	ip, err := netip.ParseAddr(cfg.Probe.IP)
+	if err != nil || cfg.Probe.Port < 1 || cfg.Probe.Port > 65535 || !hostnameOK(cfg.Probe.Host) {
+		return nil, false
+	}
+	p.addr = netip.AddrPortFrom(ip.Unmap(), uint16(cfg.Probe.Port))
+	for _, line := range strings.Split(cfg.UAPI, "\n") {
+		k, v, _ := strings.Cut(strings.TrimSpace(line), "=")
+		switch k {
+		case "public_key":
+			if p.job.PeerKey == "" {
+				p.job.PeerKey = strings.ToLower(v)
+			}
+		case "endpoint":
+			if p.endpoint == "" {
+				p.endpoint = v
+			}
+		}
+	}
+	if len(p.job.PeerKey) != 64 || p.endpoint == "" {
+		return nil, false
+	}
+	var addrs []string
+	if len(cfg.Address) > 0 {
+		var one string
+		if json.Unmarshal(cfg.Address, &one) == nil {
+			addrs = strings.Split(one, ",")
+		} else if json.Unmarshal(cfg.Address, &addrs) != nil {
+			return nil, false
+		}
+	}
+	for _, a := range addrs {
+		a = strings.TrimSpace(a)
+		if a == "" {
+			continue
+		}
+		pfx, err := netip.ParsePrefix(a)
+		if err != nil {
+			ad, aerr := netip.ParseAddr(a)
+			if aerr != nil {
+				return nil, false
+			}
+			pfx = netip.PrefixFrom(ad, ad.BitLen())
+		}
+		p.job.Addresses = append(p.job.Addresses, pfx)
+	}
+	if len(p.job.Addresses) == 0 {
+		return nil, false // without the device's tunnel address the node drops every packet
+	}
+	if cfg.MTU != 0 && (cfg.MTU < 576 || cfg.MTU > 9000) {
+		return nil, false
+	}
+	p.job.UAPI, p.job.MTU = cfg.UAPI, cfg.MTU
+	if cfg.PrimeEchoTarget != nil && *cfg.PrimeEchoTarget != "" {
+		t, err := netip.ParseAddr(*cfg.PrimeEchoTarget)
+		if err != nil {
+			return nil, false
+		}
+		p.job.EchoTarget = t
+		p.job.Echoes = l.AwgPrimeEchoes
+	}
+	if cfg.BoundIf != nil && *cfg.BoundIf > 0 {
+		p.job.BoundIf = *cfg.BoundIf
+	}
+	p.job.Handshake = time.Duration(l.AwgHandshakeMs) * time.Millisecond
+	p.job.Spacing = time.Duration(max(l.AwgSpacingMs, 50)) * time.Millisecond
+	return p, true
+}
+
+func hostnameOK(h string) bool {
+	if h == "" || len(h) > 253 || strings.ContainsAny(h, " /:?#@[]\r\n") {
+		return false
+	}
+	return headerSafe(h)
+}
+
+// livePeer is the host option awg_live_peer: the live tunnel's peer, never probed.
+type livePeer struct {
+	PublicKey string `json:"public_key"` // hex or base64
+	Endpoint  string `json:"endpoint"`
+}
+
+func (lp *livePeer) keyHex() string {
+	k := strings.TrimSpace(lp.PublicKey)
+	if len(k) == 64 {
+		if _, err := hex.DecodeString(k); err == nil {
+			return strings.ToLower(k)
+		}
+	}
+	if b, err := base64.StdEncoding.DecodeString(k); err == nil && len(b) == 32 {
+		return hex.EncodeToString(b)
+	}
+	return ""
+}
+
+func sameEndpoint(a, b string) bool {
+	if a == "" || b == "" {
+		return false
+	}
+	pa, ea := netip.ParseAddrPort(a)
+	pb, eb := netip.ParseAddrPort(b)
+	if ea == nil && eb == nil {
+		return pa.Addr().Unmap() == pb.Addr().Unmap() && pa.Port() == pb.Port()
+	}
+	return strings.EqualFold(a, b)
+}
+
+// awgRefusedLocked decides the scan-level rules before a session is admitted.
+func (s *Scan) awgRefusedLocked(p *awgPlan) bool {
+	if lp := s.opts.AwgLivePeer; lp != nil {
+		if k := lp.keyHex(); (k != "" && k == p.job.PeerKey) || sameEndpoint(lp.Endpoint, p.endpoint) {
+			return true // the live tunnel's node: probing it would move its endpoint
+		}
+	}
+	if s.awgNodes[p.job.PeerKey] {
+		return true // one session per node in a scan
+	}
+	return false
+}
+
+func (s *Scan) runAwg(e *entry) (it Item) {
+	c := e.c
+	size := s.bodyBytes(c)
+	p := e.awg
+	if p == nil {
+		return *dataItem(c, size, ErrConfig)
+	}
+	job := p.job
+	if job.BoundIf == 0 {
+		job.BoundIf = s.opts.BindInterfaceIndex
+	}
+	if job.BoundIf == 0 && s.opts.BindInterface != "" {
+		// A runner in another process binds by index (amneziawg-go probe).
+		if ifc, err := net.InterfaceByName(s.opts.BindInterface); err == nil {
+			job.BoundIf = ifc.Index
+		}
+	}
+	boundIf := job.BoundIf
+	job.Protect = func(network string, fd uintptr) error { return s.protectFd(network, "", fd, boundIf) }
+	t0 := time.Now()
+	total := time.Duration(s.req.Limits.TotalMs) * time.Millisecond
+	if c.TotalMs > 0 {
+		total = time.Duration(c.TotalMs) * time.Millisecond
+	}
+	end := t0.Add(total)
+	ctx, cancel := context.WithDeadline(s.pctx, end)
+	defer cancel()
+	defer func() { it.StartMs, it.EndMs = s.sinceStart(t0), s.sinceStart(time.Now()) }()
+	sess, err := s.plat.Awg(ctx, job)
+	if err != nil {
+		code := ErrInternal
+		switch {
+		case s.ctx.Err() != nil:
+			code = s.stopCode()
+		case errors.Is(err, ErrAwgConfig), errors.Is(err, ErrAwgBusy):
+			code = ErrConfig
+		case errors.Is(err, ErrAwgBind):
+			code = ErrBindFailed
+		case ctx.Err() != nil:
+			code = ErrTotal
+		}
+		it = *dataItem(c, size, code)
+		it.DurationMs = i64(time.Since(t0).Milliseconds())
+		return it
+	}
+	defer sess.Close()
+	if s.plat.JobHook != nil {
+		s.plat.JobHook(c.ID)
+	}
+	sent, replies, echoBytes := sess.Echoes()
+	hsMs := sess.HandshakeMs()
+	fill := func(it *Item, spent int64) {
+		it.HandshakeOK, it.EchoSent, it.EchoReplies = bp(sess.HandshakeOK()), ip(sent), ip(replies)
+		if hsMs >= 0 {
+			it.HandshakeMs = i64(hsMs)
+		}
+		it.SpentBytes, it.Retries, it.DurationMs = i64(spent), ip(0), i64(time.Since(t0).Milliseconds())
+	}
+	if !sess.HandshakeOK() {
+		it = *dataItem(c, size, ErrDial)
+		if s.ctx.Err() != nil {
+			it.Error = s.stopCode()
+		}
+		fill(&it, echoBytes)
+		return it
+	}
+	allowance := int64(-1)
+	if c.CostBytes > 0 {
+		if allowance = c.CostBytes - echoBytes; allowance < tlsOverhead {
+			it = *dataItem(c, size, ErrBudget)
+			fill(&it, echoBytes)
+			return it
+		}
+	}
+	base := "https://" + p.host
+	dial := func(ctx context.Context) (net.Conn, error) { return sess.DialTCP(ctx, p.addr) }
+	out := s.attempt(dial, ErrDial, p.host, base, c, end, allowance)
+	if out.notYet && out.read == 0 {
+		out.spent = reachOverhead
+	}
+	it = out.item
+	fill(&it, out.spent+echoBytes)
+	return it
+}
+
+// parseLivePeer reads the host option awg_live_peer ({"public_key","endpoint"}).
+func parseLivePeer(raw json.RawMessage) (*livePeer, bool) {
+	if len(raw) == 0 || string(raw) == "null" {
+		return nil, true
+	}
+	var lp livePeer
+	if json.Unmarshal(raw, &lp) != nil || (lp.PublicKey == "" && lp.Endpoint == "") {
+		return nil, false
+	}
+	if lp.PublicKey != "" && lp.keyHex() == "" {
+		return nil, false
+	}
+	return &lp, true
+}
diff --git a/tribescan/awg_test.go b/tribescan/awg_test.go
new file mode 100644
index 0000000..86620ae
--- /dev/null
+++ b/tribescan/awg_test.go
@@ -0,0 +1,441 @@
+//go:build tribescan_testkit
+
+package tribescan
+
+import (
+	"context"
+	"encoding/base64"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"net"
+	"net/netip"
+	"runtime"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"syscall"
+	"testing"
+	"time"
+)
+
+// fakeAwg is a runner without AmneziaWG: its "tunnel" dials the kit server directly. It records
+// what the engine asked for, so the scheduling rules can be checked without a device.
+type fakeAwg struct {
+	mu        sync.Mutex
+	opens     []time.Time
+	jobs      []AwgJob
+	open      map[string]int
+	maxOpen   int
+	closed    atomic.Int32
+	closedAt  []time.Time
+	noShake   map[string]bool
+	echoes    int
+	protectFd bool
+}
+
+type fakeSession struct {
+	f     *fakeAwg
+	job   AwgJob
+	shake bool
+	once  sync.Once
+}
+
+func (f *fakeAwg) Open(ctx context.Context, job AwgJob) (AwgSession, error) {
+	f.mu.Lock()
+	f.opens = append(f.opens, time.Now())
+	f.jobs = append(f.jobs, job)
+	if f.open == nil {
+		f.open = map[string]int{}
+	}
+	f.open[job.PeerKey]++
+	n := 0
+	for _, v := range f.open {
+		n += v
+	}
+	f.maxOpen = max(f.maxOpen, n)
+	noShake := f.noShake[job.PeerKey]
+	f.mu.Unlock()
+	if f.protectFd {
+		// The session's UDP socket goes through the probe protector before its first packet.
+		uc, err := net.ListenUDP("udp4", &net.UDPAddr{IP: net.IPv4(127, 0, 0, 1)})
+		if err != nil {
+			return nil, err
+		}
+		rc, _ := uc.SyscallConn()
+		var perr error
+		rc.Control(func(fd uintptr) { perr = job.Protect("udp4", fd) })
+		uc.Close()
+		if perr != nil {
+			f.release(job.PeerKey)
+			return nil, ErrAwgBind
+		}
+	}
+	if noShake {
+		select {
+		case <-time.After(job.Handshake):
+		case <-ctx.Done():
+		}
+	}
+	return &fakeSession{f: f, job: job, shake: !noShake}, nil
+}
+
+func (f *fakeAwg) release(key string) {
+	f.mu.Lock()
+	f.open[key]--
+	f.closedAt = append(f.closedAt, time.Now())
+	f.mu.Unlock()
+	f.closed.Add(1)
+}
+
+func (s *fakeSession) HandshakeOK() bool { return s.shake }
+func (s *fakeSession) HandshakeMs() int64 {
+	if s.shake {
+		return 3
+	}
+	return -1
+}
+func (s *fakeSession) Echoes() (int, int, int64) {
+	if !s.shake {
+		return 0, 0, 0
+	}
+	n := min(s.f.echoes, s.job.Echoes)
+	return n, n, int64(n) * 2 * 84
+}
+func (s *fakeSession) DialTCP(ctx context.Context, addr netip.AddrPort) (net.Conn, error) {
+	var d net.Dialer
+	return d.DialContext(ctx, "tcp", addr.String())
+}
+func (s *fakeSession) Close() error {
+	s.once.Do(func() { s.f.release(s.job.PeerKey) })
+	return nil
+}
+
+func awgKey(i int) string {
+	b := make([]byte, 32)
+	b[0], b[31] = byte(i), 0x5a
+	return hex.EncodeToString(b)
+}
+
+func kitAwgCandidate(id string, node int, port int) map[string]any {
+	uapi := fmt.Sprintf("private_key=%s\nlisten_port=0\nreplace_peers=true\npublic_key=%s\nendpoint=127.0.0.1:%d\n"+
+		"allowed_ip=127.0.0.1/32\nallowed_ip=10.8.0.1/32\n", awgKey(200), awgKey(node), 51000+node)
+	cfg, _ := json.Marshal(map[string]any{"uapi": uapi, "probe": map[string]any{"host": "example.com", "ip": "127.0.0.1", "port": port},
+		"prime_echo_target": "10.8.0.1", "bound_if": nil, "address": "10.8.0.2/32", "mtu": 1280})
+	return map[string]any{"id": id, "kind": KindAwgMini, "config": string(cfg), "entry": nil, "reach_at_ms": -1,
+		"profile_id": nil, "early_retry": false, "dns_plan": false, "cost_bytes": 90000}
+}
+
+func TestTribeScanAwgSessions(t *testing.T) {
+	e := newKitEnv(t)
+	t.Run("pool, spacing, data probe, close", func(t *testing.T) {
+		f := &fakeAwg{echoes: 1}
+		plat := e.plat
+		plat.Awg, plat.MaxAwg = f.Open, 2
+		e.srv.SetMode("slow_first_byte", false) // each sized body held 300 ms: sessions overlap
+		e.srv.Delay.Store(300)
+		defer func() { e.srv.Delay.Store(0); e.srv.SetMode("ok", false) }()
+		if c := plat.Caps(); c.MaxAwgConcurrent != 2 || c.Kinds[len(c.Kinds)-1] != KindAwgMini {
+			t.Fatalf("caps %+v", c)
+		}
+		var cands []map[string]any
+		for i := 1; i <= 4; i++ {
+			cands = append(cands, kitAwgCandidate(fmt.Sprintf("awg%d", i), i, e.srv.Port))
+		}
+		r := KitRun(t, KitRequest("s-awg", e.srv.Base(), map[string]any{"awg_concurrency": 2, "awg_spacing_ms": 120,
+			"awg_prime_echoes": 1}, 20000, cands...), "", plat, 20*time.Second)
+		if len(r.Data()) != 4 {
+			t.Fatalf("items %+v", r.Items)
+		}
+		for _, d := range r.Data() {
+			raw, _ := json.Marshal(d)
+			if d.Error != "" || !deref(d.ShaOK) || deref(d.Bytes) != 65536 || !deref(d.HandshakeOK) || deref(d.HandshakeMs) != 3 ||
+				deref(d.EchoSent) != 1 || deref(d.EchoReplies) != 1 || d.StartMs == nil || d.EndMs == nil {
+				t.Fatalf("item %s", raw)
+			}
+			// Echo bytes both ways are part of the probe's bytes (contract bytes_spent).
+			if low := int64(1024 + 65536 + 8192 + 168); deref(d.SpentBytes) < low || deref(d.SpentBytes) > low+4096 {
+				t.Fatalf("spent %d", deref(d.SpentBytes))
+			}
+		}
+		f.mu.Lock()
+		defer f.mu.Unlock()
+		if f.maxOpen != 2 || f.closed.Load() != 4 {
+			t.Fatalf("max open %d closed %d", f.maxOpen, f.closed.Load())
+		}
+		for i := 1; i < len(f.opens); i++ {
+			if gap := f.opens[i].Sub(f.opens[i-1]); gap < 115*time.Millisecond {
+				t.Fatalf("initiations %v apart, want >= 120 ms", gap)
+			}
+		}
+		j := f.jobs[0]
+		if j.Addresses[0].String() != "10.8.0.2/32" || j.MTU != 1280 || j.EchoTarget.String() != "10.8.0.1" || j.Echoes != 1 ||
+			j.Handshake != 1500*time.Millisecond || j.Spacing != 120*time.Millisecond || len(j.PeerKey) != 64 || j.Protect == nil {
+			t.Fatalf("job %+v", j)
+		}
+	})
+	t.Run("refusals: one per node, the live peer, a bad config", func(t *testing.T) {
+		f := &fakeAwg{}
+		plat := e.plat
+		plat.Awg, plat.MaxAwg = f.Open, 4
+		bad := kitAwgCandidate("noaddr", 7, e.srv.Port)
+		var cfg map[string]any
+		json.Unmarshal([]byte(bad["config"].(string)), &cfg)
+		delete(cfg, "address")
+		raw, _ := json.Marshal(cfg)
+		bad["config"] = string(raw)
+		keyB64 := func(i int) string { b, _ := hex.DecodeString(awgKey(i)); return base64.StdEncoding.EncodeToString(b) }
+		opts := fmt.Sprintf(`{"awg_live_peer":{"public_key":%q}}`, keyB64(3))
+		r := KitRun(t, KitRequest("s-awg-refuse", e.srv.Base(), map[string]any{"awg_concurrency": 4}, 20000,
+			kitAwgCandidate("a", 1, e.srv.Port), kitAwgCandidate("a-again", 1, e.srv.Port), kitAwgCandidate("live", 3, e.srv.Port), bad),
+			opts, plat, 20*time.Second)
+		want := map[string]string{"a": "", "a-again": ErrConfig, "live": ErrConfig, "noaddr": ErrConfig}
+		for id, code := range want {
+			if d, ok := r.DataByID(id); !ok || d.Error != code {
+				t.Fatalf("%s: %+v (want %q)", id, d, code)
+			}
+		}
+		if len(f.jobs) != 1 {
+			t.Fatalf("the runner was asked %d times, want 1", len(f.jobs))
+		}
+		// The live peer by endpoint too.
+		f2 := &fakeAwg{}
+		plat.Awg = f2.Open
+		r = KitRun(t, KitRequest("s-awg-live-ep", e.srv.Base(), map[string]any{"awg_concurrency": 4}, 20000,
+			kitAwgCandidate("live-ep", 5, e.srv.Port)), `{"awg_live_peer":{"endpoint":"127.0.0.1:51005"}}`, plat, 20*time.Second)
+		if d, _ := r.DataByID("live-ep"); d.Error != ErrConfig || len(f2.jobs) != 0 {
+			t.Fatalf("live endpoint: %+v jobs %d", d, len(f2.jobs))
+		}
+		if KitMessage(t, KitRequest("s-awg-badopt", e.srv.Base(), nil, 20000), `{"awg_live_peer":{"public_key":"short"}}`, plat, nil) !=
+			`{"error":"bad_request","detail":"host_options"}` {
+			t.Fatal("a malformed live peer must be refused")
+		}
+	})
+	t.Run("no handshake, protection failure", func(t *testing.T) {
+		f := &fakeAwg{noShake: map[string]bool{awgKey(1): true}, protectFd: true}
+		plat := e.plat
+		plat.Awg, plat.MaxAwg = f.Open, 2
+		r := KitRun(t, KitRequest("s-awg-fail", e.srv.Base(), map[string]any{"awg_concurrency": 2, "awg_handshake_ms": 300}, 20000,
+			kitAwgCandidate("silent", 1, e.srv.Port)), "", plat, 20*time.Second)
+		d, _ := r.DataByID("silent")
+		raw, _ := json.Marshal(d)
+		// Nothing of the session happened: the awg block is left out, as the app's encoder does
+		// (the decoder reads handshake_ok false).
+		if d.Error != ErrDial || deref(d.HandshakeOK) || d.HandshakeMs != nil || deref(d.SpentBytes) != 0 || f.closed.Load() != 1 {
+			t.Fatalf("no handshake: %s closed %d", raw, f.closed.Load())
+		}
+		plat.Protect = func(string, string, uintptr) error { return syscall.EPERM }
+		f2 := &fakeAwg{protectFd: true}
+		plat.Awg = f2.Open
+		r = KitRun(t, KitRequest("s-awg-bind", e.srv.Base(), map[string]any{"awg_concurrency": 2}, 20000,
+			kitAwgCandidate("unbound", 2, e.srv.Port)), "", plat, 20*time.Second)
+		if d, _ := r.DataByID("unbound"); d.Error != ErrBindFailed {
+			t.Fatalf("protection failure: %+v", d)
+		}
+	})
+	t.Run("cancel closes the session at once", func(t *testing.T) {
+		e.srv.SetMode("stall", false)
+		defer e.srv.SetMode("ok", false)
+		f := &fakeAwg{}
+		plat := e.plat
+		plat.Awg, plat.MaxAwg = f.Open, 2
+		var ack Ack
+		KitMessage(t, KitRequest("s-awg-cancel", e.srv.Base(), map[string]any{"awg_concurrency": 2, "stall_ms": 10000, "total_ms": 30000},
+			60000, kitAwgCandidate("x", 1, e.srv.Port)), "", plat, &ack)
+		KitWaitFor(t, "the session's body stalled", 10*time.Second, func() bool { return e.srv.Stalled() >= 1 })
+		t0 := time.Now()
+		KitMessage(t, `{"action":"scan_cancel","scan_id":"s-awg-cancel"}`, "", plat, &ack)
+		p := KitPollFinal(t, "s-awg-cancel", 5*time.Second)
+		f.mu.Lock()
+		closedAt := f.closedAt
+		f.mu.Unlock()
+		if len(closedAt) != 1 || closedAt[0].Sub(t0) > 100*time.Millisecond {
+			t.Fatalf("session closed %v after the cancel", closedAt)
+		}
+		if d, _ := (&KitResult{Items: p.Items}).DataByID("x"); d.Error != ErrCancelled || deref(d.SpentBytes) < 8192+1024 {
+			t.Fatalf("cancelled item %+v", d)
+		}
+	})
+	t.Run("one byte gate with the Xray pools", func(t *testing.T) {
+		f := &fakeAwg{}
+		plat := e.plat
+		plat.Awg, plat.MaxAwg = f.Open, 2
+		// 2 x 10240 for the access attempts + 90000 for the session: the full probe (83456) no longer fits.
+		r := KitRun(t, KitRequest("s-awg-gate", e.srv.Base(), map[string]any{"awg_concurrency": 1, "max_bytes": 180000}, 20000,
+			kitAwgCandidate("w", 1, e.srv.Port), KitFullCandidate("full", e.vless)), "", plat, 20*time.Second)
+		w, _ := r.DataByID("w")
+		full, _ := r.DataByID("full")
+		if w.Error != "" || full.Error != ErrBudget {
+			t.Fatalf("awg %+v full %+v", w, full)
+		}
+	})
+	assertNoInstances(t)
+}
+
+// The app's own awg_mini config (ScanHostContract.h scanAwgMiniConfig of testAwgInput(), as in the
+// host vector start_awg_mini_typed_config_and_base_ips) parses whole; prime_echo_target null means no
+// echo, bound_if null leaves the interface to the host option.
+const contractAwgConfig = `{"address":"100.64.0.250/32","bound_if":4,"mtu":1280,"prime_echo_target":"10.8.1.1",` +
+	`"probe":{"host":"api.tribe.example","ip":"198.51.100.7","port":443},"uapi":"private_key=11111111111111111111111111111111` +
+	`11111111111111111111111111111111\nlisten_port=0\njc=4\njmin=40\njmax=70\ns1=50\ns2=100\nh1=1234\nh2=5678\nh3=91011\nh4=121314\n` +
+	`i1=<b 0xf6ab3267fa>\nreplace_peers=true\npublic_key=2222222222222222222222222222222222222222222222222222222222222222\n` +
+	`endpoint=203.0.113.5:51820\nreplace_allowed_ips=true\nallowed_ip=198.51.100.7/32\nallowed_ip=10.8.1.1/32\n"}`
+
+func TestTribeScanAwgContractFixture(t *testing.T) {
+	l := Limits{AwgHandshakeMs: 1500, AwgPrimeEchoes: 1, AwgSpacingMs: 50}
+	p, ok := parseAwg(&Candidate{Config: contractAwgConfig}, l)
+	if !ok {
+		t.Fatal("the contract's awg_mini config was refused")
+	}
+	var cfg struct {
+		UAPI string `json:"uapi"`
+	}
+	json.Unmarshal([]byte(contractAwgConfig), &cfg)
+	j := p.job
+	if j.UAPI != cfg.UAPI || len(j.Addresses) != 1 || j.Addresses[0].String() != "100.64.0.250/32" || j.MTU != 1280 ||
+		j.EchoTarget.String() != "10.8.1.1" || j.Echoes != 1 || j.BoundIf != 4 || j.Handshake != 1500*time.Millisecond ||
+		j.PeerKey != "2222222222222222222222222222222222222222222222222222222222222222" || p.endpoint != "203.0.113.5:51820" ||
+		p.host != "api.tribe.example" || p.addr.String() != "198.51.100.7:443" {
+		t.Fatalf("parsed %+v / %+v", j, p)
+	}
+	// With a preshared key line, no echo target and no bound_if.
+	var m map[string]any
+	json.Unmarshal([]byte(contractAwgConfig), &m)
+	m["uapi"] = strings.Replace(m["uapi"].(string), "\nendpoint=", "\npreshared_key="+strings.Repeat("ab", 32)+"\nendpoint=", 1)
+	m["prime_echo_target"], m["bound_if"] = nil, nil
+	raw, _ := json.Marshal(m)
+	p, ok = parseAwg(&Candidate{Config: string(raw)}, l)
+	if !ok || p.job.EchoTarget.IsValid() || p.job.Echoes != 0 || p.job.BoundIf != 0 || !strings.Contains(p.job.UAPI, "preshared_key=") {
+		t.Fatalf("variant: ok %v %+v", ok, p)
+	}
+	// bound_if null: the session takes the host option's interface; a candidate's own bound_if wins.
+	e := newKitEnv(t)
+	for _, c := range []struct {
+		boundIf any
+		want    int
+	}{{nil, 7}, {4, 4}} {
+		f := &fakeAwg{}
+		plat := e.plat
+		plat.Awg, plat.MaxAwg = f.Open, 1
+		cand := kitAwgCandidate("b", 1, e.srv.Port)
+		var cm map[string]any
+		json.Unmarshal([]byte(cand["config"].(string)), &cm)
+		cm["bound_if"] = c.boundIf
+		cr, _ := json.Marshal(cm)
+		cand["config"] = string(cr)
+		KitRun(t, KitRequest(fmt.Sprintf("s-awg-bif-%v", c.boundIf), e.srv.Base(), map[string]any{"awg_concurrency": 1}, 20000, cand),
+			`{"bind_interface_index":7}`, plat, 20*time.Second)
+		if len(f.jobs) != 1 || f.jobs[0].BoundIf != c.want {
+			t.Fatalf("bound_if %v: jobs %+v", c.boundIf, f.jobs)
+		}
+	}
+}
+
+// memAdmissionReading: the caller of AvailableMB is the admission guard (memMayStart), not the running
+// probes' watchdog (memRunOK).
+func memAdmissionReading() bool {
+	pcs := make([]uintptr, 16)
+	frames := runtime.CallersFrames(pcs[:runtime.Callers(3, pcs)])
+	for {
+		fr, more := frames.Next()
+		if strings.HasSuffix(fr.Function, ".memMayStart") {
+			return true
+		}
+		if !more {
+			return false
+		}
+	}
+}
+
+// Review F4 (followup 2): on iOS an AmneziaWG session runs next to the single Xray leg instance (cap 1),
+// which closes in the background after its last leg. Admitting new work (memMayStart: an instance or a
+// session) must not measure while an instance is still closing - its memory is about to come back, so a
+// refusal then would be a false one: the admission waits for the close, then measures. The running
+// session's watchdog (memRunOK) keeps measuring during the close: a low reading then is real.
+// A1's session opens only once the leg instance is closing (active during the close); A2 is added from
+// inside the slow close, so its admission falls in it.
+func TestTribeScanMemoryGuardWaitsForClose(t *testing.T) {
+	e := newKitEnv(t)
+	e.srv.SetMode("slow_first_byte", false) // every sized body held 400 ms: A1 runs through the close
+	e.srv.Delay.Store(400)
+	defer func() { e.srv.Delay.Store(0); e.srv.SetMode("ok", false) }()
+	f := &fakeAwg{echoes: 1}
+	closing := make(chan struct{})
+	var closingOnce sync.Once
+	plat := e.plat
+	plat.MaxInstances = 1
+	plat.MaxAwg = 2
+	plat.Awg = func(ctx context.Context, job AwgJob) (AwgSession, error) {
+		if job.PeerKey == awgKey(1) {
+			select {
+			case <-closing:
+			case <-ctx.Done():
+			}
+		}
+		return f.Open(ctx, job)
+	}
+	plat.MemStartMinMB, plat.MemRunMinMB = 12, 8
+	var admissions, admissionsInClose, watchInClose atomic.Int64
+	var inClose atomic.Bool // inside the slow close
+	plat.AvailableMB = func() float64 {
+		admission := memAdmissionReading()
+		closing := inClose.Load()
+		switch {
+		case admission:
+			admissions.Add(1)
+			if closing {
+				admissionsInClose.Add(1)
+			}
+		case closing:
+			watchInClose.Add(1)
+		}
+		return 64
+	}
+	added := make(chan string, 1)
+	SetCloseInstanceHook(func() {
+		inClose.Store(true)
+		defer inClose.Store(false)
+		closingOnce.Do(func() {
+			close(closing) // A1's session opens now: it is active during the close
+			added <- Message(fmt.Sprintf(`{"action":"scan_add","scan_id":"s-mem-close","candidates":[%s]}`,
+				mustJSON(kitAwgCandidate("A2", 2, e.srv.Port))), "", plat)
+		})
+		time.Sleep(250 * time.Millisecond) // a slow close
+	})
+	defer SetCloseInstanceHook(nil)
+	var ack Ack
+	KitMessage(t, KitRequest("s-mem-close", e.srv.Base(), map[string]any{"leg_concurrency": 1, "awg_concurrency": 2,
+		"concurrency": 0}, 30000, KitLegCandidate("L1", VlessOutbound("p", e.vless), nil, nil), kitAwgCandidate("A1", 1, e.srv.Port)),
+		"", plat, &ack)
+	if ack.Type != "scan_ack" {
+		t.Fatalf("start: %+v", ack)
+	}
+	p := KitPollUntil(t, "s-mem-close", "three data items", 20*time.Second, func(p Progress) bool {
+		n := 0
+		for _, it := range p.Items {
+			if it.Stage == "data" {
+				n++
+			}
+		}
+		return n == 3 || p.Done && p.Reason != ReasonComplete
+	})
+	if raw := <-added; !strings.Contains(raw, `"accepted":1`) {
+		t.Fatalf("scan_add during the close: %s", raw)
+	}
+	for _, it := range p.Items {
+		if it.Stage == "data" && (it.Error != "" || !deref(it.ShaOK)) {
+			t.Fatalf("item %+v (final %+v)", it, p)
+		}
+	}
+	// The admissions (L1's instance, A1, A2) never measured inside the close; A1's watchdog did, and the
+	// scan ended normally all the same.
+	if p.Reason == ReasonMemory || admissionsInClose.Load() != 0 || admissions.Load() < 3 || watchInClose.Load() == 0 {
+		t.Fatalf("reason %q; admission readings %d, during the close %d; watchdog readings during the close %d",
+			p.Reason, admissions.Load(), admissionsInClose.Load(), watchInClose.Load())
+	}
+	t.Logf("admission readings %d (none during the close), watchdog readings during the close %d", admissions.Load(), watchInClose.Load())
+	if !StopAllWait(5 * time.Second) {
+		t.Fatal("stop")
+	}
+	assertNoInstances(t)
+}
diff --git a/tribescan/body.go b/tribescan/body.go
new file mode 100644
index 0000000..1c088e1
--- /dev/null
+++ b/tribescan/body.go
@@ -0,0 +1,86 @@
+package tribescan
+
+// Body scheme tribe-probe-v1 (api/openapi.yaml, GET /v1/probe):
+// block_i = SHA-256(ASCII("tribe-probe-v1") || 0x00 || ASCII(nonce) || 0x00 || uint32_be(i)),
+// body = the first N bytes of block_0 || block_1 || ... . The digest a probe trusts is the one
+// computed here for (nonce, N), never the X-Tribe-Probe-Sha256 header alone.
+
+import (
+	"crypto/sha256"
+	"encoding/binary"
+	"encoding/hex"
+	"hash"
+)
+
+// BodyScheme is the only body scheme this engine verifies.
+const BodyScheme = "tribe-probe-v1"
+
+type bodyGen struct {
+	prefix []byte
+	index  uint32
+	block  [sha256.Size]byte
+	off    int // bytes of block already consumed; sha256.Size = empty
+	h      hash.Hash
+}
+
+func newBodyGen(nonce string) *bodyGen {
+	prefix := make([]byte, 0, len(BodyScheme)+len(nonce)+2)
+	prefix = append(prefix, BodyScheme...)
+	prefix = append(prefix, 0)
+	prefix = append(prefix, nonce...)
+	prefix = append(prefix, 0)
+	return &bodyGen{prefix: prefix, off: sha256.Size, h: sha256.New()}
+}
+
+func (g *bodyGen) next() {
+	var be [4]byte
+	binary.BigEndian.PutUint32(be[:], g.index)
+	g.h.Reset()
+	g.h.Write(g.prefix)
+	g.h.Write(be[:])
+	g.h.Sum(g.block[:0])
+	g.index++
+	g.off = 0
+}
+
+// Read fills p with the next body bytes (never fails; the body is unbounded).
+func (g *bodyGen) Read(p []byte) (int, error) {
+	n := 0
+	for n < len(p) {
+		if g.off == sha256.Size {
+			g.next()
+		}
+		c := copy(p[n:], g.block[g.off:])
+		g.off += c
+		n += c
+	}
+	return n, nil
+}
+
+// Body returns the first n bytes of the tribe-probe-v1 body for nonce (empty for n <= 0).
+func Body(nonce string, n int) []byte {
+	if n <= 0 {
+		return []byte{}
+	}
+	out := make([]byte, n)
+	newBodyGen(nonce).Read(out)
+	return out
+}
+
+// ExpectedSHA256Hex is the lower-case hex SHA-256 of Body(nonce, n), computed in 16 KiB steps
+// without holding the body.
+func ExpectedSHA256Hex(nonce string, n int64) string {
+	h := sha256.New()
+	g := newBodyGen(nonce)
+	var buf [16 << 10]byte
+	for left := n; left > 0; {
+		k := int64(len(buf))
+		if left < k {
+			k = left
+		}
+		g.Read(buf[:k])
+		h.Write(buf[:k])
+		left -= k
+	}
+	return hex.EncodeToString(h.Sum(nil))
+}
diff --git a/tribescan/body_test.go b/tribescan/body_test.go
new file mode 100644
index 0000000..bd3e6ec
--- /dev/null
+++ b/tribescan/body_test.go
@@ -0,0 +1,104 @@
+package tribescan
+
+import (
+	"encoding/hex"
+	"fmt"
+	"testing"
+)
+
+// Vectors from the contract text (openapi /v1/probe, scheme tribe-probe-v1), checked against the
+// backend's own scan.probe_body (upstream-scan worktree, 15.11.2026) and an independent
+// hashlib implementation; the first four are also in the client's upstream_engine_check.cpp.
+var bodyVectors = []struct {
+	nonce  string
+	n      int64
+	head   string // hex of the first min(8, n) bytes
+	sha256 string
+}{
+	{"abcdefgh12345678", 40, "494b8d5157dd5161", "1a8a8ef14b12194c84e15ddd3a443bd99da626a2570b33222472313a5a6bd220"},
+	{"abcdefgh12345678", 1024, "494b8d5157dd5161", "5c86d6a852fa9f8d739c051e7afa15eeb6fb637bfe8f1de08e569bf7555b24e9"},
+	{"abcdefgh12345678", 1, "49", "a83dd0ccbffe39d071cc317ddf6e97f5c6b1c87af91919271f9fa140b0508c6c"},
+	{"Nonce.-_x", 131072, "a4063ea83684eada", "21eb1ab157da102fe50295581b954225b3a47ac95ec75a6393edc3f7c24dee6f"},
+	{"abcdefgh12345678", 65536, "494b8d5157dd5161", "218eae274d56c32fb88be7463a5015779ce741884c352354810a00c46a6ee2c4"},
+	{"zzzzzzzz", 33, "43944b6788fa7239", "d8d0336f3efb69b99396c90059bd4d0d81b0da55d58e433e5a3c8d4ba7cb6e9d"},
+	{"A1b2C3d4._-", 1048576, "40d73022054fde38", "6ab9b163ccf1d8d5521bea4f3e5f68a8d363292724f4248aad24539470ca18e0"},
+}
+
+func TestTribeScanBodyVectors(t *testing.T) {
+	for _, v := range bodyVectors {
+		body := Body(v.nonce, int(v.n))
+		if int64(len(body)) != v.n {
+			t.Fatalf("%s/%d: length %d", v.nonce, v.n, len(body))
+		}
+		k := min(8, len(body))
+		if got := hex.EncodeToString(body[:k]); got != v.head {
+			t.Errorf("%s/%d: head %s want %s", v.nonce, v.n, got, v.head)
+		}
+		if got := ExpectedSHA256Hex(v.nonce, v.n); got != v.sha256 {
+			t.Errorf("%s/%d: digest %s want %s", v.nonce, v.n, got, v.sha256)
+		}
+	}
+	if len(Body("x", 0)) != 0 || len(Body("x", 33)) != 33 {
+		t.Fatal("edge lengths")
+	}
+	// A prefix of a longer body is the shorter body (block boundaries do not matter).
+	long, short := Body("abcdefgh12345678", 100), Body("abcdefgh12345678", 63)
+	if string(long[:63]) != string(short) {
+		t.Fatal("prefix property")
+	}
+}
+
+func TestTribeScanRetrySpacing(t *testing.T) {
+	want := []int64{300, 600, 1200, 2000, 2000}
+	for i, w := range want {
+		if got := retryDelay(i + 1).Milliseconds(); got != w {
+			t.Fatalf("retry %d: %d ms want %d", i+1, got, w)
+		}
+	}
+}
+
+func TestTribeScanProbeURL(t *testing.T) {
+	u := probeURL("https://api.example.com/prefix/", "/v1/probe", "0123456789abcdef", 65536, "n0nce-xyz")
+	if u.String() != "https://api.example.com/prefix/v1/probe?bytes=65536&nonce=n0nce-xyz&profile_id=0123456789abcdef" {
+		t.Fatalf("probe url %s", u)
+	}
+	u = probeURL("https://api.example.com:8443", "/v1/probe", "", 1024, "n0nce-xyz")
+	if u.String() != "https://api.example.com:8443/v1/probe?bytes=1024&nonce=n0nce-xyz" {
+		t.Fatalf("probe url %s", u)
+	}
+}
+
+func TestTribeScanHostChecks(t *testing.T) {
+	base := `{"action":"scan_start","version":"tribe-scan-v1","scan_id":"s","deadline_ms":5000,"limits":{"stage1_sockets":1,
+"stage1_stagger_ms":0,"per_entry_ip":1,"entry_ip_spacing_ms":0,"stage1_timeout_ms":200,"concurrency":1,"ttfb_ms":500,
+"stall_ms":200,"stall_after_bytes":1024,"total_ms":1000},"probe":{"base":%q,"path":%q,"token":%q,"warm_bytes":1024,
+"bytes":1024},"candidates":[]}`
+	for name, c := range map[string][3]string{
+		"ok":         {"https://a.example", "/v1/probe", "tsc1.x"},
+		"userinfo":   {"https://u:p@a.example", "/v1/probe", "tsc1.x"},
+		"query":      {"https://a.example/?x=1", "/v1/probe", "tsc1.x"},
+		"token crlf": {"https://a.example", "/v1/probe", "tsc1.x\r\nX: y"},
+		"path query": {"https://a.example", "/v1/probe?x", "tsc1.x"},
+	} {
+		_, err := DecodeRequest([]byte(fmt.Sprintf(base, c[0], c[1], c[2])))
+		if (err == nil) != (name == "ok") {
+			t.Errorf("%s: %v", name, err)
+		}
+	}
+}
+
+func TestTribeScanNonce(t *testing.T) {
+	seen := map[string]bool{}
+	for i := 0; i < 1000; i++ {
+		n := newNonce()
+		if len(n) != 24 || seen[n] {
+			t.Fatalf("nonce %q", n)
+		}
+		for _, r := range n {
+			if !(r >= 'a' && r <= 'z' || r >= 'A' && r <= 'Z' || r >= '0' && r <= '9') {
+				t.Fatalf("nonce alphabet %q", n)
+			}
+		}
+		seen[n] = true
+	}
+}
diff --git a/tribescan/config.go b/tribescan/config.go
new file mode 100644
index 0000000..968414b
--- /dev/null
+++ b/tribescan/config.go
@@ -0,0 +1,201 @@
+package tribescan
+
+// The core config of one temporary probe instance.
+//
+// xray_full: the candidate's complete (already sanitized) profile with every inbound, the API,
+// stats and metrics sections removed: the probe stream is dialled straight into the instance's
+// dispatcher (core.Dial), carrying the removed tunnel inbound's tag so routing rules that match
+// on inboundTag choose the same outbound as for the tunnel. No listener, no port, no credential.
+// xray_leg: up to scan_leg_batch_legs candidates share one outbounds-only instance (no routing,
+// DNS or geo; legs.go); every probe stream is forced through its candidate's namespaced tag.
+//
+// Both: the log app is dropped from the built config. Xray's log handler is process-global
+// (app/log registers it on Start), so a probe instance with its own log app would take over the
+// tunnel's log handler and, on Close, leave the tunnel logging into a closed sink. Without it the
+// probe instance's few lines go to whatever handler the tunnel installed.
+
+import (
+	"bytes"
+	"encoding/json"
+	"errors"
+	"strings"
+
+	applog "github.com/xtls/xray-core/app/log"
+	cserial "github.com/xtls/xray-core/common/serial"
+	"github.com/xtls/xray-core/core"
+	confserial "github.com/xtls/xray-core/infra/conf/serial"
+)
+
+type probePlan struct {
+	cfg        *core.Config
+	inboundTag string // xray_full: tag of the removed tunnel inbound ("" = none)
+	forcedTag  string // xray_leg: outbound every probe stream is forced through
+}
+
+var droppedSections = []string{"inbounds", "api", "stats", "metrics", "log"}
+
+func decodeObject(raw json.RawMessage) (map[string]any, error) {
+	raw = bytes.TrimSpace(raw)
+	if len(raw) > 0 && raw[0] == '"' { // a config handed over as a JSON string
+		var s string
+		if err := json.Unmarshal(raw, &s); err != nil {
+			return nil, err
+		}
+		raw = []byte(s)
+	}
+	dec := json.NewDecoder(bytes.NewReader(raw))
+	dec.UseNumber() // keep every number exactly as the profile wrote it
+	var m map[string]any
+	if err := dec.Decode(&m); err != nil {
+		return nil, err
+	}
+	if m == nil {
+		return nil, errors.New("config is not an object")
+	}
+	return m, nil
+}
+
+func decodeArray(raw json.RawMessage) ([]any, error) {
+	raw = bytes.TrimSpace(raw)
+	if len(raw) > 0 && raw[0] == '"' {
+		var s string
+		if err := json.Unmarshal(raw, &s); err != nil {
+			return nil, err
+		}
+		raw = []byte(s)
+	}
+	dec := json.NewDecoder(bytes.NewReader(raw))
+	dec.UseNumber()
+	var a []any
+	if err := dec.Decode(&a); err != nil {
+		return nil, err
+	}
+	return a, nil
+}
+
+// lookup returns m[key] matching the key case-insensitively (Go's JSON decoding, which Xray uses,
+// matches field names that way too).
+func lookup(m map[string]any, key string) (string, any, bool) {
+	if v, ok := m[key]; ok {
+		return key, v, true
+	}
+	for k, v := range m {
+		if strings.EqualFold(k, key) {
+			return k, v, true
+		}
+	}
+	return "", nil, false
+}
+
+func deleteFold(m map[string]any, key string) {
+	for k := range m {
+		if strings.EqualFold(k, key) {
+			delete(m, k)
+		}
+	}
+}
+
+func stringField(m map[string]any, key string) string {
+	_, v, _ := lookup(m, key)
+	s, _ := v.(string)
+	return s
+}
+
+// sanitizeProcessState removes what would make a probe instance touch process or system state:
+// a WireGuard outbound's kernel TUN (Linux with CAP_NET_ADMIN creates an interface and routes) is
+// forced to the userspace stack, and a "quic+local" DNS server (dialled by quic-go on a raw socket,
+// past the probe's protector) is dropped.
+func sanitizeProcessState(m map[string]any) {
+	if _, obs, ok := lookup(m, "outbounds"); ok {
+		list, _ := obs.([]any)
+		for _, o := range list {
+			ob, _ := o.(map[string]any)
+			if ob == nil || !strings.EqualFold(stringField(ob, "protocol"), "wireguard") {
+				continue
+			}
+			settings, _ := ob["settings"].(map[string]any)
+			if settings == nil {
+				settings = map[string]any{}
+				ob["settings"] = settings
+			}
+			deleteFold(settings, "noKernelTun")
+			settings["noKernelTun"] = true
+		}
+	}
+	if _, d, ok := lookup(m, "dns"); ok {
+		dns, _ := d.(map[string]any)
+		if _, sv, ok := lookup(dns, "servers"); ok && dns != nil {
+			list, _ := sv.([]any)
+			kept := list[:0]
+			for _, x := range list {
+				addr := ""
+				switch v := x.(type) {
+				case string:
+					addr = v
+				case map[string]any:
+					addr = stringField(v, "address")
+				}
+				if strings.HasPrefix(strings.ToLower(addr), "quic+local://") {
+					continue
+				}
+				kept = append(kept, x)
+			}
+			deleteFold(dns, "servers")
+			dns["servers"] = kept
+		}
+	}
+}
+
+func loadCore(m map[string]any) (*core.Config, error) {
+	sanitizeLogging(m)
+	sanitizeProcessState(m)
+	raw, err := json.Marshal(m)
+	if err != nil {
+		return nil, err
+	}
+	cfg, err := confserial.LoadJSONConfig(bytes.NewReader(raw))
+	if err != nil {
+		return nil, err
+	}
+	logType := cserial.GetMessageType(&applog.Config{})
+	apps := cfg.App[:0]
+	for _, app := range cfg.App {
+		if app.Type != logType {
+			apps = append(apps, app)
+		}
+	}
+	cfg.App = apps
+	return cfg, nil
+}
+
+// buildFullPlan returns the instance config of an xray_full candidate (its config is the whole
+// sanitized profile as a JSON string), or ErrConfig.
+func buildFullPlan(c *Candidate) (*probePlan, string) {
+	m, err := decodeObject(json.RawMessage(c.Config))
+	if err != nil {
+		return nil, ErrConfig
+	}
+	plan := &probePlan{}
+	if _, v, ok := lookup(m, "inbounds"); ok {
+		if list, ok := v.([]any); ok {
+			for _, in := range list {
+				if ib, ok := in.(map[string]any); ok && stringField(ib, "tag") != "" {
+					plan.inboundTag = stringField(ib, "tag")
+					break
+				}
+			}
+		}
+	}
+	for _, k := range droppedSections {
+		deleteFold(m, k)
+	}
+	_, v, _ := lookup(m, "outbounds")
+	outbounds, _ := v.([]any)
+	if len(outbounds) == 0 {
+		return nil, ErrConfig
+	}
+	if plan.cfg, err = loadCore(m); err != nil {
+		return nil, ErrConfig
+	}
+	return plan, ""
+}
diff --git a/tribescan/direct.go b/tribescan/direct.go
new file mode 100644
index 0000000..8505799
--- /dev/null
+++ b/tribescan/direct.go
@@ -0,0 +1,212 @@
+package tribescan
+
+// The host's DIRECT access attempts (plan §2.2c, "proof by exclusion"): one HTTPS GET of
+// <probe.base><probe.netinfo_path> with the scan token on a socket that runs the probe protector
+// (bound to the physical interface / VpnService.protect), so it leaves through the ACCESS network, not
+// a tunnel. The opening attempt runs before the first probe, the closing one during the stop. Each is
+// admitted by the byte gate (netinfo_cost_bytes, ids netinfo_open / netinfo_close) and charged what
+// it used: 8192 for the TLS connection + the plaintext read, or 512 when TLS never came up.
+//
+// Only a failure AFTER packets left on the physical interface is an attempt (attempted, http_answered
+// false: refused, reset, timeout, TLS or HTTP failure). Everything that fails before that is NOT an
+// attempt (null on the wire, a log code), so it can never support the exclusion:
+//   - "dns": the probe host's name did not resolve. The name never goes through Xray's DNS: the
+//     system resolver answers it (darwin/iOS libSystem, Android netd, Windows GetAddrInfo, Linux
+//     /etc/resolv.conf), and with a tunnel up that resolver usually sits inside the tunnel - a DNS
+//     failure says nothing about the access network. probe.base_ips (or, without it, the host
+//     option probe_base_ips) are dialled instead of resolving, with the name as the TLS name;
+//   - "bind": the probe's own socket protection failed (interface binding, the host's protector);
+//   - "no_route": the bound interface has no route (ENETUNREACH, EHOSTUNREACH, EADDRNOTAVAIL,
+//     ENETDOWN at connect).
+// http_answered = an HTTP answer of any status; a 200 of our server also tells the access ASN and
+// net token.
+
+import (
+	"bufio"
+	"context"
+	"crypto/tls"
+	"encoding/json"
+	"errors"
+	"io"
+	"net"
+	"net/http"
+	"net/netip"
+	"strings"
+	"sync/atomic"
+	"syscall"
+	"time"
+
+	clog "github.com/xtls/xray-core/common/log"
+	xnet "github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/transport/internet"
+)
+
+// Test seams (set only by the test kit): directDialOverride is the address the attempt dials
+// instead of the probe host's ("" in production; the TLS name stays the probe host);
+// directResolve replaces the system resolver.
+var (
+	directDialOverride atomic.Pointer[string]
+	directResolve      atomic.Pointer[func(ctx context.Context, host string) ([]netip.Addr, error)]
+)
+
+type directResult struct {
+	notAttempted string // "", "dns", "bind", "no_route"
+	answered     bool
+	asn          int64
+	netToken     string
+	used         int64
+}
+
+type countingReader struct {
+	r io.Reader
+	n int64
+}
+
+func (c *countingReader) Read(p []byte) (int, error) {
+	n, err := c.r.Read(p)
+	c.n += int64(n)
+	return n, err
+}
+
+// directAddrs are the addresses an attempt dials: an IP literal host, the supplied base IPs, or
+// the system resolver's answer.
+func (s *Scan) directAddrs(ctx context.Context) ([]netip.Addr, bool) {
+	if ip, err := netip.ParseAddr(strings.Trim(s.host, "[]")); err == nil {
+		return []netip.Addr{ip}, true
+	}
+	// One source: the contract's probe.base_ips; the host option probe_base_ips only without it.
+	list := s.req.BaseIPs
+	if len(list) == 0 {
+		list = s.opts.ProbeBaseIPs
+	}
+	var out []netip.Addr
+	for _, a := range list {
+		if ip, err := netip.ParseAddr(a); err == nil {
+			out = append(out, ip.Unmap())
+		}
+	}
+	if len(out) > 0 {
+		return out, true
+	}
+	resolve := func(ctx context.Context, host string) ([]netip.Addr, error) {
+		return net.DefaultResolver.LookupNetIP(ctx, "ip", host)
+	}
+	if f := directResolve.Load(); f != nil {
+		resolve = *f
+	}
+	ips, err := resolve(ctx, s.host)
+	if err != nil || len(ips) == 0 {
+		return nil, false
+	}
+	for _, ip := range ips {
+		out = append(out, ip.Unmap())
+	}
+	return out, true
+}
+
+func noRoute(err error) bool {
+	for _, e := range []error{syscall.ENETUNREACH, syscall.EHOSTUNREACH, syscall.EADDRNOTAVAIL, syscall.ENETDOWN} {
+		if errors.Is(err, e) {
+			return true
+		}
+	}
+	return false
+}
+
+func (s *Scan) directCheck(timeout time.Duration) (res directResult) {
+	res.used = reachOverhead
+	defer func() {
+		if r := recover(); r != nil {
+			s.panics.Add(1)
+		}
+	}()
+	// The scan's life context (the closing attempt runs after a cancel stopped the probes; a
+	// teardown cancels it too), with the probe protector and the probe log scope.
+	liveWork.access.Add(1)
+	defer liveWork.access.Add(-1)
+	base := clog.ContextWithScope(internet.ContextWithSocketProtector(s.life, s.protectSocket), scopeHandler{})
+	ctx, cancel := context.WithTimeout(base, timeout)
+	defer cancel()
+	var dests []xnet.Destination
+	if o := directDialOverride.Load(); o != nil && *o != "" {
+		if d, err := xnet.ParseDestination("tcp:" + *o); err == nil {
+			dests = append(dests, d)
+		}
+	}
+	if len(dests) == 0 {
+		addrs, ok := s.directAddrs(ctx)
+		if !ok {
+			res.notAttempted = "dns"
+			return res
+		}
+		for _, a := range addrs {
+			dests = append(dests, xnet.TCPDestination(xnet.IPAddress(a.AsSlice()), xnet.Port(s.port)))
+		}
+	}
+	var conn net.Conn
+	sent := false
+	why := "no_route"
+	for _, dest := range dests {
+		binds := s.bindFailures.Load()
+		c, err := internet.DialSystem(ctx, dest, nil)
+		if err == nil {
+			conn, sent = c, true
+			break
+		}
+		switch {
+		case s.bindFailures.Load() != binds:
+			why = "bind"
+		case noRoute(err):
+		default:
+			sent = true // a SYN left: refused, reset or timed out on the access network
+		}
+		if ctx.Err() != nil {
+			break
+		}
+	}
+	if conn == nil {
+		if !sent {
+			res.notAttempted = why
+		}
+		return res
+	}
+	defer conn.Close()
+	stop := context.AfterFunc(ctx, func() { conn.Close() })
+	defer stop()
+	tc := tls.Client(conn, &tls.Config{ServerName: s.host, NextProtos: []string{"http/1.1"},
+		MinVersion: tls.VersionTLS12, RootCAs: s.plat.RootCAs})
+	if err := tc.HandshakeContext(ctx); err != nil {
+		return res // no HTTP answer
+	}
+	cr := &countingReader{r: tc}
+	defer func() { res.used = tlsOverhead + cr.n }()
+	u := probeURL(s.req.ProbeBase, s.req.NetinfoPath, "", 0, "x")
+	var b strings.Builder
+	b.WriteString("GET " + u.Path + " HTTP/1.1\r\nHost: " + u.Host + "\r\nAuthorization: Bearer " + s.req.Token +
+		"\r\nAccept: application/json\r\nAccept-Encoding: identity\r\nUser-Agent: TribeScan/1\r\nConnection: close\r\n\r\n")
+	if _, err := io.WriteString(tc, b.String()); err != nil {
+		return res
+	}
+	resp, err := http.ReadResponse(bufio.NewReader(cr), nil)
+	if err != nil {
+		return res
+	}
+	defer resp.Body.Close()
+	res.answered = true
+	body, _ := io.ReadAll(io.LimitReader(resp.Body, 4096))
+	if resp.StatusCode == http.StatusOK && resp.Header.Get("X-Tribe-Api") == "1" {
+		var info struct {
+			Asn      *int64  `json:"asn"`
+			NetToken *string `json:"net_token"`
+		}
+		if json.Unmarshal(body, &info) == nil {
+			if info.Asn != nil && *info.Asn > 0 && *info.Asn <= 4294967295 {
+				res.asn = *info.Asn
+			}
+			if info.NetToken != nil && len(*info.NetToken) <= 64 {
+				res.netToken = *info.NetToken
+			}
+		}
+	}
+	return res
+}
diff --git a/tribescan/direct_test.go b/tribescan/direct_test.go
new file mode 100644
index 0000000..1b4a032
--- /dev/null
+++ b/tribescan/direct_test.go
@@ -0,0 +1,143 @@
+//go:build tribescan_testkit
+
+package tribescan
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"net"
+	"net/netip"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+)
+
+// The direct access attempts count only what left on the physical interface (plan §2.2c): a DNS
+// failure, a failed binding and no route on the bound interface are NOT attempts (null on the wire,
+// a log code) and can never support the proof by exclusion; a refusal, a reset or a timeout after
+// the connect are attempts without an HTTP answer.
+func TestTribeScanDirectAttemptClasses(t *testing.T) {
+	e := newKitEnv(t)
+	brokenDNS := func(context.Context, string) ([]netip.Addr, error) {
+		return nil, errors.New("resolver inside a dead tunnel")
+	}
+	defer SetDirectResolve(nil)
+	defer SetDirectAddr(fmt.Sprintf("127.0.0.1:%d", e.srv.Port))
+	var mu sync.Mutex
+	var lines []string
+	plat := e.plat
+	plat.Log = func(l string) bool { mu.Lock(); lines = append(lines, l); mu.Unlock(); return true }
+	logged := func(code string) bool {
+		mu.Lock()
+		defer mu.Unlock()
+		n := 0
+		for _, l := range lines {
+			if strings.Contains(l, "attempted=false code="+code) {
+				n++
+			}
+		}
+		return n == 2 // opening and closing
+	}
+	withBaseIPs := func(req string, ips ...string) string {
+		var m map[string]any
+		json.Unmarshal([]byte(req), &m)
+		m["probe"].(map[string]any)["base_ips"] = ips
+		raw, _ := json.Marshal(m)
+		return string(raw)
+	}
+	scan := func(id, req, opts string, p Platform) Progress {
+		t.Helper()
+		r := KitRun(t, req, opts, p, 20*time.Second)
+		if r.Ack.Type != "scan_ack" {
+			t.Fatalf("%s: %+v", id, r.Err)
+		}
+		_, _, fin := KitStop(t, id, 5*time.Second)
+		return fin
+	}
+	req := func(id string) string {
+		return KitRequest(id, e.srv.Base(), nil, 15000, KitFullCandidate("a", e.vless))
+	}
+
+	SetDirectAddr("")
+	SetDirectResolve(brokenDNS)
+	t.Run("resolver broken, addresses supplied: attempted and answered", func(t *testing.T) {
+		for i, v := range []struct{ req, opts string }{
+			{withBaseIPs(req("d-ips-probe"), "127.0.0.1"), ""},
+			{req("d-ips-host"), `{"probe_base_ips":["127.0.0.1"]}`},
+		} {
+			id := []string{"d-ips-probe", "d-ips-host"}[i]
+			fin := scan(id, v.req, v.opts, plat)
+			for _, a := range []*Attempt{fin.Access, fin.AccessClose} {
+				if a == nil || !a.HTTPAnswered || deref(a.Asn) != 12389 {
+					t.Fatalf("%s: attempts %+v %+v", id, fin.Access, fin.AccessClose)
+				}
+			}
+		}
+	})
+	t.Run("resolver broken, no address: not attempted", func(t *testing.T) {
+		fin := scan("d-dns", req("d-dns"), "", plat)
+		d, _ := (&KitResult{Items: fin.Items}).DataByID("a")
+		if fin.Access != nil || fin.AccessClose != nil || !logged("dns") {
+			t.Fatalf("attempts %+v %+v lines %v", fin.Access, fin.AccessClose, lines)
+		}
+		// Nothing was charged for them: the total is the probe's alone.
+		if fin.BytesSpent != deref(d.SpentBytes) || d.Error != "" {
+			t.Fatalf("spent %d, probe %+v", fin.BytesSpent, d)
+		}
+		raw, _ := json.Marshal(fin)
+		if !strings.Contains(string(raw), `"access":null,"access_close":null`) {
+			t.Fatalf("wire %s", raw)
+		}
+	})
+	SetDirectResolve(nil)
+	t.Run("binding failed: not attempted", func(t *testing.T) {
+		SetDirectAddr(fmt.Sprintf("127.0.0.1:%d", e.srv.Port))
+		p := plat
+		p.Protect = func(string, string, uintptr) error { return errors.New("bind failed (test)") }
+		fin := scan("d-bind", req("d-bind"), "", p)
+		if fin.Access != nil || fin.AccessClose != nil || !logged("bind") {
+			t.Fatalf("attempts %+v %+v", fin.Access, fin.AccessClose)
+		}
+	})
+	t.Run("no route on the bound interface: not attempted", func(t *testing.T) {
+		en0, err := net.InterfaceByName("en0")
+		if err != nil {
+			t.Skip("no en0")
+		}
+		// Loopback bound to the uplink: the kernel refuses at connect (EADDRNOTAVAIL), nothing leaves.
+		SetDirectAddr(fmt.Sprintf("127.0.0.1:%d", e.srv.Port))
+		fin := scan("d-route", KitRequest("d-route", e.srv.Base(), nil, 15000), fmt.Sprintf(`{"bind_interface_index":%d}`, en0.Index), plat)
+		if fin.Access != nil || fin.AccessClose != nil || !logged("no_route") {
+			t.Fatalf("attempts %+v %+v", fin.Access, fin.AccessClose)
+		}
+	})
+	t.Run("refused or silent after the connect: attempted, not answered", func(t *testing.T) {
+		SetDirectAddr(fmt.Sprintf("127.0.0.1:%d", FreePort(t))) // RST
+		fin := scan("d-rst", KitRequest("d-rst", e.srv.Base(), nil, 15000), "", plat)
+		if a := fin.Access; a == nil || !a.Attempted || a.HTTPAnswered || fin.AccessClose == nil || fin.AccessClose.HTTPAnswered {
+			t.Fatalf("refused: %+v %+v", fin.Access, fin.AccessClose)
+		}
+		ln, err := net.Listen("tcp4", "127.0.0.1:0") // accepts, never speaks TLS
+		if err != nil {
+			t.Fatal(err)
+		}
+		defer ln.Close()
+		go func() {
+			for {
+				c, err := ln.Accept()
+				if err != nil {
+					return
+				}
+				defer c.Close()
+			}
+		}()
+		SetDirectAddr(ln.Addr().String())
+		fin = scan("d-silent", KitRequest("d-silent", e.srv.Base(), map[string]any{"stage1_timeout_ms": 300}, 15000), "", plat)
+		if a := fin.Access; a == nil || !a.Attempted || a.HTTPAnswered {
+			t.Fatalf("silent: %+v", fin.Access)
+		}
+	})
+}
diff --git a/tribescan/dns.go b/tribescan/dns.go
new file mode 100644
index 0000000..b968f79
--- /dev/null
+++ b/tribescan/dns.go
@@ -0,0 +1,199 @@
+package tribescan
+
+// DNS-plan exercise of a leg: one query (A record of the probe host's NAME) to each resolver the
+// profile reaches through this leg, sent through the leg itself (forced tag + core.Dial), so the
+// caller can tell whether the leg's data result is a profile verdict (plan §2.2 "DNS plan").
+
+import (
+	"bufio"
+	"bytes"
+	"context"
+	"crypto/rand"
+	"crypto/tls"
+	"encoding/binary"
+	"errors"
+	"io"
+	"net/http"
+	"strconv"
+	"strings"
+	"sync"
+	"time"
+
+	xnet "github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/common/session"
+	"github.com/xtls/xray-core/core"
+)
+
+const dnsMaxAnswer = 64 << 10
+
+// dnsQuery builds a standard recursive query for name / A.
+func dnsQuery(name string) ([]byte, uint16, error) {
+	var idb [2]byte
+	if _, err := rand.Read(idb[:]); err != nil {
+		return nil, 0, err
+	}
+	id := binary.BigEndian.Uint16(idb[:])
+	var b bytes.Buffer
+	b.Write(idb[:])
+	b.Write([]byte{0x01, 0x00, 0, 1, 0, 0, 0, 0, 0, 0}) // RD; QDCOUNT 1
+	for _, label := range strings.Split(strings.TrimSuffix(name, "."), ".") {
+		if len(label) == 0 || len(label) > 63 {
+			return nil, 0, errors.New("bad name")
+		}
+		b.WriteByte(byte(len(label)))
+		b.WriteString(label)
+	}
+	b.Write([]byte{0, 0, 1, 0, 1}) // root, QTYPE A, QCLASS IN
+	return b.Bytes(), id, nil
+}
+
+// dnsParse checks an answer against our query id; returns rcode and the answer count.
+func dnsParse(msg []byte, id uint16) (rcode, answers int, ok bool) {
+	if len(msg) < 12 || binary.BigEndian.Uint16(msg[:2]) != id || msg[2]&0x80 == 0 {
+		return 0, 0, false
+	}
+	return int(msg[3] & 0x0f), int(binary.BigEndian.Uint16(msg[6:8])), true
+}
+
+func (s *Scan) exerciseDNS(inst *core.Instance, targets []dnsTarget, timeout time.Duration) []DNSResult {
+	out := make([]DNSResult, len(targets))
+	var wg sync.WaitGroup
+	for i, t := range targets {
+		out[i] = DNSResult{Address: t.address, Transport: t.transport, Ms: -1, Error: t.skip}
+		if t.skip != "" {
+			continue
+		}
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			defer func() {
+				if r := recover(); r != nil {
+					s.panics.Add(1)
+					out[i].OK, out[i].Error = false, ErrInternal
+				}
+			}()
+			s.queryOne(inst, t, timeout, &out[i])
+		}()
+	}
+	wg.Wait()
+	return out
+}
+
+func (s *Scan) queryOne(inst *core.Instance, t dnsTarget, timeout time.Duration, res *DNSResult) {
+	ctx, cancel := context.WithTimeout(s.pctx, timeout)
+	defer cancel()
+	msg, id, err := dnsQuery(s.host)
+	if err != nil {
+		res.Error = "no_name"
+		return
+	}
+	dctx := session.SetForcedOutboundTagToContext(ctx, t.forced)
+	dest := xnet.TCPDestination(xnet.ParseAddress(t.host), xnet.Port(t.port))
+	if t.transport == "udp" {
+		dest = xnet.UDPDestination(xnet.ParseAddress(t.host), xnet.Port(t.port))
+	}
+	t0 := time.Now()
+	conn, err := core.Dial(dctx, inst, dest)
+	if err != nil {
+		res.Error = ErrConfig
+		return
+	}
+	var closeOnce sync.Once
+	closeConn := func() { closeOnce.Do(func() { conn.Close() }) }
+	defer closeConn()
+	stop := context.AfterFunc(ctx, closeConn) // the cnc connection ignores deadlines
+	defer stop()
+
+	var answer []byte
+	switch t.transport {
+	case "udp":
+		if _, err = conn.Write(msg); err == nil {
+			buf := make([]byte, 4096)
+			var n int
+			n, err = conn.Read(buf)
+			answer = buf[:n]
+		}
+	case "tcp":
+		framed := binary.BigEndian.AppendUint16(nil, uint16(len(msg)))
+		if _, err = conn.Write(append(framed, msg...)); err == nil {
+			answer, err = readFramed(conn)
+		}
+	case "doh", "h2c":
+		var rw io.ReadWriter = conn
+		if t.transport == "doh" {
+			tc := tls.Client(conn, &tls.Config{ServerName: t.host, NextProtos: []string{"http/1.1"},
+				MinVersion: tls.VersionTLS12, RootCAs: s.plat.RootCAs})
+			if err = tc.Handshake(); err != nil {
+				if isTLSAnswer(err) {
+					res.Error = ErrTLS
+					return
+				}
+				res.Error = dnsStopOr(s, ctx, "no_answer")
+				return
+			}
+			rw = tc
+		}
+		answer, err = dohExchange(rw, t, msg, res)
+		if res.Error != "" {
+			return
+		}
+	}
+	if err != nil {
+		res.Error = dnsStopOr(s, ctx, "no_answer")
+		return
+	}
+	rcode, answers, ok := dnsParse(answer, id)
+	if !ok {
+		res.Error = "bad_answer"
+		return
+	}
+	res.OK, res.Rcode, res.Answers, res.Ms = true, rcode, answers, time.Since(t0).Milliseconds()
+}
+
+func dnsStopOr(s *Scan, ctx context.Context, fallback string) string {
+	if s.ctx.Err() != nil {
+		return s.stopCode()
+	}
+	if ctx.Err() != nil {
+		return "timeout"
+	}
+	return fallback
+}
+
+func readFramed(r io.Reader) ([]byte, error) {
+	var hdr [2]byte
+	if _, err := io.ReadFull(r, hdr[:]); err != nil {
+		return nil, err
+	}
+	buf := make([]byte, binary.BigEndian.Uint16(hdr[:]))
+	_, err := io.ReadFull(r, buf)
+	return buf, err
+}
+
+// dohExchange: RFC 8484 POST over HTTP/1.1 on an established (TLS for doh) connection.
+func dohExchange(rw io.ReadWriter, t dnsTarget, msg []byte, res *DNSResult) ([]byte, error) {
+	host := t.host
+	if (t.transport == "doh" && t.port != 443) || (t.transport == "h2c" && t.port != 80) {
+		host += ":" + strconv.Itoa(t.port)
+	}
+	var b strings.Builder
+	b.WriteString("POST " + t.path + " HTTP/1.1\r\nHost: " + host +
+		"\r\nContent-Type: application/dns-message\r\nAccept: application/dns-message\r\nContent-Length: " +
+		strconv.Itoa(len(msg)) + "\r\nUser-Agent: TribeScan/1\r\n\r\n")
+	if _, err := io.WriteString(rw, b.String()); err != nil {
+		return nil, err
+	}
+	if _, err := rw.Write(msg); err != nil {
+		return nil, err
+	}
+	resp, err := http.ReadResponse(bufio.NewReader(rw), nil)
+	if err != nil {
+		return nil, err
+	}
+	defer resp.Body.Close()
+	if resp.StatusCode != http.StatusOK {
+		res.Error = "http_" + strconv.Itoa(resp.StatusCode)
+		return nil, nil
+	}
+	return io.ReadAll(io.LimitReader(resp.Body, dnsMaxAnswer))
+}
diff --git a/tribescan/engine.go b/tribescan/engine.go
new file mode 100644
index 0000000..57b9192
--- /dev/null
+++ b/tribescan/engine.go
@@ -0,0 +1,1248 @@
+// Package tribescan is the probe engine of the Tribe VPN Scanner: the host side of the app's
+// tribe-scan-v1 contract (ScanHostContract.h, wire.go).
+//
+// Next to a running tunnel it starts SEPARATE temporary Xray core instances (one per xray_full
+// probe; one shared outbounds-only instance per batch of xray_leg probes), dials our API through
+// them with core.Dial (no inbound, no listening port, no credential), does HTTPS with Go's
+// crypto/tls (the host needs no TLS stack of its own), downloads two tribe-probe-v1 bodies on one
+// connection, verifies the second locally, measures the timings, reads the egress headers, and
+// closes the instance.
+//
+// It never calls libXray's RunXray/InitEnv, never touches a host's tunnel instance, registers no
+// log handler (config.go), enables no stats and installs no dialer controller. Socket protection is
+// the probe's OWN (core patch 0011, ContextWithSocketProtector): every socket of a probe instance,
+// and every reach dial, runs only the scan's protector - the interface binding the host asked for
+// (host_options.bind_interface[_index]) and/or the host's Platform.Protect hook - and never the
+// process-wide controllers, so it never reaches the tunnel's protect callback (on iOS that
+// callback's failure handler cancels the tunnel). A failed probe protection is the probe's error
+// "bind_failed". Every goroutine it starts recovers a panic. It logs nothing.
+package tribescan
+
+import (
+	"context"
+	"crypto/rand"
+	"crypto/x509"
+	"encoding/json"
+	"errors"
+	"math"
+	"net"
+	"net/netip"
+	"net/url"
+	"runtime/debug"
+	"strconv"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"syscall"
+	"time"
+
+	clog "github.com/xtls/xray-core/common/log"
+	xnet "github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/core"
+	"github.com/xtls/xray-core/transport/internet"
+	// Every protocol and transport a profile may name (every host links the same set already).
+	_ "github.com/xtls/xray-core/main/distro/all"
+)
+
+// Platform is what the host wrapper (NE export, service export, Android, test) provides.
+type Platform struct {
+	Name string // scan_caps.platform
+	// Pools (scan_caps max_*_concurrent); 0 = the kind is not offered.
+	MaxFull, MaxLeg, MaxAwg int
+	// MaxInstances caps the probe core instances alive at once (a leg batch is one). 0 = no cap.
+	MaxInstances       int
+	MaxLegsPerInstance int // default 24
+	CanVerifyComposite bool
+	NeedsVPN           bool
+	// RequireBindInterface: scan_start is refused (bad_request) without an interface to bind to.
+	RequireBindInterface bool
+	// RequireProtection: scan_start is refused (no_vpn) unless the probe sockets have a protection
+	// (an interface to bind to, or Protect). iOS / Android: a probe socket must never enter the VPN.
+	RequireProtection bool
+	// Protect is the host's own protection for PROBE sockets (Android: VpnService.protect through a
+	// dedicated probe protector). It runs instead of the process-wide controllers, so it must never
+	// call the tunnel's failure handler: a false/error result fails that probe only (bind_failed).
+	// ProtectArmed reports whether Protect can be called now (nil = always).
+	Protect      func(network, address string, fd uintptr) error
+	ProtectArmed func() bool
+	// Awg is the host's AmneziaWG runner (awg_mini; nil = the kind is not offered), MaxAwg its pool.
+	Awg AwgOpener
+	// AvailableMB: memory the process may still use (iOS os_proc_available_memory). nil = no guard.
+	AvailableMB func() float64
+	// FootprintMB: the process's footprint for mem_mb. nil = null.
+	FootprintMB          func() float64
+	FreeOSMemoryAfterJob bool
+	MemStartMinMB        float64
+	MemRunMinMB          float64
+	// Test seams (nil in production): RootCAs replaces the system roots; JobHook runs inside every
+	// data job once its instance is up.
+	RootCAs *x509.CertPool
+	JobHook func(candidateID string)
+	// Log takes the one redacted line a finished probe leaves (ids, error code, timings, bytes);
+	// false or nil: the line goes to the process Xray log at Info.
+	Log func(line string) bool
+}
+
+// HostOptions are set by the platform wrapper, never by the app.
+type HostOptions struct {
+	BindInterface      string  `json:"bind_interface"`       // name (Linux / desktop), e.g. "en0"
+	BindInterfaceIndex int     `json:"bind_interface_index"` // index (Apple, Windows); wins over the name
+	MemStartMinMB      float64 `json:"mem_start_min_mb"`
+	MemRunMinMB        float64 `json:"mem_run_min_mb"`
+	// awg_live_peer {"public_key": hex|base64, "endpoint": "ip:port"}: the live AmneziaWG tunnel's
+	// peer; an awg_mini candidate for that node is refused (config).
+	AwgLivePeerRaw json.RawMessage `json:"awg_live_peer"`
+	AwgLivePeer    *livePeer       `json:"-"`
+	// probe_base_ips: IP literals of probe.base's host the host resolved itself; a FALLBACK for the
+	// direct access attempts when scan_start has no probe.base_ips (that one always wins).
+	ProbeBaseIPs []string `json:"probe_base_ips"`
+}
+
+func parseHostOptions(raw string) (HostOptions, bool) {
+	var o HostOptions
+	if s := strings.TrimSpace(raw); s != "" && s != "null" {
+		if json.Unmarshal([]byte(s), &o) != nil {
+			return o, false
+		}
+	}
+	lp, ok := parseLivePeer(o.AwgLivePeerRaw)
+	if !ok {
+		return o, false
+	}
+	o.AwgLivePeer = lp
+	if len(o.ProbeBaseIPs) > 8 {
+		return o, false
+	}
+	for _, a := range o.ProbeBaseIPs {
+		if _, err := netip.ParseAddr(a); err != nil {
+			return o, false
+		}
+	}
+	if o.BindInterface != "" && (len(o.BindInterface) > 15 || !headerSafe(o.BindInterface)) {
+		return o, false
+	}
+	if o.BindInterfaceIndex < 0 {
+		return o, false
+	}
+	return o, true
+}
+
+// Early-refusal retry (lab D3; the app's decideUpstreamEarlyRetry): a probe whose attempt got
+// nothing back waits 300, 600, 1200, then 2000 ms and tries again on the same instance while at
+// least 1 s of its budget is left after the wait. Only for candidates with early_retry.
+const (
+	retryBaseMs = 300
+	retryCapMs  = 2000
+	retryMinMs  = 1000
+)
+
+func retryDelay(retry int) time.Duration {
+	retry = max(1, min(16, retry))
+	return time.Duration(min(int64(retryBaseMs)<<(retry-1), retryCapMs)) * time.Millisecond
+}
+
+var liveInstances atomic.Int64
+
+// LiveInstances is the number of probe core instances alive right now (all scans).
+func LiveInstances() int64 { return liveInstances.Load() }
+
+type stopError struct{ reason string }
+
+func (e stopError) Error() string { return "scan stopped: " + e.reason }
+
+const (
+	stQueued = iota
+	stReaching
+	stReady
+	stRunning
+	stFinal
+)
+
+type entry struct {
+	c         *Candidate
+	st        int
+	batch     *batch
+	index     int    // 1-based position in the scan (the log line's id when the id is unsafe)
+	ran       bool   // a reach or data job started (only those leave a log line)
+	reachMs   *int64 // the reach stage's result, for the log line
+	reachCode string
+	awg       *awgPlan // awg_mini: the parsed session (at dispatch)
+}
+
+// batch is one shared leg instance and its members.
+type batch struct {
+	members   []*Candidate
+	open      int // members without a final item
+	slot      bool
+	once      sync.Once
+	ready     chan struct{}
+	inst      *core.Instance
+	plan      *legBatch
+	failCode  string
+	closeOnce sync.Once
+}
+
+// Scan is one scan.
+type Scan struct {
+	req  *StartRequest
+	opts HostOptions
+	plat Platform
+
+	host     string
+	port     int
+	pools    map[string]int
+	instCap  int
+	memStart float64
+	memRun   float64
+	started  time.Time
+	deadline time.Time
+
+	ctx          context.Context // the probes: cancelled by every stop (cancel, deadline, teardown)
+	cancel       context.CancelCauseFunc
+	life         context.Context    // everything else of the scan (the access attempts): cancelled only
+	lifeCancel   context.CancelFunc // by a teardown (StopAll, a replacing scan_start)
+	closers      sync.WaitGroup     // leg instances closing in the background (drain waits for them)
+	pctx         context.Context    // ctx + the probe socket protector: every probe dial and instance
+	drained      chan struct{}      // closed once no probe runs any more (the cancel ack waits for it)
+	stopped      chan struct{}      // closed after the closing access check and the final state
+	wake         chan struct{}
+	panics       atomic.Int64
+	bindFailures atomic.Int64
+
+	mu              sync.Mutex
+	entries         []*entry
+	items           []Item
+	notify          chan struct{}
+	running         map[string]int
+	instances       int
+	reachInflight   int
+	ipInflight      map[string]int
+	lastOpen        map[string]time.Time
+	lastReachLaunch time.Time
+	lastAwgLaunch   time.Time       // awg_mini initiations at least awg_spacing_ms apart
+	awgNodes        map[string]bool // nodes (peer keys) with a session in this scan: one each
+	gate            *ByteGate       // the one shared byte cap (review F6); frozen by scan_freeze
+	openAdmitted    bool            // the opening access attempt's reservation (netinfo_open)
+	closeAdmitted   bool            // the closing attempt's, held from the start (netinfo_close)
+	opening         *Attempt
+	closing         *Attempt
+	gen             *Gen // the host's path monitor, from the latest message's host options
+	final           bool // the scan is over: nothing in flight or reserved, bytes_spent is final
+	done            bool
+	closed          bool // past the deadline or stopped: scan_add accepts nothing
+	reason          string
+	stopReason      string
+	redactRelease   []func() // the queued candidates' log redaction terms (privacy.go)
+
+	hostEpoch   *int64       // the host_epoch of its scan_start (nil = none): which stops end it
+	instClosing atomic.Int64 // instances of this scan closing now (closeInstance)
+	memWaitFrom time.Time    // admission waits for a close since (memAdmitLocked)
+}
+
+func newScan(req *StartRequest, opts HostOptions, plat Platform) *Scan {
+	base, _ := url.Parse(req.ProbeBase)
+	port := 443
+	if p := base.Port(); p != "" {
+		port, _ = strconv.Atoi(p)
+	}
+	if plat.MaxLegsPerInstance <= 0 {
+		plat.MaxLegsPerInstance = 24
+	}
+	s := &Scan{
+		req: req, opts: opts, plat: plat, host: base.Hostname(), port: port,
+		pools: map[string]int{
+			KindXrayFull: min(req.Limits.Concurrency, plat.MaxFull),
+			KindXrayLeg:  min(req.Limits.LegConcurrency, plat.MaxLeg),
+			KindAwgMini:  0, // only with the host's AmneziaWG runner (Platform.Awg)
+		},
+		instCap: plat.MaxInstances, memStart: plat.MemStartMinMB, memRun: plat.MemRunMinMB,
+		started: time.Now(), stopped: make(chan struct{}), drained: make(chan struct{}), wake: make(chan struct{}, 1),
+		notify: make(chan struct{}), running: map[string]int{}, ipInflight: map[string]int{},
+		lastOpen: map[string]time.Time{}, gate: NewByteGate(req.MaxBytes), awgNodes: map[string]bool{},
+	}
+	if plat.Awg != nil {
+		s.pools[KindAwgMini] = min(req.Limits.AwgConcurrency, plat.MaxAwg)
+	}
+	if opts.MemStartMinMB > 0 {
+		s.memStart = opts.MemStartMinMB
+	}
+	if opts.MemRunMinMB > 0 {
+		s.memRun = opts.MemRunMinMB
+	}
+	s.deadline = s.started.Add(time.Duration(req.DeadlineMs) * time.Millisecond)
+	// Access attempts (plan §2.2c): the opening one is admitted first, the closing one's
+	// reservation is held from the start, so a frozen scan can still make it.
+	s.openAdmitted = s.gate.Admit(netinfoOpenID, int64(req.Limits.NetinfoCostBytes))
+	s.closeAdmitted = s.gate.Admit(netinfoCloseID, int64(req.Limits.NetinfoCostBytes))
+	s.ctx, s.cancel = context.WithCancelCause(context.Background())
+	s.life, s.lifeCancel = context.WithCancel(context.Background())
+	// Every probe instance and dial: the probe's own socket protector and log scope (core 0011).
+	s.pctx = clog.ContextWithScope(internet.ContextWithSocketProtector(s.ctx, s.protectSocket), scopeHandler{})
+	s.enqueueLocked(req.Candidates)
+	return s
+}
+
+func (o HostOptions) binds() bool { return o.BindInterfaceIndex > 0 || o.BindInterface != "" }
+
+// protectSocket is the only controller of every probe socket (core 0011): the interface binding
+// the host asked for, then the host's probe Protect hook. Its failure fails this socket's dial.
+func (s *Scan) protectSocket(network, address string, c syscall.RawConn) error {
+	var perr error
+	err := c.Control(func(fd uintptr) { perr = s.protectFd(network, address, fd, 0) })
+	if err == nil {
+		err = perr
+	}
+	if err != nil {
+		if perr == nil {
+			s.bindFailures.Add(1)
+		}
+		return errors.New("probe socket protection failed")
+	}
+	return nil
+}
+
+// protectFd binds one probe socket (index > 0 overrides the host options' interface, e.g. an
+// awg_mini candidate's bound_if) and runs the host's probe Protect hook. Counts its failures.
+func (s *Scan) protectFd(network, address string, fd uintptr, index int) error {
+	err := func() error {
+		name := ""
+		if index <= 0 {
+			index, name = s.opts.BindInterfaceIndex, s.opts.BindInterface
+		}
+		if index > 0 || name != "" {
+			if index == 0 || name == "" {
+				var iface *net.Interface
+				var lerr error
+				if index > 0 {
+					iface, lerr = net.InterfaceByIndex(index)
+				} else {
+					iface, lerr = net.InterfaceByName(name)
+				}
+				if lerr != nil {
+					return lerr
+				}
+				index, name = iface.Index, iface.Name
+			}
+			if err := bindSocket(network, fd, index, name); err != nil {
+				return err
+			}
+		}
+		if s.plat.Protect != nil {
+			if s.plat.ProtectArmed != nil && !s.plat.ProtectArmed() {
+				return errors.New("probe protector is not armed")
+			}
+			return s.plat.Protect(network, address, fd)
+		}
+		return nil
+	}()
+	if err != nil {
+		s.bindFailures.Add(1)
+		return errors.New("probe socket protection failed")
+	}
+	return nil
+}
+
+func (s *Scan) kick() {
+	select {
+	case s.wake <- struct{}{}:
+	default:
+	}
+}
+
+func (s *Scan) signalLocked() {
+	close(s.notify)
+	s.notify = make(chan struct{})
+}
+
+// enqueueLocked appends candidates; consecutive legs of one message share instances of at most
+// MaxLegsPerInstance legs.
+func (s *Scan) enqueueLocked(cands []*Candidate) {
+	s.registerTermsLocked(cands)
+	var b *batch
+	for _, c := range cands {
+		e := &entry{c: c, index: len(s.entries) + 1}
+		if c.EntryIP == "" || c.ReachAtMs < 0 {
+			e.st = stReady
+		}
+		if c.Kind == KindXrayLeg {
+			if b == nil || len(b.members) == s.plat.MaxLegsPerInstance {
+				b = &batch{ready: make(chan struct{})}
+			}
+			b.members = append(b.members, c)
+			b.open++
+			e.batch = b
+		}
+		s.entries = append(s.entries, e)
+	}
+	if len(cands) > 0 {
+		s.done, s.reason = false, ""
+	}
+}
+
+func (s *Scan) addItemLocked(it Item) {
+	it.Seq = int64(len(s.items) + 1)
+	s.items = append(s.items, it)
+	s.signalLocked()
+}
+
+// finalLocked records a candidate's final data item (and releases its leg batch slot).
+func (s *Scan) finalLocked(e *entry, it *Item) {
+	if e.st == stFinal {
+		return
+	}
+	e.st = stFinal
+	if it != nil {
+		s.addItemLocked(*it)
+	}
+	s.logProbeLocked(e, it)
+	if b := e.batch; b != nil {
+		b.open--
+		if b.open == 0 {
+			s.closeBatchLocked(b)
+		}
+	}
+}
+
+// closeBatchLocked closes a batch's leg instance in the background. Its instance slot is released only
+// after the instance is closed: until then it is alive (LiveWork counts it, its memory is not back),
+// so the cap and the memory guard must not let the next instance start.
+func (s *Scan) closeBatchLocked(b *batch) {
+	b.closeOnce.Do(func() {
+		inst, slot := b.inst, b.slot
+		b.inst, b.slot = nil, false
+		if inst == nil {
+			if slot {
+				s.instances--
+			}
+			return
+		}
+		s.closers.Add(1)
+		liveWork.closers.Add(1)
+		go func() {
+			defer s.closers.Done()
+			defer func() { // closed (closeInstance recovers a panicking Close): no longer closing, then the slot
+				liveWork.closers.Add(-1)
+				if slot {
+					s.mu.Lock()
+					s.instances--
+					s.mu.Unlock()
+					s.kick() // the dispatcher may start the next instance now
+				}
+			}()
+			s.closeInstance(inst)
+		}()
+	})
+}
+
+func (s *Scan) setStop(reason string) {
+	s.mu.Lock()
+	if s.stopReason == "" && !(s.done && s.closed) {
+		s.stopReason = reason
+	}
+	s.mu.Unlock()
+}
+
+// abort stops the scan: probes in flight end with the matching error. The closing access attempt
+// still runs (scan_cancel, deadline, memory).
+func (s *Scan) abort(reason string) {
+	s.setStop(reason)
+	s.cancel(stopError{reason})
+	s.kick()
+}
+
+// teardown is abort plus the end of everything else: the access attempts are cancelled too (then
+// not attempted). StopAll and a replacing scan_start use it.
+func (s *Scan) teardown(reason string) {
+	s.abort(reason)
+	s.lifeCancel()
+}
+
+// Live work of every scan, for the hosts' and the tests' "nothing is alive" checks.
+var liveWork struct {
+	jobs, access, closers atomic.Int64
+}
+
+// Work counts what of the scans is alive now.
+type Work struct {
+	Instances int64 // probe core instances (full and leg; a leg instance still closing too)
+	Jobs      int64 // reach and data jobs (an AmneziaWG session is inside its data job)
+	Access    int64 // direct access attempts in flight
+	Closers   int64 // leg instances closing in the background
+	Awg       int64 // AmneziaWG devices of the host's in-process runner (SetRunnerLive)
+	Children  int64 // probe child processes of the host's out-of-process runner (SetRunnerLive)
+}
+
+// The host runner's own live counts (SetRunnerLive).
+var runnerLive struct{ awg, children atomic.Pointer[func() int64] }
+
+// SetRunnerLive registers the AmneziaWG runner's own live counts (nil = none): awg = the devices it
+// holds in this process (awg-apple's tribeawg), children = its probe child processes (the desktop
+// service's amneziawg-go probe). LiveWork and the stop reply carry them.
+func SetRunnerLive(awg, children func() int64) {
+	store := func(p *atomic.Pointer[func() int64], f func() int64) {
+		if f == nil {
+			p.Store(nil)
+		} else {
+			p.Store(&f)
+		}
+	}
+	store(&runnerLive.awg, awg)
+	store(&runnerLive.children, children)
+}
+
+func runnerCount(p *atomic.Pointer[func() int64]) int64 {
+	if f := p.Load(); f != nil {
+		return (*f)()
+	}
+	return 0
+}
+
+// LiveWork returns the live counts (all zero once StopAll returned true).
+func LiveWork() Work {
+	return Work{Instances: liveInstances.Load(), Jobs: liveWork.jobs.Load(), Access: liveWork.access.Load(),
+		Closers: liveWork.closers.Load(), Awg: runnerCount(&runnerLive.awg), Children: runnerCount(&runnerLive.children)}
+}
+
+func (s *Scan) stopCode() string {
+	var e stopError
+	if errors.As(context.Cause(s.ctx), &e) {
+		switch e.reason {
+		case ReasonDeadline:
+			return ErrDeadline
+		case ReasonMemory:
+			return ErrMemory
+		case ReasonInternal:
+			return ErrInternal
+		}
+	}
+	return ErrCancelled // cancel, a new scan_start, tunnel_stopped
+}
+
+func (s *Scan) memMayStart() bool {
+	if s.plat.AvailableMB == nil {
+		return true
+	}
+	av := s.plat.AvailableMB()
+	return av < 0 || av >= s.memStart
+}
+
+// closeWaitBound bounds how long an admission waits for an instance still closing before it measures
+// anyway (the bound a replacing scan_start already waits for the old scan's instances).
+const closeWaitBound = replaceWait
+
+// memAdmitLocked is the memory guard of new work - a probe instance or an AmneziaWG session (s.mu held).
+// It never measures while an instance of the scan is still closing: that memory is about to come back,
+// so a refusal then would be a false one (on iOS an AmneziaWG session is admitted next to the single leg
+// instance closing in the background). It waits for the close - the close wakes the dispatcher - at most
+// closeWaitBound, then measures. wait != zero: not yet, ask again then. The running probes' watchdog
+// (memRunOK) keeps measuring during a close: a low reading while work runs is real.
+func (s *Scan) memAdmitLocked(now time.Time) (ok bool, wait time.Time) {
+	if s.plat.AvailableMB != nil && s.instClosing.Load() > 0 {
+		if s.memWaitFrom.IsZero() {
+			s.memWaitFrom = now
+		}
+		if until := s.memWaitFrom.Add(closeWaitBound); now.Before(until) {
+			return false, until
+		}
+	}
+	s.memWaitFrom = time.Time{}
+	return s.memMayStart(), time.Time{}
+}
+
+func (s *Scan) memRunOK() bool {
+	if s.plat.AvailableMB == nil {
+		return true
+	}
+	av := s.plat.AvailableMB()
+	return av < 0 || av >= s.memRun
+}
+
+func memMB(plat Platform) *int64 {
+	if plat.FootprintMB == nil {
+		return nil
+	}
+	v := plat.FootprintMB()
+	if v < 0 || math.IsNaN(v) {
+		return nil
+	}
+	return i64(int64(math.Round(v)))
+}
+
+func (s *Scan) recoverTo() {
+	if r := recover(); r != nil {
+		s.panics.Add(1)
+		s.abort(ReasonInternal)
+	}
+}
+
+func (s *Scan) directTimeout() time.Duration {
+	return time.Duration(s.req.Limits.Stage1TimeoutMs) * time.Millisecond
+}
+
+// Gate ids of the two access attempts (the vectors' names).
+const (
+	netinfoOpenID  = "netinfo_open"
+	netinfoCloseID = "netinfo_close"
+)
+
+// accessAttempt makes one direct access attempt under its reservation and records it.
+func (s *Scan) accessAttempt(closing bool) {
+	id := netinfoOpenID
+	s.mu.Lock()
+	admitted := s.openAdmitted
+	if closing {
+		id, admitted = netinfoCloseID, s.closeAdmitted
+	}
+	gen := s.gen
+	s.mu.Unlock()
+	which := "opening"
+	if closing {
+		which = "closing"
+	}
+	if !admitted {
+		s.logAccess(which, "budget") // max_bytes could not cover it: attempted false (null on the wire)
+		return
+	}
+	at := s.sinceStart(time.Now())
+	r := s.directCheck(s.directTimeout())
+	if s.life.Err() != nil {
+		r.notAttempted = "stopped" // a teardown cancelled it: no evidence either way
+	}
+	if r.notAttempted != "" {
+		// Nothing left on the physical interface (no address, no binding, no route): not an
+		// attempt, so it can never support the proof by exclusion (null on the wire).
+		s.mu.Lock()
+		s.gate.Finish(id, 0)
+		s.signalLocked()
+		s.mu.Unlock()
+		s.logAccess(which, r.notAttempted)
+		return
+	}
+	a := &Attempt{Attempted: true, HTTPAnswered: r.answered, AtMs: at, Gen: gen}
+	if r.answered {
+		if r.asn > 0 {
+			a.Asn = i64(r.asn)
+		}
+		a.NetToken = sp(r.netToken)
+	}
+	s.mu.Lock()
+	s.gate.Finish(id, r.used)
+	if closing {
+		s.closing = a
+	} else {
+		s.opening = a
+	}
+	s.signalLocked()
+	s.mu.Unlock()
+}
+
+// sinceStart is t on the scan's clock (ms after scan_start, monotonic).
+func (s *Scan) sinceStart(t time.Time) *int64 {
+	return i64(max(0, t.Sub(s.started).Milliseconds()))
+}
+
+// setGen keeps the host's latest path monitor element.
+func (s *Scan) setGen(g *Gen) {
+	if g == nil {
+		return
+	}
+	s.mu.Lock()
+	s.gen = g
+	s.mu.Unlock()
+}
+
+// run is the dispatcher: the only launcher of reach dials and data jobs. The opening direct check
+// runs before the first probe, the closing one after the last (plan v2.2).
+func (s *Scan) run() {
+	defer close(s.stopped)
+	defer func() {
+		if r := recover(); r != nil {
+			s.panics.Add(1)
+			s.abort(ReasonInternal)
+		}
+		// The stop: the closing attempt after the last probe ended (a teardown cancels it: then it
+		// is not attempted), every instance closed, then the final totals; only then drained.
+		s.accessAttempt(true)
+		s.drain()
+		s.releaseTerms()
+		close(s.drained)
+	}()
+	s.accessAttempt(false)
+	timer := time.NewTimer(time.Hour)
+	defer timer.Stop()
+	for {
+		s.mu.Lock()
+		now := time.Now()
+		if s.ctx.Err() == nil && !now.Before(s.deadline) {
+			if s.done {
+				// A drained queue that was never stopped: the deadline ends it.
+				s.closed = true
+				if s.stopReason == "" {
+					s.stopReason = ReasonDeadline
+				}
+				s.mu.Unlock()
+				return
+			}
+			s.mu.Unlock()
+			s.abort(ReasonDeadline)
+			continue
+		}
+		if s.ctx.Err() != nil {
+			busy := s.reachInflight > 0
+			for _, n := range s.running { // every pool: full, leg, awg_mini
+				busy = busy || n > 0
+			}
+			s.mu.Unlock()
+			if !busy {
+				return
+			}
+			<-s.wake
+			continue
+		}
+		next := s.dispatchLocked(now)
+		if !s.done && s.stopReason == "" && s.ctx.Err() == nil && s.allFinalLocked() {
+			// The queue drained: done, "complete", NOT final - the scan stays open for scan_add
+			// until the deadline or the app's freeze + cancel.
+			s.done, s.reason = true, ReasonComplete
+			s.signalLocked()
+		}
+		s.mu.Unlock()
+		wait := time.Until(s.deadline)
+		if !next.IsZero() {
+			wait = min(wait, time.Until(next))
+		}
+		timer.Reset(max(wait, time.Millisecond))
+		select {
+		case <-s.wake:
+		case <-timer.C:
+		case <-s.ctx.Done():
+		}
+		if !timer.Stop() {
+			select {
+			case <-timer.C:
+			default:
+			}
+		}
+	}
+}
+
+// drain runs after the dispatcher stopped: no job runs any more; every open batch closes.
+func (s *Scan) drain() {
+	s.mu.Lock()
+	for _, e := range s.entries {
+		if e.batch != nil {
+			s.closeBatchLocked(e.batch)
+		}
+	}
+	s.mu.Unlock()
+	s.closers.Wait() // every leg instance is closed before the scan says drained
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if !s.done || s.stopReason != "" {
+		s.done = true
+		if s.stopReason != "" {
+			s.reason = s.stopReason
+		} else if s.reason == "" {
+			s.reason = ReasonComplete
+		}
+	}
+	s.closed = true
+	s.final = true // nothing in flight, nothing reserved: bytes_spent is the final total
+	s.signalLocked()
+}
+
+func (s *Scan) allFinalLocked() bool {
+	for _, e := range s.entries {
+		if e.st != stFinal {
+			return false
+		}
+	}
+	return true
+}
+
+func earliest(a, b time.Time) time.Time {
+	if a.IsZero() || (!b.IsZero() && b.Before(a)) {
+		return b
+	}
+	return a
+}
+
+func dataItem(c *Candidate, bytesReq int64, code string) *Item {
+	return &Item{ID: c.ID, Stage: "data", HTTPStatus: ip(0), BytesRequested: i64(bytesReq), Bytes: i64(0),
+		ShaOK: bp(false), Error: code, SpentBytes: i64(0), Retries: ip(0)}
+}
+
+func (s *Scan) bodyBytes(c *Candidate) int64 {
+	if c.Bytes > 0 {
+		return c.Bytes
+	}
+	return s.req.Bytes
+}
+
+func (s *Scan) dispatchLocked(now time.Time) (next time.Time) {
+	if s.gate.Frozen() {
+		return next // scan_freeze: nothing new starts
+	}
+	l := s.req.Limits
+	spacing := time.Duration(l.EntryIPSpacingMs) * time.Millisecond
+	// Stage 1.
+	stagger := time.Duration(l.Stage1StaggerMs) * time.Millisecond
+	for _, e := range s.entries {
+		if e.st != stQueued {
+			continue
+		}
+		due := s.started.Add(time.Duration(e.c.ReachAtMs) * time.Millisecond)
+		if now.Before(due) {
+			next = earliest(next, due)
+			continue
+		}
+		if s.reachInflight >= l.Stage1Sockets {
+			break
+		}
+		if t := s.lastReachLaunch.Add(stagger); !s.lastReachLaunch.IsZero() && now.Before(t) {
+			next = earliest(next, t)
+			break
+		}
+		if s.ipInflight[e.c.EntryIP] >= l.PerEntryIP {
+			continue
+		}
+		if t, ok := s.lastOpen[e.c.EntryIP]; ok && now.Before(t.Add(spacing)) {
+			next = earliest(next, t.Add(spacing))
+			continue
+		}
+		if !s.gate.Charge(reachOverhead) { // a reach socket is charged only if it fits
+			s.finalLocked(e, &Item{ID: e.c.ID, Stage: "reach", OK: bp(false), Error: ErrBudget})
+			continue
+		}
+		e.st, e.ran = stReaching, true
+		s.reachInflight++
+		s.ipInflight[e.c.EntryIP]++
+		s.lastOpen[e.c.EntryIP] = now
+		s.lastReachLaunch = now
+		liveWork.jobs.Add(1)
+		go s.reachJob(e)
+	}
+	// Stage 2: per pool, in queue order.
+	blocked := map[string]bool{}
+	for _, e := range s.entries {
+		if e.st != stReady || blocked[e.c.Kind] {
+			continue
+		}
+		kind := e.c.Kind
+		pool := s.pools[kind]
+		if pool <= 0 {
+			s.finalLocked(e, dataItem(e.c, s.bodyBytes(e.c), ErrConfig))
+			continue
+		}
+		if s.running[kind] >= pool {
+			blocked[kind] = true
+			continue
+		}
+		if e.c.EntryIP != "" {
+			if t, ok := s.lastOpen[e.c.EntryIP]; ok && now.Before(t.Add(spacing)) {
+				next = earliest(next, t.Add(spacing))
+				blocked[kind] = true
+				continue
+			}
+		}
+		if kind == KindAwgMini {
+			if e.awg == nil {
+				p, ok := parseAwg(e.c, l)
+				if !ok || s.awgRefusedLocked(p) {
+					s.finalLocked(e, dataItem(e.c, s.bodyBytes(e.c), ErrConfig))
+					continue
+				}
+				e.awg = p
+			}
+			gap := time.Duration(max(l.AwgSpacingMs, 50)) * time.Millisecond
+			if t := s.lastAwgLaunch.Add(gap); !s.lastAwgLaunch.IsZero() && now.Before(t) {
+				next = earliest(next, t)
+				blocked[kind] = true
+				continue
+			}
+			memOK, memWait := s.memAdmitLocked(now)
+			if !memWait.IsZero() { // an instance is closing: measure after it
+				next = earliest(next, memWait)
+				blocked[kind] = true
+				continue
+			}
+			if !memOK {
+				s.finalLocked(e, dataItem(e.c, s.bodyBytes(e.c), ErrMemory))
+				if s.stopReason == "" {
+					s.stopReason = ReasonMemory // before the run loop can call the drained queue complete
+				}
+				go s.abort(ReasonMemory)
+				return next
+			}
+		}
+		needSlot := kind == KindXrayFull || (kind == KindXrayLeg && !e.batch.slot)
+		if needSlot && s.instCap > 0 && s.instances >= s.instCap {
+			blocked[kind] = true
+			continue
+		}
+		memOK := true
+		if needSlot {
+			ok, memWait := s.memAdmitLocked(now)
+			if !memWait.IsZero() { // an instance is closing: measure after it
+				next = earliest(next, memWait)
+				blocked[kind] = true
+				continue
+			}
+			memOK = ok
+		}
+		if !memOK {
+			s.finalLocked(e, dataItem(e.c, s.bodyBytes(e.c), ErrMemory))
+			if s.stopReason == "" {
+				s.stopReason = ReasonMemory // before the run loop can call the drained queue complete
+			}
+			go s.abort(ReasonMemory)
+			return next
+		}
+		// Atomic admission against the shared cap, the last check before the launch (review F6).
+		if !s.gate.Admit(e.c.ID, e.c.CostBytes) {
+			s.finalLocked(e, dataItem(e.c, s.bodyBytes(e.c), ErrBudget))
+			continue
+		}
+		if needSlot {
+			s.instances++
+			if kind == KindXrayLeg {
+				e.batch.slot = true
+			}
+		}
+		if kind == KindAwgMini {
+			s.lastAwgLaunch = now
+			s.awgNodes[e.awg.job.PeerKey] = true
+		}
+		e.st, e.ran = stRunning, true
+		s.running[kind]++
+		if e.c.EntryIP != "" {
+			s.lastOpen[e.c.EntryIP] = now
+		}
+		liveWork.jobs.Add(1)
+		go s.dataJob(e)
+	}
+	return next
+}
+
+// reachJob: one TCP connect to the entry through Xray's system dialer, so the socket passes the
+// same process-wide dialer controller as the tunnel's sockets and, when the host asked for it, is
+// bound to the physical interface (sockopt.interface).
+func (s *Scan) reachJob(e *entry) {
+	defer liveWork.jobs.Add(-1)
+	ok, ms, code := false, int64(-1), ErrInternal
+	func() {
+		defer func() {
+			if r := recover(); r != nil {
+				s.panics.Add(1)
+			}
+		}()
+		ctx, cancel := context.WithTimeout(s.pctx, time.Duration(s.req.Limits.Stage1TimeoutMs)*time.Millisecond)
+		defer cancel()
+		dest := xnet.TCPDestination(xnet.ParseAddress(e.c.EntryIP), xnet.Port(e.c.EntryPort))
+		t0 := time.Now()
+		conn, err := internet.DialSystem(ctx, dest, nil)
+		ms = time.Since(t0).Milliseconds()
+		switch {
+		case err == nil:
+			conn.Close()
+			ok, code = true, ""
+		case ctx.Err() != nil && s.ctx.Err() == nil:
+			code = ErrReachTimeout
+		default:
+			var ne net.Error
+			if errors.As(err, &ne) && ne.Timeout() {
+				code = ErrReachTimeout
+			} else {
+				code = ErrReachRefused
+			}
+		}
+	}()
+	s.mu.Lock()
+	s.reachInflight--
+	if s.ipInflight[e.c.EntryIP]--; s.ipInflight[e.c.EntryIP] <= 0 {
+		delete(s.ipInflight, e.c.EntryIP)
+	}
+	if s.ctx.Err() == nil {
+		s.addItemLocked(Item{ID: e.c.ID, Stage: "reach", OK: bp(ok), Ms: optMs(ms), Error: code})
+		e.reachMs, e.reachCode = optMs(ms), code
+		if ok {
+			e.st = stReady
+		} else {
+			s.finalLocked(e, nil)
+		}
+	}
+	s.mu.Unlock()
+	s.kick()
+}
+
+func (s *Scan) dataJob(e *entry) {
+	defer liveWork.jobs.Add(-1)
+	var it Item
+	func() {
+		defer func() {
+			if r := recover(); r != nil {
+				s.panics.Add(1)
+				it = *dataItem(e.c, s.bodyBytes(e.c), ErrInternal)
+			}
+		}()
+		switch e.c.Kind {
+		case KindXrayLeg:
+			it = s.runLeg(e)
+		case KindAwgMini:
+			it = s.runAwg(e)
+		default:
+			it = s.runFull(e)
+		}
+	}()
+	if s.ctx.Err() != nil && it.Error != "" {
+		// The scan is stopping: the instance may close the stream before the watchdog recorded
+		// why, so a failure now is the scan's stop, whatever the reader saw.
+		it.Error = s.stopCode()
+	}
+	s.mu.Lock()
+	s.running[e.c.Kind]--
+	if e.c.CostBytes > 0 && *it.SpentBytes > e.c.CostBytes {
+		*it.SpentBytes = e.c.CostBytes // the gate never charges more than the reservation
+	}
+	if e.c.CostBytes == 0 {
+		s.gate.Finish(e.c.ID, 0)
+		s.gate.Charge(*it.SpentBytes) // no per-probe limit (cost 0): count what it used
+	} else {
+		s.gate.Finish(e.c.ID, *it.SpentBytes)
+	}
+	if e.c.Kind == KindXrayFull {
+		s.instances--
+	}
+	s.finalLocked(e, &it)
+	s.mu.Unlock()
+	s.kick()
+}
+
+func (s *Scan) runFull(e *entry) Item {
+	c := e.c
+	plan, code := buildFullPlan(c)
+	if code != "" {
+		return *dataItem(c, s.bodyBytes(c), code)
+	}
+	inst, err := s.startInstance(plan)
+	if err != nil {
+		return *dataItem(c, s.bodyBytes(c), ErrConfig)
+	}
+	defer s.closeInstance(inst)
+	if s.plat.JobHook != nil {
+		s.plat.JobHook(c.ID)
+	}
+	return s.probe(inst, plan, c)
+}
+
+func (s *Scan) runLeg(e *entry) Item {
+	c, b := e.c, e.batch
+	b.once.Do(func() {
+		defer close(b.ready)
+		b.plan, b.failCode = nil, ""
+		lb, plan := buildLegBatch(b.members, s.host)
+		b.plan = lb
+		if plan == nil {
+			return
+		}
+		inst, err := s.startInstance(plan)
+		if err != nil {
+			b.failCode = ErrConfig
+			return
+		}
+		s.mu.Lock()
+		if b.open == 0 || s.ctx.Err() != nil { // nothing left to probe (raced with a stop)
+			s.mu.Unlock()
+			s.closeInstance(inst)
+			return
+		}
+		b.inst = inst
+		s.mu.Unlock()
+	})
+	<-b.ready
+	if code, bad := b.plan.bad[c.ID]; bad {
+		return *dataItem(c, s.bodyBytes(c), code)
+	}
+	if b.failCode != "" {
+		return *dataItem(c, s.bodyBytes(c), b.failCode)
+	}
+	s.mu.Lock()
+	inst := b.inst
+	s.mu.Unlock()
+	if inst == nil {
+		return *dataItem(c, s.bodyBytes(c), s.stopCode())
+	}
+	if s.plat.JobHook != nil {
+		s.plat.JobHook(c.ID)
+	}
+	mem := b.plan.plans[c.ID]
+	it := s.probe(inst, &probePlan{forcedTag: mem.forced}, c)
+	if c.DNSPlan && len(mem.dns) > 0 && s.ctx.Err() == nil {
+		it.DNS = s.exerciseDNS(inst, mem.dns, time.Duration(min(s.req.Limits.TTFBMs, 2000))*time.Millisecond)
+		all := true
+		for _, r := range it.DNS {
+			all = all && r.OK
+		}
+		it.DNSExercised = all
+	}
+	return it
+}
+
+// startInstance builds and starts a probe instance; on success the caller owns closeInstance.
+func (s *Scan) startInstance(plan *probePlan) (*core.Instance, error) {
+	// The instance's own context carries the probe protector: DNS, observatory and every outbound
+	// of this instance dial with it (core 0011).
+	inst, err := core.NewWithContext(s.pctx, plan.cfg)
+	if err != nil {
+		return nil, err
+	}
+	liveInstances.Add(1)
+	if err := inst.Start(); err != nil {
+		s.closeInstance(inst)
+		return nil, err
+	}
+	return inst, nil
+}
+
+// closeInstanceHook is a test seam (the kit's SetCloseInstanceHook): runs before every instance close.
+var closeInstanceHook atomic.Pointer[func()]
+
+func (s *Scan) closeInstance(inst *core.Instance) {
+	s.instClosing.Add(1)
+	defer func() {
+		s.instClosing.Add(-1) // its memory is back: an admission waiting for it measures now
+		s.kick()
+	}()
+	if h := closeInstanceHook.Load(); h != nil {
+		(*h)()
+	}
+	func() {
+		defer func() { recover() }() //nolint:errcheck // Close of a broken instance must not take the host down
+		inst.Close()
+	}()
+	liveInstances.Add(-1)
+	if s.plat.FreeOSMemoryAfterJob {
+		debug.FreeOSMemory()
+	}
+}
+
+func (s *Scan) probe(inst *core.Instance, plan *probePlan, c *Candidate) (it Item) {
+	t0 := time.Now()
+	defer func() { it.StartMs, it.EndMs = s.sinceStart(t0), s.sinceStart(time.Now()) }()
+	total := time.Duration(s.req.Limits.TotalMs) * time.Millisecond
+	if c.TotalMs > 0 {
+		total = time.Duration(c.TotalMs) * time.Millisecond
+	}
+	end := t0.Add(total)
+	var spent int64
+	retries := 0
+	for {
+		allowance := int64(-1) // bytes this attempt may still use: cost_bytes is the probe's hard limit
+		if c.CostBytes > 0 {
+			if allowance = c.CostBytes - spent; allowance < tlsOverhead {
+				it := *dataItem(c, s.bodyBytes(c), ErrBudget)
+				it.Retries, it.SpentBytes, it.DurationMs = ip(retries), i64(spent), i64(time.Since(t0).Milliseconds())
+				return it
+			}
+		}
+		binds := s.bindFailures.Load()
+		out := s.attempt(s.xrayDial(inst, plan), ErrConfig, s.host, s.req.ProbeBase, c, end, allowance)
+		if out.notYet && out.read == 0 {
+			// Nothing came back: our TLS never got a byte (no certificate, no body); charged like a
+			// reach socket, not like a TLS connection.
+			out.spent = reachOverhead
+		}
+		spent += out.spent
+		it := out.item
+		if it.Error != "" && s.bindFailures.Load() != binds {
+			it.Error, out.notYet = ErrBindFailed, false // the probe's own protection failed: never the tunnel's
+		}
+		if s.ctx.Err() != nil || !out.notYet || !c.EarlyRetry {
+			it.Retries, it.SpentBytes, it.DurationMs = ip(retries), i64(spent), i64(time.Since(t0).Milliseconds())
+			return it
+		}
+		delay := retryDelay(retries + 1)
+		if time.Until(end)-delay < retryMinMs*time.Millisecond || !sleepCtx(s.ctx, delay) {
+			it.Retries, it.SpentBytes, it.DurationMs = ip(retries), i64(spent), i64(time.Since(t0).Milliseconds())
+			return it
+		}
+		retries++
+	}
+}
+
+func sleepCtx(ctx context.Context, d time.Duration) bool {
+	if d <= 0 {
+		return ctx.Err() == nil
+	}
+	t := time.NewTimer(d)
+	defer t.Stop()
+	select {
+	case <-ctx.Done():
+		return false
+	case <-t.C:
+		return true
+	}
+}
+
+// progress returns the items with seq > since.
+func (s *Scan) progress(since int64) Progress {
+	s.mu.Lock()
+	p := Progress{Type: "scan_progress", ScanID: s.req.ScanID, Seq: int64(len(s.items)), BytesSpent: s.gate.Spent(),
+		BytesReserved: s.gate.Reserved(), Done: s.done, Final: s.final, Reason: s.reason, Items: []Item{},
+		Access: s.opening, AccessClose: s.closing, Gen: s.gen}
+	if !s.done {
+		p.Reason = ""
+	}
+	switch {
+	case s.done:
+		p.Phase = PhaseDone
+	case s.reachPendingLocked():
+		p.Phase = PhaseReach
+	default:
+		p.Phase = PhaseData
+	}
+	if since < 0 {
+		since = 0
+	}
+	for i := since; i < int64(len(s.items)) && len(p.Items) < maxItemsPerReply; i++ {
+		p.Items = append(p.Items, s.items[i])
+	}
+	s.mu.Unlock()
+	p.MemMB = memMB(s.plat)
+	return p
+}
+
+func (s *Scan) reachPendingLocked() bool {
+	for _, e := range s.entries {
+		if e.st == stQueued || e.st == stReaching {
+			return true
+		}
+	}
+	return false
+}
+
+const nonceAlphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789"
+
+// newNonce: 24 characters of the server's nonce alphabet ([A-Za-z0-9._-]{8,64}).
+func newNonce() string {
+	var b [24]byte
+	if _, err := rand.Read(b[:]); err != nil {
+		panic(err) // crypto/rand never fails on supported platforms
+	}
+	for i := range b {
+		b[i] = nonceAlphabet[int(b[i])%len(nonceAlphabet)]
+	}
+	return string(b[:])
+}
+
+// probeURL builds <base><path>?bytes=N&nonce=X[&profile_id=P].
+func probeURL(base, path, profileID string, size int64, nonce string) *url.URL {
+	u, _ := url.Parse(base)
+	q := url.Values{}
+	q.Set("bytes", strconv.FormatInt(size, 10))
+	q.Set("nonce", nonce)
+	if profileID != "" {
+		q.Set("profile_id", profileID)
+	}
+	return &url.URL{Scheme: "https", Host: u.Host, Path: strings.TrimRight(u.Path, "/") + path, RawQuery: q.Encode()}
+}
