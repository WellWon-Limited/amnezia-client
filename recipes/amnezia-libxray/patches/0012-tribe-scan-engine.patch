index 0000000..0d8de45
--- /dev/null
+++ b/tribescan/privacy_test.go
@@ -0,0 +1,298 @@
+//go:build tribescan_testkit
+
+package tribescan
+
+import (
+	"bytes"
+	"context"
+	"crypto/ecdh"
+	"crypto/rand"
+	"encoding/base64"
+	"encoding/json"
+	"net"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"golang.org/x/sys/unix"
+	"google.golang.org/grpc/grpclog"
+
+	"github.com/xtls/xray-core/common/errors"
+	clog "github.com/xtls/xray-core/common/log"
+	xnet "github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/common/session"
+	"github.com/xtls/xray-core/core"
+	confserial "github.com/xtls/xray-core/infra/conf/serial"
+)
+
+const (
+	privSecretHost  = "tribe-secret-provider.test"
+	privRefusedHost = "tribe-secret-refused.test"
+	privOwnHost     = "tribe-own-node.test"
+)
+
+// captureFDs points file descriptors 1 and 2 at a file until the returned function runs, which
+// gives back everything written there (Go's os.Stdout / os.Stderr and C code alike).
+func captureFDs(t *testing.T) func() string {
+	restore, _ := captureFDsPeek(t)
+	return restore
+}
+
+// captureFDsPeek is captureFDs that can also read what was written so far.
+func captureFDsPeek(t *testing.T) (func() string, func() string) {
+	t.Helper()
+	f, err := os.CreateTemp(t.TempDir(), "fds")
+	if err != nil {
+		t.Fatal(err)
+	}
+	saved := [2]int{}
+	for i, fd := range []int{1, 2} {
+		if saved[i], err = unix.Dup(fd); err != nil {
+			t.Fatal(err)
+		}
+		if err := unix.Dup2(int(f.Fd()), fd); err != nil {
+			t.Fatal(err)
+		}
+	}
+	var once sync.Once
+	var out string
+	restore := func() string {
+		once.Do(func() {
+			for i, fd := range []int{1, 2} {
+				unix.Dup2(saved[i], fd)
+				unix.Close(saved[i])
+			}
+			b, _ := os.ReadFile(f.Name())
+			f.Close()
+			out = string(b)
+		})
+		return out
+	}
+	// A failing check stops the test early: the descriptors come back before its report, which
+	// then carries what was captured (a race report lands there too).
+	t.Cleanup(func() {
+		if got := restore(); t.Failed() {
+			t.Logf("captured fds 1 and 2:\n%s", got)
+		}
+	})
+	peek := func() string {
+		b, _ := os.ReadFile(f.Name())
+		return string(b)
+	}
+	return restore, peek
+}
+
+// privacyCandidates: a full profile reaching the kit server through a provider host only its own
+// DNS knows, one whose provider host refuses, and a REALITY leg with "show" on (Xray would print
+// its session id to stdout) against a listener that hangs up.
+func privacyCandidates(t *testing.T, vless int) []map[string]any {
+	refused := FreePort(t)
+	full := func(id, host string, port int) map[string]any {
+		cfg := TunnelConfig(vless, FreePort(t))
+		delete(cfg, "inbounds")
+		ob := VlessOutbound("proxy", port)
+		ob["settings"].(map[string]any)["vnext"].([]any)[0].(map[string]any)["address"] = host
+		ob["streamSettings"] = map[string]any{"sockopt": map[string]any{"domainStrategy": "UseIPv4"}}
+		cfg["outbounds"] = []any{ob}
+		cfg["dns"] = map[string]any{"hosts": map[string]any{host: "127.0.0.1"}}
+		raw, _ := json.Marshal(cfg)
+		c := KitFullCandidate(id, vless)
+		c["config"] = string(raw)
+		c["early_retry"] = false
+		return c
+	}
+	ln, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { ln.Close() })
+	go func() {
+		for {
+			c, err := ln.Accept()
+			if err != nil {
+				return
+			}
+			c.Close()
+		}
+	}()
+	key, _ := ecdh.X25519().GenerateKey(rand.Reader)
+	reality := VlessOutbound("proxy", ln.Addr().(*net.TCPAddr).Port)
+	reality["streamSettings"] = map[string]any{"network": "tcp", "security": "reality", "realitySettings": map[string]any{
+		"show": true, "serverName": "www.example.org", "fingerprint": "chrome", "shortId": "a1b2c3d4",
+		"publicKey": base64.RawURLEncoding.EncodeToString(key.PublicKey().Bytes())}}
+	leg := KitLegCandidate("leg-reality", reality, nil, nil)
+	leg["early_retry"] = false
+	return []map[string]any{full("full-ok", privSecretHost, vless), full("full-bad", privRefusedHost, refused), leg}
+}
+
+func privacyCheck(t *testing.T, where, text string, wantOwn bool) {
+	t.Helper()
+	low := strings.ToLower(text)
+	for _, bad := range []string{"tribe-secret", "reality localaddr", "a1b2c3d4"} {
+		if strings.Contains(low, bad) {
+			t.Fatalf("%s names %q:\n%s", where, bad, text)
+		}
+	}
+	for _, want := range []string{
+		"tribescan: scan=privacy probe=full-ok kind=xray_full error=ok",
+		"tribescan: scan=privacy probe=full-bad kind=xray_full error=",
+		"tribescan: scan=privacy probe=leg-reality kind=xray_leg error=",
+		"context-free line names " + clog.RedactedMark,
+	} {
+		if !strings.Contains(text, want) {
+			t.Fatalf("%s lacks %q:\n%s", where, want, text)
+		}
+	}
+	if strings.Contains(text, "probe=full-bad kind=xray_full error=ok") || strings.Contains(text, "probe=leg-reality kind=xray_leg error=ok") {
+		t.Fatalf("%s: a failing probe logged ok:\n%s", where, text)
+	}
+	if wantOwn && !strings.Contains(low, privOwnHost) {
+		t.Fatalf("%s lost the tunnel's own lines:\n%s", where, text)
+	}
+}
+
+// Probe instances never write a provider's host, address or REALITY session to stdout, stderr or
+// the process log - whether that is Xray's default stdout handler or the tunnel's own log in the
+// same process, which keeps logging its own traffic. Each probe leaves one redacted line.
+func TestTribeScanLogPrivacy(t *testing.T) {
+	e := newKitEnv(t)
+	defer clog.RegisterHandler(&kitLogHandler{})
+	scopeLevel.Store(int32(clog.Severity_Debug)) // count what the scope takes
+	defer scopeLevel.Store(int32(clog.Severity_Unknown))
+	grace := redactGrace.Swap(0)
+	defer redactGrace.Store(grace)
+
+	plat := e.plat
+	plat.JobHook = func(string) {
+		errors.LogWarning(context.Background(), "context-free line names ", privSecretHost)
+		grpclog.Errorf("grpc line names %s", privSecretHost)
+	}
+	run := func(scanID string) *KitResult {
+		before := ScopeMessages()
+		r := KitRun(t, KitRequest(scanID, e.srv.Base(), map[string]any{"concurrency": 2}, 20000,
+			privacyCandidates(t, e.vless)...), "", plat, 30*time.Second)
+		if d, ok := r.DataByID("full-ok"); !ok || d.Error != "" {
+			t.Fatalf("full-ok: %+v", r.Items)
+		}
+		for _, id := range []string{"full-bad", "leg-reality"} {
+			if d, ok := r.DataByID(id); !ok || d.Error == "" {
+				t.Fatalf("%s did not fail: %+v", id, r.Items)
+			}
+		}
+		if ScopeMessages() == before {
+			t.Fatal("the probe scope took no message: probe logs are not scoped")
+		}
+		return r
+	}
+
+	// 1. No tunnel instance: Xray's default handler prints every level to stdout.
+	clog.RegisterHandler(clog.NewLogger(clog.CreateStdoutLogWriter()))
+	restore, peek := captureFDsPeek(t)
+	run("privacy")
+	// The default handler writes from its own goroutine: wait for the last probe's line.
+	for deadline := time.Now().Add(3 * time.Second); time.Now().Before(deadline); time.Sleep(20 * time.Millisecond) {
+		if txt := peek(); strings.Contains(txt, "probe=leg-reality") && strings.Contains(txt, "probe=full-bad") &&
+			strings.Contains(txt, "probe=full-ok") && strings.Contains(txt, "grpc line names") {
+			break
+		}
+	}
+	time.Sleep(100 * time.Millisecond)
+	out := restore()
+	privacyCheck(t, "stdout/stderr (default handler)", out, false)
+	if !strings.Contains(out, "grpc line names "+clog.RedactedMark) {
+		t.Fatalf("gRPC's line was dropped instead of masked:\n%s", out)
+	}
+
+	// 2. The tunnel's instance logs at debug into files (DNS log on) and carries traffic to its own
+	// node while the scan runs.
+	dir := t.TempDir()
+	errPath, accessPath := filepath.Join(dir, "error.log"), filepath.Join(dir, "access.log")
+	cfg := TunnelConfig(e.vless, FreePort(t))
+	ob := VlessOutbound("proxy", e.vless)
+	ob["settings"].(map[string]any)["vnext"].([]any)[0].(map[string]any)["address"] = privOwnHost
+	ob["streamSettings"] = map[string]any{"sockopt": map[string]any{"domainStrategy": "UseIPv4"}}
+	cfg["outbounds"] = []any{ob}
+	cfg["dns"] = map[string]any{"hosts": map[string]any{privOwnHost: "127.0.0.1"}}
+	cfg["log"] = map[string]any{"loglevel": "debug", "error": errPath, "access": accessPath, "dnsLog": true}
+	raw, _ := json.Marshal(cfg)
+	c, err := confserial.LoadJSONConfig(bytes.NewReader(raw))
+	if err != nil {
+		t.Fatal(err)
+	}
+	tunnel, err := core.New(c)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := tunnel.Start(); err != nil {
+		t.Fatal(err)
+	}
+	tunnelOpen := true
+	defer func() {
+		if tunnelOpen {
+			tunnel.Close()
+		}
+	}()
+	stop := make(chan struct{})
+	traffic := make(chan int)
+	go func() {
+		n := 0
+		defer func() { traffic <- n }()
+		for {
+			select {
+			case <-stop:
+				return
+			default:
+			}
+			ctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)
+			dest := xnet.TCPDestination(xnet.ParseAddress("example.com"), xnet.Port(e.srv.Port))
+			if conn, err := core.Dial(session.SetForcedOutboundTagToContext(ctx, "proxy"), tunnel, dest); err == nil {
+				conn.Write([]byte{0x16})
+				conn.Close()
+				n++
+			}
+			cancel()
+			time.Sleep(50 * time.Millisecond)
+		}
+	}()
+	restore = captureFDs(t)
+	run("privacy")
+	close(stop)
+	n := <-traffic
+	// The file loggers write from their own goroutine: wait (while the tunnel runs) until the last
+	// probe's line is there, then read once more after the close.
+	read := func() string {
+		var b strings.Builder
+		for _, p := range []string{errPath, accessPath} {
+			raw, err := os.ReadFile(p)
+			if err != nil {
+				t.Fatal(err)
+			}
+			b.Write(raw)
+		}
+		return b.String()
+	}
+	for deadline := time.Now().Add(3 * time.Second); time.Now().Before(deadline); time.Sleep(20 * time.Millisecond) {
+		if txt := read(); strings.Contains(txt, "probe=leg-reality") && strings.Contains(txt, "probe=full-bad") &&
+			strings.Contains(txt, "probe=full-ok") {
+			break
+		}
+	}
+	tunnel.Close()
+	tunnelOpen = false
+	out = restore()
+	if n == 0 {
+		t.Fatal("no tunnel traffic during the scan")
+	}
+	var logs strings.Builder
+	logs.WriteString(read())
+	privacyCheck(t, "the tunnel's log", logs.String(), true)
+	if low := strings.ToLower(out); strings.Contains(low, "tribe-secret") || strings.Contains(low, "reality localaddr") {
+		t.Fatalf("stdout/stderr next to the tunnel:\n%s", out)
+	}
+	t.Logf("tunnel streams during the scan %d, masked process lines %d, scope messages %d",
+		n, clog.RedactedLines(), ScopeMessages())
+	assertNoInstances(t)
+}
