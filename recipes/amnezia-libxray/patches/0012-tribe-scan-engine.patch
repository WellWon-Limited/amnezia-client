+
+import "syscall"
+
+// bindSocket pins a probe socket to the interface by name (SO_BINDTODEVICE; the service runs as
+// root). Android hosts use Platform.Protect (VpnService.protect) instead.
+func bindSocket(_ string, fd uintptr, _ int, name string) error {
+	return syscall.BindToDevice(int(fd), name)
+}
