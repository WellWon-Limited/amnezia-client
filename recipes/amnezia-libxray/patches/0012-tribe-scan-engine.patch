+++ b/tribescan/wire.go
@@ -0,0 +1,720 @@
+package tribescan
+
+// Wire format of the probe host contract tribe-scan-v1. The contract's owner is the app's pure scan core
+// (client/core/serviceEngine/ScanHostContract.h, lane L1); this file decodes its requests exactly as
+// scanDecodeRequest does (strict types and ranges, the same bad_request details) and encodes the
+// replies its scanDecodeReply reads. The shared vectors (tests/vectors/scan_host_vectors.json) are
+// replayed by vectors_test.go.
+//
+//	requests  {"action":"scan_caps"} | scan_start | scan_add | scan_poll | scan_freeze | scan_cancel
+//	replies   scan_caps | scan_ack | scan_freeze_ack | scan_progress | {"error":...}
+//
+// Contract fields (ScanHostContract.h @ 174e99e83, first added here): candidate "bytes" / "total_ms"
+// (per-job size and limit, e.g. a 24 KiB race probe), probe "base_ips", data items "dns"
+// (per-resolver detail behind dns_exercised), item error "bind_failed". Host-local settings
+// (interface binding, memory thresholds, gen) are a separate host options object set by the
+// platform wrapper, never by the app.
+
+import (
+	"bytes"
+	"encoding/json"
+	"math"
+	"net/netip"
+	"net/url"
+	"strconv"
+	"strings"
+)
+
+// Version is the contract version this host speaks.
+const Version = "tribe-scan-v1"
+
+// Candidate kinds.
+const (
+	KindXrayFull = "xray_full"
+	KindXrayLeg  = "xray_leg"
+	KindAwgMini  = "awg_mini"
+)
+
+// Phases.
+const (
+	PhaseReach = "reach"
+	PhaseData  = "data"
+	PhaseDone  = "done"
+)
+
+// Item errors (ScanTypes.h scanProbeErrorName).
+const (
+	ErrReachTimeout = "reach_timeout"
+	ErrReachRefused = "reach_refused"
+	ErrDial         = "dial" // the path gave nothing back (refused, closed, reset) after the early retries
+	ErrTLS          = "tls"
+	ErrTTFB         = "ttfb_timeout"
+	ErrStalled      = "stalled"
+	ErrTotal        = "total_timeout"
+	ErrHTTP         = "http" // an HTTP answer that is not a 200 of our server (http_status says which)
+	ErrShort        = "short"
+	ErrDigest       = "digest"
+	ErrMemory       = "memory"
+	ErrBudget       = "budget"
+	ErrCancelled    = "cancelled"
+	ErrDeadline     = "deadline"
+	ErrConfig       = "config"
+	ErrInternal     = "internal"
+	// The probe's OWN socket protection failed (interface binding / probe protector): that probe
+	// only, no verdict; never the tunnel's.
+	ErrBindFailed = "bind_failed"
+)
+
+// Done reasons.
+const (
+	ReasonComplete      = "complete"
+	ReasonDeadline      = "deadline"
+	ReasonCancelled     = "cancelled"
+	ReasonBudget        = "budget"
+	ReasonMemory        = "memory"
+	ReasonTunnelStopped = "tunnel_stopped"
+	ReasonInternal      = "internal"
+)
+
+const (
+	maxCandidates    = 128 // kScanHostMaxCandidates
+	maxItemsPerReply = 512 // kScanHostMaxItems
+	maxConfigBytes   = 4 * 1024 * 1024
+	tlsOverhead      = 8192 // bytes_spent per TLS connection
+	reachOverhead    = 512  // bytes_spent per reach socket
+)
+
+// Limits are the request's "limits" object.
+type Limits struct {
+	Stage1Sockets    int `json:"stage1_sockets"`
+	Stage1StaggerMs  int `json:"stage1_stagger_ms"`
+	PerEntryIP       int `json:"per_entry_ip"`
+	EntryIPSpacingMs int `json:"entry_ip_spacing_ms"`
+	Stage1TimeoutMs  int `json:"stage1_timeout_ms"`
+	Concurrency      int `json:"concurrency"`
+	LegConcurrency   int `json:"leg_concurrency"`
+	AwgConcurrency   int `json:"awg_concurrency"`
+	TTFBMs           int `json:"ttfb_ms"`
+	StallMs          int `json:"stall_ms"`
+	StallAfterBytes  int `json:"stall_after_bytes"`
+	TotalMs          int `json:"total_ms"`
+	AwgHandshakeMs   int `json:"awg_handshake_ms"`
+	AwgPrimeEchoes   int `json:"awg_prime_echoes"`
+	NetinfoCostBytes int `json:"netinfo_cost_bytes"`
+	AwgSpacingMs     int `json:"awg_spacing_ms"`
+}
+
+// Candidate is one probe job (CAND).
+type Candidate struct {
+	ID         string
+	Kind       string
+	Config     string // SECRET
+	EntryIP    string
+	EntryPort  int
+	ReachAtMs  int64 // -1 = no reach stage
+	ProfileID  string
+	EarlyRetry bool
+	DNSPlan    bool
+	CostBytes  int64
+	// Per-job overrides (contract "bytes" / "total_ms"; 0 = the scan's values).
+	Bytes   int64
+	TotalMs int64
+}
+
+// StartRequest is scan_start.
+type StartRequest struct {
+	ScanID         string
+	DeadlineMs     int64
+	MaxBytes       int64 // -1 = no cap
+	Limits         Limits
+	ProbeBase      string
+	ProbePath      string
+	NetinfoPath    string   // probe.netinfo_path (default /v1/netinfo): the access attempts
+	BaseIPs        []string // probe.base_ips (1..8 IP literals of probe.base's host; wins over the host option)
+	Token          string   // SECRET
+	WarmBytes      int64
+	Bytes          int64
+	AccessAsn      int64 // 0 = unknown
+	AccessNetToken string
+	Candidates     []*Candidate
+}
+
+// Request is one decoded message.
+type Request struct {
+	Action     string // scan_caps | scan_start | scan_add | scan_poll | scan_cancel
+	ScanID     string
+	Since      int64
+	Start      *StartRequest
+	Candidates []*Candidate // scan_add
+}
+
+// WireError is a refusal at decode time: code (bad_request | unknown_action | version) and detail.
+type WireError struct{ Code, Detail string }
+
+func (e *WireError) Error() string { return e.Code + " " + e.Detail }
+
+func badRequest(field string) *WireError { return &WireError{Code: "bad_request", Detail: field} }
+
+// field accessors with scanwire's rules.
+type obj map[string]json.RawMessage
+
+func (o obj) has(k string) (json.RawMessage, bool) {
+	v, ok := o[k]
+	return v, ok
+}
+
+func isNull(v json.RawMessage) bool { return string(bytes.TrimSpace(v)) == "null" }
+
+// intField: absent -> def (ok unless required); null -> def when nullable; else an integral number
+// in [lo, hi].
+func (o obj) intField(k string, lo, hi, def int64, required, nullable bool) (int64, bool) {
+	v, ok := o.has(k)
+	if !ok || (nullable && isNull(v)) {
+		return def, !required || (nullable && ok && isNull(v))
+	}
+	var f float64
+	if bytes.HasPrefix(bytes.TrimSpace(v), []byte{'"'}) || json.Unmarshal(v, &f) != nil {
+		return 0, false
+	}
+	if math.IsInf(f, 0) || math.IsNaN(f) || f != math.Floor(f) || f < float64(lo) || f > float64(hi) {
+		return 0, false
+	}
+	return int64(f), true
+}
+
+func (o obj) strField(k string, maxLen int, required, nullable bool) (string, bool) {
+	v, ok := o.has(k)
+	if !ok || (nullable && isNull(v)) {
+		return "", !required || (nullable && ok && isNull(v))
+	}
+	var s string
+	if json.Unmarshal(v, &s) != nil {
+		return "", false
+	}
+	return s, len([]rune(s)) <= maxLen
+}
+
+func (o obj) boolField(k string, def bool, required bool) (bool, bool) {
+	v, ok := o.has(k)
+	if !ok {
+		return def, !required
+	}
+	var b bool
+	if json.Unmarshal(v, &b) != nil {
+		return false, false
+	}
+	return b, true
+}
+
+func (o obj) object(k string) obj {
+	var m obj
+	if v, ok := o.has(k); ok {
+		_ = json.Unmarshal(v, &m)
+	}
+	return m
+}
+
+func hex16(s string) bool {
+	if len(s) != 16 {
+		return false
+	}
+	for _, c := range s {
+		if !(c >= '0' && c <= '9' || c >= 'a' && c <= 'f') {
+			return false
+		}
+	}
+	return true
+}
+
+func decodeCandidate(raw json.RawMessage) (*Candidate, bool) {
+	var o obj
+	if json.Unmarshal(raw, &o) != nil || o == nil {
+		return nil, false
+	}
+	c := &Candidate{}
+	var ok bool
+	if c.ID, ok = o.strField("id", 64, true, false); !ok || c.ID == "" {
+		return nil, false
+	}
+	if c.Kind, ok = o.strField("kind", 16, true, false); !ok {
+		return nil, false
+	}
+	if c.Kind != KindXrayFull && c.Kind != KindXrayLeg && c.Kind != KindAwgMini {
+		return nil, false
+	}
+	if c.Config, ok = o.strField("config", maxConfigBytes, true, false); !ok || c.Config == "" {
+		return nil, false
+	}
+	if e, present := o.has("entry"); present && !isNull(e) {
+		var eo obj
+		if json.Unmarshal(e, &eo) != nil || eo == nil {
+			return nil, false
+		}
+		if c.EntryIP, ok = eo.strField("ip", 64, true, false); !ok || c.EntryIP == "" {
+			return nil, false
+		}
+		port, ok := eo.intField("port", 1, 65535, 0, true, false)
+		if !ok {
+			return nil, false
+		}
+		c.EntryPort = int(port)
+	}
+	if c.ReachAtMs, ok = o.intField("reach_at_ms", -1, 600000, -1, false, false); !ok {
+		return nil, false
+	}
+	if c.ProfileID, ok = o.strField("profile_id", 16, false, true); !ok || (c.ProfileID != "" && !hex16(c.ProfileID)) {
+		return nil, false
+	}
+	if c.EarlyRetry, ok = o.boolField("early_retry", false, false); !ok {
+		return nil, false
+	}
+	if c.DNSPlan, ok = o.boolField("dns_plan", false, false); !ok {
+		return nil, false
+	}
+	if c.CostBytes, ok = o.intField("cost_bytes", 0, 1<<32, 0, false, false); !ok {
+		return nil, false
+	}
+	// Per-job overrides (optional; out of range = a bad candidate, as the app's decoder decides).
+	if c.Bytes, ok = o.intField("bytes", 1024, 4*1024*1024, 0, false, false); !ok {
+		return nil, false
+	}
+	if c.TotalMs, ok = o.intField("total_ms", 1000, 30000, 0, false, false); !ok {
+		return nil, false
+	}
+	return c, true
+}
+
+func decodeCandidates(o obj) ([]*Candidate, bool) {
+	v, ok := o.has("candidates")
+	if !ok {
+		return nil, false
+	}
+	var list []json.RawMessage
+	if json.Unmarshal(v, &list) != nil || list == nil || len(list) > maxCandidates {
+		return nil, false
+	}
+	out := make([]*Candidate, 0, len(list))
+	for _, raw := range list {
+		c, ok := decodeCandidate(raw)
+		if !ok {
+			return nil, false
+		}
+		out = append(out, c)
+	}
+	return out, true
+}
+
+// DecodeRequest decodes one message like the app's scanDecodeRequest.
+func DecodeRequest(raw []byte) (*Request, *WireError) {
+	var o obj
+	if err := json.Unmarshal(raw, &o); err != nil || o == nil {
+		return nil, badRequest("json")
+	}
+	var action string
+	if v, ok := o.has("action"); ok {
+		_ = json.Unmarshal(v, &action)
+	}
+	r := &Request{Action: action}
+	if action == "scan_caps" {
+		return r, nil
+	}
+	switch action {
+	case "scan_start", "scan_add", "scan_poll", "scan_cancel", "scan_freeze":
+	default:
+		return nil, &WireError{Code: "unknown_action"}
+	}
+	var ok bool
+	if r.ScanID, ok = o.strField("scan_id", 64, true, false); !ok || r.ScanID == "" {
+		return nil, badRequest("scan_id")
+	}
+	switch action {
+	case "scan_cancel", "scan_freeze":
+		return r, nil
+	case "scan_poll":
+		if r.Since, ok = o.intField("since", 0, 1<<40, 0, false, false); !ok {
+			return nil, badRequest("since")
+		}
+		return r, nil
+	case "scan_add":
+		if r.Candidates, ok = decodeCandidates(o); !ok {
+			return nil, badRequest("candidates")
+		}
+		return r, nil
+	}
+	var version string
+	if v, ok := o.has("version"); ok {
+		_ = json.Unmarshal(v, &version)
+	}
+	if version != Version {
+		return nil, &WireError{Code: "version"}
+	}
+	s := &StartRequest{ScanID: r.ScanID}
+	if s.DeadlineMs, ok = o.intField("deadline_ms", 1000, 120000, 0, true, false); !ok {
+		return nil, badRequest("deadline_ms")
+	}
+	if s.MaxBytes, ok = o.intField("max_bytes", 0, 1<<36, -1, false, true); !ok {
+		return nil, badRequest("max_bytes")
+	}
+	l := o.object("limits")
+	type lf struct {
+		key    string
+		dst    *int
+		lo, hi int64
+	}
+	s.Limits = Limits{AwgHandshakeMs: 1500, AwgPrimeEchoes: 1, AwgSpacingMs: 50, NetinfoCostBytes: 10240}
+	for _, f := range []lf{
+		{"stage1_sockets", &s.Limits.Stage1Sockets, 1, 64},
+		{"stage1_stagger_ms", &s.Limits.Stage1StaggerMs, 0, 1000},
+		{"per_entry_ip", &s.Limits.PerEntryIP, 1, 16},
+		{"entry_ip_spacing_ms", &s.Limits.EntryIPSpacingMs, 0, 2000},
+		{"stage1_timeout_ms", &s.Limits.Stage1TimeoutMs, 200, 10000},
+		{"concurrency", &s.Limits.Concurrency, 0, 32},
+		{"ttfb_ms", &s.Limits.TTFBMs, 500, 15000},
+		{"stall_ms", &s.Limits.StallMs, 200, 10000},
+		{"stall_after_bytes", &s.Limits.StallAfterBytes, 1024, 262144},
+		{"total_ms", &s.Limits.TotalMs, 1000, 30000},
+	} {
+		v, ok := l.intField(f.key, f.lo, f.hi, 0, true, false)
+		if !ok {
+			return nil, badRequest(f.key)
+		}
+		*f.dst = int(v)
+	}
+	for _, f := range []lf{
+		{"leg_concurrency", &s.Limits.LegConcurrency, 0, 32},
+		{"awg_concurrency", &s.Limits.AwgConcurrency, 0, 32},
+		{"awg_handshake_ms", &s.Limits.AwgHandshakeMs, 300, 5000},
+		{"awg_prime_echoes", &s.Limits.AwgPrimeEchoes, 0, 3},
+		{"awg_spacing_ms", &s.Limits.AwgSpacingMs, 50, 1000},
+		{"netinfo_cost_bytes", &s.Limits.NetinfoCostBytes, 1024, 1048576},
+	} {
+		v, ok := l.intField(f.key, f.lo, f.hi, int64(*f.dst), false, false)
+		if !ok {
+			return nil, badRequest(f.key)
+		}
+		*f.dst = int(v)
+	}
+	p := o.object("probe")
+	if s.ProbeBase, ok = p.strField("base", 512, true, false); !ok || !strings.HasPrefix(s.ProbeBase, "https://") {
+		return nil, badRequest("probe.base")
+	}
+	if s.ProbePath, ok = p.strField("path", 128, true, false); !ok || !strings.HasPrefix(s.ProbePath, "/") {
+		return nil, badRequest("probe.path")
+	}
+	if s.NetinfoPath, ok = p.strField("netinfo_path", 128, false, false); !ok {
+		return nil, badRequest("probe.netinfo_path")
+	}
+	if s.NetinfoPath == "" {
+		s.NetinfoPath = "/v1/netinfo"
+	} else if !strings.HasPrefix(s.NetinfoPath, "/") {
+		return nil, badRequest("probe.netinfo_path")
+	}
+	if raw, ok := p.has("base_ips"); ok && !isNull(raw) {
+		var ips []string
+		if json.Unmarshal(raw, &ips) != nil || len(ips) == 0 || len(ips) > 8 {
+			return nil, badRequest("probe.base_ips")
+		}
+		for _, a := range ips {
+			if _, err := netip.ParseAddr(a); err != nil {
+				return nil, badRequest("probe.base_ips")
+			}
+		}
+		s.BaseIPs = ips
+	}
+	if s.Token, ok = p.strField("token", 4096, true, false); !ok || s.Token == "" {
+		return nil, badRequest("probe.token")
+	}
+	if s.WarmBytes, ok = p.intField("warm_bytes", 1024, 65536, 0, true, false); !ok {
+		return nil, badRequest("probe.warm_bytes")
+	}
+	if s.Bytes, ok = p.intField("bytes", 1024, 4*1024*1024, 0, true, false); !ok {
+		return nil, badRequest("probe.bytes")
+	}
+	if s.AccessAsn, ok = p.intField("access_asn", 1, 4294967295, 0, false, true); !ok {
+		return nil, badRequest("probe.access_asn")
+	}
+	if s.AccessNetToken, ok = p.strField("access_net_token", 64, false, true); !ok {
+		return nil, badRequest("probe.access_net_token")
+	}
+	if s.Candidates, ok = decodeCandidates(o); !ok {
+		return nil, badRequest("candidates")
+	}
+	// Host-side checks the app's decoder leaves to the host: what a request header / URL may carry.
+	if err := hostChecks(s); err != nil {
+		return nil, err
+	}
+	r.Start = s
+	return r, nil
+}
+
+func headerSafe(s string) bool {
+	for i := 0; i < len(s); i++ {
+		if s[i] < 0x21 || s[i] > 0x7e {
+			return false
+		}
+	}
+	return true
+}
+
+func hostChecks(s *StartRequest) *WireError {
+	u, err := url.Parse(s.ProbeBase)
+	if err != nil || u.Hostname() == "" || u.User != nil || u.RawQuery != "" || u.Fragment != "" {
+		return badRequest("probe.base")
+	}
+	if p := u.Port(); p != "" {
+		if n, err := strconv.Atoi(p); err != nil || n < 1 || n > 65535 {
+			return badRequest("probe.base")
+		}
+	}
+	if !headerSafe(s.Token) {
+		return badRequest("probe.token")
+	}
+	if s.AccessNetToken != "" && !headerSafe(s.AccessNetToken) {
+		return badRequest("probe.access_net_token")
+	}
+	if strings.ContainsAny(s.ProbePath, "?# \r\n") {
+		return badRequest("probe.path")
+	}
+	if strings.ContainsAny(s.NetinfoPath, "?# \r\n") {
+		return badRequest("probe.netinfo_path")
+	}
+	return nil
+}
+
+// --- replies ---------------------------------------------------------------------------------------
+
+// Caps is the scan_caps reply.
+type Caps struct {
+	Type               string   `json:"type"`
+	Version            string   `json:"version"`
+	MaxFullConcurrent  int      `json:"max_full_concurrent"`
+	MaxLegConcurrent   int      `json:"max_leg_concurrent"`
+	MaxAwgConcurrent   int      `json:"max_awg_concurrent"`
+	CanVerifyComposite bool     `json:"can_verify_composite"`
+	DNSPlan            bool     `json:"dns_plan"`
+	ReachStage         bool     `json:"reach_stage"`
+	NeedsVPN           bool     `json:"needs_vpn"`
+	Kinds              []string `json:"kinds"`
+	MemMB              *int64   `json:"mem_mb"`
+	Platform           *string  `json:"platform"`
+}
+
+// Ack is the scan_ack reply. The cancel ack carries the scan's FINAL byte total after the drain
+// ("final":true, "bytes_spent"; review F7).
+type Ack struct {
+	Type       string `json:"type"`
+	ScanID     string `json:"scan_id"`
+	Accepted   int    `json:"accepted"`
+	MemMB      *int64 `json:"mem_mb"`
+	Final      *bool  `json:"final,omitempty"`
+	BytesSpent *int64 `json:"bytes_spent,omitempty"`
+}
+
+// Gen is the host's own path monitor element (ScanNetworkGeneration.h), passed through from the host
+// options of each message: {"source": <= 16 chars, "epoch": 16 lower-case hex, "counter": int}.
+type Gen struct {
+	Source  string `json:"source"`
+	Epoch   string `json:"epoch"`
+	Counter int64  `json:"counter"`
+}
+
+// Attempt is one direct access attempt (ATTEMPT; plan §2.2c). An attempt not made is null.
+type Attempt struct {
+	Attempted    bool    `json:"attempted"`
+	HTTPAnswered bool    `json:"http_answered"` // false = no HTTP answer at all (DNS, TCP, TLS, timeout)
+	Asn          *int64  `json:"asn"`
+	NetToken     *string `json:"net_token"`
+	AtMs         *int64  `json:"at_ms"` // its start, ms after scan_start (the items' clock)
+	Gen          *Gen    `json:"gen"`
+}
+
+// FreezeAck answers scan_freeze at once: from it on nothing is admitted; spent + reserved bound
+// everything the scan can still transfer (review v2.1 F7).
+type FreezeAck struct {
+	Type     string `json:"type"`
+	ScanID   string `json:"scan_id"`
+	Spent    int64  `json:"spent"`
+	Reserved int64  `json:"reserved"`
+}
+
+// Progress is the scan_progress reply.
+type Progress struct {
+	Type          string   `json:"type"`
+	ScanID        string   `json:"scan_id"`
+	Seq           int64    `json:"seq"`
+	Phase         string   `json:"phase"`
+	Items         []Item   `json:"items"`
+	BytesSpent    int64    `json:"bytes_spent"`
+	BytesReserved int64    `json:"bytes_reserved"`
+	MemMB         *int64   `json:"mem_mb"`
+	Done          bool     `json:"done"`
+	Final         bool     `json:"final,omitempty"` // the scan is over: bytes_spent is its final total
+	Reason        string   `json:"reason"`
+	Access        *Attempt `json:"access"`       // the opening attempt (null before it is made)
+	AccessClose   *Attempt `json:"access_close"` // the closing attempt (in the final progress)
+	Gen           *Gen     `json:"gen"`
+}
+
+// Item is one reach or data result. Reach items use Seq, ID, Stage, OK, Ms, Error only.
+type Item struct {
+	Seq            int64       `json:"seq"`
+	ID             string      `json:"id"`
+	Stage          string      `json:"stage"`
+	OK             *bool       `json:"ok,omitempty"`
+	Ms             *int64      `json:"ms,omitempty"`
+	HTTPStatus     *int        `json:"http_status,omitempty"`
+	Ttfb1Ms        *int64      `json:"ttfb1_ms,omitempty"`
+	RttMs          *int64      `json:"rtt_ms,omitempty"`
+	T64Ms          *int64      `json:"t64_ms,omitempty"`
+	DurationMs     *int64      `json:"duration_ms,omitempty"`
+	BytesRequested *int64      `json:"bytes_requested,omitempty"`
+	Bytes          *int64      `json:"bytes,omitempty"`
+	ShaOK          *bool       `json:"sha_ok,omitempty"`
+	EgressClass    *string     `json:"egress_class,omitempty"`
+	EgressNode     *string     `json:"egress_node,omitempty"`
+	EgressAsn      *int64      `json:"egress_asn,omitempty"`
+	NetToken       *string     `json:"net_token,omitempty"`
+	Error          string      `json:"error"`
+	SpentBytes     *int64      `json:"spent_bytes,omitempty"`
+	Retries        *int        `json:"retries,omitempty"`
+	DNSExercised   bool        `json:"dns_exercised,omitempty"`
+	DNS            []DNSResult `json:"dns,omitempty"` // per-resolver detail behind dns_exercised
+	// The probe's first dial and last byte, ms after scan_start (the attempts' at_ms clock).
+	StartMs *int64 `json:"start_ms,omitempty"`
+	EndMs   *int64 `json:"end_ms,omitempty"`
+	// awg_mini only (the AmneziaWG runner fills them; the prime echoes are diagnostic only).
+	HandshakeOK *bool  `json:"handshake_ok,omitempty"`
+	HandshakeMs *int64 `json:"handshake_ms,omitempty"`
+	EchoSent    *int   `json:"echo_sent,omitempty"`
+	EchoReplies *int   `json:"echo_replies,omitempty"`
+}
+
+// awgFields is the awg_mini block of a data item, written as a whole (handshake_ms may be null).
+type awgFields struct {
+	HandshakeOK bool   `json:"handshake_ok"`
+	HandshakeMs *int64 `json:"handshake_ms"`
+	EchoSent    int    `json:"echo_sent"`
+	EchoReplies int    `json:"echo_replies"`
+}
+
+// MarshalJSON keeps the data item's nullable fields present as null (the app's decoder accepts
+// both, the vectors pin null) and leaves them out of reach items.
+func (it Item) MarshalJSON() ([]byte, error) {
+	if it.Stage != "data" {
+		type reachItem struct {
+			Seq   int64  `json:"seq"`
+			ID    string `json:"id"`
+			Stage string `json:"stage"`
+			OK    bool   `json:"ok"`
+			Ms    *int64 `json:"ms"`
+			Error string `json:"error"`
+		}
+		r := reachItem{Seq: it.Seq, ID: it.ID, Stage: it.Stage, Ms: it.Ms, Error: it.Error}
+		if it.OK != nil {
+			r.OK = *it.OK
+		}
+		return json.Marshal(r)
+	}
+	type dataItem struct {
+		Seq            int64       `json:"seq"`
+		ID             string      `json:"id"`
+		Stage          string      `json:"stage"`
+		HTTPStatus     int         `json:"http_status"`
+		Ttfb1Ms        *int64      `json:"ttfb1_ms"`
+		RttMs          *int64      `json:"rtt_ms"`
+		T64Ms          *int64      `json:"t64_ms"`
+		DurationMs     *int64      `json:"duration_ms"`
+		BytesRequested int64       `json:"bytes_requested"`
+		Bytes          int64       `json:"bytes"`
+		ShaOK          bool        `json:"sha_ok"`
+		EgressClass    *string     `json:"egress_class"`
+		EgressNode     *string     `json:"egress_node"`
+		EgressAsn      *int64      `json:"egress_asn"`
+		NetToken       *string     `json:"net_token"`
+		Error          string      `json:"error"`
+		SpentBytes     int64       `json:"spent_bytes"`
+		Retries        int         `json:"retries"`
+		DNSExercised   bool        `json:"dns_exercised,omitempty"`
+		DNS            []DNSResult `json:"dns,omitempty"`
+		StartMs        *int64      `json:"start_ms"`
+		EndMs          *int64      `json:"end_ms"`
+		*awgFields
+	}
+	d := dataItem{Seq: it.Seq, ID: it.ID, Stage: it.Stage, Ttfb1Ms: it.Ttfb1Ms, RttMs: it.RttMs, T64Ms: it.T64Ms,
+		DurationMs: it.DurationMs, EgressClass: it.EgressClass, EgressNode: it.EgressNode, EgressAsn: it.EgressAsn,
+		NetToken: it.NetToken, Error: it.Error, DNSExercised: it.DNSExercised, DNS: it.DNS,
+		StartMs: it.StartMs, EndMs: it.EndMs}
+	// Like the app's encoder: the awg block only once something of the session happened.
+	if (it.HandshakeOK != nil && *it.HandshakeOK) || (it.EchoSent != nil && *it.EchoSent > 0) || it.HandshakeMs != nil {
+		a := &awgFields{HandshakeMs: it.HandshakeMs}
+		if it.HandshakeOK != nil {
+			a.HandshakeOK = *it.HandshakeOK
+		}
+		if it.EchoSent != nil {
+			a.EchoSent = *it.EchoSent
+		}
+		if it.EchoReplies != nil {
+			a.EchoReplies = *it.EchoReplies
+		}
+		d.awgFields = a
+	}
+	if it.HTTPStatus != nil {
+		d.HTTPStatus = *it.HTTPStatus
+	}
+	if it.BytesRequested != nil {
+		d.BytesRequested = *it.BytesRequested
+	}
+	if it.Bytes != nil {
+		d.Bytes = *it.Bytes
+	}
+	if it.ShaOK != nil {
+		d.ShaOK = *it.ShaOK
+	}
+	if it.SpentBytes != nil {
+		d.SpentBytes = *it.SpentBytes
+	}
+	if it.Retries != nil {
+		d.Retries = *it.Retries
+	}
+	return json.Marshal(d)
+}
+
+// DNSResult is one resolver of a leg's DNS plan (the item's "dns" detail behind dns_exercised): one A query
+// for the probe host's name through the leg. ok = an answer with our id (any rcode).
+type DNSResult struct {
+	Address   string `json:"address"`
+	Transport string `json:"transport"`
+	OK        bool   `json:"ok"`
+	Ms        int64  `json:"ms"`
+	Rcode     int    `json:"rcode"`
+	Answers   int    `json:"answers"`
+	Error     string `json:"error"`
+}
+
+// ErrorReply is {"error":...}.
+type ErrorReply struct {
+	Error     string   `json:"error"`
+	Detail    string   `json:"detail,omitempty"`
+	ScanID    string   `json:"scan_id,omitempty"`
+	MemMB     *int64   `json:"mem_mb,omitempty"`
+	NeedMB    *int64   `json:"need_mb,omitempty"`
+	Supported []string `json:"supported,omitempty"`
+}
+
+func i64(v int64) *int64 { return &v }
+func ip(v int) *int      { return &v }
+func bp(v bool) *bool    { return &v }
+
+func sp(v string) *string {
+	if v == "" {
+		return nil
+	}
+	return &v
+}
+
+func optMs(v int64) *int64 {
+	if v < 0 {
+		return nil
+	}
+	return &v
+}
