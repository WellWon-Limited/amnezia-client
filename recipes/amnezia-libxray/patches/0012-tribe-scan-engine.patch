+//go:build linux
+
+package tribescan
+
+import (
+	"os"
+	"strconv"
+	"strings"
+)
+
+// ProcessRSSMB is this process's resident set from /proc/self/statm (Linux, Android hosts:
+// progress.mem_mb); -1 when it cannot be read.
+func ProcessRSSMB() float64 {
+	raw, err := os.ReadFile("/proc/self/statm")
+	if err != nil {
+		return -1
+	}
+	fields := strings.Fields(string(raw))
+	if len(fields) < 2 {
+		return -1
+	}
+	pages, err := strconv.ParseInt(fields[1], 10, 64)
+	if err != nil {
+		return -1
+	}
+	return float64(pages*int64(os.Getpagesize())) / (1024 * 1024)
+}
