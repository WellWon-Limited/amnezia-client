+		time.Sleep(50 * time.Millisecond)
+	}
+	t.Logf("goroutines %d -> %d, fds %d -> %d", baseG, g, baseFD, fd)
+	if g > baseG+2 || fd > baseFD+2 {
+		buf := make([]byte, 1<<20)
+		t.Fatalf("leak: goroutines %d -> %d, fds %d -> %d\n%s", baseG, g, baseFD, fd, buf[:runtime.Stack(buf, true)])
+	}
