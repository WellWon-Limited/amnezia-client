new file mode 100644
index 0000000..1c10ec5
--- /dev/null
+++ b/tribescan/export.go
@@ -0,0 +1,443 @@
+package tribescan
+
+// One entry point for every host: Message takes one tribe-scan-v1 request (the app's JSON, relayed
+// as is by the iOS extension's {"action":...} channel, the macOS service's QtRO slot or Android's
+// binder) and returns its reply. One scan at a time per process: a new scan_start ends the running
+// one first (as scan_cancel). Only StopAll waits (bounded): the host's lifecycle gate calls it
+// before its tunnel core stops, so no probe socket dials after the protection is gone.
+
+import (
+	"encoding/json"
+	"sync"
+	"sync/atomic"
+	"time"
+)
+
+const (
+	replaceWait = 3 * time.Second // a new scan_start waits this long for the old scan's instances
+	maxStopWait = 10 * time.Second
+)
+
+var current = struct {
+	sync.Mutex
+	scan    *Scan
+	tearing []*Scan // torn down, not stopped yet: no scan_start until they are
+	// epoch is the highest host_epoch a scan_stop_all was called for: a scan_start / scan_add of an
+	// older one is refused. Recorded and checked under this lock only, so a start that waited for a
+	// teardown checks it again at the moment it installs its scan.
+	epoch int64
+	// stops counts the stops (StopAll, scan_stop_all), log keeps the last ones' epochs (nil = none),
+	// stopped is closed and replaced by each one: a scan_start waiting for the old scan's teardown wakes
+	// and is cancelled when a stop that covers its epoch came (stopCovers).
+	stops   uint64
+	log     []stopRecord
+	stopped chan struct{}
+}{stopped: make(chan struct{})}
+
+type stopRecord struct {
+	seq   uint64
+	epoch *int64
+}
+
+const stopLogLen = 32
+
+// staleLocked: e is older than the last stop's host_epoch (no epoch = no check).
+func staleLocked(e *int64) bool { return e != nil && *e < current.epoch }
+
+// stopCovers: a stop of host epoch stop ends work of epoch work. A stop ends the scan work of its own
+// epoch and older - never work the host started in a newer epoch (a stop delayed on its way to the
+// engine must not end a scan the host started after a later stop). Equal is covered: the desktop
+// service's app stop and its teardown check carry the current, unbumped epoch of the scan they end; the
+// iOS and Android hosts bump their epoch before every stop, so their later starts are newer anyway. No
+// epoch on either side = covered (a plain StopAll ends everything, as before epochs).
+func stopCovers(stop, work *int64) bool { return stop == nil || work == nil || *work <= *stop }
+
+// coveredSinceLocked: a stop that covers epoch e came after stop number seq.
+func coveredSinceLocked(seq uint64, e *int64) bool {
+	if current.stops == seq {
+		return false
+	}
+	if len(current.log) == 0 || current.log[0].seq > seq+1 {
+		return true // the log no longer reaches back: assume covered
+	}
+	for _, r := range current.log {
+		if r.seq > seq && stopCovers(r.epoch, e) {
+			return true
+		}
+	}
+	return false
+}
+
+// startWaitHook is a test seam: runs when a replacing scan_start begins to wait for the teardown.
+var startWaitHook atomic.Pointer[func()]
+
+// teardownLocked tears s down and remembers it until it has stopped.
+func teardownLocked(s *Scan, reason string) {
+	s.teardown(reason)
+	current.tearing = append(current.tearing, s)
+}
+
+// stillTearingLocked prunes the stopped scans and returns the ones still tearing down.
+func stillTearingLocked() []*Scan {
+	live := current.tearing[:0]
+	for _, s := range current.tearing {
+		select {
+		case <-s.stopped:
+		default:
+			live = append(live, s)
+		}
+	}
+	current.tearing = live
+	return append([]*Scan(nil), live...)
+}
+
+// waitStopped waits until every scan in list has stopped (true), or the deadline or cancel (false).
+func waitStopped(list []*Scan, wait time.Duration, cancel <-chan struct{}) bool {
+	t := time.NewTimer(max(wait, 0))
+	defer t.Stop()
+	for _, s := range list {
+		select {
+		case <-s.stopped:
+		case <-t.C:
+			return false
+		case <-cancel:
+			return false
+		}
+	}
+	return true
+}
+
+// parseHostEpoch reads "host_epoch" (an integer) from host options; nil when absent.
+func parseHostEpoch(raw string) *int64 {
+	if raw == "" {
+		return nil
+	}
+	var o struct {
+		Epoch *json.Number `json:"host_epoch"`
+	}
+	if json.Unmarshal([]byte(raw), &o) != nil || o.Epoch == nil {
+		return nil
+	}
+	n, err := o.Epoch.Int64()
+	if err != nil {
+		return nil
+	}
+	return &n
+}
+
+func peekAction(raw string) string {
+	var o struct {
+		Action string `json:"action"`
+	}
+	_ = json.Unmarshal([]byte(raw), &o)
+	return o.Action
+}
+
+func encode(v any) string {
+	raw, err := json.Marshal(v)
+	if err != nil {
+		return `{"error":"internal"}`
+	}
+	return string(raw)
+}
+
+// Caps answers scan_caps for a platform.
+func (p Platform) Caps() Caps {
+	awg := 0
+	if p.Awg != nil {
+		awg = p.MaxAwg
+	}
+	c := Caps{Type: "scan_caps", Version: Version, MaxFullConcurrent: p.MaxFull, MaxLegConcurrent: p.MaxLeg,
+		MaxAwgConcurrent: awg, CanVerifyComposite: p.CanVerifyComposite && p.MaxFull > 0, DNSPlan: p.MaxLeg > 0,
+		ReachStage: true, NeedsVPN: p.NeedsVPN, Kinds: []string{}, MemMB: memMB(p), Platform: sp(p.Name)}
+	if p.MaxFull > 0 {
+		c.Kinds = append(c.Kinds, KindXrayFull)
+	}
+	if p.MaxLeg > 0 {
+		c.Kinds = append(c.Kinds, KindXrayLeg)
+	}
+	if awg > 0 {
+		c.Kinds = append(c.Kinds, KindAwgMini)
+	}
+	return c
+}
+
+// parseHostGen reads "gen" (the host's path monitor, ScanNetworkGeneration.h) from the host options
+// of any message; nil when absent or malformed (the progress then repeats the last good one).
+func parseHostGen(raw string) *Gen {
+	if raw == "" {
+		return nil
+	}
+	var o struct {
+		Gen *struct {
+			Source  *string      `json:"source"`
+			Epoch   *string      `json:"epoch"`
+			Counter *json.Number `json:"counter"`
+		} `json:"gen"`
+	}
+	if json.Unmarshal([]byte(raw), &o) != nil || o.Gen == nil || o.Gen.Source == nil || o.Gen.Epoch == nil || o.Gen.Counter == nil {
+		return nil
+	}
+	src, ep := *o.Gen.Source, *o.Gen.Epoch
+	n, err := o.Gen.Counter.Int64()
+	if src == "" || len(src) > 16 || !hex16(ep) || err != nil || n < 0 || n > 1<<53-1 {
+		return nil
+	}
+	return &Gen{Source: src, Epoch: ep, Counter: n}
+}
+
+// Message handles one request and returns the reply JSON. hostOptionsJSON: scan_start reads the
+// binding / memory options; every message may carry "gen" (the host's path monitor), kept for the
+// progress and the next access attempt.
+func Message(requestJSON, hostOptionsJSON string, plat Platform) string {
+	// Host-only: {"action":"scan_stop_all","wait_ms":n} with host options {"host_epoch":n} - the
+	// host's lifecycle gate (never sent by the app). The epoch is remembered with the teardown, under
+	// the lock every start and add checks it with: a scan_start or scan_add of an older epoch is
+	// refused (stale_epoch), also one that was already waiting for a teardown.
+	if peekAction(requestJSON) == "scan_stop_all" {
+		var o struct {
+			WaitMs int64 `json:"wait_ms"`
+		}
+		_ = json.Unmarshal([]byte(requestJSON), &o)
+		return stopAllJSON(time.Duration(o.WaitMs)*time.Millisecond, parseHostEpoch(hostOptionsJSON))
+	}
+	req, werr := DecodeRequest([]byte(requestJSON))
+	if werr != nil {
+		r := ErrorReply{Error: werr.Code, Detail: werr.Detail}
+		if werr.Code == "version" {
+			r.Supported = []string{Version}
+		}
+		return encode(r)
+	}
+	epoch := parseHostEpoch(hostOptionsJSON)
+	switch req.Action {
+	case "scan_caps":
+		return encode(plat.Caps())
+	case "scan_start":
+		return start(req.Start, hostOptionsJSON, epoch, plat)
+	}
+	current.Lock()
+	if req.Action == "scan_add" && staleLocked(epoch) {
+		current.Unlock()
+		return encode(staleEpochReply) // nothing opened
+	}
+	s := current.scan
+	if s == nil || s.req.ScanID != req.ScanID {
+		current.Unlock()
+		return encode(ErrorReply{Error: "unknown_scan", ScanID: req.ScanID})
+	}
+	if req.Action == "scan_add" {
+		// Under the lock a stop records its epoch with: an add is either before the stop (whose
+		// teardown then ends what it queued) or refused after it.
+		s.setGen(parseHostGen(hostOptionsJSON))
+		s.mu.Lock()
+		accepted := 0
+		if !s.closed && s.ctx.Err() == nil {
+			s.enqueueLocked(req.Candidates)
+			accepted = len(req.Candidates)
+		}
+		s.mu.Unlock()
+		current.Unlock()
+		s.kick()
+		return encode(Ack{Type: "scan_ack", ScanID: s.req.ScanID, Accepted: accepted, MemMB: memMB(plat)})
+	}
+	current.Unlock()
+	s.setGen(parseHostGen(hostOptionsJSON))
+	switch req.Action {
+	case "scan_poll":
+		return encode(s.progress(req.Since))
+	case "scan_freeze":
+		// Step 1 of the two-step cancel: nothing new starts (the dispatcher holds the same lock), probes
+		// in flight keep draining; answered at once with what is spent and still reserved.
+		s.mu.Lock()
+		s.gate.Freeze()
+		spent, reserved := s.gate.Spent(), s.gate.Reserved()
+		s.mu.Unlock()
+		s.kick()
+		return encode(FreezeAck{Type: "scan_freeze_ack", ScanID: s.req.ScanID, Spent: spent, Reserved: reserved})
+	case "scan_cancel":
+		// Step 2, answered at once: every probe ends, then the closing access attempt, then the
+		// final scan_progress (done, final, bytes_spent, access_close). The ack carries the final
+		// total only when the scan is already over.
+		s.abort(ReasonCancelled)
+		ack := Ack{Type: "scan_ack", ScanID: s.req.ScanID, MemMB: memMB(plat)}
+		s.mu.Lock()
+		if s.final {
+			ack.Final, ack.BytesSpent = bp(true), i64(s.gate.Spent())
+		}
+		s.mu.Unlock()
+		return encode(ack)
+	}
+	return encode(ErrorReply{Error: "unknown_action"}) // not reached: DecodeRequest knows the actions
+}
+
+var (
+	staleEpochReply = ErrorReply{Error: "stale_epoch", Detail: "host_epoch"}
+	stoppingReply   = ErrorReply{Error: "internal", Detail: "stopping"}
+)
+
+func start(req *StartRequest, hostOptionsJSON string, epoch *int64, plat Platform) string {
+	current.Lock()
+	stale := staleLocked(epoch)
+	current.Unlock()
+	if stale {
+		return encode(staleEpochReply) // nothing opened
+	}
+	opts, ok := parseHostOptions(hostOptionsJSON)
+	if !ok {
+		return encode(ErrorReply{Error: "bad_request", Detail: "host_options"})
+	}
+	if plat.RequireBindInterface && !opts.binds() {
+		return encode(ErrorReply{Error: "bad_request", Detail: "host_options.bind_interface"})
+	}
+	if plat.RequireProtection && !opts.binds() && (plat.Protect == nil || (plat.ProtectArmed != nil && !plat.ProtectArmed())) {
+		return encode(ErrorReply{Error: "no_vpn"})
+	}
+	need := plat.MemStartMinMB
+	if opts.MemStartMinMB > 0 {
+		need = opts.MemStartMinMB
+	}
+	if plat.AvailableMB != nil {
+		if av := plat.AvailableMB(); av >= 0 && av < need {
+			r := ErrorReply{Error: "memory", MemMB: memMB(plat), NeedMB: i64(int64(need + 0.5))}
+			if r.MemMB == nil {
+				r.MemMB = i64(0)
+			}
+			return encode(r)
+		}
+	}
+	// One scan at a time, and never next to a teardown still running: the old scan stops first
+	// (bounded), else this start is refused and the host may try again.
+	current.Lock()
+	if staleLocked(epoch) {
+		current.Unlock()
+		return encode(staleEpochReply)
+	}
+	stops, stopSignal := current.stops, current.stopped
+	old := current.scan
+	if old != nil {
+		teardownLocked(old, ReasonCancelled)
+	}
+	pending := stillTearingLocked()
+	current.Unlock()
+	if len(pending) > 0 {
+		if h := startWaitHook.Load(); h != nil {
+			(*h)()
+		}
+	}
+	deadline := time.Now().Add(replaceWait)
+	for {
+		waited := waitStopped(pending, time.Until(deadline), stopSignal)
+		// Under the lock a stop records its epoch with: a stop that covers this start's epoch and came
+		// while it waited (or before it got here) wins - this start opens nothing. A stop of an older
+		// epoch does not touch it: it goes on waiting.
+		current.Lock()
+		var refuse *ErrorReply
+		switch {
+		case staleLocked(epoch):
+			refuse = &staleEpochReply
+		case coveredSinceLocked(stops, epoch), current.scan != old: // a covering stop, a concurrent start
+			refuse = &stoppingReply
+		case !waited && !time.Now().Before(deadline): // the teardown still going on
+			refuse = &stoppingReply
+		}
+		if refuse != nil {
+			current.Unlock()
+			return encode(*refuse)
+		}
+		if !waited { // woken by a stop that does not cover this start
+			stopSignal = current.stopped
+			pending = stillTearingLocked()
+			current.Unlock()
+			continue
+		}
+		break
+	}
+	s := newScan(req, opts, plat)
+	s.gen = parseHostGen(hostOptionsJSON)
+	s.hostEpoch = epoch
+	current.scan = s
+	current.Unlock()
+	go s.run()
+	return encode(Ack{Type: "scan_ack", ScanID: req.ScanID, Accepted: len(req.Candidates), MemMB: memMB(plat)})
+}
+
+func isStopped(s *Scan) bool {
+	select {
+	case <-s.stopped:
+		return true
+	default:
+		return false
+	}
+}
+
+// StopAll tears the scan down (reason tunnel_stopped: probes, AmneziaWG sessions and their child
+// processes end, the closing access attempt is cancelled = not attempted) and waits up to wait
+// (max 10 s). true = NOTHING of any scan is alive any more (no instance, job, session, child, access
+// attempt, closing goroutine). false = the teardown goes on in the background; scan_start is refused
+// until it has finished, and a later StopAll waits for it again. The items stay pollable.
+func StopAll(wait time.Duration) bool { return stopAll(wait, nil) }
+
+// stopAll is StopAll for the work of host epoch `epoch` and older (scan_stop_all; nil = everything):
+// the epoch is recorded with the teardown, under the lock every start and add check it with; a start
+// of a covered epoch waiting for a teardown is cancelled. It waits only for scans it covers: true =
+// nothing of its epoch or older is alive (a newer scan the host started after it is left alone).
+func stopAll(wait time.Duration, epoch *int64) bool {
+	current.Lock()
+	if epoch != nil && *epoch > current.epoch {
+		current.epoch = *epoch
+	}
+	current.stops++
+	current.log = append(current.log, stopRecord{seq: current.stops, epoch: epoch})
+	if n := len(current.log); n > stopLogLen {
+		current.log = append([]stopRecord(nil), current.log[n-stopLogLen:]...)
+	}
+	close(current.stopped)
+	current.stopped = make(chan struct{})
+	if s := current.scan; s != nil && !isStopped(s) && stopCovers(epoch, s.hostEpoch) {
+		teardownLocked(s, ReasonTunnelStopped)
+	}
+	var pending []*Scan
+	for _, s := range stillTearingLocked() {
+		if stopCovers(epoch, s.hostEpoch) {
+			pending = append(pending, s)
+		}
+	}
+	current.Unlock()
+	if wait > maxStopWait {
+		wait = maxStopWait
+	}
+	return waitStopped(pending, wait, nil)
+}
+
+// StopAllJSON is StopAll for the C exports: {"stopped":true}, or {"stopped":false} with what is
+// still alive at that moment (LiveWork, top-level numbers, the field order fixed):
+// {"stopped":false,"instances":n,"jobs":n,"closers":n,"attempts":n,"awg":n,"children":n}.
+// instances = probe core instances (a leg instance still closing included, also in closers), jobs =
+// reach and data jobs, attempts = direct access attempts, awg = the runner's AmneziaWG devices,
+// children = its probe child processes. "stopped" is the only field a host has to read.
+func StopAllJSON(waitMs int64) string {
+	return stopAllJSON(time.Duration(waitMs)*time.Millisecond, nil)
+}
+
+func stopAllJSON(wait time.Duration, epoch *int64) string {
+	if stopAll(wait, epoch) {
+		return `{"stopped":true}`
+	}
+	// The counts are process-wide, and they are only the covered scans': a start waits for every
+	// teardown before it installs, so a newer scan this stop spared never runs next to an older one it
+	// waits for (a stop that spares one has nothing to wait for and answered true).
+	return stopReplyFalse(LiveWork())
+}
+
+func stopReplyFalse(w Work) string {
+	return encode(struct {
+		Stopped   bool  `json:"stopped"`
+		Instances int64 `json:"instances"`
+		Jobs      int64 `json:"jobs"`
+		Closers   int64 `json:"closers"`
+		Attempts  int64 `json:"attempts"`
+		Awg       int64 `json:"awg"`
+		Children  int64 `json:"children"`
+	}{false, w.Instances, w.Jobs, w.Closers, w.Access, w.Awg, w.Children})
+}
diff --git a/tribescan/fetch.go b/tribescan/fetch.go
new file mode 100644
index 0000000..08b9647
--- /dev/null
+++ b/tribescan/fetch.go
@@ -0,0 +1,499 @@
+package tribescan
+
+// One probe attempt: a stream dialled into the probe instance (core.Dial, no socket of our own),
+// Go's own TLS to the probe host, two GET /v1/probe on that one connection (HTTP/1.1 keep-alive):
+// a warm-up body (ttfb1_ms includes every handshake of the path), then the sized body (rtt_ms =
+// its first byte after the request = one full-path round trip; t64_ms = its first to last byte).
+// The cnc connection core.Dial returns ignores deadlines, so a watchdog closes it when a limit is
+// hit or the scan stops; the reader then fails and the watchdog's reason is the verdict. The stream
+// also ends with the dial's context (the job deadline, the scan's stop), which can close it before
+// the watchdog's next tick: a failed or cut-short stream is then named here the way the watchdog
+// names it (watch.settle), so the verdict does not depend on which of the two closed it first.
+
+import (
+	"bufio"
+	"context"
+	"crypto/sha256"
+	"crypto/tls"
+	"crypto/x509"
+	"encoding/hex"
+	"errors"
+	"io"
+	"net"
+	"net/http"
+	"net/url"
+	"strconv"
+	"strings"
+	"sync"
+	"time"
+
+	xnet "github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/common/session"
+	"github.com/xtls/xray-core/core"
+)
+
+const (
+	watchTick        = 20 * time.Millisecond
+	memCheckInterval = 250 * time.Millisecond
+	errBodyCap       = 4 << 10
+	readChunk        = 16 << 10
+)
+
+type limits struct {
+	ttfb       time.Duration
+	stall      time.Duration
+	stallAfter int64
+}
+
+// watch is the per-attempt watchdog and the plaintext read meter.
+type watch struct {
+	mu        sync.Mutex
+	lim       limits
+	end       time.Time // the job budget
+	waiting   bool      // waiting for the first byte of a response
+	waitFrom  time.Time
+	firstAt   time.Time
+	reading   bool // inside a body
+	bodyBytes int64
+	lastRead  time.Time
+	readTotal int64 // plaintext bytes of this attempt (headers + bodies)
+	allowance int64 // plaintext bytes this attempt may read (cost_bytes); < 0 = no limit
+	fired     string
+	closeOnce sync.Once
+	closeFn   func()
+	ctx       context.Context // the attempt's: done = the scan stops
+	dctx      context.Context // the dial's: done at the job deadline too (it ends an Xray stream)
+	stopCode  func() string   // the scan's stop code (Scan.stopCode)
+}
+
+func (w *watch) armFirst(from time.Time) {
+	w.mu.Lock()
+	w.waiting, w.waitFrom, w.firstAt, w.reading, w.bodyBytes = true, from, time.Time{}, false, 0
+	w.mu.Unlock()
+}
+
+func (w *watch) first() time.Time {
+	w.mu.Lock()
+	defer w.mu.Unlock()
+	return w.firstAt
+}
+
+func (w *watch) armBody() {
+	w.mu.Lock()
+	w.reading, w.bodyBytes, w.lastRead = true, 0, time.Now()
+	w.mu.Unlock()
+}
+
+func (w *watch) bodyProgress(n int64) {
+	w.mu.Lock()
+	w.bodyBytes = n
+	w.mu.Unlock()
+}
+
+func (w *watch) onRead(n int) {
+	now := time.Now()
+	w.mu.Lock()
+	if w.waiting {
+		w.waiting, w.firstAt = false, now
+	}
+	w.readTotal += int64(n)
+	w.lastRead = now
+	w.mu.Unlock()
+}
+
+func (w *watch) total() int64 {
+	w.mu.Lock()
+	defer w.mu.Unlock()
+	return w.readTotal
+}
+
+func (w *watch) firedCode() string {
+	w.mu.Lock()
+	defer w.mu.Unlock()
+	return w.fired
+}
+
+func (w *watch) fire(code string) {
+	w.mu.Lock()
+	if w.fired == "" {
+		w.fired = code
+	}
+	w.mu.Unlock()
+	w.closeOnce.Do(w.closeFn)
+}
+
+// deadlineCodeLocked names the job deadline: ttfb_timeout when nothing came back yet, else total_timeout.
+func (w *watch) deadlineCodeLocked() string {
+	if w.waiting && w.readTotal == 0 {
+		return ErrTTFB
+	}
+	return ErrTotal
+}
+
+func (w *watch) check(now time.Time) string {
+	w.mu.Lock()
+	defer w.mu.Unlock()
+	if !now.Before(w.end) {
+		return w.deadlineCodeLocked()
+	}
+	if w.waiting && now.Sub(w.waitFrom) > w.lim.ttfb {
+		return ErrTTFB
+	}
+	if w.reading && w.bodyBytes >= w.lim.stallAfter && now.Sub(w.lastRead) > w.lim.stall {
+		return ErrStalled
+	}
+	return ""
+}
+
+// settle is the verdict of a stream that failed or ended short: the watchdog's code when it fired,
+// else what closed the stream from outside, fired here as the watchdog would name it at this
+// moment - the scan stopping (its stop code) or the job deadline (deadlineCodeLocked; the dial's
+// context carries it and ends an Xray stream at once, possibly before the watchdog's next tick).
+// "" = nothing from outside: the peer ended the stream.
+func (w *watch) settle() string {
+	if code := w.firedCode(); code != "" {
+		return code
+	}
+	switch {
+	case w.ctx != nil && w.ctx.Err() != nil:
+		code := ErrCancelled
+		if w.stopCode != nil {
+			code = w.stopCode()
+		}
+		w.fire(code)
+	case !time.Now().Before(w.end) || (w.dctx != nil && w.dctx.Err() != nil):
+		w.mu.Lock()
+		code := w.deadlineCodeLocked()
+		w.mu.Unlock()
+		w.fire(code)
+	default:
+		return ""
+	}
+	return w.firedCode()
+}
+
+func (w *watch) run(ctx context.Context, s *Scan, stop <-chan struct{}) {
+	defer func() { recover() }() //nolint:errcheck // a watchdog panic must not take the host down
+	t := time.NewTicker(watchTick)
+	defer t.Stop()
+	var lastMem time.Time
+	for {
+		select {
+		case <-stop:
+			return
+		case <-ctx.Done():
+			w.fire(s.stopCode())
+			return
+		case now := <-t.C:
+			if now.Sub(lastMem) >= memCheckInterval {
+				lastMem = now
+				if !s.memRunOK() {
+					w.fire(ErrMemory)
+					s.abort(ReasonMemory)
+					return
+				}
+			}
+			if code := w.check(now); code != "" {
+				w.fire(code)
+				return
+			}
+		}
+	}
+}
+
+type meterReader struct {
+	r io.Reader
+	w *watch
+}
+
+func (m *meterReader) Read(p []byte) (int, error) {
+	if left := m.w.left(); left >= 0 {
+		if left == 0 { // the probe reached its cost_bytes: cut before it passes it
+			m.w.fire(ErrBudget)
+			return 0, errors.New("probe byte limit reached")
+		}
+		if int64(len(p)) > left {
+			p = p[:left]
+		}
+	}
+	n, err := m.r.Read(p)
+	if n > 0 {
+		m.w.onRead(n)
+	}
+	return n, err
+}
+
+// left is what the attempt may still read (< 0 = no limit).
+func (w *watch) left() int64 {
+	w.mu.Lock()
+	defer w.mu.Unlock()
+	if w.allowance < 0 {
+		return -1
+	}
+	return max(0, w.allowance-w.readTotal)
+}
+
+// isTLSAnswer: something answered the handshake, and it is not our server (a certificate that
+// does not verify, an alert, plain text on the TLS port). Not retried.
+func isTLSAnswer(err error) bool {
+	var unknownAuthority x509.UnknownAuthorityError
+	var hostname x509.HostnameError
+	var invalid x509.CertificateInvalidError
+	var verify *tls.CertificateVerificationError
+	var record tls.RecordHeaderError
+	var alert tls.AlertError
+	return errors.As(err, &unknownAuthority) || errors.As(err, &hostname) || errors.As(err, &invalid) ||
+		errors.As(err, &verify) || errors.As(err, &record) || errors.As(err, &alert)
+}
+
+type exchangeResult struct {
+	firstAt  time.Time
+	lastAt   time.Time
+	body     int64
+	status   int
+	ok       bool
+	code     string
+	notYet   bool
+	header   http.Header
+	answered bool // an HTTP response arrived
+}
+
+func writeProbeRequest(w io.Writer, u *url.URL, s *StartRequest) error {
+	var b strings.Builder
+	b.Grow(256 + len(s.Token))
+	b.WriteString("GET ")
+	b.WriteString(u.RequestURI())
+	b.WriteString(" HTTP/1.1\r\nHost: ")
+	b.WriteString(u.Host)
+	b.WriteString("\r\nAuthorization: Bearer ")
+	b.WriteString(s.Token)
+	b.WriteString("\r\nAccept: application/octet-stream\r\nAccept-Encoding: identity\r\nUser-Agent: TribeScan/1\r\n")
+	if s.AccessNetToken != "" {
+		b.WriteString("X-Tribe-Access-Net-Token: ")
+		b.WriteString(s.AccessNetToken)
+		b.WriteString("\r\n")
+	}
+	if s.AccessAsn > 0 {
+		b.WriteString("X-Tribe-Access-Asn: ")
+		b.WriteString(strconv.FormatInt(s.AccessAsn, 10))
+		b.WriteString("\r\n")
+	}
+	b.WriteString("\r\n")
+	_, err := io.WriteString(w, b.String())
+	return err
+}
+
+// failRead classifies a failed write/read: the watchdog's reason or what closed the stream (settle),
+// else "nothing came back" (retried when early_retry) when the attempt has not received a single
+// plaintext byte, else the fallback.
+func failRead(w *watch, fallback string) exchangeResult {
+	if code := w.settle(); code != "" {
+		return exchangeResult{code: code, notYet: code == ErrTTFB && w.total() == 0}
+	}
+	if w.total() == 0 {
+		return exchangeResult{code: ErrDial, notYet: true}
+	}
+	return exchangeResult{code: fallback}
+}
+
+// exchange sends one GET for (nonce, size) and reads and verifies the answer. Anything but a 200 of
+// our server (X-Tribe-Api: 1) is "http" with its status: a portal, a block page, a redirect, our
+// server refusing the token or the budget.
+func exchange(conn io.Writer, br *bufio.Reader, w *watch, u *url.URL, s *StartRequest, nonce string, size int64) exchangeResult {
+	if err := writeProbeRequest(conn, u, s); err != nil {
+		return failRead(w, ErrShort)
+	}
+	resp, err := http.ReadResponse(br, nil)
+	if err != nil {
+		return failRead(w, ErrHTTP)
+	}
+	defer resp.Body.Close()
+	r := exchangeResult{header: resp.Header, answered: true, firstAt: w.first(), status: resp.StatusCode}
+	if r.firstAt.IsZero() {
+		r.firstAt = time.Now()
+	}
+	if resp.Header.Get("X-Tribe-Api") != "1" || resp.StatusCode != http.StatusOK {
+		r.code = ErrHTTP
+		return r
+	}
+	expected := size
+	if v := resp.Header.Get("X-Tribe-Probe-Len"); v != "" {
+		n, err := strconv.ParseInt(v, 10, 64)
+		switch {
+		case err != nil || n < 0 || n > size:
+			r.code = ErrDigest
+			return r
+		case n > 0:
+			expected = n
+		}
+	}
+	if resp.ContentLength > expected {
+		r.code = ErrDigest
+		return r
+	}
+	if v := resp.Header.Get("X-Tribe-Probe-Nonce"); v != "" && v != nonce {
+		r.code = ErrDigest
+		return r
+	}
+	w.armBody()
+	h := sha256.New()
+	buf := make([]byte, readChunk)
+	body := io.LimitReader(resp.Body, expected+1)
+	for {
+		k, err := body.Read(buf)
+		if k > 0 {
+			h.Write(buf[:k])
+			r.body += int64(k)
+			r.lastAt = time.Now()
+			w.bodyProgress(r.body)
+		}
+		if err == io.EOF {
+			break
+		}
+		if err != nil {
+			r.code = failRead(w, ErrShort).code
+			return r
+		}
+	}
+	if r.body < expected {
+		// A clean end before the announced length: the peer's, unless the scan's stop or the job
+		// deadline closed the stream (an Xray stream ends with the dial's context).
+		if code := w.settle(); code != "" {
+			r.code = code
+			return r
+		}
+	}
+	switch {
+	case r.body > expected:
+		r.code = ErrDigest
+	case r.body == 0 && expected > 0:
+		r.code, r.notYet = ErrDial, true
+	case r.body < expected:
+		r.code = ErrShort
+	case hex.EncodeToString(h.Sum(nil)) != ExpectedSHA256Hex(nonce, expected):
+		r.code = ErrDigest
+	default:
+		r.ok = true
+	}
+	return r
+}
+
+type attemptOut struct {
+	item   Item
+	notYet bool
+	spent  int64 // plaintext bytes read + 8192 per TLS connection
+	read   int64 // plaintext bytes read
+}
+
+// xrayDial is the stream of an Xray probe: core.Dial into the instance (forced tag / inbound tag).
+func (s *Scan) xrayDial(inst *core.Instance, plan *probePlan) func(context.Context) (net.Conn, error) {
+	return func(ctx context.Context) (net.Conn, error) {
+		if plan.inboundTag != "" {
+			ctx = session.ContextWithInbound(ctx, &session.Inbound{Tag: plan.inboundTag})
+		}
+		if plan.forcedTag != "" {
+			ctx = session.SetForcedOutboundTagToContext(ctx, plan.forcedTag)
+		}
+		return core.Dial(ctx, inst, xnet.TCPDestination(xnet.ParseAddress(s.host), xnet.Port(s.port)))
+	}
+}
+
+// attempt runs one probe attempt over the stream dial gives (dialErr: the item error when it
+// fails): TLS with tlsName, the warm-up and the sized GET of base + probe.path.
+func (s *Scan) attempt(dial func(context.Context) (net.Conn, error), dialErr, tlsName, base string, c *Candidate,
+	end time.Time, allowance int64) (out attemptOut) {
+	size := s.bodyBytes(c)
+	out.item = *dataItem(c, size, "")
+	ctx, cancel := context.WithCancel(s.pctx)
+	defer cancel()
+	t0 := time.Now()
+	// The dial's context lives as long as the attempt: an Xray stream (core.Dial) ends with it.
+	dctx, dcancel := context.WithDeadline(ctx, end)
+	defer dcancel()
+	conn, err := dial(dctx)
+	if err != nil {
+		out.item.Error = dialErr
+		out.notYet = dialErr == ErrDial
+		return out
+	}
+	out.spent = tlsOverhead
+	defer conn.Close()
+	l := s.req.Limits
+	w := &watch{lim: limits{ttfb: time.Duration(l.TTFBMs) * time.Millisecond, stall: time.Duration(l.StallMs) * time.Millisecond,
+		stallAfter: int64(l.StallAfterBytes)}, end: end, waiting: true, waitFrom: t0, closeFn: func() { conn.Close() },
+		allowance: -1, ctx: ctx, dctx: dctx, stopCode: s.stopCode}
+	if allowance >= 0 {
+		w.allowance = allowance - tlsOverhead
+	}
+	stop := make(chan struct{})
+	defer close(stop)
+	go w.run(ctx, s, stop)
+	defer func() { out.read = w.total(); out.spent = tlsOverhead + out.read }() // wire bytes read (headers + bodies, cut ones too)
+
+	tconn := tls.Client(conn, &tls.Config{
+		ServerName: tlsName,
+		NextProtos: []string{"http/1.1"},
+		MinVersion: tls.VersionTLS12,
+		RootCAs:    s.plat.RootCAs, // nil in production: the platform verifier with system roots
+	})
+	if err := tconn.Handshake(); err != nil {
+		if code := w.settle(); code != "" {
+			out.item.Error, out.notYet = code, code == ErrTTFB
+		} else if isTLSAnswer(err) {
+			out.item.Error = ErrTLS
+		} else {
+			out.item.Error, out.notYet = ErrDial, true
+		}
+		return out
+	}
+	br := bufio.NewReaderSize(&meterReader{r: tconn, w: w}, 32<<10)
+	warmNonce, bodyNonce := newNonce(), newNonce()
+	ex1 := exchange(tconn, br, w, probeURL(base, s.req.ProbePath, c.ProfileID, s.req.WarmBytes, warmNonce),
+		s.req, warmNonce, s.req.WarmBytes)
+	*out.item.HTTPStatus = ex1.status
+	if ex1.answered {
+		out.item.Ttfb1Ms = i64(ex1.firstAt.Sub(t0).Milliseconds())
+		egress(&out.item, ex1.header)
+	}
+	if ex1.code != "" {
+		out.item.Error, out.notYet = ex1.code, ex1.notYet
+		return out
+	}
+	*out.item.HTTPStatus = 0 // from here the item describes the sized request
+	t2 := time.Now()
+	w.armFirst(t2)
+	ex2 := exchange(tconn, br, w, probeURL(base, s.req.ProbePath, c.ProfileID, size, bodyNonce), s.req, bodyNonce, size)
+	*out.item.Bytes = ex2.body
+	if ex2.answered {
+		*out.item.HTTPStatus = ex2.status
+		out.item.RttMs = i64(ex2.firstAt.Sub(t2).Milliseconds())
+		egress(&out.item, ex2.header)
+		if !ex2.lastAt.IsZero() {
+			out.item.T64Ms = i64(ex2.lastAt.Sub(ex2.firstAt).Milliseconds())
+		}
+	}
+	*out.item.ShaOK = ex2.ok
+	out.item.Error = ex2.code // the path carried the warm-up body: never "not yet" here
+	return out
+}
+
+// egress copies the answer's egress facts verbatim (our server only: X-Tribe-Api: 1).
+func egress(it *Item, h http.Header) {
+	if h == nil || h.Get("X-Tribe-Api") != "1" {
+		return
+	}
+	if v := h.Get("X-Tribe-Egress-Class"); v != "" {
+		it.EgressClass = sp(v)
+	}
+	if v := h.Get("X-Tribe-Egress-Asn"); v != "" {
+		if n, err := strconv.ParseInt(v, 10, 64); err == nil && n > 0 && n <= 4294967295 {
+			it.EgressAsn = i64(n)
+		}
+	}
+	if v := h.Get("X-Tribe-Net-Token"); v != "" {
+		it.NetToken = sp(v)
+	}
+	if v := h.Get("X-Tribe-Egress-Node"); v != "" {
+		it.EgressNode = sp(v)
+	}
+}
