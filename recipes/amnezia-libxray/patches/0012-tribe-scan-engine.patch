@@ -0,0 +1,14 @@
+//go:build darwin
+
+package tribescan
+
+import "syscall"
+
+// bindSocket pins a probe socket to the physical interface (IP_BOUND_IF / IPV6_BOUND_IF): its
+// packets leave through that interface whatever the routing table says (a tunnel's utun included).
+func bindSocket(network string, fd uintptr, index int, _ string) error {
+	if network == "tcp6" || network == "udp6" {
+		return syscall.SetsockoptInt(int(fd), syscall.IPPROTO_IPV6, syscall.IPV6_BOUND_IF, index)
+	}
+	return syscall.SetsockoptInt(int(fd), syscall.IPPROTO_IP, syscall.IP_BOUND_IF, index)
+}
