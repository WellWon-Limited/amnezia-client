+		if d.Error != "" || !deref(d.ShaOK) || len(refusals) < 2 || deref(d.Retries) != len(refusals) {
+			t.Fatalf("want success after early refusals, got %+v (refusals %d)", d, len(refusals))
+		}
+		for i := 1; i < len(refusals); i++ {
+			if gap := refusals[i].Sub(refusals[i-1]); gap < 280*time.Millisecond {
+				t.Fatalf("retry %d came %v after the previous refusal", i, gap)
+			}
+		}
+	})
+	t.Run("never opens", func(t *testing.T) {
+		gate := NewGate(t, e.vless)
+		r := KitRun(t, KitRequest("s-closed", e.srv.Base(), nil, 15000, KitFullCandidate("dead", gate.Port())), "", e.plat, 20*time.Second)
+		d, _ := r.DataByID("dead")
+		refusals := gate.Refusals()
+		var gaps []string
+		for i := 1; i < len(refusals); i++ {
+			gaps = append(gaps, refusals[i].Sub(refusals[i-1]).Round(10*time.Millisecond).String())
+		}
+		t.Logf("refusals=%d gaps=%v", len(refusals), gaps)
+		// 5 s budget: attempts at ~0, 300, 900, 2100 ms; a 2000 ms wait would leave < 1 s.
+		if d.Error != ErrDial || len(refusals) != 4 || deref(d.Retries) != 3 || deref(d.SpentBytes) != 4*512 {
+			t.Fatalf("want dial after 4 attempts, got %+v (%d)", d, len(refusals))
+		}
+	})
+	t.Run("early_retry false", func(t *testing.T) {
+		gate := NewGate(t, e.vless)
+		cand := KitFullCandidate("once", gate.Port())
+		cand["early_retry"] = false
+		r := KitRun(t, KitRequest("s-once", e.srv.Base(), nil, 15000, cand), "", e.plat, 20*time.Second)
+		if d, _ := r.DataByID("once"); d.Error != ErrDial || len(gate.Refusals()) != 1 || deref(d.Retries) != 0 {
+			t.Fatalf("%+v refusals %d", d, len(gate.Refusals()))
+		}
+	})
+	assertNoInstances(t)
+}
+
+func TestTribeScanCancelReplaceStopAll(t *testing.T) {
+	e := newKitEnv(t)
+	e.srv.SetMode("stall", false)
+	defer e.srv.SetMode("ok", false)
+	limits := map[string]any{"stall_ms": 10000, "total_ms": 30000, "concurrency": 1}
+	t.Run("cancel", func(t *testing.T) {
+		var ack Ack
+		KitMessage(t, KitRequest("s-cancel", e.srv.Base(), limits, 60000, KitFullCandidate("a", e.vless), KitFullCandidate("b", e.vless)), "", e.plat, &ack)
+		stalls := e.srv.Stalled()
+		KitWaitFor(t, "the first job's body stalled", 10*time.Second, func() bool { return e.srv.Stalled() > stalls })
+		if LiveInstances() != 1 {
+			t.Fatalf("expected the first job running, live=%d", LiveInstances())
+		}
+		t0 := time.Now()
+		KitMessage(t, `{"action":"scan_cancel","scan_id":"s-cancel"}`, "", e.plat, &ack)
+		// Answered at once; a probe is in flight, so no final total in the ack.
+		if ack.Type != "scan_ack" || ack.ScanID != "s-cancel" || ack.Final != nil || time.Since(t0) > 200*time.Millisecond {
+			t.Fatalf("cancel ack %+v after %v", ack, time.Since(t0))
+		}
+		// The final progress: the 1 KiB warm-up, the headers and the 32 KiB the stalled body had
+		// delivered plus one TLS connection, and both access attempts (review F7, plan §2.2c).
+		p := KitPollFinal(t, "s-cancel", 5*time.Second)
+		assertNoInstances(t)
+		// (the stalled body counts as far as it was read; the warm-up and both TLS connections at least)
+		if p.Reason != ReasonCancelled || p.BytesSpent <= 8192+1024+2*8192 || p.Access == nil || p.AccessClose == nil ||
+			time.Since(t0) > 2*time.Second {
+			t.Fatalf("final after cancel: %+v after %v", p, time.Since(t0))
+		}
+		var again Ack
+		KitMessage(t, `{"action":"scan_cancel","scan_id":"s-cancel"}`, "", e.plat, &again)
+		if !deref(again.Final) || deref(again.BytesSpent) != p.BytesSpent {
+			t.Fatalf("cancel of a finished scan: %+v, final total %d", again, p.BytesSpent)
+		}
+	})
+	t.Run("freeze, then cancel", func(t *testing.T) {
+		var ack Ack
+		KitMessage(t, KitRequest("s-freeze", e.srv.Base(), limits, 60000, KitFullCandidate("a", e.vless), KitFullCandidate("b", e.vless)), "", e.plat, &ack)
+		stalls := e.srv.Stalled()
+		KitWaitFor(t, "the first job's body stalled", 10*time.Second, func() bool { return e.srv.Stalled() > stalls })
+		t0 := time.Now()
+		var fa FreezeAck
+		KitMessage(t, `{"action":"scan_freeze","scan_id":"s-freeze"}`, "", e.plat, &fa)
+		// Answered at once: "a" (in flight) still holds its 83456, the closing attempt its 10240; "b"
+		// never starts.
+		if fa.Type != "scan_freeze_ack" || fa.ScanID != "s-freeze" || fa.Reserved != 83456+10240 || time.Since(t0) > 100*time.Millisecond {
+			t.Fatalf("freeze ack %+v after %v", fa, time.Since(t0))
+		}
+		time.Sleep(300 * time.Millisecond) // a negative check: nothing may start in this time
+		var p Progress
+		KitMessage(t, `{"action":"scan_poll","scan_id":"s-freeze","since":0}`, "", e.plat, &p)
+		if p.Done || len(p.Items) != 0 || LiveInstances() != 1 {
+			t.Fatalf("frozen scan: %+v live %d", p, LiveInstances())
+		}
+		KitMessage(t, `{"action":"scan_cancel","scan_id":"s-freeze"}`, "", e.plat, &ack)
+		p = KitPollFinal(t, "s-freeze", 5*time.Second)
+		// The freeze ack bounds everything the scan transferred afterwards.
+		if p.BytesSpent > fa.Spent+fa.Reserved || p.BytesSpent < fa.Spent+8192+1024 || p.AccessClose == nil {
+			t.Fatalf("final %+v after freeze ack %+v", p, fa)
+		}
+		assertNoInstances(t)
+	})
+	t.Run("a new start ends the running scan", func(t *testing.T) {
+		var ack Ack
+		KitMessage(t, KitRequest("s-old", e.srv.Base(), limits, 60000, KitFullCandidate("a", e.vless)), "", e.plat, &ack)
+		stalls := e.srv.Stalled()
+		KitWaitFor(t, "the old scan's body stalled", 10*time.Second, func() bool { return e.srv.Stalled() > stalls })
+		e.srv.SetMode("ok", false)
+		r := KitRun(t, KitRequest("s-new", e.srv.Base(), nil, 10000, KitFullCandidate("n", e.vless)), "", e.plat, 20*time.Second)
+		if d, _ := r.DataByID("n"); d.Error != "" || r.Final.Reason != ReasonComplete {
+			t.Fatalf("new scan %+v %+v", d, r.Final)
+		}
+		var er ErrorReply
+		KitMessage(t, `{"action":"scan_poll","scan_id":"s-old","since":0}`, "", e.plat, &er)
+		if er.Error != "unknown_scan" {
+			t.Fatalf("old scan still pollable: %+v", er)
+		}
+		e.srv.SetMode("stall", false)
+	})
+	t.Run("StopAll waits and keeps the items", func(t *testing.T) {
+		var ack Ack
+		KitMessage(t, KitRequest("s-stop", e.srv.Base(), limits, 60000, KitFullCandidate("a", e.vless)), "", e.plat, &ack)
+		stalls := e.srv.Stalled()
+		KitWaitFor(t, "the job's body stalled", 10*time.Second, func() bool { return e.srv.Stalled() > stalls })
+		t0 := time.Now()
+		if !StopAll(3*time.Second) || LiveInstances() != 0 || time.Since(t0) > 2*time.Second {
+			t.Fatalf("StopAll: live %d after %v", LiveInstances(), time.Since(t0))
+		}
+		r := KitPoll(t, &KitResult{ScanID: "s-stop"}, 5*time.Second, time.Now())
+		if p := r.Final; !p.Done || p.Reason != ReasonTunnelStopped || len(r.Items) != 1 || r.Items[0].Error != ErrCancelled {
+			t.Fatalf("after StopAll: %+v %+v", p, r.Items)
+		}
+	})
+}
