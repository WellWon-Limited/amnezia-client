--- /dev/null
+++ b/tribescan/protect_windows.go
@@ -0,0 +1,27 @@
+//go:build windows
+
+package tribescan
+
+import (
+	"encoding/binary"
+	"syscall"
+	"unsafe"
+)
+
+const (
+	ipUnicastIf   = 31 // IP_UNICAST_IF (ws2ipdef.h)
+	ipv6UnicastIf = 31 // IPV6_UNICAST_IF
+)
+
+// bindSocket pins a probe socket to the interface (IP_UNICAST_IF takes the index in network byte
+// order, IPV6_UNICAST_IF in host order).
+func bindSocket(network string, fd uintptr, index int, _ string) error {
+	if network == "tcp6" || network == "udp6" {
+		v := uint32(index)
+		return syscall.Setsockopt(syscall.Handle(fd), syscall.IPPROTO_IPV6, ipv6UnicastIf, (*byte)(unsafe.Pointer(&v)), 4)
+	}
+	var be [4]byte
+	binary.BigEndian.PutUint32(be[:], uint32(index))
+	v := binary.NativeEndian.Uint32(be[:])
+	return syscall.Setsockopt(syscall.Handle(fd), syscall.IPPROTO_IP, ipUnicastIf, (*byte)(unsafe.Pointer(&v)), 4)
+}
diff --git a/tribescan/protocols_test.go b/tribescan/protocols_test.go
new file mode 100644
index 0000000..503043a
--- /dev/null
+++ b/tribescan/protocols_test.go
@@ -0,0 +1,260 @@
+//go:build tribescan_testkit
+
+package tribescan
+
+// Protocol coverage of full probes against local servers from the same core: VLESS + REALITY +
+// Vision, XHTTP, gRPC, Hysteria2 (QUIC), and a chain (sockopt.dialerProxy through a second VLESS
+// server). Every case: the probe passes, its sockets run only the probe's own protector (never the
+// process-wide controllers), and after the scan no connection of the probe is left open at the
+// server (core 0011 closes the transports' pools with the instance).
+
+import (
+	"crypto/ecdh"
+	"crypto/rand"
+	"crypto/sha256"
+	"crypto/x509"
+	"encoding/base64"
+	"encoding/hex"
+	"encoding/json"
+	"encoding/pem"
+	"fmt"
+	"io"
+	"net"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+// kitProxy counts the TCP connections it forwards to target (open now).
+type kitProxy struct {
+	ln   *net.TCPListener
+	live atomic.Int64
+	all  atomic.Int64
+}
+
+func newKitProxy(t *testing.T, target int) *kitProxy {
+	ln, err := net.ListenTCP("tcp4", &net.TCPAddr{IP: net.IPv4(127, 0, 0, 1)})
+	if err != nil {
+		t.Fatal(err)
+	}
+	p := &kitProxy{ln: ln}
+	var mu sync.Mutex
+	var conns []net.Conn
+	go func() {
+		for {
+			c, err := ln.Accept()
+			if err != nil {
+				return
+			}
+			s, err := net.Dial("tcp4", fmt.Sprintf("127.0.0.1:%d", target))
+			if err != nil {
+				c.Close()
+				continue
+			}
+			p.live.Add(1)
+			p.all.Add(1)
+			mu.Lock()
+			conns = append(conns, c, s)
+			mu.Unlock()
+			var once sync.Once
+			end := func() { once.Do(func() { c.Close(); s.Close(); p.live.Add(-1) }) }
+			go func() { io.Copy(s, c); end() }()
+			go func() { io.Copy(c, s); end() }()
+		}
+	}()
+	t.Cleanup(func() {
+		ln.Close()
+		mu.Lock()
+		for _, c := range conns {
+			c.Close()
+		}
+		mu.Unlock()
+	})
+	return p
+}
+
+func (p *kitProxy) port() int { return p.ln.Addr().(*net.TCPAddr).Port }
+
+func kitServerOutbound() []any {
+	return []any{map[string]any{"protocol": "freedom", "settings": map[string]any{"domainStrategy": "UseIPv4",
+		"finalRules": []any{map[string]any{"action": "allow"}}}}}
+}
+
+func kitServerDNS() map[string]any {
+	return map[string]any{"hosts": map[string]any{"example.com": "127.0.0.1", "example.net": "127.0.0.1"}}
+}
+
+func kitVlessUser(flow string) []any {
+	u := map[string]any{"id": KitUUID, "encryption": "none"}
+	if flow != "" {
+		u["flow"] = flow
+	}
+	return []any{u}
+}
+
+func kitVlessClients(flow string) []any {
+	u := map[string]any{"id": KitUUID}
+	if flow != "" {
+		u["flow"] = flow
+	}
+	return []any{u}
+}
+
+func kitFullWith(id string, outbounds ...any) map[string]any {
+	cfg := map[string]any{"outbounds": outbounds,
+		"routing":  map[string]any{"rules": []any{map[string]any{"type": "field", "inboundTag": []any{"socks-in"}, "outboundTag": "proxy"}}},
+		"inbounds": []any{map[string]any{"tag": "socks-in", "listen": "127.0.0.1", "port": 10808, "protocol": "socks"}}}
+	raw, _ := json.Marshal(cfg)
+	c := KitFullCandidate(id, 0)
+	c["config"] = string(raw)
+	return c
+}
+
+// kitCert is a self-signed certificate for example.com (QUIC needs TLS on the server).
+func kitCert(t *testing.T, srv *ProbeServer) (certPEM, keyPEM []string, sha string) {
+	cert := srv.Srv.TLS.Certificates[0]
+	der := cert.Certificate[0]
+	sum := sha256.Sum256(der)
+	cp := strings.Split(strings.TrimSpace(string(pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: der}))), "\n")
+	key, err := x509.MarshalPKCS8PrivateKey(cert.PrivateKey)
+	if err != nil {
+		t.Fatal(err)
+	}
+	kp := strings.Split(strings.TrimSpace(string(pem.EncodeToMemory(&pem.Block{Type: "PRIVATE KEY", Bytes: key}))), "\n")
+	return cp, kp, hex.EncodeToString(sum[:])
+}
+
+func TestTribeScanProtocols(t *testing.T) {
+	e := newKitEnv(t)
+	var processCalls, protectCalls atomic.Int64
+	watched := sync.Map{}
+	setProcessController(t, func(address string) {
+		if _, ok := watched.Load(address); ok {
+			processCalls.Add(1)
+		}
+	})
+	plat := e.plat
+	plat.Protect = func(network, address string, fd uintptr) error {
+		if _, ok := watched.Load(address); ok {
+			protectCalls.Add(1)
+		}
+		return nil
+	}
+	watch := func(port int) int { watched.Store(fmt.Sprintf("127.0.0.1:%d", port), true); return port }
+
+	type kase struct {
+		name  string
+		build func(t *testing.T) (map[string]any, *kitProxy) // candidate, the proxy in front of its server (nil: UDP)
+	}
+	cases := []kase{
+		{"vless+reality+vision", func(t *testing.T) (map[string]any, *kitProxy) {
+			priv, _ := ecdh.X25519().GenerateKey(rand.Reader)
+			port := FreePort(t)
+			StartServerCore(t, map[string]any{"dns": kitServerDNS(), "outbounds": kitServerOutbound(),
+				"inbounds": []any{map[string]any{"listen": "127.0.0.1", "port": port, "protocol": "vless",
+					"settings": map[string]any{"clients": kitVlessClients("xtls-rprx-vision"), "decryption": "none"},
+					"streamSettings": map[string]any{"network": "tcp", "security": "reality", "realitySettings": map[string]any{
+						"dest": fmt.Sprintf("127.0.0.1:%d", e.srv.Port), "serverNames": []any{"example.com"},
+						"privateKey": base64.RawURLEncoding.EncodeToString(priv.Bytes()), "shortIds": []any{"a1b2c3d4"}}}}}})
+			px := newKitProxy(t, port)
+			return kitFullWith("reality", map[string]any{"tag": "proxy", "protocol": "vless", "settings": map[string]any{
+				"vnext": []any{map[string]any{"address": "127.0.0.1", "port": watch(px.port()), "users": kitVlessUser("xtls-rprx-vision")}}},
+				"streamSettings": map[string]any{"network": "tcp", "security": "reality", "realitySettings": map[string]any{
+					"serverName": "example.com", "fingerprint": "chrome", "shortId": "a1b2c3d4",
+					"publicKey": base64.RawURLEncoding.EncodeToString(priv.PublicKey().Bytes())}}}), px
+		}},
+		{"vless+xhttp", func(t *testing.T) (map[string]any, *kitProxy) {
+			port := FreePort(t)
+			ss := map[string]any{"network": "xhttp", "xhttpSettings": map[string]any{"path": "/tribe-xhttp"}}
+			StartServerCore(t, map[string]any{"dns": kitServerDNS(), "outbounds": kitServerOutbound(),
+				"inbounds": []any{map[string]any{"listen": "127.0.0.1", "port": port, "protocol": "vless",
+					"settings": map[string]any{"clients": kitVlessClients(""), "decryption": "none"}, "streamSettings": ss}}})
+			px := newKitProxy(t, port)
+			ob := VlessOutbound("proxy", watch(px.port()))
+			ob["streamSettings"] = ss
+			return kitFullWith("xhttp", ob), px
+		}},
+		{"vless+grpc", func(t *testing.T) (map[string]any, *kitProxy) {
+			port := FreePort(t)
+			ss := map[string]any{"network": "grpc", "grpcSettings": map[string]any{"serviceName": "tribe-grpc"}}
+			StartServerCore(t, map[string]any{"dns": kitServerDNS(), "outbounds": kitServerOutbound(),
+				"inbounds": []any{map[string]any{"listen": "127.0.0.1", "port": port, "protocol": "vless",
+					"settings": map[string]any{"clients": kitVlessClients(""), "decryption": "none"}, "streamSettings": ss}}})
+			px := newKitProxy(t, port)
+			ob := VlessOutbound("proxy", watch(px.port()))
+			ob["streamSettings"] = ss
+			return kitFullWith("grpc", ob), px
+		}},
+		{"hysteria2", func(t *testing.T) (map[string]any, *kitProxy) {
+			port := FreePort(t)
+			cp, kp, sha := kitCert(t, e.srv)
+			StartServerCore(t, map[string]any{"dns": kitServerDNS(), "outbounds": kitServerOutbound(),
+				"inbounds": []any{map[string]any{"listen": "127.0.0.1", "port": port, "protocol": "hysteria",
+					"settings": map[string]any{"version": 2, "clients": []any{map[string]any{"auth": "test-auth-1"}}},
+					"streamSettings": map[string]any{"network": "hysteria", "security": "tls",
+						"tlsSettings":      map[string]any{"certificates": []any{map[string]any{"certificate": cp, "key": kp}}},
+						"hysteriaSettings": map[string]any{"version": 2, "auth": "test-auth-1"}}}}})
+			watch(port)
+			return kitFullWith("hysteria2", map[string]any{"tag": "proxy", "protocol": "hysteria",
+				"settings": map[string]any{"version": 2, "address": "127.0.0.1", "port": port},
+				"streamSettings": map[string]any{"network": "hysteria", "security": "tls",
+					"tlsSettings":      map[string]any{"serverName": "example.com", "pinnedPeerCertSha256": sha},
+					"hysteriaSettings": map[string]any{"version": 2, "auth": "test-auth-1"}}}), nil
+		}},
+		{"chain (dialerProxy)", func(t *testing.T) (map[string]any, *kitProxy) {
+			hop := StartVlessServer(t, e.srv.Port) // the hop's freedom dials the last server
+			px := newKitProxy(t, e.vless)
+			ob := VlessOutbound("proxy", watch(px.port()))
+			ob["streamSettings"] = map[string]any{"sockopt": map[string]any{"dialerProxy": "hop"}}
+			return kitFullWith("chain", ob, VlessOutbound("hop", watch(hop))), px
+		}},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			cand, px := c.build(t)
+			before, pBefore := processCalls.Load(), protectCalls.Load()
+			r := KitRun(t, KitRequest("proto-"+strings.Fields(c.name)[0], e.srv.Base(), nil, 20000, cand), "", plat, 30*time.Second)
+			d := r.Data()[0]
+			raw, _ := json.Marshal(d)
+			if d.Error != "" || !deref(d.ShaOK) || deref(d.Bytes) != 65536 {
+				t.Fatalf("probe: %s", raw)
+			}
+			if processCalls.Load() != before || protectCalls.Load() == pBefore {
+				t.Fatalf("protector calls %d, process-wide controller calls %d", protectCalls.Load()-pBefore, processCalls.Load()-before)
+			}
+			if px != nil {
+				// A chain's inner connection ends with the hop server's own uplink / downlink timers
+				// (policy 1 s + 1 s): 5 s is the bound, everything else closes at once.
+				t0 := time.Now()
+				for end := time.Now().Add(5 * time.Second); px.live.Load() > 0 && time.Now().Before(end); time.Sleep(20 * time.Millisecond) {
+				}
+				t.Logf("server connections closed %v after the scan", time.Since(t0))
+				if px.live.Load() != 0 {
+					t.Fatalf("%d connections of the probe still open at the server after its instance closed", px.live.Load())
+				}
+			}
+			t.Logf("ok: ttfb1 %d ms, rtt %d ms, t64 %d ms; protector calls %d; server connections %v",
+				deref(d.Ttfb1Ms), deref(d.RttMs), deref(d.T64Ms), protectCalls.Load()-pBefore, px != nil)
+		})
+	}
+	assertNoInstances(t)
+}
+
+// A probe config never creates a kernel TUN (WireGuard outbound) or dials DNS past the protector
+// (quic+local).
+func TestTribeScanSanitizeProcessState(t *testing.T) {
+	m := map[string]any{
+		"dns": map[string]any{"servers": []any{"quic+local://dns.example", map[string]any{"address": "QUIC+LOCAL://x.example"}, "1.1.1.1"}},
+		"outbounds": []any{map[string]any{"tag": "wg", "protocol": "WireGuard", "settings": map[string]any{"noKernelTun": false}},
+			map[string]any{"tag": "d", "protocol": "freedom"}},
+	}
+	sanitizeProcessState(m)
+	if s := m["dns"].(map[string]any)["servers"].([]any); len(s) != 1 || s[0] != "1.1.1.1" {
+		t.Fatalf("dns servers %v", s)
+	}
+	if v := m["outbounds"].([]any)[0].(map[string]any)["settings"].(map[string]any)["noKernelTun"]; v != true {
+		t.Fatalf("noKernelTun %v", v)
+	}
+}
