diff --git a/tribescan/privacy.go b/tribescan/privacy.go
new file mode 100644
index 0000000..9d1fd1e
--- /dev/null
+++ b/tribescan/privacy.go
@@ -0,0 +1,258 @@
+package tribescan
+
+// Probe log privacy. A probe instance lives in the tunnel's process, and the process log (the
+// tunnel's xray log file, the app's log callback, or without either the default stdout handler)
+// goes into diagnostics and bug reports. Nothing a probe dials may reach it:
+//   - every probe instance and dial runs under a log scope (core 0011 log.ContextWithScope) whose
+//     handler drops all of Xray's messages (counted in ScopeMessages);
+//   - context-free Xray lines (and gRPC's own logger) still reach the process log, so the hosts,
+//     addresses and credentials of every queued candidate are registered as redaction terms
+//     (core 0011 log.RedactTerms) until 30 s after the scan stops: such a line keeps its place with
+//     the term masked;
+//   - REALITY "show" (fmt.Printf to stdout of the session id, which holds the shortId) is removed
+//     from every probe config;
+//   - the only line a probe writes is the redacted summary below (ids, error code, timings, bytes).
+
+import (
+	"encoding/json"
+	"fmt"
+	"io"
+	"net"
+	"os"
+	"strconv"
+	"strings"
+	"sync/atomic"
+	"time"
+
+	clog "github.com/xtls/xray-core/common/log"
+	"google.golang.org/grpc/grpclog"
+)
+
+// scopeHandler is the log scope of every probe instance and dial.
+type scopeHandler struct{}
+
+var (
+	scopeMessages atomic.Int64
+	scopeLevel    atomic.Int32 // clog.Severity_Unknown: every message is skipped before it is built
+)
+
+func (scopeHandler) Handle(clog.Message)     { scopeMessages.Add(1) }
+func (scopeHandler) Severity() clog.Severity { return clog.Severity(scopeLevel.Load()) }
+
+var _ clog.SeverityLogger = scopeHandler{}
+
+// ScopeMessages is the number of Xray messages the probe scope took (only counted when a test
+// raised the scope's level).
+func ScopeMessages() int64 { return scopeMessages.Load() }
+
+// redactGrace keeps a stopped scan's terms registered for goroutines that log after their
+// instance closed (atomic: a test shortens it while older scans still stop).
+var redactGrace atomic.Int64
+
+func init() { redactGrace.Store(int64(30 * time.Second)) }
+
+// Keys whose string values name a provider's server or credential (lower case).
+var termKeys = map[string]int{
+	"address": 4, "server": 4, "endpoint": 4, "host": 4, "authority": 4, "servername": 4,
+	"sni": 4, "id": 4, "password": 4, "pass": 4, "user": 4, "email": 4, "publickey": 4,
+	"shortid": 6, "path": 8, "servicename": 6, "seed": 6, "secretkey": 8, "presharedkey": 8,
+}
+
+// Sections a probe config may hold that name no provider server (resolvers, routing).
+var termSkip = map[string]bool{"dns": true, "routing": true, "policy": true, "fakedns": true,
+	"observatory": true, "burstobservatory": true}
+
+// candidateTerms returns the strings of c that must never reach the process log.
+func candidateTerms(c *Candidate) []string {
+	var terms []string
+	add := func(s string) {
+		s = strings.TrimSpace(s)
+		if s == "" || strings.EqualFold(s, "localhost") {
+			return
+		}
+		host := s
+		if h, _, err := net.SplitHostPort(s); err == nil {
+			terms = append(terms, s)
+			host = h
+		}
+		if ip := net.ParseIP(strings.Trim(host, "[]")); ip != nil {
+			if ip.IsLoopback() || ip.IsUnspecified() {
+				return
+			}
+			terms = append(terms, ip.String())
+		}
+		terms = append(terms, host)
+	}
+	if c.EntryIP != "" {
+		add(c.EntryIP)
+	}
+	var root any
+	if json.Unmarshal([]byte(c.Config), &root) != nil {
+		return terms
+	}
+	var walk func(v any, key string, inReality bool)
+	walk = func(v any, key string, inReality bool) {
+		switch t := v.(type) {
+		case map[string]any:
+			for k, x := range t {
+				lk := strings.ToLower(k)
+				if termSkip[lk] {
+					continue
+				}
+				walk(x, lk, inReality || lk == "realitysettings")
+			}
+		case []any:
+			for _, x := range t {
+				walk(x, key, inReality)
+			}
+		case string:
+			min, ok := termKeys[key]
+			if !ok || len(t) < min {
+				return
+			}
+			// REALITY's serverName is a public decoy site, often the tunnel's own too.
+			if inReality && key == "servername" {
+				return
+			}
+			add(t)
+		}
+	}
+	walk(root, "", false)
+	return terms
+}
+
+// registerTermsLocked registers the terms of newly queued candidates for this scan.
+func (s *Scan) registerTermsLocked(cands []*Candidate) {
+	var terms []string
+	for _, c := range cands {
+		terms = append(terms, candidateTerms(c)...)
+	}
+	if len(terms) > 0 {
+		s.redactRelease = append(s.redactRelease, clog.RedactTerms(terms...))
+	}
+}
+
+// releaseTerms drops the scan's terms redactGrace after it stopped.
+func (s *Scan) releaseTerms() {
+	s.mu.Lock()
+	rel := s.redactRelease
+	s.redactRelease = nil
+	s.mu.Unlock()
+	if len(rel) == 0 {
+		return
+	}
+	time.AfterFunc(time.Duration(redactGrace.Load()), func() {
+		for _, r := range rel {
+			r()
+		}
+	})
+}
+
+// sanitizeLogging removes what makes a probe config print by itself: REALITY "show".
+func sanitizeLogging(v any) {
+	switch t := v.(type) {
+	case map[string]any:
+		for k, x := range t {
+			if strings.EqualFold(k, "realitySettings") {
+				if m, ok := x.(map[string]any); ok {
+					deleteFold(m, "show")
+				}
+			}
+			sanitizeLogging(x)
+		}
+	case []any:
+		for _, x := range t {
+			sanitizeLogging(x)
+		}
+	}
+}
+
+// safeID keeps an id printable and short, and never lets it carry a registered term.
+func safeID(id string, index int) string {
+	if len(id) > 64 {
+		id = id[:64]
+	}
+	b := []byte(id)
+	for i, c := range b {
+		if !(c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c >= '0' && c <= '9' || strings.IndexByte("._:-", c) >= 0) {
+			b[i] = '_'
+		}
+	}
+	out := string(b)
+	if _, hit := clog.RedactString(out); hit || out == "" {
+		return "#" + strconv.Itoa(index)
+	}
+	return out
+}
+
+func msField(p *int64) string {
+	if p == nil {
+		return "-"
+	}
+	return strconv.FormatInt(*p, 10)
+}
+
+// logProbeLocked writes the one line a finished probe leaves in the process log.
+func (s *Scan) logProbeLocked(e *entry, it *Item) {
+	if !e.ran {
+		return
+	}
+	code := "ok"
+	var ttfb, dur, bytes, spent *int64
+	retries := 0
+	if it != nil {
+		if it.Error != "" {
+			code = it.Error
+		}
+		ttfb, dur, bytes, spent = it.Ttfb1Ms, it.DurationMs, it.Bytes, it.SpentBytes
+		if it.Retries != nil {
+			retries = *it.Retries
+		}
+	} else if e.reachCode != "" {
+		code = e.reachCode
+	}
+	line := fmt.Sprintf("tribescan: scan=%s probe=%s kind=%s error=%s reach_ms=%s ttfb_ms=%s duration_ms=%s bytes=%s spent=%s retries=%d",
+		safeID(s.req.ScanID, 0), safeID(e.c.ID, e.index), e.c.Kind, code, msField(e.reachMs), msField(ttfb),
+		msField(dur), msField(bytes), msField(spent), retries)
+	if s.plat.Log != nil && s.plat.Log(line) {
+		return
+	}
+	clog.Record(&clog.GeneralMessage{Severity: clog.Severity_Info, Content: line})
+}
+
+// logAccess writes the line of an access attempt that was not made (code: budget, dns, bind,
+// no_route).
+func (s *Scan) logAccess(which, code string) {
+	line := "tribescan: scan=" + safeID(s.req.ScanID, 0) + " access=" + which + " attempted=false code=" + code
+	if s.plat.Log != nil && s.plat.Log(line) {
+		return
+	}
+	clog.Record(&clog.GeneralMessage{Severity: clog.Severity_Info, Content: line})
+}
+
+// gRPC's own logger writes errors to stderr; the tunnel keeps that, with the terms masked.
+type redactWriter struct{ w io.Writer }
+
+func (r redactWriter) Write(p []byte) (int, error) {
+	if s, hit := clog.RedactString(string(p)); hit {
+		_, err := io.WriteString(r.w, s)
+		return len(p), err
+	}
+	return r.w.Write(p)
+}
+
+func init() {
+	// grpclog's default (env GRPC_GO_LOG_SEVERITY_LEVEL / _VERBOSITY_LEVEL), with masked writers.
+	// SetLoggerV2 must run before any gRPC use: package init is the only safe place.
+	info, warning, errw := io.Writer(io.Discard), io.Writer(io.Discard), io.Writer(io.Discard)
+	switch os.Getenv("GRPC_GO_LOG_SEVERITY_LEVEL") {
+	case "", "ERROR", "error":
+		errw = os.Stderr
+	case "WARNING", "warning":
+		warning = os.Stderr
+	case "INFO", "info":
+		info = os.Stderr
+	}
+	v, _ := strconv.Atoi(os.Getenv("GRPC_GO_LOG_VERBOSITY_LEVEL"))
+	grpclog.SetLoggerV2(grpclog.NewLoggerV2WithVerbosity(redactWriter{info}, redactWriter{warning}, redactWriter{errw}, v))
+}
diff --git a/tribescan/privacy_test.go b/tribescan/privacy_test.go
