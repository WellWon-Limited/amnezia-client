+func TestTribeScanBudgetAndAdd(t *testing.T) {
+	e := newKitEnv(t)
+	t.Run("max_bytes", func(t *testing.T) {
+		// cost 83456 each against 180000: two launch, the third gets "budget"; the scan completes.
+		r := KitRun(t, KitRequest("s-budget", e.srv.Base(), map[string]any{"max_bytes": 180000, "concurrency": 1}, 15000,
+			KitFullCandidate("a", e.vless), KitFullCandidate("b", e.vless), KitFullCandidate("c", e.vless)), "", e.plat, 20*time.Second)
+		c, _ := r.DataByID("c")
+		if r.Final.Reason != ReasonComplete || len(r.Data()) != 3 || c.Error != ErrBudget || deref(c.SpentBytes) != 0 {
+			t.Fatalf("final %+v data %+v", r.Final, r.Data())
+		}
+		if r.Final.BytesSpent > 180000 {
+			t.Fatalf("spent %d", r.Final.BytesSpent)
+		}
+	})
+	t.Run("cut at cost_bytes", func(t *testing.T) {
+		cand := KitFullCandidate("capped", e.vless)
+		cand["cost_bytes"] = 40000 // less than the 1 KiB + 64 KiB + TLS the probe would use
+		before := len(e.srv.Seen())
+		r := KitRun(t, KitRequest("s-cut", e.srv.Base(), map[string]any{"max_bytes": 100000}, 15000, cand), "", e.plat, 20*time.Second)
+		d, _ := r.DataByID("capped")
+		if d.Error != ErrBudget || deref(d.ShaOK) || deref(d.SpentBytes) != 40000 || r.Final.BytesSpent-40000 < 8192 ||
+			r.Final.BytesSpent-40000 > 10240 || r.Final.BytesReserved != 10240 {
+			t.Fatalf("%+v final %+v", d, r.Final)
+		}
+		if seen := e.srv.Seen()[before:]; len(seen) != 2 { // the warm-up passed, the sized body was cut
+			t.Fatalf("server saw %+v", seen)
+		}
+	})
+	t.Run("scan_add", func(t *testing.T) {
+		var ack Ack
+		KitMessage(t, KitRequest("s-add", e.srv.Base(), nil, 8000, KitFullCandidate("first", e.vless)), "", e.plat, &ack)
+		// The first one is done: the scan is complete but open.
+		p := KitPollUntil(t, "s-add", "the first probe done", 7*time.Second, func(p Progress) bool { return p.Done })
+		if p.Reason != ReasonComplete || p.Final {
+			t.Fatalf("before add: %+v", p)
+		}
+		add, _ := json.Marshal(map[string]any{"action": "scan_add", "scan_id": "s-add",
+			"candidates": []any{KitFullCandidate("second", e.vless), KitLegCandidate("third", VlessOutbound("p", e.vless), nil, nil)}})
+		KitMessage(t, string(add), "", e.plat, &ack)
+		if ack.Accepted != 2 {
+			t.Fatalf("add ack %+v", ack)
+		}
+		r := KitPoll(t, &KitResult{ScanID: "s-add"}, 10*time.Second, time.Now())
+		if len(r.Data()) != 3 || r.Final.Reason != ReasonComplete {
+			t.Fatalf("after add: %+v", r.Items)
+		}
+		// Past the deadline the scan is over (final) and takes nothing more.
+		KitPollUntil(t, "s-add", "the deadline", 15*time.Second, func(p Progress) bool { return p.Final })
+		KitMessage(t, string(add), "", e.plat, &ack)
+		if ack.Accepted != 0 {
+			t.Fatalf("add after the deadline accepted %d", ack.Accepted)
+		}
+	})
+}
