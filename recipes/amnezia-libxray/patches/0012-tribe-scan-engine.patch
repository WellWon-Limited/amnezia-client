index 0000000..36cbc04
--- /dev/null
+++ b/tribescan/legs.go
@@ -0,0 +1,251 @@
+package tribescan
+
+// Leg mode (design D8): up to scan_leg_batch_legs xray_leg candidates share ONE temporary instance
+// that holds only their outbounds. Each candidate's tags get a per-candidate namespace ("m<k>.")
+// so two profiles that both call their leg "proxy" never collide, and every dialerProxy /
+// proxySettings reference inside the candidate is rewritten to the namespaced tag. A job dials
+// through its own leg by forcing the namespaced tag on the stream (no routing table exists).
+
+import (
+	"encoding/json"
+	"errors"
+	"fmt"
+	"net"
+	"net/url"
+	"strconv"
+	"strings"
+)
+
+const maxDNSPlan = 16
+
+// dnsTarget is one resolver of a leg's DNS plan, resolved to how this host queries it.
+type dnsTarget struct {
+	address   string
+	transport string // udp | tcp | doh | h2c (exercised); anything else is reported as skipped
+	host      string
+	port      int
+	path      string // doh / h2c
+	forced    string // namespaced outbound tag the query is forced through; "" = skip
+	skip      string // reason when not exercised
+}
+
+// legMember is one candidate inside a batch.
+type legMember struct {
+	forced string
+	dns    []dnsTarget
+	outs   []any
+}
+
+// legBatch is one shared leg instance and its members.
+type legBatch struct {
+	members []*Candidate
+	plans   map[string]*legMember // candidate id -> plan (valid members only)
+	bad     map[string]string     // candidate id -> error code
+}
+
+func setTag(ob map[string]any, tag string) {
+	deleteFold(ob, "tag")
+	ob["tag"] = tag
+}
+
+// dialerRef returns the (container map, key) holding the outbound's dialer reference, if any.
+func dialerRef(ob map[string]any) (map[string]any, string, string) {
+	if _, v, ok := lookup(ob, "streamSettings"); ok {
+		if ss, ok := v.(map[string]any); ok {
+			if _, v, ok := lookup(ss, "sockopt"); ok {
+				if so, ok := v.(map[string]any); ok {
+					if k, v, ok := lookup(so, "dialerProxy"); ok {
+						if ref, _ := v.(string); ref != "" {
+							return so, k, ref
+						}
+					}
+				}
+			}
+		}
+	}
+	if _, v, ok := lookup(ob, "proxySettings"); ok {
+		if ps, ok := v.(map[string]any); ok {
+			if k, v, ok := lookup(ps, "tag"); ok {
+				if ref, _ := v.(string); ref != "" {
+					return ps, k, ref
+				}
+			}
+		}
+	}
+	return nil, "", ""
+}
+
+// legConfig is an xray_leg candidate's config (a JSON string): {"outbound": <the leg's outbound as
+// dialled>, "dns": [{"address","tag","transport"}]}. Host additions: "dialers" (outbounds the leg
+// dials through, for a leg with sockopt.dialerProxy) and "dialer" ({tag, protocol} of the
+// projection: a freedom hop that is not carried is added as a plain freedom outbound).
+type legConfig struct {
+	Outbound map[string]any   `json:"outbound"`
+	DNS      []any            `json:"dns"`
+	Dialers  []map[string]any `json:"dialers"`
+	Dialer   map[string]any   `json:"dialer"`
+}
+
+// buildMember namespaces one candidate's leg (index k inside its batch).
+func buildMember(c *Candidate, k int, probeHost string) (*legMember, error) {
+	dec := json.NewDecoder(strings.NewReader(c.Config))
+	dec.UseNumber() // keep every number exactly as the profile wrote it
+	var cfg legConfig
+	if err := dec.Decode(&cfg); err != nil || cfg.Outbound == nil {
+		return nil, errors.New("config must be {\"outbound\":{...}}")
+	}
+	ns := func(tag string) string { return fmt.Sprintf("m%d.%s", k, tag) }
+	outs := []map[string]any{cfg.Outbound}
+	outs = append(outs, cfg.Dialers...)
+	freedomDialers := map[string]bool{}
+	if cfg.Dialer != nil && strings.EqualFold(stringField(cfg.Dialer, "protocol"), "freedom") {
+		freedomDialers[stringField(cfg.Dialer, "tag")] = true
+	}
+	tags := map[string]bool{}
+	for i, ob := range outs {
+		tag := stringField(ob, "tag")
+		if tag == "" {
+			tag = fmt.Sprintf("leg%d", i)
+		}
+		if tags[tag] {
+			return nil, errors.New("duplicate leg tag")
+		}
+		tags[tag] = true
+		setTag(ob, tag)
+	}
+	leg := stringField(outs[0], "tag")
+	var synthesized []map[string]any
+	for _, ob := range outs {
+		if holder, key, ref := dialerRef(ob); holder != nil {
+			switch {
+			case tags[ref]:
+			case freedomDialers[ref]:
+				tags[ref] = true
+				synthesized = append(synthesized, map[string]any{"tag": ref, "protocol": "freedom"})
+			default:
+				return nil, errors.New("a leg's dialer is not among its outbounds")
+			}
+			holder[key] = ns(ref)
+		}
+	}
+	outs = append(outs, synthesized...)
+	mem := &legMember{forced: ns(leg)}
+	for _, ob := range outs {
+		setTag(ob, ns(stringField(ob, "tag")))
+		mem.outs = append(mem.outs, ob)
+	}
+	if c.DNSPlan {
+		if len(cfg.DNS) > maxDNSPlan {
+			return nil, errors.New("dns plan has too many resolvers")
+		}
+		for _, entry := range cfg.DNS {
+			t := parseDNSTarget(entry)
+			if t.skip == "" && net.ParseIP(probeHost) != nil {
+				t.skip = "no_name"
+			}
+			t.forced = mem.forced // the coordinator lists only resolvers this leg carries
+			mem.dns = append(mem.dns, t)
+		}
+	}
+	return mem, nil
+}
+
+// parseDNSTarget reads a projection dns entry {address, transport, host, port, ...} or a plain
+// resolver address ("8.8.8.8", "tcp://1.1.1.1:53", "https://dns.google/dns-query").
+func parseDNSTarget(entry any) dnsTarget {
+	var t dnsTarget
+	var address, transport, host string
+	var port int
+	switch e := entry.(type) {
+	case string:
+		address = e
+	case map[string]any:
+		address = stringField(e, "address")
+		transport = strings.ToLower(stringField(e, "transport"))
+		host = stringField(e, "host")
+		if _, v, ok := lookup(e, "port"); ok {
+			port, _ = strconv.Atoi(fmt.Sprint(v))
+		}
+	}
+	t.address = address
+	low := strings.ToLower(strings.TrimSpace(address))
+	scheme := "udp"
+	if strings.Contains(low, "://") {
+		if u, err := url.Parse(strings.TrimSpace(address)); err == nil {
+			scheme = strings.ToLower(u.Scheme)
+			if host == "" {
+				host = u.Hostname()
+			}
+			if port == 0 {
+				port, _ = strconv.Atoi(u.Port())
+			}
+			t.path = u.EscapedPath()
+		}
+	} else if low == "localhost" || low == "fakedns" {
+		scheme = map[string]string{"localhost": "system", "fakedns": "fakedns"}[low]
+	} else if host == "" {
+		if h, p, err := net.SplitHostPort(strings.TrimSpace(address)); err == nil {
+			host = h
+			port, _ = strconv.Atoi(p)
+		} else {
+			host = strings.TrimSpace(address)
+		}
+	}
+	if strings.HasSuffix(scheme, "+local") {
+		t.transport, t.skip = scheme, "skipped" // bypasses routing: never through a leg
+		return t
+	}
+	if transport == "" {
+		transport = map[string]string{"udp": "udp", "tcp": "tcp", "https": "doh", "h2c": "h2c", "quic": "quic"}[scheme]
+		if transport == "" {
+			transport = scheme
+		}
+	}
+	t.transport, t.host = transport, host
+	defaults := map[string]int{"udp": 53, "tcp": 53, "doh": 443, "h2c": 80}
+	def, exercised := defaults[transport]
+	if !exercised || host == "" {
+		t.skip = "skipped"
+		return t
+	}
+	if port <= 0 || port > 65535 {
+		port = def
+	}
+	t.port = port
+	if (transport == "doh" || transport == "h2c") && (t.path == "" || t.path == "/") {
+		t.path = "/dns-query"
+	}
+	return t
+}
+
+// buildLegBatch validates every member alone (a broken leg must not take its batch down: it gets
+// "config"), then merges the valid ones into one outbounds-only config.
+func buildLegBatch(members []*Candidate, probeHost string) (*legBatch, *probePlan) {
+	b := &legBatch{members: members, plans: map[string]*legMember{}, bad: map[string]string{}}
+	var all []any
+	for k, c := range members {
+		mem, err := buildMember(c, k, probeHost)
+		if err != nil {
+			b.bad[c.ID] = ErrConfig
+			continue
+		}
+		if _, err := loadCore(map[string]any{"outbounds": mem.outs}); err != nil {
+			b.bad[c.ID] = ErrConfig
+			continue
+		}
+		b.plans[c.ID] = mem
+		all = append(all, mem.outs...)
+	}
+	if len(all) == 0 {
+		return b, nil
+	}
+	cfg, err := loadCore(map[string]any{"outbounds": all})
+	if err != nil {
+		for id := range b.plans {
+			b.bad[id] = ErrConfig
+		}
+		b.plans = map[string]*legMember{}
+		return b, nil
+	}
+	return b, &probePlan{cfg: cfg}
+}
diff --git a/tribescan/legs_test.go b/tribescan/legs_test.go
new file mode 100644
index 0000000..9c7329d
--- /dev/null
+++ b/tribescan/legs_test.go
@@ -0,0 +1,317 @@
+//go:build tribescan_testkit
+
+package tribescan
+
+// Leg mode: many legs in ONE outbounds-only instance, each job forced onto its own leg.
+
+import (
+	"encoding/json"
+	"fmt"
+	"runtime"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+// liveMax records the highest LiveInstances seen inside jobs.
+func liveMax(plat *Platform) *atomic.Int64 {
+	var m atomic.Int64
+	prev := plat.JobHook
+	plat.JobHook = func(id string) {
+		for n, seen := LiveInstances(), m.Load(); n > seen && !m.CompareAndSwap(seen, n); seen = m.Load() {
+		}
+		if prev != nil {
+			prev(id)
+		}
+	}
+	return &m
+}
+
+func TestTribeScanLegBatchParallel(t *testing.T) {
+	e := newKitEnv(t)
+	for _, delay := range []int64{0, 300} {
+		e.srv.SetMode("slow_first_byte", false)
+		e.srv.Delay.Store(delay)
+		e.srv.maxInflight.Store(0)
+		plat := e.plat
+		maxLive := liveMax(&plat)
+		var cands []map[string]any
+		for i := 0; i < 12; i++ { // every profile calls its leg "proxy": namespacing must keep them apart
+			cands = append(cands, KitLegCandidate(fmt.Sprintf("leg%02d", i), VlessOutbound("proxy", e.vless), nil, nil))
+		}
+		r := KitRun(t, KitRequest(fmt.Sprintf("s-legs-%d", delay), e.srv.Base(), map[string]any{"leg_concurrency": 6}, 30000, cands...), "", plat, 30*time.Second)
+		ok := 0
+		for _, d := range r.Data() {
+			if d.Error == "" && deref(d.ShaOK) && deref(d.Bytes) == 65536 && d.RttMs != nil {
+				ok++
+			}
+		}
+		t.Logf("12 legs, 6 at once, server delay %d ms: wall %v, ok %d, live instances max %d, server in flight max %d",
+			delay, r.Elapsed, ok, maxLive.Load(), e.srv.MaxInflight())
+		if ok != 12 || maxLive.Load() != 1 || r.Final.Reason != ReasonComplete {
+			t.Fatalf("data %+v final %+v live %d", r.Data(), r.Final, maxLive.Load())
+		}
+		if delay > 0 && (e.srv.MaxInflight() < 2 || e.srv.MaxInflight() > 6) {
+			t.Fatalf("legs did not run 2..6 at once: %d", e.srv.MaxInflight())
+		}
+	}
+	e.srv.SetMode("ok", false)
+	assertNoInstances(t)
+}
+
+func TestTribeScanLegBatchesAndInstanceCap(t *testing.T) {
+	e := newKitEnv(t)
+	plat := e.plat
+	plat.MaxInstances = 1
+	plat.MaxLegsPerInstance = 4
+	maxLive := liveMax(&plat)
+	var cands []map[string]any
+	for i := 0; i < 2; i++ {
+		cands = append(cands, KitFullCandidate(fmt.Sprintf("full%d", i), e.vless))
+	}
+	for i := 0; i < 10; i++ {
+		cands = append(cands, KitLegCandidate(fmt.Sprintf("leg%d", i), VlessOutbound("p", e.vless), nil, nil))
+	}
+	// 4 legs per instance: 3 leg instances + 2 full instances, never two alive at once.
+	r := KitRun(t, KitRequest("s-batches", e.srv.Base(), map[string]any{"concurrency": 2, "leg_concurrency": 4}, 30000, cands...), "", plat, 40*time.Second)
+	if len(r.Data()) != 12 || maxLive.Load() != 1 {
+		t.Fatalf("data %d live %d", len(r.Data()), maxLive.Load())
+	}
+	for _, d := range r.Data() {
+		if d.Error != "" {
+			t.Fatalf("%+v", d)
+		}
+	}
+	assertNoInstances(t)
+}
+
+// A leg instance closes in the background after its batch's last leg; its instance slot is free only
+// once it is closed, so with a slow close (an iPhone under memory pressure) the next instance still
+// waits: the live count never passes the cap, at any moment (sampled every millisecond, not only when
+// a job starts), and the admission memory guard never measures while an instance is still closing.
+func TestTribeScanInstanceCapSlowClose(t *testing.T) {
+	e := newKitEnv(t)
+	plat := e.plat
+	plat.MaxInstances = 1
+	plat.MaxLegsPerInstance = 2
+	maxLive := liveMax(&plat)
+	// The memory guard of a new instance must never measure while an instance is still closing: its
+	// memory is not back yet. (The running probes' watchdog may: a low reading then is real.)
+	var guardSawClosing atomic.Int64
+	plat.MemStartMinMB = 1
+	plat.AvailableMB = func() float64 {
+		if LiveWork().Closers > 0 && memAdmissionReading() {
+			guardSawClosing.Add(1)
+		}
+		return 1 << 20
+	}
+	SetCloseInstanceHook(func() { time.Sleep(250 * time.Millisecond) })
+	defer SetCloseInstanceHook(nil)
+	var sampled atomic.Int64
+	stop := make(chan struct{})
+	sampler := make(chan struct{})
+	go func() {
+		defer close(sampler)
+		for {
+			select {
+			case <-stop:
+				return
+			case <-time.After(time.Millisecond):
+			}
+			for n, seen := LiveWork().Instances, sampled.Load(); n > seen && !sampled.CompareAndSwap(seen, n); seen = sampled.Load() {
+			}
+		}
+	}()
+	var cands []map[string]any
+	for i := 0; i < 6; i++ { // 3 leg instances of 2 legs
+		cands = append(cands, KitLegCandidate(fmt.Sprintf("leg%d", i), VlessOutbound("p", e.vless), nil, nil))
+	}
+	cands = append(cands, KitFullCandidate("full", e.vless))
+	r := KitRun(t, KitRequest("s-slow-close", e.srv.Base(), map[string]any{"concurrency": 1, "leg_concurrency": 2}, 30000, cands...),
+		"", plat, 40*time.Second)
+	close(stop)
+	<-sampler
+	if len(r.Data()) != 7 {
+		t.Fatalf("data %d", len(r.Data()))
+	}
+	for _, d := range r.Data() {
+		if d.Error != "" {
+			t.Fatalf("%+v", d)
+		}
+	}
+	if maxLive.Load() != 1 || sampled.Load() != 1 || guardSawClosing.Load() != 0 {
+		t.Fatalf("instances alive at once with a cap of 1: in jobs %d, sampled %d; memory guard calls during a close %d",
+			maxLive.Load(), sampled.Load(), guardSawClosing.Load())
+	}
+	assertNoInstances(t)
+}
+
+func TestTribeScanLegConfigShapes(t *testing.T) {
+	e := newKitEnv(t)
+	hop := VlessOutbound("a", e.vless)
+	hop["streamSettings"] = map[string]any{"sockopt": map[string]any{"dialerProxy": "hop"}}
+	viaFreedom := KitLegCandidate("via-freedom", hop, nil, map[string]any{"dialer": map[string]any{"tag": "hop", "protocol": "freedom"}})
+	inner := VlessOutbound("b", e.vless)
+	inner["streamSettings"] = map[string]any{"sockopt": map[string]any{"dialerProxy": "c"}}
+	chain := KitLegCandidate("vless-in-vless", inner, nil, map[string]any{"dialers": []any{VlessOutbound("c", e.vless)}})
+	orphan := VlessOutbound("d", e.vless)
+	orphan["streamSettings"] = map[string]any{"sockopt": map[string]any{"dialerProxy": "nowhere"}}
+	missing := KitLegCandidate("missing-dialer", orphan, nil, nil)
+	broken := KitLegCandidate("broken", map[string]any{"tag": "x", "protocol": "no-such-protocol"}, nil, nil)
+	notJSON := KitLegCandidate("not-json", VlessOutbound("p", e.vless), nil, nil)
+	notJSON["config"] = "{"
+	healthy := KitLegCandidate("healthy", VlessOutbound("", e.vless), nil, nil) // untagged: the host names it
+	r := KitRun(t, KitRequest("s-shapes", e.srv.Base(), nil, 20000, viaFreedom, chain, missing, broken, notJSON, healthy), "", e.plat, 30*time.Second)
+	want := map[string]string{"via-freedom": "", "vless-in-vless": "", "missing-dialer": ErrConfig, "broken": ErrConfig,
+		"not-json": ErrConfig, "healthy": ""}
+	for id, code := range want {
+		if d, ok := r.DataByID(id); !ok || d.Error != code || (code == "" && !deref(d.ShaOK)) {
+			t.Fatalf("%s: want %q, got %+v", id, code, d)
+		}
+	}
+}
+
+func TestTribeScanLegDNSPlan(t *testing.T) {
+	e := newKitEnv(t)
+	dns := NewKitDNS(t)
+	silent := NewKitDNS(t)
+	silent.Silent.Store(true)
+	bad := NewKitDNS(t)
+	bad.Bad.Store(true)
+	good := []any{
+		map[string]any{"address": fmt.Sprintf("127.0.0.1:%d", dns.UDPPort), "tag": nil, "transport": "udp"},
+		map[string]any{"address": fmt.Sprintf("tcp://127.0.0.1:%d", dns.TCPPort), "tag": "dns-out", "transport": "tcp"},
+		map[string]any{"address": fmt.Sprintf("https://example.com:%d/dns-query", e.srv.Port), "tag": nil, "transport": "doh"},
+	}
+	all := KitLegCandidate("dns-ok", VlessOutbound("proxy", e.vless), good, nil)
+	mixed := KitLegCandidate("dns-mixed", VlessOutbound("proxy", e.vless), []any{
+		good[0],
+		map[string]any{"address": fmt.Sprintf("127.0.0.1:%d", silent.UDPPort), "transport": "udp"},
+		map[string]any{"address": fmt.Sprintf("tcp://127.0.0.1:%d", bad.TCPPort), "transport": "tcp"},
+		map[string]any{"address": "quic://1.1.1.1", "transport": "quic"},
+	}, nil)
+	planOff := KitLegCandidate("dns-off", VlessOutbound("proxy", e.vless), good, nil)
+	planOff["dns_plan"] = false
+	r := KitRun(t, KitRequest("s-dns", e.srv.Base(), map[string]any{"ttfb_ms": 600}, 20000, all, mixed, planOff), "", e.plat, 30*time.Second)
+	ok, _ := r.DataByID("dns-ok")
+	mx, _ := r.DataByID("dns-mixed")
+	off, _ := r.DataByID("dns-off")
+	raw, _ := json.Marshal([]Item{ok, mx})
+	t.Logf("items %s", raw)
+	if ok.Error != "" || !ok.DNSExercised || len(ok.DNS) != 3 {
+		t.Fatalf("all answered: %+v", ok)
+	}
+	for _, d := range ok.DNS {
+		if !d.OK || d.Answers != 1 || d.Rcode != 0 || d.Ms < 0 {
+			t.Fatalf("resolver %+v", d)
+		}
+	}
+	codes := []string{mx.DNS[0].Error, mx.DNS[1].Error, mx.DNS[2].Error, mx.DNS[3].Error}
+	if mx.Error != "" || mx.DNSExercised || fmt.Sprint(codes) != "[ timeout bad_answer skipped]" {
+		t.Fatalf("mixed: %v %+v", codes, mx)
+	}
+	if off.DNSExercised || off.DNS != nil {
+		t.Fatalf("dns_plan false exercised the plan: %+v", off)
+	}
+	if dns.UDPQueries.Load() != 2 || dns.TCPQueries.Load() != 1 || e.srv.DoHQueries() != 1 {
+		t.Fatalf("queries udp=%d tcp=%d doh=%d", dns.UDPQueries.Load(), dns.TCPQueries.Load(), e.srv.DoHQueries())
+	}
+}
+
+func TestTribeScanLegPerJobBytesAndRetry(t *testing.T) {
+	e := newKitEnv(t)
+	gate := NewGate(t, e.vless)
+	gate.OpenAfter(700 * time.Millisecond)
+	race := KitLegCandidate("race", VlessOutbound("p", e.vless), nil, nil)
+	race["bytes"], race["total_ms"] = 24576, 2000
+	guarded := KitLegCandidate("guarded", VlessOutbound("p", gate.Port()), nil, nil)
+	full := KitLegCandidate("full", VlessOutbound("p", e.vless), nil, nil)
+	r := KitRun(t, KitRequest("s-perjob", e.srv.Base(), nil, 20000, race, guarded, full), "", e.plat, 30*time.Second)
+	for id, size := range map[string]int64{"race": 24576, "guarded": 65536, "full": 65536} {
+		if d, _ := r.DataByID(id); d.Error != "" || deref(d.Bytes) != size || deref(d.BytesRequested) != size || !deref(d.ShaOK) {
+			t.Fatalf("%s: %+v", id, d)
+		}
+	}
+	if d, _ := r.DataByID("guarded"); deref(d.Retries) < 2 || gate.Refused.Load() < 2 {
+		t.Fatalf("the guarded leg was not refused first: %+v (%d)", d, gate.Refused.Load())
+	}
+}
+
+func TestTribeScanLegCancelMemoryPanic(t *testing.T) {
+	e := newKitEnv(t)
+	t.Run("cancel", func(t *testing.T) {
+		e.srv.SetMode("stall", false)
+		defer e.srv.SetMode("ok", false)
+		var cands []map[string]any
+		for i := 0; i < 6; i++ {
+			cands = append(cands, KitLegCandidate(fmt.Sprintf("l%d", i), VlessOutbound("p", e.vless), nil, nil))
+		}
+		var ack Ack
+		KitMessage(t, KitRequest("s-leg-cancel", e.srv.Base(), map[string]any{"stall_ms": 10000, "total_ms": 30000, "leg_concurrency": 3},
+			60000, cands...), "", e.plat, &ack)
+		stalls := e.srv.Stalled()
+		KitWaitFor(t, "three legs' bodies stalled", 10*time.Second, func() bool { return e.srv.Stalled() >= stalls+3 })
+		KitMessage(t, `{"action":"scan_cancel","scan_id":"s-leg-cancel"}`, "", e.plat, &ack)
+		// Three legs were in flight, each had read its warm-up (and its stalled body as far as it got).
+		if p := KitPollFinal(t, "s-leg-cancel", 5*time.Second); p.BytesSpent <= 3*(8192+1024) {
+			t.Fatalf("final %+v", p)
+		}
+		assertNoInstances(t)
+	})
+	t.Run("memory guard counts the leg instance", func(t *testing.T) {
+		var avail atomic.Int64
+		avail.Store(30)
+		plat := e.plat
+		plat.MaxInstances = 1 // the leg instance starts after the full probe's instance closed
+		plat.MemStartMinMB = 12
+		plat.AvailableMB = func() float64 { return float64(avail.Load()) }
+		plat.JobHook = func(string) { avail.Store(5) }
+		r := KitRun(t, KitRequest("s-leg-mem", e.srv.Base(), nil, 20000, KitFullCandidate("full", e.vless),
+			KitLegCandidate("a", VlessOutbound("p", e.vless), nil, nil)), "", plat, 10*time.Second)
+		if d, _ := r.DataByID("a"); r.Final.Reason != ReasonMemory || d.Error != ErrMemory {
+			t.Fatalf("final %+v items %+v", r.Final, r.Items)
+		}
+	})
+	t.Run("panic", func(t *testing.T) {
+		plat := e.plat
+		plat.JobHook = func(id string) {
+			if id == "boom" {
+				panic("leg job panic (test)")
+			}
+		}
+		r := KitRun(t, KitRequest("s-leg-panic", e.srv.Base(), nil, 20000,
+			KitLegCandidate("boom", VlessOutbound("p", e.vless), nil, nil), KitLegCandidate("fine", VlessOutbound("p", e.vless), nil, nil)), "", plat, 20*time.Second)
+		boom, _ := r.DataByID("boom")
+		fine, _ := r.DataByID("fine")
+		if boom.Error != ErrInternal || fine.Error != "" {
+			t.Fatalf("boom %+v fine %+v", boom, fine)
+		}
+	})
+	t.Run("no leak", func(t *testing.T) {
+		run := func(tag string) {
+			var cands []map[string]any
+			for i := 0; i < 8; i++ {
+				cands = append(cands, KitLegCandidate(fmt.Sprintf("l%d", i), VlessOutbound("p", e.vless), nil, nil))
+			}
+			cands = append(cands, KitLegCandidate("dead", VlessOutbound("p", FreePort(t)), nil, nil))
+			KitRun(t, KitRequest("s-leg-leak-"+tag, e.srv.Base(), map[string]any{"total_ms": 1500}, 20000, cands...), "", e.plat, 20*time.Second)
+		}
+		run("warm")
+		assertNoInstances(t)
+		time.Sleep(500 * time.Millisecond)
+		baseG, baseFD := runtime.NumGoroutine(), OpenFDs()
+		for i := 0; i < 3; i++ {
+			run(fmt.Sprint(i))
+		}
+		assertNoInstances(t)
+		g := Settle(baseG+2, 5*time.Second)
+		fd := OpenFDs()
+		for deadline := time.Now().Add(3 * time.Second); fd > baseFD+2 && time.Now().Before(deadline); fd = OpenFDs() {
+			time.Sleep(50 * time.Millisecond)
+		}
+		t.Logf("goroutines %d -> %d, fds %d -> %d", baseG, g, baseFD, fd)
+		if g > baseG+2 || fd > baseFD+2 {
+			t.Fatalf("leak: goroutines %d -> %d, fds %d -> %d", baseG, g, baseFD, fd)
+		}
+	})
+}
