+func TestTribeScanSuccessTimings(t *testing.T) {
+	e := newKitEnv(t)
+	socksPort := FreePort(t)
+	cand := KitFullCandidate("own-1", e.vless)
+	raw, _ := json.Marshal(TunnelConfig(e.vless, socksPort))
+	cand["config"] = string(raw)
+	cand["profile_id"] = "0123456789abcdef"
+	var listenedFree atomic.Bool
+	e.plat.JobHook = func(string) {
+		// The tunnel-shaped profile names socksPort; the probe instance must not listen there.
+		if ln, err := net.Listen("tcp", fmt.Sprintf("127.0.0.1:%d", socksPort)); err == nil {
+			listenedFree.Store(true)
+			ln.Close()
+		}
+	}
+	r := KitRun(t, KitRequest("s-ok", e.srv.Base(), nil, 10000, cand), "", e.plat, 20*time.Second)
+	if r.Ack.Accepted != 1 || r.Final.Reason != ReasonComplete || len(r.Data()) != 1 {
+		t.Fatalf("ack %+v final %+v", r.Ack, r.Final)
+	}
+	d := r.Data()[0]
+	raw, _ = json.Marshal(d)
+	t.Logf("item %s; spent %d, elapsed %v, polls %d", raw, r.Final.BytesSpent, r.Elapsed, r.Polls)
+	if d.Error != "" || !deref(d.ShaOK) || deref(d.Bytes) != 65536 || deref(d.BytesRequested) != 65536 ||
+		deref(d.HTTPStatus) != 200 || d.Ttfb1Ms == nil || d.RttMs == nil || d.T64Ms == nil || d.DurationMs == nil {
+		t.Fatalf("data item %s", raw)
+	}
+	if deref(d.EgressClass) != KitEgressClass || deref(d.EgressAsn) != 64500 || deref(d.NetToken) != KitNetToken ||
+		deref(d.EgressNode) != KitEgressNode || deref(d.Retries) != 0 {
+		t.Fatalf("egress facts %s", raw)
+	}
+	// Wire bytes read (both bodies and their response headers) + 8192 for the TLS connection.
+	// The scan's total adds the opening access attempt (TLS + its answer); the closing one stays
+	// reserved until the stop.
+	if low := int64(1024 + 65536 + 8192); deref(d.SpentBytes) < low || deref(d.SpentBytes) > low+4096 ||
+		r.Final.BytesSpent-deref(d.SpentBytes) < 8192 || r.Final.BytesSpent-deref(d.SpentBytes) > 10240 || r.Final.BytesReserved != 10240 {
+		t.Fatalf("spent %d / %d reserved %d, want %d + headers", deref(d.SpentBytes), r.Final.BytesSpent, r.Final.BytesReserved, low)
+	}
+	if !listenedFree.Load() {
+		t.Fatal("the probe instance listened on the profile's inbound port")
+	}
+	// The access attempts bracket the probe (plan §2.2c): the opening one before it; "complete" is
+	// not final, the closing one comes with the app's freeze + cancel, then the final totals.
+	if a := r.Final.Access; a == nil || !a.Attempted || !a.HTTPAnswered || deref(a.Asn) != 12389 ||
+		deref(a.NetToken) != "accessTok9" || deref(a.AtMs) > deref(d.StartMs) || r.Final.AccessClose != nil || r.Final.Final {
+		t.Fatalf("opening %+v close %+v final %v", r.Final.Access, r.Final.AccessClose, r.Final.Final)
+	}
+	fa, ack, fin := KitStop(t, "s-ok", 5*time.Second)
+	if fa.Reserved != 10240 || fa.Spent != r.Final.BytesSpent || deref(ack.Final) {
+		t.Fatalf("freeze ack %+v cancel ack %+v", fa, ack)
+	}
+	if c := fin.AccessClose; c == nil || !c.HTTPAnswered || deref(c.AtMs) < deref(d.EndMs) || fin.Reason != ReasonCancelled ||
+		fin.BytesSpent-deref(d.SpentBytes) < 2*8192 || fin.BytesSpent-deref(d.SpentBytes) > 2*10240 || e.srv.NetinfoCalls() != 2 {
+		t.Fatalf("final %+v close %+v netinfo calls %d", fin, fin.AccessClose, e.srv.NetinfoCalls())
+	}
+	seen := e.srv.Seen()
+	if len(seen) != 2 || seen[0].Bytes != 1024 || seen[1].Bytes != 65536 || seen[0].RemoteAddr != seen[1].RemoteAddr {
+		t.Fatalf("server saw %+v (the sized request must reuse the warm-up connection)", seen)
+	}
+	for _, s := range seen {
+		if s.Authorization != "Bearer "+KitToken || s.AccessToken != "accessTok1" || s.AccessAsn != "12389" ||
+			s.ProfileID != "0123456789abcdef" || len(s.Nonce) != 24 {
+			t.Fatalf("request headers %+v", s)
+		}
+	}
+	if seen[0].Nonce == seen[1].Nonce {
+		t.Fatal("the two requests share a nonce")
+	}
+	assertNoInstances(t)
+}
