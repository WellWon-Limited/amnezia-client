+++ b/tribescan/gate.go
@@ -0,0 +1,69 @@
+package tribescan
+
+// ByteGate is the scan's ONE shared byte cap (review F6), the Go twin of ScanHostContract.h's
+// ScanHostByteGate (its vectors "byte_gate" are replayed by vectors_test.go): every pool and every
+// retry of a probe go through it. A probe is admitted atomically only if spent + reserved + cost <=
+// max (max < 0 = no cap); its cost stays reserved until its final item, then the reservation is
+// replaced by what it really used, never more than its cost (the engine cuts a probe at cost_bytes,
+// error "budget"). So spent + reserved <= max holds at every moment. Not safe for concurrent use:
+// the scan's mutex guards it.
+type ByteGate struct {
+	max      int64
+	spent    int64
+	reserved int64
+	frozen   bool
+	open     map[string]int64
+}
+
+// NewByteGate returns a gate for maxBytes (< 0 = no cap).
+func NewByteGate(maxBytes int64) *ByteGate {
+	return &ByteGate{max: maxBytes, open: map[string]int64{}}
+}
+
+// Admit reserves cost for probe id: true and reserved, or false and nothing changes (one
+// reservation per probe; nothing after Freeze).
+func (g *ByteGate) Admit(id string, cost int64) bool {
+	cost = max(0, cost)
+	if _, dup := g.open[id]; dup || g.frozen {
+		return false
+	}
+	if g.max >= 0 && g.spent+g.reserved+cost > g.max {
+		return false
+	}
+	g.open[id] = cost
+	g.reserved += cost
+	return true
+}
+
+// Finish replaces the probe's reservation with the bytes it used (bounded by its cost). Unknown ids
+// change nothing.
+func (g *ByteGate) Finish(id string, used int64) {
+	cost, ok := g.open[id]
+	if !ok {
+		return
+	}
+	delete(g.open, id)
+	g.reserved -= cost
+	g.spent += min(max(0, used), cost)
+}
+
+// Charge counts bytes outside a reservation (a reach socket) only if they fit and the gate is not
+// frozen.
+func (g *ByteGate) Charge(bytes int64) bool {
+	bytes = max(0, bytes)
+	if g.frozen || (g.max >= 0 && g.spent+g.reserved+bytes > g.max) {
+		return false
+	}
+	g.spent += bytes
+	return true
+}
+
+// Freeze (scan_freeze, plan §2.2b step 5): nothing is admitted or charged any more; open
+// reservations still finish, so spent + reserved now bound everything the scan can still transfer.
+func (g *ByteGate) Freeze()      { g.frozen = true }
+func (g *ByteGate) Frozen() bool { return g.frozen }
+
+// Spent, Reserved and Open report the gate's state.
+func (g *ByteGate) Spent() int64    { return g.spent }
+func (g *ByteGate) Reserved() int64 { return g.reserved }
+func (g *ByteGate) Open() int       { return len(g.open) }
