@@ -65,6 +65,18 @@ func (w *BufferToBytesWriter) WriteMultiBuffer(mb MultiBuffer) error {
 	return nil
 }
 
+// Write implements io.Writer and counts like WriteMultiBuffer. Tribe: without it the embedded
+// writer's Write was promoted, so callers that use this writer as an io.Writer (BufferedWriter's
+// flush: a VLESS request header with the first payload) bypassed the stats counter of a
+// CounterConnection unwrapped by NewWriter.
+func (w *BufferToBytesWriter) Write(b []byte) (int, error) {
+	n, err := w.Writer.Write(b)
+	if w.counter != nil && n > 0 {
+		w.counter.Add(int64(n))
+	}
+	return n, err
+}
