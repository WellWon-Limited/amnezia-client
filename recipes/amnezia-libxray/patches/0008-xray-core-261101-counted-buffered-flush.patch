+package buf_test
+
+import (
+	"bytes"
+	"errors"
+	"net"
+	"syscall"
+	"testing"
+
+	"github.com/xtls/xray-core/app/stats"
+	. "github.com/xtls/xray-core/common/buf"
+	"github.com/xtls/xray-core/transport/internet/stat"
+)
+
+type tribeSinkConn struct {
+	net.Conn
+	out bytes.Buffer
+}
+
+func (c *tribeSinkConn) Write(b []byte) (int, error) { return c.out.Write(b) }
+
+// SyscallConn makes NewWriter treat the sink as a stream socket (like *net.TCPConn).
+func (c *tribeSinkConn) SyscallConn() (syscall.RawConn, error) { return nil, errors.New("test sink") }
+
+// TestTribeBufferedFlushIsCounted: every byte written through NewWriter(CounterConnection) is
+// counted, including the buffered first write (BufferedWriter flushes through io.Writer).
+func TestTribeBufferedFlushIsCounted(t *testing.T) {
+	counter := new(stats.Counter)
+	sink := &tribeSinkConn{}
+	conn := &stat.CounterConnection{Connection: sink, WriteCounter: counter}
+	writer := NewBufferedWriter(NewWriter(conn))
+	header := []byte("request-header")
+	if _, err := writer.Write(header); err != nil {
+		t.Fatal(err)
+	}
+	first := New()
+	first.Extend(4000)
+	if err := writer.WriteMultiBuffer(MultiBuffer{first}); err != nil {
+		t.Fatal(err)
+	}
+	if err := writer.SetBuffered(false); err != nil {
+		t.Fatal(err)
+	}
+	rest := New()
+	rest.Extend(3000)
+	if err := writer.WriteMultiBuffer(MultiBuffer{rest}); err != nil {
+		t.Fatal(err)
+	}
+	want := int64(len(header) + 4000 + 3000)
+	if int64(sink.out.Len()) != want {
+		t.Fatalf("written %d, want %d", sink.out.Len(), want)
+	}
+	if got := counter.Value(); got != want {
+		t.Fatalf("counted %d of %d written bytes", got, want)
+	}
+}
