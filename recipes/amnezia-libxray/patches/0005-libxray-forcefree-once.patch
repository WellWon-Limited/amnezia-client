 import (
 	"runtime/debug"
+	"sync"
+	"sync/atomic"
 	"time"
 )
 
+// Tribe: the release loop is process-wide. Upstream v1.0.3 started a new,
+// unstoppable FreeOSMemory goroutine on every RunXray, so each core restart
+// inside one long-lived process (iOS packet tunnel: reconnects, uplink
+// changes) added one more loop. The loop now starts once per process and
+// keeps running across StopXray/RunXray; a later call only updates the
+// interval (upstream libXray main does the same since PR #141).
+var (
+	forceFreeOnce     sync.Once
+	forceFreeInterval atomic.Int64 // time.Duration
+	forceFreeLoops    atomic.Int32 // loops started; 0 or 1 (read by tests)
+)
+
 func forceFree(interval time.Duration) {
-	go func() {
-		for {
-			time.Sleep(interval)
-			debug.FreeOSMemory()
-		}
-	}()
+	forceFreeInterval.Store(int64(interval))
+	forceFreeOnce.Do(func() {
+		forceFreeLoops.Add(1)
+		go func() {
+			for {
+				time.Sleep(time.Duration(forceFreeInterval.Load()))
+				debug.FreeOSMemory()
+			}
+		}()
+	})
 }
 
 func InitForceFree(maxMemory int64, interval int) {
