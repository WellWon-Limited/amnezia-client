--- /dev/null
+++ b/nodep/memory_tribe_test.go
@@ -0,0 +1,52 @@
+package nodep
+
+import (
+	"math"
+	"runtime"
+	"runtime/debug"
+	"testing"
+	"time"
+)
+
+// TestTribeForceFreeLoopStartsOnce: N RunXray-equivalent calls (each one calls
+// InitForceFree) leave exactly one release loop and no extra goroutines.
+func TestTribeForceFreeLoopStartsOnce(t *testing.T) {
+	prevGC := debug.SetGCPercent(100)
+	debug.SetGCPercent(prevGC)
+	prevLimit := debug.SetMemoryLimit(-1)
+	defer func() {
+		debug.SetGCPercent(prevGC)
+		debug.SetMemoryLimit(prevLimit)
+	}()
+
+	InitForceFree(math.MaxInt64, 1)
+	if got := forceFreeLoops.Load(); got != 1 {
+		t.Fatalf("after first start: loops=%d, want 1", got)
+	}
+	runtime.Gosched()
+	base := runtime.NumGoroutine()
+
+	const starts = 50
+	for i := 0; i < starts; i++ {
+		InitForceFree(30<<20, 1)
+	}
+	if got := forceFreeLoops.Load(); got != 1 {
+		t.Fatalf("after %d more starts: loops=%d, want 1", starts, got)
+	}
+	time.Sleep(10 * time.Millisecond)
+	if got := runtime.NumGoroutine(); got > base {
+		t.Fatalf("goroutines grew from %d to %d over %d starts", base, got, starts)
+	}
+	// The last call still applies its own soft limit (per-session tunable).
+	if got := debug.SetMemoryLimit(-1); got != 30<<20 {
+		t.Fatalf("memory limit=%d, want %d", got, 30<<20)
+	}
+	if got := time.Duration(forceFreeInterval.Load()); got != time.Second {
+		t.Fatalf("interval=%v, want 1s", got)
+	}
+	// interval <= 0 never starts or changes the loop.
+	InitForceFree(30<<20, 0)
+	if got := forceFreeLoops.Load(); got != 1 {
+		t.Fatalf("interval 0 changed loops=%d", got)
+	}
+}
