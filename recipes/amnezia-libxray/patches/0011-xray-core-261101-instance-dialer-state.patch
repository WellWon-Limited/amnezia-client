diff --git a/transport/internet/tribe_dialer_state_test.go b/transport/internet/tribe_dialer_state_test.go
new file mode 100644
index 0000000..f92ae5b
--- /dev/null
+++ b/transport/internet/tribe_dialer_state_test.go
@@ -0,0 +1,222 @@
+package internet_test
+
+// Tribe (0011): a second core instance in the process must not change how the first one dials, and
+// its sockets need not pass the first one's process-wide protect callback.
+// Instance A resolves with its own DNS hosts table (freedom domainStrategy) and dials a
+// dialerProxy hop that only A has; instances B are created and closed around it (a scan probe
+// next to the tunnel). Before the patch every core.New replaced the process-wide DNS client and
+// outbound manager, so A resolved with B's table and looked its hop up in B's outbounds.
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net"
+	"sync"
+	"sync/atomic"
+	"syscall"
+	"testing"
+	"time"
+
+	xnet "github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/common/session"
+	"github.com/xtls/xray-core/core"
+	"github.com/xtls/xray-core/infra/conf/serial"
+	_ "github.com/xtls/xray-core/main/distro/all"
+	"github.com/xtls/xray-core/transport/internet"
+)
+
+func tribeStateInstance(t *testing.T, cfg map[string]any) *core.Instance {
+	t.Helper()
+	raw, _ := json.Marshal(cfg)
+	c, err := serial.LoadJSONConfig(bytes.NewReader(raw))
+	if err != nil {
+		t.Fatal(err)
+	}
+	inst, err := core.New(c)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := inst.Start(); err != nil {
+		t.Fatal(err)
+	}
+	return inst
+}
+
+func tribeStateConfig(hostIP string) map[string]any {
+	return map[string]any{
+		"log": map[string]any{"loglevel": "none"},
+		"dns": map[string]any{"hosts": map[string]any{"tribe-state.test": hostIP}},
+		"outbounds": []any{
+			map[string]any{"tag": "direct", "protocol": "freedom",
+				"settings": map[string]any{"domainStrategy": "UseIPv4", "finalRules": []any{map[string]any{"action": "allow"}}}},
+			map[string]any{"tag": "chain", "protocol": "freedom",
+				"settings":       map[string]any{"finalRules": []any{map[string]any{"action": "allow"}}},
+				"streamSettings": map[string]any{"sockopt": map[string]any{"dialerProxy": "hop-" + hostIP}}},
+			map[string]any{"tag": "hop-" + hostIP, "protocol": "freedom",
+				"settings": map[string]any{"finalRules": []any{map[string]any{"action": "allow"}}}},
+		},
+	}
+}
+
+func tribeStateFetch(inst *core.Instance, tag string, dest xnet.Destination) (string, error) {
+	ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+	defer cancel()
+	conn, err := core.Dial(session.SetForcedOutboundTagToContext(ctx, tag), inst, dest)
+	if err != nil {
+		return "", err
+	}
+	defer conn.Close()
+	stop := context.AfterFunc(ctx, func() { conn.Close() })
+	defer stop()
+	conn.Write([]byte("?"))
+	b, err := io.ReadAll(io.LimitReader(conn, 16))
+	return string(b), err
+}
+
+func TestTribeDialerStatePerInstance(t *testing.T) {
+	ln, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer ln.Close()
+	go func() {
+		for {
+			c, err := ln.Accept()
+			if err != nil {
+				return
+			}
+			go func() {
+				defer c.Close()
+				var b [1]byte
+				c.Read(b[:])
+				c.Write([]byte("instance-A"))
+			}()
+		}
+	}()
+	port := xnet.Port(ln.Addr().(*net.TCPAddr).Port)
+
+	a := tribeStateInstance(t, tribeStateConfig("127.0.0.1"))
+	defer a.Close()
+	byName := xnet.TCPDestination(xnet.DomainAddress("tribe-state.test"), port)
+	byIP := xnet.TCPDestination(xnet.LocalHostIP, port)
+	check := func(when string) {
+		t.Helper()
+		if got, err := tribeStateFetch(a, "direct", byName); got != "instance-A" {
+			t.Fatalf("%s: A's freedom did not resolve with A's DNS: %q %v", when, got, err)
+		}
+		if got, err := tribeStateFetch(a, "chain", byIP); got != "instance-A" {
+			t.Fatalf("%s: A's dialerProxy hop was not found in A: %q %v", when, got, err)
+		}
+	}
+	check("alone")
+	b := tribeStateInstance(t, tribeStateConfig("127.0.0.9")) // resolves elsewhere, other hop tag
+	check("next to B")
+	b.Close()
+	check("after B closed")
+
+	// Instances come and go while A dials (run with -race: the fallback pair is atomic now).
+	var wg sync.WaitGroup
+	stop := make(chan struct{})
+	wg.Add(1)
+	go func() {
+		defer wg.Done()
+		for i := 0; ; i++ {
+			select {
+			case <-stop:
+				return
+			default:
+			}
+			raw, _ := json.Marshal(tribeStateConfig(fmt.Sprintf("127.0.0.%d", 10+i%200)))
+			c, err := serial.LoadJSONConfig(bytes.NewReader(raw))
+			if err != nil {
+				t.Error(err)
+				return
+			}
+			x, err := core.New(c)
+			if err != nil || x.Start() != nil {
+				t.Error("churn instance did not start")
+				return
+			}
+			x.Close()
+		}
+	}()
+	for i := 0; i < 20; i++ {
+		check(fmt.Sprintf("churn %d", i))
+	}
+	close(stop)
+	wg.Wait()
+}
+
+// Tribe (0011): a dial whose context carries a socket protector runs only that protector, never the
+// process-wide controllers (the tunnel's protect callback); a failing protector fails that dial only.
+func TestTribeSocketProtectorReplacesControllers(t *testing.T) {
+	ln, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer ln.Close()
+	go func() {
+		for {
+			c, err := ln.Accept()
+			if err != nil {
+				return
+			}
+			go func() { defer c.Close(); var b [1]byte; c.Read(b[:]); c.Write([]byte("instance-A")) }()
+		}
+	}()
+	port := xnet.Port(ln.Addr().(*net.TCPAddr).Port)
+	target := ln.Addr().String()
+	var globalCalls, protectCalls atomic.Int32
+	internet.RegisterDialerController(func(network, address string, c syscall.RawConn) error {
+		if address == target {
+			globalCalls.Add(1)
+		}
+		return nil
+	})
+	live := tribeStateInstance(t, tribeStateConfig("127.0.0.1"))
+	defer live.Close()
+	byIP := xnet.TCPDestination(xnet.LocalHostIP, port)
+	if got, _ := tribeStateFetch(live, "direct", byIP); got != "instance-A" || globalCalls.Load() != 1 {
+		t.Fatalf("live dial: %q, global controller calls %d", got, globalCalls.Load())
+	}
+	for _, fail := range []bool{false, true} {
+		protect := func(network, address string, c syscall.RawConn) error {
+			protectCalls.Add(1)
+			if fail {
+				return errors.New("probe bind failed (test)")
+			}
+			return nil
+		}
+		ctx := internet.ContextWithSocketProtector(context.Background(), protect)
+		raw, _ := json.Marshal(tribeStateConfig("127.0.0.1"))
+		cfg, _ := serial.LoadJSONConfig(bytes.NewReader(raw))
+		probe, err := core.NewWithContext(ctx, cfg)
+		if err != nil || probe.Start() != nil {
+			t.Fatal("probe instance")
+		}
+		before := protectCalls.Load()
+		dctx, cancel := context.WithTimeout(ctx, 3*time.Second)
+		conn, err := core.Dial(session.SetForcedOutboundTagToContext(dctx, "direct"), probe, byIP)
+		var got []byte
+		if err == nil {
+			conn.Write([]byte("?"))
+			got, _ = io.ReadAll(io.LimitReader(conn, 16))
+			conn.Close()
+		}
+		cancel()
+		probe.Close()
+		if protectCalls.Load() == before || globalCalls.Load() != 1 {
+			t.Fatalf("fail=%v: protector calls %d, global controller calls %d (must stay 1)", fail, protectCalls.Load()-before, globalCalls.Load())
+		}
+		if fail == (string(got) == "instance-A") {
+			t.Fatalf("fail=%v: probe dial answered %q", fail, got)
+		}
+	}
+	if got, _ := tribeStateFetch(live, "direct", byIP); got != "instance-A" || globalCalls.Load() != 2 {
+		t.Fatalf("live dial after the probes: %q, global calls %d", got, globalCalls.Load())
+	}
+}
diff --git a/transport/internet/tribe_instance.go b/transport/internet/tribe_instance.go
new file mode 100644
index 0000000..7871d12
--- /dev/null
+++ b/transport/internet/tribe_instance.go
@@ -0,0 +1,77 @@
+package internet
+
+// Tribe (core 0011): per-instance transport resources. Transports that pool connections across
+// dials (XHTTP's XmuxManager, gRPC's ClientConn) key their pools by the core instance in the dial's
+// context too, and register a closer here; core.Instance.Close runs them, so a short-lived second
+// instance (the Scanner's probe) never leaves pooled connections behind, never shares one with the
+// tunnel's instance, and the tunnel's pools are untouched by a probe's close.
+
+import (
+	"context"
+	"sync"
+	"sync/atomic"
+)
+
+var instanceKeyFn atomic.Pointer[func(context.Context) any]
+
+// RegisterInstanceKey is called by core: fn returns an opaque key of the instance in ctx, or nil.
+func RegisterInstanceKey(fn func(context.Context) any) { instanceKeyFn.Store(&fn) }
+
+// InstanceKeyFromContext returns the key of the core instance a dial belongs to (nil: none).
+func InstanceKeyFromContext(ctx context.Context) any {
+	if ctx == nil {
+		return nil
+	}
+	if p := instanceKeyFn.Load(); p != nil {
+		return (*p)(ctx)
+	}
+	return nil
+}
+
+var instanceClosers = struct {
+	sync.Mutex
+	m map[any][]func()
+}{m: map[any][]func(){}}
+
+// OnInstanceClose runs fn when the instance with this key closes (a nil key: never).
+func OnInstanceClose(key any, fn func()) {
+	if key == nil {
+		return
+	}
+	instanceClosers.Lock()
+	instanceClosers.m[key] = append(instanceClosers.m[key], fn)
+	instanceClosers.Unlock()
+}
+
+// CloseInstanceResources runs the closers of an instance; core.Instance.Close calls it.
+func CloseInstanceResources(key any) {
+	instanceClosers.Lock()
+	fns := instanceClosers.m[key]
+	delete(instanceClosers.m, key)
+	instanceClosers.Unlock()
+	for _, fn := range fns {
+		fn()
+	}
+}
+
+// ContextWithValuesOf returns ctx (its deadline and cancellation) whose values fall back to those of
+// values: a transport that dials from its own context (gRPC) keeps the dial's socket protector,
+// log scope and instance.
+func ContextWithValuesOf(ctx, values context.Context) context.Context {
+	if values == nil {
+		return ctx
+	}
+	return valuesOf{Context: ctx, values: values}
+}
+
+type valuesOf struct {
+	context.Context
+	values context.Context
+}
+
+func (v valuesOf) Value(key any) any {
+	if x := v.Context.Value(key); x != nil {
+		return x
+	}
+	return v.values.Value(key)
+}
diff --git a/transport/internet/tribe_log_scope_test.go b/transport/internet/tribe_log_scope_test.go
new file mode 100644
index 0000000..b65c683
--- /dev/null
+++ b/transport/internet/tribe_log_scope_test.go
@@ -0,0 +1,203 @@
+package internet_test
+
+// Tribe (0011): a core instance created with a scoped context logs into its scope only. The
+// tunnel's instance (app/log at debug into files, DNS log on) keeps logging its own traffic while
+// a scoped instance in the same process dials a host the tunnel log must never see; a
+// context-free line naming that host reaches the tunnel log with the host masked.
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"io"
+	"net"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	applog "github.com/xtls/xray-core/app/log"
+	"github.com/xtls/xray-core/common/errors"
+	clog "github.com/xtls/xray-core/common/log"
+	xnet "github.com/xtls/xray-core/common/net"
+	cserial "github.com/xtls/xray-core/common/serial"
+	"github.com/xtls/xray-core/common/session"
+	"github.com/xtls/xray-core/core"
+	"github.com/xtls/xray-core/infra/conf/serial"
+)
+
+type tribeScopeSink struct {
+	mu sync.Mutex
+	b  strings.Builder
+	n  int
+}
+
+func (s *tribeScopeSink) Handle(m clog.Message) {
+	s.mu.Lock()
+	s.b.WriteString(m.String())
+	s.b.WriteByte('\n')
+	s.n++
+	s.mu.Unlock()
+}
+
+func (s *tribeScopeSink) Severity() clog.Severity { return clog.Severity_Debug }
+
+func tribeEchoListener(t *testing.T) *net.TCPListener {
+	t.Helper()
+	ln, err := net.ListenTCP("tcp4", &net.TCPAddr{IP: net.IPv4(127, 0, 0, 1)})
+	if err != nil {
+		t.Fatal(err)
+	}
+	go func() {
+		for {
+			c, err := ln.Accept()
+			if err != nil {
+				return
+			}
+			go func() {
+				defer c.Close()
+				b := make([]byte, 1)
+				if _, err := c.Read(b); err == nil {
+					c.Write([]byte("ok"))
+				}
+			}()
+		}
+	}()
+	return ln
+}
+
+func TestTribeLogScopePerInstance(t *testing.T) {
+	const secret = "tribe-secret-provider.test"
+	const own = "tribe-own-node.test"
+	dir := t.TempDir()
+	errPath, accessPath := filepath.Join(dir, "error.log"), filepath.Join(dir, "access.log")
+	ln := tribeEchoListener(t)
+	defer ln.Close()
+	port := ln.Addr().(*net.TCPAddr).Port
+
+	tunnelCfg := tribeStateConfig("127.0.0.1")
+	tunnelCfg["log"] = map[string]any{"loglevel": "debug", "error": errPath, "access": accessPath, "dnsLog": true}
+	tunnelCfg["dns"] = map[string]any{"hosts": map[string]any{own: "127.0.0.1"}}
+	tunnel := tribeStateInstance(t, tunnelCfg)
+	tunnelOpen := true
+	defer func() {
+		if tunnelOpen {
+			tunnel.Close()
+		}
+	}()
+
+	scope := &tribeScopeSink{}
+	probeCfg := tribeStateConfig("127.0.0.1")
+	delete(probeCfg, "log")
+	probeCfg["dns"] = map[string]any{"hosts": map[string]any{secret: "127.0.0.1"}}
+	probe := tribeScopedInstance(t, clog.ContextWithScope(context.Background(), scope), probeCfg)
+
+	release := clog.RedactTerms(secret)
+	defer release()
+	for i := 0; i < 3; i++ {
+		if got, err := tribeStateFetch(tunnel, "direct", xnet.TCPDestination(xnet.ParseAddress(own), xnet.Port(port))); err != nil || got != "ok" {
+			t.Fatalf("tunnel fetch %q %v", got, err)
+		}
+		ctx, cancel := context.WithTimeout(clog.ContextWithScope(context.Background(), scope), 3*time.Second)
+		got, err := tribeScopedFetch(ctx, probe, xnet.TCPDestination(xnet.ParseAddress(secret), xnet.Port(port)))
+		cancel()
+		if err != nil || got != "ok" {
+			t.Fatalf("probe fetch %q %v", got, err)
+		}
+	}
+	errors.LogWarning(context.Background(), "a line without a context names ", secret)
+	probe.Close()
+
+	// The file loggers write from their own goroutine: read while the tunnel still runs, until its
+	// own lines and the masked line are there (or 3 s).
+	var logs strings.Builder
+	for deadline := time.Now().Add(3 * time.Second); ; time.Sleep(20 * time.Millisecond) {
+		logs.Reset()
+		for _, p := range []string{errPath, accessPath} {
+			b, err := os.ReadFile(p)
+			if err != nil {
+				t.Fatal(err)
+			}
+			logs.Write(b)
+		}
+		low := strings.ToLower(logs.String())
+		if (strings.Contains(low, own) && strings.Contains(low, clog.RedactedMark)) || time.Now().After(deadline) {
+			break
+		}
+	}
+	tunnel.Close()
+	tunnelOpen = false
+	for _, p := range []string{errPath, accessPath} { // whatever the loggers still wrote
+		if b, err := os.ReadFile(p); err == nil {
+			logs.Write(b)
+		}
+	}
+
+	text := strings.ToLower(logs.String())
+	if strings.Contains(text, secret) {
+		t.Fatalf("the tunnel's log names the scoped instance's host:\n%s", logs.String())
+	}
+	if !strings.Contains(text, own) {
+		t.Fatalf("the tunnel's own lines are missing:\n%s", logs.String())
+	}
+	if !strings.Contains(text, "a line without a context names "+clog.RedactedMark) {
+		t.Fatalf("the context-free line was dropped instead of masked:\n%s", logs.String())
+	}
+	scope.mu.Lock()
+	defer scope.mu.Unlock()
+	if scope.n == 0 || !strings.Contains(scope.b.String(), secret) {
+		t.Fatalf("the scope got %d messages, none naming its host", scope.n)
+	}
+}
+
+func tribeScopedInstance(t *testing.T, ctx context.Context, cfg map[string]any) *core.Instance {
+	t.Helper()
+	c := tribeStateLoad(t, cfg)
+	// Like the Scanner's probe config: no log app of its own (one would replace the process
+	// handler - the tunnel's - for good).
+	logType := cserial.GetMessageType(&applog.Config{})
+	apps := c.App[:0]
+	for _, app := range c.App {
+		if app.Type != logType {
+			apps = append(apps, app)
+		}
+	}
+	c.App = apps
+	inst, err := core.NewWithContext(ctx, c)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := inst.Start(); err != nil {
+		t.Fatal(err)
+	}
+	return inst
+}
+
+func tribeStateLoad(t *testing.T, cfg map[string]any) *core.Config {
+	t.Helper()
+	raw, _ := json.Marshal(cfg)
+	c, err := serial.LoadJSONConfig(bytes.NewReader(raw))
+	if err != nil {
+		t.Fatal(err)
+	}
+	return c
+}
+
+func tribeScopedFetch(ctx context.Context, inst *core.Instance, dest xnet.Destination) (string, error) {
+	return tribeScopedFetchVia(ctx, inst, "direct", dest)
+}
+
+func tribeScopedFetchVia(ctx context.Context, inst *core.Instance, tag string, dest xnet.Destination) (string, error) {
+	conn, err := core.Dial(session.SetForcedOutboundTagToContext(ctx, tag), inst, dest)
+	if err != nil {
+		return "", err
+	}
+	defer conn.Close()
+	stop := context.AfterFunc(ctx, func() { conn.Close() })
+	defer stop()
+	conn.Write([]byte("?"))
+	b, err := io.ReadAll(io.LimitReader(conn, 16))
+	return string(b), err
+}
diff --git a/transport/internet/tribe_pool_scope_test.go b/transport/internet/tribe_pool_scope_test.go
new file mode 100644
index 0000000..f02e1ff
--- /dev/null
+++ b/transport/internet/tribe_pool_scope_test.go
@@ -0,0 +1,203 @@
+package internet_test
+
+// Tribe (0011): connection pools of a transport (XHTTP's XmuxManager, gRPC's ClientConn) belong
+// to the core instance that dialled them. A probe instance next to the tunnel's: its pooled
+// connections dial with the probe's own socket protector (never the process-wide controllers), are
+// never reused by the tunnel (or the reverse), and are closed when the probe instance closes, while
+// the tunnel's stay up and keep working.
+
+import (
+	"context"
+	"io"
+	"net"
+	"strconv"
+	"sync"
+	"sync/atomic"
+	"syscall"
+	"testing"
+	"time"
+
+	clog "github.com/xtls/xray-core/common/log"
+	xnet "github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/core"
+	"github.com/xtls/xray-core/transport/internet"
+)
+
+const tribePoolUUID = "3b1f2e4d-5c6a-4b7e-8f90-a1b2c3d4e5f6"
+
+// tribeCountingProxy forwards to target and counts the connections it carries (open now, total).
+type tribeCountingProxy struct {
+	ln          *net.TCPListener
+	live, total atomic.Int64
+	mu          sync.Mutex
+	conns       []net.Conn
+}
+
+func newTribeCountingProxy(t *testing.T, target int) *tribeCountingProxy {
+	t.Helper()
+	ln, err := net.ListenTCP("tcp4", &net.TCPAddr{IP: net.IPv4(127, 0, 0, 1)})
+	if err != nil {
+		t.Fatal(err)
+	}
+	p := &tribeCountingProxy{ln: ln}
+	go func() {
+		for {
+			c, err := ln.Accept()
+			if err != nil {
+				return
+			}
+			s, err := net.Dial("tcp4", net.JoinHostPort("127.0.0.1", itoa(target)))
+			if err != nil {
+				c.Close()
+				continue
+			}
+			p.live.Add(1)
+			p.total.Add(1)
+			p.mu.Lock()
+			p.conns = append(p.conns, c, s)
+			p.mu.Unlock()
+			var once sync.Once
+			end := func() { once.Do(func() { c.Close(); s.Close(); p.live.Add(-1) }) }
+			go func() { io.Copy(s, c); end() }()
+			go func() { io.Copy(c, s); end() }()
+		}
+	}()
+	t.Cleanup(func() {
+		ln.Close()
+		p.mu.Lock()
+		for _, c := range p.conns {
+			c.Close()
+		}
+		p.mu.Unlock()
+	})
+	return p
+}
+
+func (p *tribeCountingProxy) port() int { return p.ln.Addr().(*net.TCPAddr).Port }
+
+func itoa(n int) string { return strconv.Itoa(n) }
+
+func tribeFreePort(t *testing.T) int {
+	l, err := net.Listen("tcp4", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer l.Close()
+	return l.Addr().(*net.TCPAddr).Port
+}
+
+func tribePoolClient(xPort, gPort int) map[string]any {
+	user := []any{map[string]any{"id": tribePoolUUID, "encryption": "none"}}
+	vnext := func(port int) map[string]any {
+		return map[string]any{"vnext": []any{map[string]any{"address": "127.0.0.1", "port": port, "users": user}}}
+	}
+	return map[string]any{
+		"outbounds": []any{
+			map[string]any{"tag": "x", "protocol": "vless", "settings": vnext(xPort),
+				"streamSettings": map[string]any{"network": "xhttp", "xhttpSettings": map[string]any{"path": "/tribe-x"}}},
+			map[string]any{"tag": "g", "protocol": "vless", "settings": vnext(gPort),
+				"streamSettings": map[string]any{"network": "grpc", "grpcSettings": map[string]any{"serviceName": "tribe-g"}}},
+		},
+	}
+}
+
+func TestTribePoolsPerInstance(t *testing.T) {
+	clog.RegisterHandler(tribeQuietLog{})
+	echo := tribeEchoListener(t)
+	defer echo.Close()
+	dest := xnet.TCPDestination(xnet.ParseAddress("127.0.0.1"), xnet.Port(echo.Addr().(*net.TCPAddr).Port))
+	sx, sg := tribeFreePort(t), tribeFreePort(t)
+	clients := []any{map[string]any{"id": tribePoolUUID}}
+	server := tribeScopedInstance(t, clog.ContextWithScope(context.Background(), tribeQuietLog{}), map[string]any{
+		"inbounds": []any{
+			map[string]any{"listen": "127.0.0.1", "port": sx, "protocol": "vless", "settings": map[string]any{"clients": clients, "decryption": "none"},
+				"streamSettings": map[string]any{"network": "xhttp", "xhttpSettings": map[string]any{"path": "/tribe-x"}}},
+			map[string]any{"listen": "127.0.0.1", "port": sg, "protocol": "vless", "settings": map[string]any{"clients": clients, "decryption": "none"},
+				"streamSettings": map[string]any{"network": "grpc", "grpcSettings": map[string]any{"serviceName": "tribe-g"}}},
+		},
+		"outbounds": []any{map[string]any{"protocol": "freedom", "settings": map[string]any{"finalRules": []any{map[string]any{"action": "allow"}}}}},
+	})
+	defer server.Close()
+	px, pg := newTribeCountingProxy(t, sx), newTribeCountingProxy(t, sg)
+	ports := map[string]bool{"127.0.0.1:" + itoa(px.port()): true, "127.0.0.1:" + itoa(pg.port()): true}
+
+	// The tunnel's process-wide controller (amnezia_xray_setsockcallback / LibXraySetSockCallback).
+	var processCalls atomic.Int64
+	internet.RegisterDialerController(func(network, address string, c syscall.RawConn) error {
+		if ports[address] {
+			processCalls.Add(1)
+		}
+		return nil
+	})
+	fetch := func(inst *core.Instance, tag string) {
+		t.Helper()
+		ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+		defer cancel()
+		got, err := tribeScopedFetchTag(ctx, inst, tag, dest)
+		if err != nil || got != "ok" {
+			t.Fatalf("%s: %q %v", tag, got, err)
+		}
+	}
+	tunnel := tribeScopedInstance(t, context.Background(), tribePoolClient(px.port(), pg.port()))
+	defer tunnel.Close()
+	for _, tag := range []string{"x", "g"} {
+		fetch(tunnel, tag)
+	}
+	time.Sleep(200 * time.Millisecond)
+	tunnelLive := px.live.Load() + pg.live.Load()
+	tunnelTotal := px.total.Load() + pg.total.Load()
+	tunnelProcess := processCalls.Load()
+	if tunnelLive == 0 || tunnelProcess == 0 {
+		t.Fatalf("the tunnel's pools: live %d, controller calls %d", tunnelLive, tunnelProcess)
+	}
+
+	var protectCalls atomic.Int64
+	protect := func(network, address string, c syscall.RawConn) error {
+		if ports[address] {
+			protectCalls.Add(1)
+		}
+		return nil
+	}
+	probeCtx := internet.ContextWithSocketProtector(clog.ContextWithScope(context.Background(), tribeQuietLog{}), protect)
+	probe := tribeScopedInstance(t, probeCtx, tribePoolClient(px.port(), pg.port()))
+	for _, tag := range []string{"x", "g"} {
+		ctx, cancel := context.WithTimeout(probeCtx, 5*time.Second)
+		got, err := tribeScopedFetchTag(ctx, probe, tag, dest)
+		cancel()
+		if err != nil || got != "ok" {
+			t.Fatalf("probe %s: %q %v", tag, got, err)
+		}
+	}
+	time.Sleep(200 * time.Millisecond)
+	if processCalls.Load() != tunnelProcess {
+		t.Errorf("probe sockets ran the process-wide controller (%d calls, %d before)", processCalls.Load(), tunnelProcess)
+	}
+	if protectCalls.Load() < 2 {
+		t.Errorf("probe sockets ran their own protector %d times, want one per transport", protectCalls.Load())
+	}
+	if px.total.Load()+pg.total.Load() < tunnelTotal+2 {
+		t.Errorf("the probe reused the tunnel's pooled connections (total %d, tunnel's %d)", px.total.Load()+pg.total.Load(), tunnelTotal)
+	}
+	probe.Close()
+	deadline := time.Now().Add(3 * time.Second)
+	for px.live.Load()+pg.live.Load() > tunnelLive && time.Now().Before(deadline) {
+		time.Sleep(20 * time.Millisecond)
+	}
+	if live := px.live.Load() + pg.live.Load(); live > tunnelLive {
+		t.Errorf("the probe's pooled connections outlived it: %d live, the tunnel holds %d", live, tunnelLive)
+	}
+	// The tunnel's pools are untouched by the probe's close.
+	for _, tag := range []string{"x", "g"} {
+		fetch(tunnel, tag)
+	}
+	t.Logf("tunnel: %d live / %d connections; after the probe closed: %d live; protector calls %d, controller calls %d",
+		tunnelLive, tunnelTotal, px.live.Load()+pg.live.Load(), protectCalls.Load(), processCalls.Load())
+}
+
+type tribeQuietLog struct{}
+
+func (tribeQuietLog) Handle(clog.Message) {}
+
+func tribeScopedFetchTag(ctx context.Context, inst *core.Instance, tag string, dest xnet.Destination) (string, error) {
+	return tribeScopedFetchVia(ctx, inst, tag, dest)
+}
