+// Tribe (0011): a dial uses the DNS client and outbound manager of the instance in its context.
+func init() {
+	internet.RegisterContextDialerState(func(ctx context.Context) (dns.Client, outbound.Manager) {
+		v := FromContext(ctx)
+		if v == nil {
+			return nil, nil
+		}
+		dc, _ := v.GetFeature(dns.ClientType()).(dns.Client)
+		om, _ := v.GetFeature(outbound.ManagerType()).(outbound.Manager)
+		return dc, om
+	})
+	// Transport pools are per instance and closed with it (Instance.Close).
+	internet.RegisterInstanceKey(func(ctx context.Context) any {
+		if v := FromContext(ctx); v != nil {
+			return v
+		}
+		return nil
+	})
+}
+
 // XrayKey is the key type of Instance in Context, exported for test.
 type XrayKey int
 
