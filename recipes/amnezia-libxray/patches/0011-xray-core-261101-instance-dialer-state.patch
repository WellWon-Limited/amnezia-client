diff --git a/common/log/tribe_scope.go b/common/log/tribe_scope.go
new file mode 100644
index 0000000..85dd4cc
--- /dev/null
+++ b/common/log/tribe_scope.go
@@ -0,0 +1,231 @@
+package log
+
+// Tribe (core 0011): log scopes and redaction, so a short-lived second core instance in the
+// process (the Scanner's probe instances) never writes what it dials into the process log - the
+// handler the tunnel's instance registered (its log file, the app's log callback) or, without
+// one, the default stdout handler.
+//
+// Scope: a context may carry a scope handler (ContextWithScope). A message recorded with that
+// context (RecordContext, errors.LogX) goes to the scope handler only, never to the process
+// handler. A core instance created with core.NewWithContext(scopedCtx, ...) hands the scope to its
+// features, so everything it logs with its own or a derived context stays in the scope.
+//
+// Redaction: messages recorded without a scope (context.Background() call sites, goroutines that
+// lost the context) still reach the process handler. RedactTerms registers strings that must not
+// appear there: such a message is passed on with every occurrence (case-insensitive) replaced by
+// "[redacted]", keeping its type and severity, so the process log loses no line. Without
+// registered terms Record costs one atomic load more than before.
+
+import (
+	"context"
+	"strings"
+	"sync"
+	"sync/atomic"
+
+	"github.com/xtls/xray-core/common/serial"
+)
+
+type scopeKey struct{}
+
+// ContextWithScope returns a context whose messages go to h instead of the process handler.
+func ContextWithScope(ctx context.Context, h Handler) context.Context {
+	return context.WithValue(ctx, scopeKey{}, h)
+}
+
+// ScopeFromContext returns the scope handler of ctx, or nil.
+func ScopeFromContext(ctx context.Context) Handler {
+	if ctx == nil {
+		return nil
+	}
+	h, _ := ctx.Value(scopeKey{}).(Handler)
+	return h
+}
+
+// ScopeWants reports whether scope h takes a message of this severity (a SeverityLogger scope
+// drops more verbose ones before they are built).
+func ScopeWants(h Handler, severity Severity) bool {
+	if sh, ok := h.(SeverityLogger); ok {
+		return sh.Severity() >= severity
+	}
+	return true
+}
+
+// RecordContext writes msg to the scope handler of ctx, or (redacted) to the process handler.
+func RecordContext(ctx context.Context, msg Message) {
+	if h := ScopeFromContext(ctx); h != nil {
+		h.Handle(msg)
+		return
+	}
+	Record(msg)
+}
+
+// RedactedMark replaces a registered term in a process log line.
+const RedactedMark = "[redacted]"
+
+// minRedactTerm: shorter terms would mask unrelated text.
+const minRedactTerm = 4
+
+type redactSet struct {
+	terms []string // lower case
+}
+
+var (
+	redactMu   sync.Mutex
+	redactRefs = map[string]int{}
+	redactCur  atomic.Pointer[redactSet]
+	redactHits atomic.Uint64
+)
+
+// RedactTerms registers terms for the process handler and returns the function that removes them
+// again (registrations are counted, a term stays while any registration holds it). Terms shorter
+// than 4 bytes are ignored.
+func RedactTerms(terms ...string) (release func()) {
+	var held []string
+	redactMu.Lock()
+	for _, t := range terms {
+		t = strings.ToLower(strings.TrimSpace(t))
+		if len(t) < minRedactTerm {
+			continue
+		}
+		redactRefs[t]++
+		held = append(held, t)
+	}
+	if len(held) > 0 {
+		publishRedactLocked()
+	}
+	redactMu.Unlock()
+	var once sync.Once
+	return func() {
+		once.Do(func() {
+			if len(held) == 0 {
+				return
+			}
+			redactMu.Lock()
+			for _, t := range held {
+				if redactRefs[t]--; redactRefs[t] <= 0 {
+					delete(redactRefs, t)
+				}
+			}
+			publishRedactLocked()
+			redactMu.Unlock()
+		})
+	}
+}
+
+func publishRedactLocked() {
+	if len(redactRefs) == 0 {
+		redactCur.Store(nil)
+		return
+	}
+	set := &redactSet{terms: make([]string, 0, len(redactRefs))}
+	for t := range redactRefs {
+		set.terms = append(set.terms, t)
+	}
+	redactCur.Store(set)
+}
+
+// RedactedLines is the number of process log lines that had a term masked.
+func RedactedLines() uint64 { return redactHits.Load() }
+
+// RedactString masks the registered terms in s; ok is false when s had none.
+func RedactString(s string) (out string, ok bool) {
+	set := redactCur.Load()
+	if set == nil {
+		return s, false
+	}
+	return set.mask(s)
+}
+
+func (set *redactSet) mask(s string) (string, bool) {
+	lower := strings.ToLower(s)
+	if len(lower) != len(s) {
+		// Case folding changed the byte length (non-ASCII text): mask the whole line if a term
+		// is in it rather than cut it at wrong offsets.
+		for _, t := range set.terms {
+			if strings.Contains(lower, t) {
+				return RedactedMark, true
+			}
+		}
+		return s, false
+	}
+	var hide []bool
+	for _, t := range set.terms {
+		for from := 0; ; {
+			i := strings.Index(lower[from:], t)
+			if i < 0 {
+				break
+			}
+			i += from
+			if hide == nil {
+				hide = make([]bool, len(s))
+			}
+			for k := i; k < i+len(t); k++ {
+				hide[k] = true
+			}
+			from = i + len(t)
+		}
+	}
+	if hide == nil {
+		return s, false
+	}
+	var out strings.Builder
+	out.Grow(len(s))
+	for i := 0; i < len(s); {
+		j := i
+		for j < len(s) && hide[j] == hide[i] {
+			j++
+		}
+		if hide[i] {
+			out.WriteString(RedactedMark)
+		} else {
+			out.WriteString(s[i:j])
+		}
+		i = j
+	}
+	return out.String(), true
+}
+
+// redactMessage returns msg as the process handler may see it.
+func redactMessage(msg Message) Message {
+	set := redactCur.Load()
+	if set == nil || msg == nil {
+		return msg
+	}
+	masked, hit := set.mask(msg.String())
+	if !hit {
+		return msg
+	}
+	redactHits.Add(1)
+	str := func(v interface{}) string {
+		s, _ := set.mask(serial.ToString(v))
+		return s
+	}
+	switch m := msg.(type) {
+	case *GeneralMessage:
+		return &GeneralMessage{Severity: m.Severity, Content: str(m.Content)}
+	case *AccessMessage:
+		c := *m
+		c.From, c.To, c.Reason = str(m.From), str(m.To), str(m.Reason)
+		c.Email, c.Detour = str(m.Email), str(m.Detour)
+		return &c
+	case *DNSLog:
+		c := *m
+		c.Server, c.Domain = str(m.Server), str(m.Domain)
+		if m.Error != nil {
+			c.Error = redactedError(str(m.Error))
+		}
+		c.Result = nil
+		for _, ip := range m.Result {
+			if _, hit := set.mask(ip.String()); !hit {
+				c.Result = append(c.Result, ip)
+			}
+		}
+		return &c
+	default:
+		return &GeneralMessage{Severity: Severity_Info, Content: masked}
+	}
+}
+
+type redactedError string
+
+func (e redactedError) Error() string { return string(e) }
diff --git a/common/log/tribe_scope_test.go b/common/log/tribe_scope_test.go
new file mode 100644
index 0000000..68d4b30
--- /dev/null
+++ b/common/log/tribe_scope_test.go
@@ -0,0 +1,95 @@
+package log_test
+
+import (
+	"context"
+	"net"
+	"strings"
+	"sync"
+	"testing"
+
+	"github.com/xtls/xray-core/common/log"
+)
+
+type tribeCapture struct {
+	mu   sync.Mutex
+	msgs []log.Message
+}
+
+func (c *tribeCapture) Handle(m log.Message) {
+	c.mu.Lock()
+	c.msgs = append(c.msgs, m)
+	c.mu.Unlock()
+}
+
+func (c *tribeCapture) take() []log.Message {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	m := c.msgs
+	c.msgs = nil
+	return m
+}
+
+// Tribe (core 0011): a scoped context's messages never reach the process handler; registered terms
+// are masked in process messages of every type, which keep their type and severity.
+func TestTribeLogScopeAndRedaction(t *testing.T) {
+	process := &tribeCapture{}
+	log.RegisterHandler(process)
+	scope := &tribeCapture{}
+	ctx := log.ContextWithScope(context.Background(), scope)
+
+	log.RecordContext(ctx, &log.GeneralMessage{Severity: log.Severity_Info, Content: "dial secret-host.test"})
+	if got := process.take(); len(got) != 0 {
+		t.Fatalf("scoped message reached the process handler: %v", got)
+	}
+	if got := scope.take(); len(got) != 1 {
+		t.Fatalf("scope got %d messages, want 1", len(got))
+	}
+
+	release := log.RedactTerms("Secret-Host.TEST", "abc", "203.0.113.7")
+	release2 := log.RedactTerms("secret-host.test")
+	before := log.RedactedLines()
+	log.Record(&log.GeneralMessage{Severity: log.Severity_Warning, Content: "a SECRET-HOST.test b secret-host.testsecret-host.test c abc"})
+	log.Record(&log.AccessMessage{From: "x", To: "tcp:secret-host.test:443", Status: log.AccessAccepted, Detour: "p"})
+	log.Record(&log.DNSLog{Server: "s", Domain: "secret-host.test.", Result: []net.IP{net.ParseIP("203.0.113.7"), net.ParseIP("198.51.100.1")}})
+	log.Record(&log.GeneralMessage{Severity: log.Severity_Info, Content: "unrelated line"})
+	got := process.take()
+	if len(got) != 4 {
+		t.Fatalf("process got %d messages, want 4 (redaction must not drop lines)", len(got))
+	}
+	if g, ok := got[0].(*log.GeneralMessage); !ok || g.Severity != log.Severity_Warning {
+		t.Fatalf("general message changed type or severity: %#v", got[0])
+	}
+	if s := got[0].String(); s != "[Warning] a [redacted] b [redacted] c abc" {
+		t.Fatalf("masked general line %q", s)
+	}
+	if _, ok := got[1].(*log.AccessMessage); !ok {
+		t.Fatalf("access message changed type: %T", got[1])
+	}
+	if d, ok := got[2].(*log.DNSLog); !ok || len(d.Result) != 1 || d.Result[0].String() != "198.51.100.1" {
+		t.Fatalf("dns log: %#v", got[2])
+	}
+	for _, m := range got[:3] {
+		s := strings.ToLower(m.String())
+		if strings.Contains(s, "secret-host") || strings.Contains(s, "203.0.113.7") {
+			t.Fatalf("term left in %q", m.String())
+		}
+		if !strings.Contains(s, log.RedactedMark) {
+			t.Fatalf("no mark in %q", m.String())
+		}
+	}
+	if got[3].String() != "[Info] unrelated line" {
+		t.Fatalf("unrelated line changed: %q", got[3].String())
+	}
+	if d := log.RedactedLines() - before; d != 3 {
+		t.Fatalf("redacted lines %d, want 3", d)
+	}
+	release()
+	release() // idempotent
+	if s, ok := log.RedactString("secret-host.test 203.0.113.7"); !ok || s != "[redacted] 203.0.113.7" {
+		t.Fatalf("second registration must hold its term: %q %v", s, ok)
+	}
+	release2()
+	if s, ok := log.RedactString("secret-host.test"); ok || s != "secret-host.test" {
+		t.Fatalf("released term still masked: %q", s)
+	}
+}
