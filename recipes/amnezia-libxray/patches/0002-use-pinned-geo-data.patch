From 4b523bd26f05d98c4571d632fe229de400e9c5c0 Mon Sep 17 00:00:00 2001
From: Tribe VPN <engineering@tribevpn.example>
Date: Fri, 28 Aug 2026 08:45:00 +0300
Subject: [PATCH] fix: build Android assets from pinned geo data

The upstream helper downloads mutable `latest` release assets and stamps the
current wall clock into every AAR.  The Conan recipe supplies authenticated,
versioned inputs instead; this helper now only validates and indexes them.
---
 main/main.go | 81 +++++-------------------------------------------------------
 1 file changed, 8 insertions(+), 73 deletions(-)

diff --git a/main/main.go b/main/main.go
index 85bb543..2a37672 100644
--- a/main/main.go
+++ b/main/main.go
@@ -2,53 +2,20 @@ package main
 
 import (
 	"fmt"
-	"io"
-	"net/http"
 	"os"
 	"path"
-	"strconv"
-	"time"
 
 	libXray "github.com/amnezia-vpn/amnezia-libxray"
-	"github.com/amnezia-vpn/amnezia-libxray/nodep"
 )
 
-func checkDir(dir string) error {
-	if _, err := os.Stat(dir); err == nil {
-		err = os.RemoveAll(dir)
-		if err != nil {
-			return err
-		}
+func validateGeoData(datDir string, name string, dataType string) {
+	result := libXray.LoadGeoData(datDir, name, dataType)
+	if len(result) != 0 {
+		fmt.Println("LoadGeoData", name, result)
+		os.Exit(1)
 	}
-	if err := os.Mkdir(dir, os.ModePerm); err != nil {
-		return err
-	}
-	return nil
 }
 
-func downloadFile(url string, writePath string) error {
-	client := http.Client{}
-	resp, err := client.Get(url)
-	if err != nil {
-		return err
-	}
-	defer resp.Body.Close()
-	body, err := io.ReadAll(resp.Body)
-	if err != nil {
-		return err
-	}
-
-	err = nodep.WriteBytes(body, writePath)
-	return err
-}
-
-func saveTimestamp(datDir string) error {
-	ts := time.Now().Unix()
-	tsText := strconv.FormatInt(ts, 10)
-	tsPath := path.Join(datDir, "timestamp.txt")
-	return nodep.WriteText(tsText, tsPath)
-}
-
 func main() {
 	cwd, err := os.Getwd()
 	if err != nil {
@@ -56,38 +23,6 @@ func main() {
 		os.Exit(1)
 	}
 	datDir := path.Join(cwd, "dat")
-	checkDir(datDir)
-
-	geositeUrl := "https://github.com/v2fly/domain-list-community/releases/latest/download/dlc.dat"
-	geositePath := path.Join(datDir, "geosite.dat")
-	err = downloadFile(geositeUrl, geositePath)
-	if err != nil {
-		fmt.Println(err)
-		os.Exit(1)
-	}
-	result := libXray.LoadGeoData(datDir, "geosite", "domain")
-	if len(result) != 0 {
-		fmt.Println("LoadGeoData ", result)
-		os.Exit(1)
-	}
-
-	geoipUrl := "https://github.com/v2fly/geoip/releases/latest/download/geoip.dat"
-	geoipPath := path.Join(datDir, "geoip.dat")
-	err = downloadFile(geoipUrl, geoipPath)
-	if err != nil {
-		fmt.Println(err)
-		os.Exit(1)
-	}
-
-	result = libXray.LoadGeoData(datDir, "geoip", "ip")
-	if len(result) != 0 {
-		fmt.Println("load geoip ", result)
-		os.Exit(1)
-	}
-
-	err = saveTimestamp(datDir)
-	if err != nil {
-		fmt.Println(err)
-		os.Exit(1)
-	}
+	validateGeoData(datDir, "geosite", "domain")
+	validateGeoData(datDir, "geoip", "ip")
 }
