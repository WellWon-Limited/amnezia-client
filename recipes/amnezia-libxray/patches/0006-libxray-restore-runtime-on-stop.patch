diff --git a/xray/xray_tribe_test.go b/xray/xray_tribe_test.go
new file mode 100644
index 0000000..131b313
--- /dev/null
+++ b/xray/xray_tribe_test.go
@@ -0,0 +1,45 @@
+package xray
+
+import (
+	"math"
+	"os"
+	"path/filepath"
+	"runtime/debug"
+	"testing"
+)
+
+// TestTribeXraySessionRestoresRuntime: RunXray applies the memory regime only
+// for the session; StopXray and a failed RunXray give the values back.
+func TestTribeXraySessionRestoresRuntime(t *testing.T) {
+	prevGC := debug.SetGCPercent(100)
+	prevLimit := debug.SetMemoryLimit(math.MaxInt64)
+	defer func() {
+		debug.SetGCPercent(prevGC)
+		debug.SetMemoryLimit(prevLimit)
+	}()
+
+	dir := t.TempDir()
+	if err := RunXray(dir, filepath.Join(dir, "missing.json"), 30<<20); err == nil {
+		t.Fatal("RunXray with a missing config succeeded")
+	}
+	if gc, limit := debug.SetGCPercent(100), debug.SetMemoryLimit(-1); gc != 100 || limit != math.MaxInt64 {
+		t.Fatalf("failed RunXray left gc=%d limit=%d", gc, limit)
+	}
+
+	cfg := filepath.Join(dir, "config.json")
+	if err := os.WriteFile(cfg, []byte(`{"log":{"loglevel":"none"},"outbounds":[{"protocol":"freedom"}]}`), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if err := RunXray(dir, cfg, 30<<20); err != nil {
+		t.Fatalf("RunXray: %v", err)
+	}
+	if gc, limit := debug.SetGCPercent(10), debug.SetMemoryLimit(-1); gc != 10 || limit != 30<<20 {
+		t.Fatalf("session regime gc=%d limit=%d, want 10 and %d", gc, limit, 30<<20)
+	}
+	if err := StopXray(); err != nil {
+		t.Fatalf("StopXray: %v", err)
+	}
+	if gc, limit := debug.SetGCPercent(100), debug.SetMemoryLimit(-1); gc != 100 || limit != math.MaxInt64 {
+		t.Fatalf("StopXray left gc=%d limit=%d", gc, limit)
+	}
+}
