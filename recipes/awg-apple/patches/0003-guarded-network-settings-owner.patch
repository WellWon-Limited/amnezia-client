+/// Immutable output of the authenticated outer-guard PREPARE transaction. It freezes both the
+/// exact tunnel configuration and its resolved peer endpoints so ACTIVATE/path-resume cannot
+/// resolve a different address than the one excluded by the outer NetworkExtension policy.
+public final class WireGuardGuardPreparation {
+    public let tunnelConfiguration: TunnelConfiguration
+    fileprivate let settingsGenerator: PacketTunnelSettingsGenerator
+
+    fileprivate init(tunnelConfiguration: TunnelConfiguration,
+                     settingsGenerator: PacketTunnelSettingsGenerator) {
+        self.tunnelConfiguration = tunnelConfiguration
+        self.settingsGenerator = settingsGenerator
+    }
+
+    public var networkSettings: NEPacketTunnelNetworkSettings {
+        settingsGenerator.generateNetworkSettings()
+    }
+
+    public var resolvedEndpointLiterals: [String] {
+        settingsGenerator.resolvedEndpoints.compactMap { endpoint in
+            guard let endpoint else { return nil }
+            switch endpoint.host {
+            case .ipv4(let address): return "\(address)"
+            case .ipv6(let address): return "\(address)"
+            case .name: return nil
+            @unknown default: return nil
+            }
+        }
+    }
+}
