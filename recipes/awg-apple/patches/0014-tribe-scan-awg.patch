--- /dev/null
+++ b/Sources/WireGuardKitGo/tribeawg/session.go
@@ -0,0 +1,318 @@
+// Package tribeawg is the Scanner's AmneziaWG mini-session runner (awg-probe-plan.md §3, §6.3,
+// contract "One awg_mini session"): a userspace AmneziaWG device on an in-memory gVisor netstack,
+// next to the live tunnel in the same process, with its own registry and its own (silent) logger,
+// never the extension's tunnelHandles, global C logger or dnsfwd / directsplit wrappers.
+//
+// One session: the device's OWN key from the candidate's UAPI lines; its UDP socket bound to the
+// physical interface by the probe's protector BEFORE the first packet; the handshake triggered by
+// one persistent keepalive and awaited up to the job's timeout; the prime ICMP echoes; then the
+// engine's data probe over DialTCP (no DNS inside the session). Close tears the device down; the
+// engine calls it on every path.
+//
+// Process rules (defence in depth next to the engine's): one open session per node (peer key) -
+// a second Open for it fails with ErrAwgBusy; initiations of the identity at least job.Spacing apart.
+package tribeawg
+
+import (
+	"bufio"
+	"context"
+	"net"
+	"net/netip"
+	"strconv"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"github.com/amnezia-vpn/amneziawg-go/v3/conn"
+	"github.com/amnezia-vpn/amneziawg-go/v3/device"
+	"github.com/amnezia-vpn/amneziawg-go/v3/tun/netstack"
+	"golang.org/x/net/icmp"
+	"golang.org/x/net/ipv4"
+	"golang.org/x/net/ipv6"
+
+	"github.com/amnezia-vpn/amneziawg-apple/tribescan"
+)
+
+// The registry of open sessions (not tunnelHandles: locked, and only probe sessions).
+var reg = struct {
+	sync.Mutex
+	open     map[string]*session
+	lastInit time.Time
+}{open: map[string]*session{}}
+
+var live atomic.Int64
+
+// Live is the number of open sessions (tests, leak checks).
+func Live() int64 { return live.Load() }
+
+const (
+	echoWait    = 150 * time.Millisecond
+	echoPayload = 56
+	defaultMTU  = 1280
+	pollEvery   = 5 * time.Millisecond
+)
+
+type session struct {
+	key      string
+	dev      *device.Device
+	tnet     *netstack.Net
+	local    netip.Addr
+	hsOK     bool
+	hsMs     int64
+	sent     int
+	replies  int
+	echoWire int64
+	once     sync.Once
+}
+
+var _ tribescan.AwgOpener = Open
+
+// Open opens one session (a tribescan.AwgOpener). It returns once the handshake succeeded (and the
+// prime echoes ran) or timed out; errors: tribescan.ErrAwgConfig, ErrAwgBind, ErrAwgBusy, or the
+// context's error.
+func Open(ctx context.Context, job tribescan.AwgJob) (_ tribescan.AwgSession, err error) {
+	if job.PeerKey == "" || len(job.Addresses) == 0 {
+		return nil, tribescan.ErrAwgConfig
+	}
+	s := &session{key: job.PeerKey, hsMs: -1}
+	reg.Lock()
+	if reg.open[job.PeerKey] != nil {
+		reg.Unlock()
+		return nil, tribescan.ErrAwgBusy
+	}
+	reg.open[job.PeerKey] = s
+	reg.Unlock()
+	live.Add(1)
+	ok := false
+	defer func() {
+		if !ok {
+			s.Close()
+		}
+	}()
+	addrs := make([]netip.Addr, 0, len(job.Addresses))
+	for _, p := range job.Addresses {
+		addrs = append(addrs, p.Addr())
+	}
+	s.local = addrs[0]
+	mtu := job.MTU
+	if mtu <= 0 {
+		mtu = defaultMTU
+	}
+	tdev, tnet, terr := netstack.CreateNetTUN(addrs, nil, mtu)
+	if terr != nil {
+		return nil, tribescan.ErrAwgConfig
+	}
+	s.tnet = tnet
+	bind := conn.NewStdNetBind()
+	// Its own logger: nothing of a session (endpoints, keys) reaches the extension's log.
+	s.dev = device.NewDevice(tdev, bind, &device.Logger{Verbosef: device.DiscardLogf, Errorf: device.DiscardLogf})
+	if err := s.dev.IpcSet(withoutKeepalive(job.UAPI)); err != nil {
+		return nil, tribescan.ErrAwgConfig
+	}
+	if err := s.dev.Up(); err != nil {
+		return nil, tribescan.ErrAwgBind
+	}
+	// The probe's own protection on every socket of the session before its first packet (nothing is
+	// sent before the trigger below: no keepalive, no traffic).
+	if err := protect(bind, job.Protect); err != nil {
+		return nil, err
+	}
+	if err := waitSpacing(ctx, job.Spacing); err != nil {
+		return nil, err
+	}
+	t0 := time.Now()
+	if err := s.dev.IpcSet("public_key=" + job.PeerKey + "\nupdate_only=true\npersistent_keepalive_interval=1\n"); err != nil {
+		return nil, tribescan.ErrAwgConfig
+	}
+	timeout := job.Handshake
+	if timeout <= 0 {
+		timeout = 1500 * time.Millisecond
+	}
+	deadline := t0.Add(timeout)
+	for {
+		if s.handshaken(job.PeerKey) {
+			s.hsOK, s.hsMs = true, time.Since(t0).Milliseconds()
+			break
+		}
+		if !time.Now().Before(deadline) {
+			break
+		}
+		select {
+		case <-ctx.Done():
+			return nil, ctx.Err()
+		case <-time.After(pollEvery):
+		}
+	}
+	// One keepalive was the trigger; the session sends nothing else of its own.
+	_ = s.dev.IpcSet("public_key=" + job.PeerKey + "\nupdate_only=true\npersistent_keepalive_interval=0\n")
+	if s.hsOK && job.Echoes > 0 && job.EchoTarget.IsValid() {
+		s.echo(ctx, job.EchoTarget, job.Echoes)
+	}
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	ok = true
+	return s, nil
+}
+
+// withoutKeepalive drops persistent keepalive lines: a keepalive at Up would send the first packet
+// before the socket is protected.
+func withoutKeepalive(uapi string) string {
+	var b strings.Builder
+	for _, line := range strings.Split(uapi, "\n") {
+		if strings.HasPrefix(strings.TrimSpace(line), "persistent_keepalive_interval=") {
+			continue
+		}
+		b.WriteString(line)
+		b.WriteByte('\n')
+	}
+	return b.String()
+}
+
+func protect(bind conn.Bind, fn func(network string, fd uintptr) error) error {
+	if fn == nil {
+		return nil
+	}
+	peek, ok := bind.(conn.PeekLookAtSocketFd)
+	if !ok {
+		return tribescan.ErrAwgBind
+	}
+	fd4, err4 := peek.PeekLookAtSocketFd4()
+	if err4 == nil {
+		if err := fn("udp4", uintptr(fd4)); err != nil {
+			return tribescan.ErrAwgBind
+		}
+	}
+	fd6, err6 := peek.PeekLookAtSocketFd6()
+	if err6 == nil {
+		if err := fn("udp6", uintptr(fd6)); err != nil {
+			return tribescan.ErrAwgBind
+		}
+	}
+	if err4 != nil && err6 != nil {
+		return tribescan.ErrAwgBind
+	}
+	return nil
+}
+
+// waitSpacing keeps initiations of the identity (every session uses the device's key) apart:
+// two initiations closer than ~50 ms lose handshakes (awg-probe-plan.md §1.2).
+func waitSpacing(ctx context.Context, gap time.Duration) error {
+	for {
+		reg.Lock()
+		next := reg.lastInit.Add(gap)
+		now := time.Now()
+		if reg.lastInit.IsZero() || !now.Before(next) {
+			reg.lastInit = now
+			reg.Unlock()
+			return nil
+		}
+		reg.Unlock()
+		select {
+		case <-ctx.Done():
+			return ctx.Err()
+		case <-time.After(next.Sub(now)):
+		}
+	}
+}
+
+// handshaken reads the peer's last handshake time through the device's own UAPI.
+func (s *session) handshaken(peerKey string) bool {
+	text, err := s.dev.IpcGet()
+	if err != nil {
+		return false
+	}
+	inPeer := false
+	sc := bufio.NewScanner(strings.NewReader(text))
+	for sc.Scan() {
+		k, v, _ := strings.Cut(sc.Text(), "=")
+		switch k {
+		case "public_key":
+			inPeer = v == peerKey
+		case "last_handshake_time_sec":
+			if inPeer {
+				n, _ := strconv.ParseInt(v, 10, 64)
+				return n > 0
+			}
+		}
+	}
+	return false
+}
+
+// echo sends n ICMP echoes to target inside the tunnel, 150 ms each (the first packet after the
+// handshake is lost with S4 obfuscation; these absorb it). Diagnostic only; their IP bytes both
+// ways are counted.
+func (s *session) echo(ctx context.Context, target netip.Addr, n int) {
+	pc, err := s.tnet.DialPingAddr(s.local, target)
+	if err != nil {
+		return
+	}
+	defer pc.Close()
+	stop := context.AfterFunc(ctx, func() { pc.Close() })
+	defer stop()
+	ipHeader := int64(20)
+	var typ icmp.Type = ipv4.ICMPTypeEcho
+	proto := 1
+	if target.Is6() {
+		ipHeader, typ, proto = 40, ipv6.ICMPTypeEchoRequest, 58
+	}
+	buf := make([]byte, 1500)
+	for i := 1; i <= n && ctx.Err() == nil; i++ {
+		msg := icmp.Message{Type: typ, Body: &icmp.Echo{ID: 0x7462, Seq: i, Data: make([]byte, echoPayload)}}
+		raw, err := msg.Marshal(nil)
+		if err != nil {
+			return
+		}
+		end := time.Now().Add(echoWait)
+		pc.SetDeadline(end)
+		if _, err := pc.Write(raw); err != nil {
+			continue
+		}
+		s.sent++
+		s.echoWire += ipHeader + int64(len(raw))
+		for time.Now().Before(end) {
+			m, err := pc.Read(buf)
+			if err != nil {
+				break
+			}
+			reply, err := icmp.ParseMessage(proto, buf[:m])
+			if err != nil {
+				continue
+			}
+			if e, ok := reply.Body.(*icmp.Echo); ok && e.Seq == i {
+				s.replies++
+				s.echoWire += ipHeader + int64(m)
+				// The rest of the 150 ms is not waited: the next echo (if any) goes now.
+				break
+			}
+		}
+	}
+}
+
+func (s *session) HandshakeOK() bool  { return s.hsOK }
+func (s *session) HandshakeMs() int64 { return s.hsMs }
+func (s *session) Echoes() (int, int, int64) {
+	return s.sent, s.replies, s.echoWire
+}
+
+// DialTCP opens a TCP connection inside the tunnel to an IP literal.
+func (s *session) DialTCP(ctx context.Context, addr netip.AddrPort) (net.Conn, error) {
+	return s.tnet.DialContextTCPAddrPort(ctx, addr)
+}
+
+// Close closes the device (its netstack, socket and goroutines) and leaves the registry.
+func (s *session) Close() error {
+	s.once.Do(func() {
+		if s.dev != nil {
+			s.dev.Close()
+		}
+		reg.Lock()
+		if reg.open[s.key] == s {
+			delete(reg.open, s.key)
+		}
+		reg.Unlock()
+		live.Add(-1)
+	})
+	return nil
+}
diff --git a/Sources/WireGuardKitGo/tribeawg/session_test.go b/Sources/WireGuardKitGo/tribeawg/session_test.go
new file mode 100644
index 0000000..47e438d
--- /dev/null
+++ b/Sources/WireGuardKitGo/tribeawg/session_test.go
@@ -0,0 +1,760 @@
+//go:build tribescan_testkit
+
+package tribeawg
+
+// Loopback harness of awg-probe-plan.md §6.4: userspace AmneziaWG "nodes" on 127.0.0.1 (each a
+// device on its own netstack with the kit's HTTPS /v1/probe inside it at an "API" IP), and the
+// runner's sessions driven through the real engine (tribescan.Message). No system interface, no
+// VPN, nothing leaves 127.0.0.1.
+
+import (
+	"bufio"
+	"context"
+	"crypto/ecdh"
+	"crypto/rand"
+	"crypto/tls"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net"
+	"net/http"
+	"net/netip"
+	"os"
+	"os/exec"
+	"runtime"
+	"runtime/debug"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/amnezia-vpn/amneziawg-go/v3/conn"
+	"github.com/amnezia-vpn/amneziawg-go/v3/device"
+	"github.com/amnezia-vpn/amneziawg-go/v3/tun/netstack"
+	clog "github.com/xtls/xray-core/common/log"
+
+	"github.com/amnezia-vpn/amneziawg-apple/tribescan"
+)
+
+var (
+	apiIP     = netip.MustParseAddr("203.0.113.10") // the "API" address the probe dials (node NAT stand-in)
+	echoIP    = netip.MustParseAddr("10.8.0.1")     // the nodes' tunnel address (prime echo target)
+	clientIP  = netip.MustParseAddr("10.8.0.2")     // the device's one /32 on every node
+	silentLog = &device.Logger{Verbosef: device.DiscardLogf, Errorf: device.DiscardLogf}
+)
+
+type quiet struct{}
+
+func (quiet) Handle(clog.Message) {}
+
+func TestMain(m *testing.M) {
+	clog.RegisterHandler(quiet{})
+	if os.Getenv("TRIBEAWG_NODE_PROCESS") == "1" {
+		os.Exit(nodeProcess())
+	}
+	os.Exit(m.Run())
+}
+
+type key struct{ priv, pub string }
+
+func newKey() key {
+	k, err := ecdh.X25519().GenerateKey(rand.Reader)
+	if err != nil {
+		panic(err)
+	}
+	return key{hex.EncodeToString(k.Bytes()), hex.EncodeToString(k.PublicKey().Bytes())}
+}
+
+// params are the AmneziaWG obfuscation lines both ends share.
+type params struct {
+	S4     int
+	H1     uint32
+	H2, H3 uint32
+	H4     uint32
+}
+
+func newParams(s4 int) params {
+	var b [16]byte
+	rand.Read(b[:])
+	h := func(i int) uint32 {
+		return 5 + (uint32(b[i])<<24|uint32(b[i+1])<<16|uint32(b[i+2])<<8|uint32(b[i+3]))%2000000000
+	}
+	return params{S4: s4, H1: h(0), H2: h(4), H3: h(8), H4: h(12)}
+}
+
+func (p params) lines() string {
+	return fmt.Sprintf("jc=4\njmin=40\njmax=70\ns1=15\ns2=18\ns3=20\ns4=%d\nh1=%d\nh2=%d\nh3=%d\nh4=%d\n", p.S4, p.H1, p.H2, p.H3, p.H4)
+}
+
+// node is one userspace AmneziaWG server on 127.0.0.1 with the kit's probe server inside its netstack.
+type node struct {
+	key   key
+	port  int
+	psk   string // hex, "" = none
+	dev   *device.Device
+	close func()
+}
+
+func freeUDPPort(t testing.TB) int {
+	c, err := net.ListenUDP("udp4", &net.UDPAddr{IP: net.IPv4(127, 0, 0, 1)})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer c.Close()
+	return c.LocalAddr().(*net.UDPAddr).Port
+}
+
+func startNode(t testing.TB, p params, clientPub string, handler http.Handler, tlsConf *tls.Config, psk ...string) *node {
+	t.Helper()
+	n := &node{key: newKey(), port: freeUDPPort(t)}
+	pskLine := ""
+	if len(psk) > 0 && psk[0] != "" {
+		n.psk = psk[0]
+		pskLine = "preshared_key=" + n.psk + "\n"
+	}
+	tdev, tnet, err := netstack.CreateNetTUN([]netip.Addr{echoIP, apiIP}, nil, 1280)
+	if err != nil {
+		t.Fatal(err)
+	}
+	n.dev = device.NewDevice(tdev, conn.NewStdNetBind(), silentLog)
+	cfg := fmt.Sprintf("private_key=%s\nlisten_port=%d\n%spublic_key=%s\n%sallowed_ip=%s/32\n", n.key.priv, n.port, p.lines(),
+		clientPub, pskLine, clientIP)
+	if err := n.dev.IpcSet(cfg); err != nil {
+		t.Fatal(err)
+	}
+	if err := n.dev.Up(); err != nil {
+		t.Fatal(err)
+	}
+	ln, err := tnet.ListenTCPAddrPort(netip.AddrPortFrom(apiIP, 443))
+	if err != nil {
+		t.Fatal(err)
+	}
+	hs := &http.Server{Handler: handler, TLSConfig: tlsConf.Clone(), ErrorLog: nil}
+	go hs.Serve(tls.NewListener(ln, hs.TLSConfig))
+	var once sync.Once
+	n.close = func() {
+		once.Do(func() {
+			hs.Close()
+			n.dev.Close()
+		})
+	}
+	t.Cleanup(n.close)
+	return n
+}
+
+// endpointOf reads the node's current endpoint for a peer (where it answers that key).
+func (n *node) endpointOf(pub string) string {
+	text, _ := n.dev.IpcGet()
+	in := false
+	for _, line := range strings.Split(text, "\n") {
+		k, v, _ := strings.Cut(line, "=")
+		if k == "public_key" {
+			in = v == pub
+		}
+		if in && k == "endpoint" {
+			return v
+		}
+	}
+	return ""
+}
+
+// clientUAPI is the UAPI text exactly as the app's scanAwgMiniConfig builds it (ScanHostContract.h):
+// interface lines, the obfuscation lines, then replace_peers, the peer, an optional preshared key,
+// the endpoint, replace_allowed_ips and the allowed IPs.
+func clientUAPI(client key, p params, n *node) string {
+	psk := ""
+	if n.psk != "" {
+		psk = "preshared_key=" + n.psk + "\n"
+	}
+	return fmt.Sprintf("private_key=%s\nlisten_port=0\n%sreplace_peers=true\npublic_key=%s\n%sendpoint=127.0.0.1:%d\n"+
+		"replace_allowed_ips=true\nallowed_ip=%s/32\nallowed_ip=%s/32\n", client.priv, p.lines(), n.key.pub, psk, n.port, apiIP, echoIP)
+}
+
+func awgCandidate(id string, client key, p params, n *node, echo bool) map[string]any {
+	cfg := map[string]any{"uapi": clientUAPI(client, p, n), "probe": map[string]any{"host": "example.com", "ip": apiIP.String(), "port": 443},
+		"prime_echo_target": nil, "bound_if": nil, "address": clientIP.String() + "/32", "mtu": 1280}
+	if echo {
+		cfg["prime_echo_target"] = echoIP.String()
+	}
+	raw, _ := json.Marshal(cfg)
+	return map[string]any{"id": id, "kind": tribescan.KindAwgMini, "config": string(raw), "entry": nil, "reach_at_ms": -1,
+		"profile_id": nil, "early_retry": false, "dns_plan": false, "cost_bytes": 90000}
+}
+
+type harness struct {
+	srv    *tribescan.ProbeServer
+	client key
+	plat   tribescan.Platform
+	nodes  []*node
+}
+
+func newHarness(t *testing.T) *harness {
+	srv := tribescan.NewProbeServer(t)
+	t.Cleanup(func() { tribescan.StopAllWait(5 * time.Second) })
+	return &harness{srv: srv, client: newKey(), plat: tribescan.Platform{Name: "test", MaxAwg: 4, Awg: Open, RootCAs: srv.Pool}}
+}
+
+func (h *harness) node(t *testing.T, p params) *node {
+	n := startNode(t, p, h.client.pub, h.srv.Srv.Config.Handler, h.srv.Srv.TLS)
+	h.nodes = append(h.nodes, n)
+	return n
+}
+
+func (h *harness) scan(t *testing.T, id string, limits map[string]any, opts string, cands ...map[string]any) *tribescan.KitResult {
+	t.Helper()
+	l := map[string]any{"awg_concurrency": 4, "concurrency": 0}
+	if raceOn {
+		l["ttfb_ms"], l["stall_ms"], l["total_ms"], l["awg_handshake_ms"] = 15000, 10000, 30000, 5000
+	}
+	for k, v := range limits {
+		l[k] = v
+	}
+	return tribescan.KitRun(t, tribescan.KitRequest(id, h.srv.Base(), l, 30000, cands...), opts, h.plat, 30*time.Second)
+}
+
+func deref[T any](p *T) T {
+	var z T
+	if p == nil {
+		return z
+	}
+	return *p
+}
+
+func waitLive(t *testing.T, want int64, d time.Duration) {
+	t.Helper()
+	for end := time.Now().Add(d); Live() != want; time.Sleep(5 * time.Millisecond) {
+		if time.Now().After(end) {
+			t.Fatalf("%d sessions open, want %d", Live(), want)
+		}
+	}
+}
