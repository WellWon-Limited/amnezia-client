+// S4 obfuscation loses the first packet after the handshake; one prime echo absorbs it, so the
+// first byte of the warm-up comes about a second earlier (gVisor's first SYN retransmit).
+func TestTribeAwgPrimeEcho(t *testing.T) {
+	if raceOn {
+		t.Skip("timing: not under the race detector")
+	}
+	h := newHarness(t)
+	p := newParams(4)
+	var unprimed, primed []int64
+	for i := 0; i < 3; i++ {
+		n := h.node(t, p)
+		for _, echo := range []bool{false, true} {
+			limits := map[string]any{"awg_prime_echoes": 0}
+			if echo {
+				limits["awg_prime_echoes"] = 1
+			}
+			r := h.scan(t, fmt.Sprintf("awg-s4-%d-%v", i, echo), limits, "", awgCandidate("n", h.client, p, n, echo))
+			d, _ := r.DataByID("n")
+			if d.Error != "" || !deref(d.ShaOK) {
+				t.Fatalf("s4 probe (echo %v): %+v", echo, d)
+			}
+			if echo {
+				primed = append(primed, deref(d.Ttfb1Ms))
+			} else {
+				unprimed = append(unprimed, deref(d.Ttfb1Ms))
+			}
+			time.Sleep(60 * time.Millisecond)
+		}
+	}
+	med := func(v []int64) int64 {
+		s := append([]int64(nil), v...)
+		sort.Slice(s, func(i, j int) bool { return s[i] < s[j] })
+		return s[len(s)/2]
+	}
+	t.Logf("S4=4 ttfb1_ms: no prime echo %v, one prime echo %v", unprimed, primed)
+	if med(unprimed)-med(primed) < 500 {
+		t.Fatalf("the prime echo did not absorb the lost first packet: %v vs %v", unprimed, primed)
+	}
+}
