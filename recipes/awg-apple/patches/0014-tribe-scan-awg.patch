+func TestTribeAwgMemory(t *testing.T) {
+	if os.Getenv("TRIBEAWG_MEASURE") != "1" {
+		t.Skip("measurement: TRIBEAWG_MEASURE=1")
+	}
+	cmd := exec.Command(os.Args[0], "-test.run=^$")
+	cmd.Env = append(os.Environ(), "TRIBEAWG_NODE_PROCESS=1", "TRIBEAWG_NODES=4")
+	stdin, _ := cmd.StdinPipe()
+	stdout, _ := cmd.StdoutPipe()
+	cmd.Stderr = os.Stderr
+	if err := cmd.Start(); err != nil {
+		t.Fatal(err)
+	}
+	defer func() { stdin.Close(); cmd.Wait() }()
+	line, err := bufio.NewReader(stdout).ReadString('\n')
+	if err != nil {
+		t.Fatal(err)
+	}
+	var set nodeSet
+	if err := json.Unmarshal([]byte(line), &set); err != nil {
+		t.Fatal(err)
+	}
+	pool := tribescan.PoolFromPEM(set.CertPEM)
+	client := key{set.ClientPriv, set.ClientPub}
+	fetch := func(s tribescan.AwgSession) error {
+		c, err := s.DialTCP(context.Background(), netip.AddrPortFrom(apiIP, 443))
+		if err != nil {
+			return err
+		}
+		tc := tls.Client(c, &tls.Config{ServerName: "example.com", RootCAs: pool})
+		br := bufio.NewReader(tc)
+		for _, size := range []int{1024, 65536} {
+			fmt.Fprintf(tc, "GET /v1/probe?bytes=%d&nonce=mem-measure-%d HTTP/1.1\r\nHost: example.com\r\nAuthorization: Bearer %s\r\n\r\n",
+				size, size, tribescan.KitToken)
+			resp, err := http.ReadResponse(br, nil)
+			if err != nil {
+				return err
+			}
+			io.Copy(io.Discard, resp.Body)
+			resp.Body.Close()
+		}
+		// Held open at the sample point (the connection stays up until Close).
+		return nil
+	}
+	runtime.GC()
+	var ms runtime.MemStats
+	counts := []int{1, 2, 4}
+	if v := os.Getenv("TRIBEAWG_SESSIONS"); v != "" { // one count per process gives clean baselines
+		k, _ := strconv.Atoi(v)
+		counts = []int{k}
+	}
+	for _, k := range counts {
+		runtime.GC()
+		debug.FreeOSMemory()
+		time.Sleep(300 * time.Millisecond)
+		base := rssKB(t)
+		runtime.ReadMemStats(&ms)
+		heap0, stack0, g0 := ms.HeapInuse, ms.StackInuse, runtime.NumGoroutine()
+		var sessions []tribescan.AwgSession
+		for i := 0; i < k; i++ {
+			nd := &node{key: key{pub: set.Nodes[i].Pub}, port: set.Nodes[i].Port}
+			s, err := Open(context.Background(), tribescan.AwgJob{UAPI: clientUAPI(client, set.Params, nd),
+				Addresses: []netip.Prefix{netip.PrefixFrom(clientIP, 32)}, EchoTarget: echoIP, Echoes: 1,
+				Handshake: 2 * time.Second, Spacing: 50 * time.Millisecond, PeerKey: nd.key.pub})
+			if err != nil || !s.HandshakeOK() {
+				t.Fatalf("session %d: %v", i, err)
+			}
+			if err := fetch(s); err != nil {
+				t.Fatalf("fetch %d: %v", i, err)
+			}
+			sessions = append(sessions, s)
+		}
+		runtime.ReadMemStats(&ms)
+		rss := rssKB(t)
+		t.Logf("%d session(s) at once: RSS +%.1f MB (base %.1f MB), heap in use +%.1f MB, stacks +%.1f MB, goroutines +%d",
+			k, float64(rss-base)/1024, float64(base)/1024, float64(int64(ms.HeapInuse)-int64(heap0))/(1<<20),
+			float64(int64(ms.StackInuse)-int64(stack0))/(1<<20), runtime.NumGoroutine()-g0)
+		for _, s := range sessions {
+			s.Close()
+		}
+	}
+	_ = set.ServerPort
+}
+
+// The app's own fixture (ScanHostContract.h scanAwgMiniConfig of tests/scan_world.h testAwgInput(),
+// as recorded in the host vector start_awg_mini_typed_config_and_base_ips): the device takes every
+// line of it as it is - listen_port=0, the obfuscation keys incl. i1, replace_peers,
+// replace_allowed_ips, both allowed IPs - and a preshared key line too. Nothing is dropped.
+const contractUAPI = "private_key=1111111111111111111111111111111111111111111111111111111111111111\nlisten_port=0\njc=4\njmin=40\n" +
+	"jmax=70\ns1=50\ns2=100\nh1=1234\nh2=5678\nh3=91011\nh4=121314\ni1=<b 0xf6ab3267fa>\nreplace_peers=true\n" +
+	"public_key=2222222222222222222222222222222222222222222222222222222222222222\nendpoint=203.0.113.5:51820\n" +
+	"replace_allowed_ips=true\nallowed_ip=198.51.100.7/32\nallowed_ip=10.8.1.1/32\n"
+
+func TestTribeAwgContractConfig(t *testing.T) {
+	psk := strings.Repeat("ab", 32)
+	for _, uapi := range []string{contractUAPI, strings.Replace(contractUAPI, "\nendpoint=", "\npreshared_key="+psk+"\nendpoint=", 1)} {
+		tdev, _, err := netstack.CreateNetTUN([]netip.Addr{netip.MustParseAddr("100.64.0.250")}, nil, 1280)
+		if err != nil {
+			t.Fatal(err)
+		}
+		dev := device.NewDevice(tdev, conn.NewStdNetBind(), silentLog)
+		if err := dev.IpcSet(withoutKeepalive(uapi)); err != nil {
+			dev.Close()
+			t.Fatalf("the device refused the contract's UAPI: %v", err)
+		}
+		got, _ := dev.IpcGet()
+		dev.Close()
+		// listen_port=0 is taken (a random port at Up); IpcGet leaves a zero port out.
+		want := []string{"jc=4", "jmin=40", "jmax=70", "s1=50", "s2=100", "h1=1234", "h2=5678", "h3=91011",
+			"h4=121314", "i1=<b 0xf6ab3267fa>", "public_key=2222222222222222222222222222222222222222222222222222222222222222",
+			"endpoint=203.0.113.5:51820", "allowed_ip=198.51.100.7/32", "allowed_ip=10.8.1.1/32"}
+		if strings.Contains(uapi, "preshared_key") {
+			want = append(want, "preshared_key="+psk)
+		}
+		for _, w := range want {
+			if !strings.Contains("\n"+got, "\n"+w+"\n") {
+				t.Fatalf("the device ignored %q:\n%s", w, got)
+			}
+		}
+		if strings.Count(got, "allowed_ip=") != 2 {
+			t.Fatalf("allowed IPs: %s", got)
+		}
+	}
+}
