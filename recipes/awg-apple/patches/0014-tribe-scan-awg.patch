+// --- memory: sessions in this process, nodes in another (TRIBEAWG_MEASURE=1) ---------------------
+
+type nodeInfo struct {
+	Pub    string `json:"pub"`
+	Port   int    `json:"port"`
+	Client key    `json:"-"`
+}
+
+type nodeSet struct {
+	ClientPriv string     `json:"client_priv"`
+	ClientPub  string     `json:"client_pub"`
+	Params     params     `json:"params"`
+	Nodes      []nodeInfo `json:"nodes"`
+	CertPEM    string     `json:"cert_pem"`
+	ServerPort int        `json:"server_port"`
+}
+
+// nodeProcess serves N nodes until stdin closes (the measurement's other process).
+func nodeProcess() int {
+	n, _ := strconv.Atoi(os.Getenv("TRIBEAWG_NODES"))
+	srv := tribescan.NewProbeServerStandalone()
+	defer srv.Close()
+	client := newKey()
+	p := newParams(0)
+	set := nodeSet{ClientPriv: client.priv, ClientPub: client.pub, Params: p, CertPEM: srv.CertPEM(), ServerPort: srv.Port}
+	var closers []func()
+	for i := 0; i < n; i++ {
+		nd, closeFn, err := startNodeStandalone(p, client.pub, srv.Srv.Config.Handler, srv.Srv.TLS)
+		if err != nil {
+			fmt.Fprintln(os.Stderr, err)
+			return 1
+		}
+		closers = append(closers, closeFn)
+		set.Nodes = append(set.Nodes, nodeInfo{Pub: nd.key.pub, Port: nd.port})
+	}
+	raw, _ := json.Marshal(set)
+	fmt.Println(string(raw))
+	io.Copy(io.Discard, os.Stdin)
+	for _, c := range closers {
+		c()
+	}
+	return 0
+}
+
+func startNodeStandalone(p params, clientPub string, handler http.Handler, tlsConf *tls.Config) (*node, func(), error) {
+	n := &node{key: newKey()}
+	c, err := net.ListenUDP("udp4", &net.UDPAddr{IP: net.IPv4(127, 0, 0, 1)})
+	if err != nil {
+		return nil, nil, err
+	}
+	n.port = c.LocalAddr().(*net.UDPAddr).Port
+	c.Close()
+	tdev, tnet, err := netstack.CreateNetTUN([]netip.Addr{echoIP, apiIP}, nil, 1280)
+	if err != nil {
+		return nil, nil, err
+	}
+	n.dev = device.NewDevice(tdev, conn.NewStdNetBind(), silentLog)
+	if err := n.dev.IpcSet(fmt.Sprintf("private_key=%s\nlisten_port=%d\n%spublic_key=%s\nallowed_ip=%s/32\n", n.key.priv, n.port,
+		p.lines(), clientPub, clientIP)); err != nil {
+		return nil, nil, err
+	}
+	n.dev.Up()
+	ln, err := tnet.ListenTCPAddrPort(netip.AddrPortFrom(apiIP, 443))
+	if err != nil {
+		return nil, nil, err
+	}
+	hs := &http.Server{Handler: handler, TLSConfig: tlsConf.Clone()}
+	go hs.Serve(tls.NewListener(ln, hs.TLSConfig))
+	return n, func() { hs.Close(); n.dev.Close() }, nil
+}
