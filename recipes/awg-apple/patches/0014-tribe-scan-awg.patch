+package main
+
+// AVPN (awg-apple, patch 0014): the Scanner's AmneziaWG mini-session runner (package tribeawg) for
+// awg_mini candidates: a userspace device on an in-memory netstack next to the live tunnel, with
+// its own registry and logger and its UDP socket bound to the physical interface by the probe's
+// protector. scan_caps offers awg_mini (2 at once on iOS, 4 on the macOS NE) only with this file.
+
+import (
+	"github.com/amnezia-vpn/amneziawg-apple/tribeawg"
+	"github.com/amnezia-vpn/amneziawg-apple/tribescan"
+)
+
+func init() {
+	tribeScanAwgOpen = tribeawg.Open
+	tribescan.SetRunnerLive(tribeawg.Live, nil) // the devices count in LiveWork and the stop reply ("awg")
+}
