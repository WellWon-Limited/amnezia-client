+// Tribe (awg-apple tribe.8): keepalive to every peer with a live keypair WITHOUT BindUpdate. Used
+// right after listen_port=0, which has already reopened the socket on a fresh port, so the server
+// learns the new outer port at once (tribe.7 re-bound that new socket a second time through
+// wgBumpSockets just to get this keepalive out).
+//
+//export wgSendKeepalives
+func wgSendKeepalives(tunnelHandle int32) {
+	dev, ok := tunnelHandles[tunnelHandle]
+	if !ok {
+		return
+	}
+	dev.SendKeepalivesToPeersWithCurrentKeypair()
+}
