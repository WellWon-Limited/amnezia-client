@@ -0,0 +1,17 @@
+//go:build !ios
+
+package main
+
+// AVPN (patch 0013): the macOS Network Extension build (the shipped macOS app scans from the service,
+// not from the NE): two instances at once, composites allowed, no memory guard
+// (os_proc_available_memory is iOS-only).
+
+import "github.com/amnezia-vpn/amneziawg-apple/tribescan"
+
+func tribeScanPlatformOS(p *tribescan.Platform) {
+	p.Name = "macos-ne"
+	p.MaxFull, p.MaxLeg, p.MaxInstances = 2, 6, 2
+	p.MaxAwg = 4 // AmneziaWG sessions (with patch 0014)
+	p.CanVerifyComposite = true
+	p.NeedsVPN = true
+}
