new file mode 100644
index 0000000..7ecbf4c
--- /dev/null
+++ b/Sources/WireGuardKitGo/api-tribestats.go
@@ -0,0 +1,20 @@
+package main
+
+// AVPN (tribe.12): C export of libxray's in-process outbound counters (shared libxray patch
+// ../amnezia-libxray/patches/0007-libxray-outbound-stats.patch). ABI libxray-tribe-stats-v1.
+
+/*
+#include <stdlib.h>
+*/
+import "C"
+
+import "github.com/amnezia-vpn/amnezia-libxray/xray"
+
+// LibXrayTribeOutboundStats returns the running core's cumulative per-outbound bytes as a malloc'd
+// JSON string the caller frees with free(); never NULL:
+// {"running":bool,"outbounds":{"<tag>":{"uplink":n,"downlink":n}},"error":"","error_code":""}.
+//
+//export LibXrayTribeOutboundStats
+func LibXrayTribeOutboundStats() *C.char {
+	return C.CString(xray.OutboundStatsJSON())
+}
