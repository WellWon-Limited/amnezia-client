+// A reply that comes after the verdict is credited: the result turns into answered, late.
+func TestTribeProbeLateAnswer(t *testing.T) {
+	inner, dev, clock := setupProbe(t)
+	id := startProbe(t, 4*time.Second)
+	query := readOne(t, dev)
+	clock.Advance(4 * time.Second)
+	wantState(t, "silent")
+	clock.Advance(2 * time.Second)
+	if n, err := writeBatch(t, dev, probeReply(query)); err != nil || n != 1 {
+		t.Fatalf("Write n=%d err=%v", n, err)
+	}
+	if len(inner.delivered()) != 0 {
+		t.Fatal("the late reply reached the OS")
+	}
+	got := wantState(t, "answered")
+	if !strings.Contains(got, " late=1") || !strings.Contains(got, " ms=6000") || !strings.Contains(got, "id="+itoa(uint32(id))+" ") {
+		t.Fatalf("result %q", got)
+	}
+	// An answer in time is not late.
+	second := startProbe(t, 4*time.Second)
+	q2 := readOne(t, dev)
+	clock.Advance(100 * time.Millisecond)
+	writeBatch(t, dev, probeReply(q2))
+	if got := wantState(t, "answered"); !strings.Contains(got, " late=0") || !strings.Contains(got, "id="+itoa(uint32(second))+" ") {
+		t.Fatalf("result %q", got)
+	}
+}
