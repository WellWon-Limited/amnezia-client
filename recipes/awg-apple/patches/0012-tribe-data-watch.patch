+// The look-out for the reply ends by itself: nobody has to ask for the result (the watch may have
+// been switched off with a probe in flight).
+func TestTribeProbeLookoutEndsByItself(t *testing.T) {
+	inner, dev, clock, engine := setupProbeEngine(t)
+	startProbe(t, 2*time.Second)
+	query := readOne(t, dev)
+	if tribeProbeUntil.Load() == 0 {
+		t.Fatal("no look-out while the probe is in flight")
+	}
+	// Nobody polls. Ten minutes later the write path has to be a plain pass-through again, and
+	// what looks like the old reply is an ordinary packet for the OS.
+	clock.Advance(10 * time.Minute)
+	if n, err := writeBatch(t, dev, probeReply(query)); err != nil || n != 1 {
+		t.Fatalf("Write n=%d err=%v", n, err)
+	}
+	if tribeProbeUntil.Load() != 0 {
+		t.Fatal("the look-out did not end")
+	}
+	if len(inner.delivered()) != 1 {
+		t.Fatal("after the look-out a packet was still taken off the write path")
+	}
+	// Told as silent, the look-out is 30 s from the verdict.
+	engine.setHandshake(clock.Now().Add(-10 * time.Second))
+	startProbe(t, 2*time.Second)
+	q2 := readOne(t, dev)
+	clock.Advance(2 * time.Second)
+	wantState(t, "silent")
+	clock.Advance(tribeProbeLateWindow + time.Second)
+	writeBatch(t, dev, probeReply(q2))
+	wantState(t, "silent")
+	if len(inner.delivered()) != 2 || tribeProbeUntil.Load() != 0 {
+		t.Fatal("a reply after the late window must pass to the OS and change nothing")
+	}
+}
