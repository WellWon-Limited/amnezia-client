+func TestTribeProbeReadBlocksOnlyOnTheInnerTun(t *testing.T) {
+	inner, dev, _ := setupProbe(t)
+	got := make(chan []byte, 2)
+	go func() {
+		for i := 0; i < 2; i++ {
+			bufs := [][]byte{make([]byte, 2048)}
+			sizes := make([]int, 1)
+			if n, err := dev.Read(bufs, sizes, probeTestOffset); err == nil && n == 1 {
+				got <- append([]byte(nil), bufs[0][probeTestOffset:probeTestOffset+sizes[0]]...)
+			}
+		}
+	}()
+	time.Sleep(20 * time.Millisecond) // the device is now blocked inside the inner Read
+	startProbe(t, 0)
+	select {
+	case <-got:
+		t.Fatal("the probe cannot leave while the device waits for the OS: there is no outbound demand")
+	case <-time.After(50 * time.Millisecond):
+	}
+	osPacket := buildUDP4(probeClient, netip.MustParseAddr("8.8.8.8"), 40000, 443, []byte("demand"))
+	inner.fromOS <- osPacket
+	first := <-got
+	second := <-got
+	if !bytes.Equal(first, osPacket) {
+		t.Fatal("the OS packet did not pass")
+	}
+	if m, ok := parseUDP4(second); !ok || m.dst != probeTarget {
+		t.Fatal("the probe did not leave with the next read")
+	}
+}
