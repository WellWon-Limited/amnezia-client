--- /dev/null
+++ b/Sources/WireGuardKitGo/tribeprobe_test.go
@@ -0,0 +1,532 @@
+/* SPDX-License-Identifier: MIT
+ *
+ * Tribe data watch probe - tests with a fake tun (no device, no network): what the wrapper hands
+ * to the device, what it takes off the write path, and how the result is told apart.
+ */
+package main
+
+import (
+	"bytes"
+	"errors"
+	"net/netip"
+	"os"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/amnezia-vpn/amneziawg-go/v3/tun"
+)
+
+// fakeProbeTun is the inner device: Read blocks until the test feeds a packet "from the OS",
+// Write records what reached "the OS".
+type fakeProbeTun struct {
+	fromOS  chan []byte
+	mu      sync.Mutex
+	toOS    [][]byte
+	closed  chan struct{}
+	writeN  int
+	failing bool
+}
+
+func newFakeProbeTun() *fakeProbeTun {
+	return &fakeProbeTun{fromOS: make(chan []byte, 16), closed: make(chan struct{})}
+}
+
+func (f *fakeProbeTun) File() *os.File           { return nil }
+func (f *fakeProbeTun) MTU() (int, error)        { return 1280, nil }
+func (f *fakeProbeTun) Name() (string, error)    { return "utun-test", nil }
+func (f *fakeProbeTun) Events() <-chan tun.Event { return nil }
+func (f *fakeProbeTun) BatchSize() int           { return 4 }
+func (f *fakeProbeTun) Close() error {
+	select {
+	case <-f.closed:
+	default:
+		close(f.closed)
+	}
+	return nil
+}
+
+func (f *fakeProbeTun) Read(bufs [][]byte, sizes []int, offset int) (int, error) {
+	select {
+	case pkt := <-f.fromOS:
+		sizes[0] = copy(bufs[0][offset:], pkt)
+		return 1, nil
+	case <-f.closed:
+		return 0, os.ErrClosed
+	}
+}
+
+func (f *fakeProbeTun) Write(bufs [][]byte, offset int) (int, error) {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	f.writeN++
+	if f.failing {
+		return 0, errors.New("write failed")
+	}
+	for _, b := range bufs {
+		f.toOS = append(f.toOS, append([]byte(nil), b[offset:]...))
+	}
+	return len(bufs), nil
+}
+
+func (f *fakeProbeTun) delivered() [][]byte {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	return append([][]byte(nil), f.toOS...)
+}
+
+const probeTestOffset = 4
+
+var (
+	probeClient = netip.MustParseAddr("10.8.1.7")
+	probeTarget = netip.MustParseAddr("1.1.1.1")
+)
+
+// probeClock is the test's clock; the resend timer is real but set far away unless a test asks.
+type probeClock struct {
+	mu  sync.Mutex
+	now time.Time
+}
+
+func (c *probeClock) Now() time.Time {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	return c.now
+}
+
+func (c *probeClock) Advance(d time.Duration) {
+	c.mu.Lock()
+	c.now = c.now.Add(d)
+	c.mu.Unlock()
+}
+
+func setupProbe(t *testing.T) (*fakeProbeTun, tun.Device, *probeClock) {
+	t.Helper()
+	clock := &probeClock{now: time.Unix(1_800_000_000, 0)}
+	oldNow, oldResend := tribeProbeNow, tribeProbeResendAfter
+	tribeProbeNow = clock.Now
+	tribeProbeResendAfter = time.Hour
+	t.Cleanup(func() {
+		tribeProbeConfigure("", "", false)
+		tribeProbeMu.Lock()
+		tribeProbeTun = nil
+		tribeProbeMu.Unlock()
+		tribeProbeNow, tribeProbeResendAfter = oldNow, oldResend
+	})
+	if rc := tribeProbeConfigure("10.8.1.7/32", "1.1.1.1", true); rc != 0 {
+		t.Fatalf("configure rc=%d", rc)
+	}
+	inner := newFakeProbeTun()
+	return inner, wrapTribeProbeIfEnabled(inner, nil, nil), clock
+}
+
+// readOne is the device reading one batch from the tunnel.
+func readOne(t *testing.T, dev tun.Device) []byte {
+	t.Helper()
+	bufs := [][]byte{make([]byte, 2048), make([]byte, 2048)}
+	sizes := make([]int, 2)
+	n, err := dev.Read(bufs, sizes, probeTestOffset)
+	if err != nil || n != 1 {
+		t.Fatalf("Read n=%d err=%v", n, err)
+	}
+	return append([]byte(nil), bufs[0][probeTestOffset:probeTestOffset+sizes[0]]...)
+}
+
+// writeBatch is the device writing decrypted packets towards the OS.
+func writeBatch(t *testing.T, dev tun.Device, pkts ...[]byte) (int, error) {
+	t.Helper()
+	bufs := make([][]byte, 0, len(pkts))
+	for _, p := range pkts {
+		b := make([]byte, probeTestOffset+len(p))
+		copy(b[probeTestOffset:], p)
+		bufs = append(bufs, b)
+	}
+	return dev.Write(bufs, probeTestOffset)
+}
+
+func probeReply(query []byte) []byte {
+	m, _ := parseUDP4(query)
+	resp := append([]byte(nil), m.payload...)
+	resp[2] |= 0x80 // QR
+	return buildUDP4(m.dst, m.src, 53, m.sport, resp)
+}
+
+func wantState(t *testing.T, want string) string {
+	t.Helper()
+	got := tribeProbeResult()
+	if !strings.HasPrefix(got, "state="+want+" ") {
+		t.Fatalf("result %q, want state=%s", got, want)
+	}
+	return got
+}
+
+func TestTribeProbeUnavailable(t *testing.T) {
+	tribeProbeConfigure("", "", false)
+	wantState(t, "unavailable")
+	if id := tribeProbeStart(0); id != 0 {
+		t.Fatalf("a probe started without a configuration: id=%d", id)
+	}
+	inner := newFakeProbeTun()
+	if got := wrapTribeProbeIfEnabled(inner, nil, nil); got != tun.Device(inner) {
+		t.Fatalf("not configured: the device must get the inner tun itself")
+	}
+	for _, bad := range [][2]string{
+		{"fd00::7/128", "1.1.1.1"}, {"10.8.1.7/32", "2606:4700:4700::1111"}, {"garbage", "1.1.1.1"},
+		{"10.8.1.7/32", ""}, {"0.0.0.0/0", "1.1.1.1"}, {"10.8.1.7", "0.0.0.0"},
+	} {
+		if rc := tribeProbeConfigure(bad[0], bad[1], true); rc != -1 {
+			t.Fatalf("configure(%q, %q) rc=%d, want -1", bad[0], bad[1], rc)
+		}
+		wantState(t, "unavailable")
+	}
+	// Configured but no device yet: still nothing to send into.
+	if rc := tribeProbeConfigure("10.8.1.7/32", "1.1.1.1", true); rc != 0 {
+		t.Fatalf("rc=%d", rc)
+	}
+	tribeProbeMu.Lock()
+	tribeProbeTun = nil
+	tribeProbeMu.Unlock()
+	if id := tribeProbeStart(0); id != 0 {
+		t.Fatalf("a probe started without a device: id=%d", id)
+	}
+	wantState(t, "none")
+	tribeProbeConfigure("", "", false)
+}
+
+func TestTribeProbePacketGoesFirstAndIsWellFormed(t *testing.T) {
+	inner, dev, _ := setupProbe(t)
+	wantState(t, "none")
+	osPacket := buildUDP4(probeClient, netip.MustParseAddr("8.8.8.8"), 40000, 443, []byte("user data"))
+	inner.fromOS <- osPacket
+	id := tribeProbeStart(0)
+	if id == 0 {
+		t.Fatal("probe not started")
+	}
+	wantState(t, "pending")
+	first := readOne(t, dev)
+	m, ok := parseUDP4(first)
+	if !ok || m.src != probeClient || m.dst != probeTarget || m.dpt != 53 {
+		t.Fatalf("probe packet %+v ok=%v", m, ok)
+	}
+	if m.sport < tribeProbePortBase || m.sport >= tribeProbePortBase+tribeProbePortSpan {
+		t.Fatalf("source port %d outside the probe range", m.sport)
+	}
+	if m.sport >= fwdEphBase && m.sport < fwdEphBase+fwdEphSpan || m.sport == warmupSport {
+		t.Fatalf("source port %d collides with the forwarder", m.sport)
+	}
+	if qname, ok := parseQName(m.payload); !ok || qname != "" {
+		t.Fatalf("payload is not a root query: %q ok=%v", qname, ok)
+	}
+	if ipChecksum(first[:20]) != uint16(first[10])<<8|uint16(first[11]) || udpChecksum(first) != uint16(first[26])<<8|uint16(first[27]) {
+		t.Fatal("checksums are wrong")
+	}
+	// The OS packet that was already waiting comes next, untouched.
+	if second := readOne(t, dev); !bytes.Equal(second, osPacket) {
+		t.Fatal("the OS packet did not pass through unchanged")
+	}
+	wantState(t, "pending")
+}
+
+func TestTribeProbeAnswered(t *testing.T) {
+	inner, dev, clock := setupProbe(t)
+	id := tribeProbeStart(0)
+	query := readOne(t, dev)
+	clock.Advance(180 * time.Millisecond)
+	other := buildUDP4(netip.MustParseAddr("8.8.8.8"), probeClient, 443, 40000, []byte("download"))
+	n, err := writeBatch(t, dev, other, probeReply(query), other)
+	if err != nil || n != 3 {
+		t.Fatalf("Write n=%d err=%v", n, err)
+	}
+	got := wantState(t, "answered")
+	if !strings.Contains(got, " ms=180") || !strings.Contains(got, "id="+itoa(id)+" ") {
+		t.Fatalf("result %q", got)
+	}
+	out := inner.delivered()
+	if len(out) != 2 || !bytes.Equal(out[0], other) || !bytes.Equal(out[1], other) {
+		t.Fatalf("the reply must not reach the OS and the rest must pass in order: %d packets", len(out))
+	}
+	if tribeProbeFlying.Load() {
+		t.Fatal("after the result the write path must be a plain pass-through again")
+	}
+	// A late copy of the reply (the repeat was answered too) is not handed to the OS as garbage
+	// either way, but with no probe in flight the wrapper does not even look.
+	clock.Advance(10 * time.Second)
+	wantState(t, "answered")
+}
+
+func TestTribeProbeSilentAndNotSent(t *testing.T) {
+	_, dev, clock := setupProbe(t)
+	// Handed to the device, no reply: silent after the timeout, pending before it.
+	tribeProbeStart(3 * time.Second)
+	readOne(t, dev)
+	clock.Advance(2999 * time.Millisecond)
+	wantState(t, "pending")
+	clock.Advance(time.Millisecond)
+	wantState(t, "silent")
+
+	// Nothing reads the tunnel: the packet never leaves. That is NOT silence.
+	id := tribeProbeStart(3 * time.Second)
+	clock.Advance(2999 * time.Millisecond)
+	wantState(t, "pending")
+	clock.Advance(time.Millisecond)
+	got := wantState(t, "not_sent")
+	if !strings.Contains(got, "id="+itoa(id)+" ") {
+		t.Fatalf("result %q", got)
+	}
+	// The default timeout applies to a non-positive value.
+	tribeProbeStart(0)
+	readOne(t, dev)
+	clock.Advance(tribeProbeDefaultTimeout - time.Millisecond)
+	wantState(t, "pending")
+	clock.Advance(time.Millisecond)
+	wantState(t, "silent")
+}
+
+func TestTribeProbeOneAtATime(t *testing.T) {
+	_, dev, clock := setupProbe(t)
+	first := tribeProbeStart(0)
+	if again := tribeProbeStart(0); again != first {
+		t.Fatalf("a second probe started while one is in flight: %d vs %d", again, first)
+	}
+	q1 := readOne(t, dev)
+	clock.Advance(5 * time.Second)
+	wantState(t, "silent")
+	second := tribeProbeStart(0)
+	if second == first || second == 0 {
+		t.Fatalf("a finished probe must be replaced: %d", second)
+	}
+	q2 := readOne(t, dev)
+	m1, _ := parseUDP4(q1)
+	m2, _ := parseUDP4(q2)
+	if m1.sport == m2.sport {
+		t.Fatal("two probes share a source port")
+	}
+	// The answer to the FIRST probe arrives late: it is not the answer to the second.
+	if n, err := writeBatch(t, dev, probeReply(q1)); err != nil || n != 1 {
+		t.Fatalf("Write n=%d err=%v", n, err)
+	}
+	wantState(t, "pending")
+}
+
+func TestTribeProbeForeignPacketsPass(t *testing.T) {
+	inner, dev, _ := setupProbe(t)
+	tribeProbeStart(0)
+	query := readOne(t, dev)
+	m, _ := parseUDP4(query)
+	reply := probeReply(query)
+	wrongSource := buildUDP4(netip.MustParseAddr("9.9.9.9"), probeClient, 53, m.sport, m.payload)
+	wrongPort := buildUDP4(probeTarget, probeClient, 53, m.sport+1, m.payload)
+	wrongID := append([]byte(nil), reply...)
+	wrongID[28] ^= 0xFF
+	wrongID = buildUDP4(probeTarget, probeClient, 53, m.sport, wrongID[28:])
+	forwarderReply := buildUDP4(probeTarget, probeClient, 53, fwdEphBase+5, m.payload)
+	tcp := append([]byte(nil), reply...)
+	tcp[9] = 6
+	short := []byte{0x45, 0, 0}
+	n, err := writeBatch(t, dev, wrongSource, wrongPort, wrongID, forwarderReply, tcp, short)
+	if err != nil || n != 6 {
+		t.Fatalf("Write n=%d err=%v", n, err)
+	}
+	if got := inner.delivered(); len(got) != 6 {
+		t.Fatalf("%d of 6 foreign packets reached the OS", len(got))
+	}
+	wantState(t, "pending")
+}
+
+func TestTribeProbeRepeat(t *testing.T) {
+	_, dev, clock := setupProbe(t)
+	tribeProbeResendAfter = 30 * time.Millisecond
+	tribeProbeStart(0)
+	first := readOne(t, dev)
+	deadline := time.Now().Add(2 * time.Second)
+	var second []byte
+	for second == nil && time.Now().Before(deadline) {
+		tribeProbeMu.Lock()
+		waiting := tribeProbeTun != nil && len(tribeProbeTun.pending) > 0
+		tribeProbeMu.Unlock()
+		if waiting {
+			second = readOne(t, dev)
+		} else {
+			time.Sleep(5 * time.Millisecond)
+		}
+	}
+	if second == nil || !bytes.Equal(first, second) {
+		t.Fatal("the repeat was not sent or differs from the first packet")
+	}
+	// The latency is counted from the FIRST packet.
+	clock.Advance(1700 * time.Millisecond)
+	if n, err := writeBatch(t, dev, probeReply(second)); err != nil || n != 1 {
+		t.Fatalf("Write n=%d err=%v", n, err)
+	}
+	if got := wantState(t, "answered"); !strings.Contains(got, " ms=1700") {
+		t.Fatalf("result %q", got)
+	}
+}
+
+func TestTribeProbeDeviceRestart(t *testing.T) {
+	inner, dev, clock := setupProbe(t)
+	id := tribeProbeStart(0)
+	query := readOne(t, dev)
+	// In-place restart of the backend: the old device closes, a new one wraps the tun again.
+	if err := dev.Close(); err != nil {
+		t.Fatal(err)
+	}
+	got := wantState(t, "not_sent")
+	if !strings.Contains(got, "id="+itoa(id)+" ") {
+		t.Fatalf("a probe cut by a restart is unjudged, not silent: %q", got)
+	}
+	inner2 := newFakeProbeTun()
+	dev2 := wrapTribeProbeIfEnabled(inner2, nil, nil)
+	if dev2 == tun.Device(inner2) {
+		t.Fatal("the new device has no probe wrapper")
+	}
+	// The old probe's answer on the new device is not an answer.
+	if n, err := writeBatch(t, dev2, probeReply(query)); err != nil || n != 1 {
+		t.Fatalf("Write n=%d err=%v", n, err)
+	}
+	wantState(t, "not_sent")
+	// A new probe works on the new device.
+	second := tribeProbeStart(0)
+	q2 := readOne(t, dev2)
+	clock.Advance(50 * time.Millisecond)
+	writeBatch(t, dev2, probeReply(q2))
+	if got := wantState(t, "answered"); !strings.Contains(got, "id="+itoa(second)+" ") {
+		t.Fatalf("result %q", got)
+	}
+	_ = inner
+}
+
+func TestTribeProbeWriteErrorsAndCounts(t *testing.T) {
+	inner, dev, _ := setupProbe(t)
+	other := buildUDP4(netip.MustParseAddr("8.8.8.8"), probeClient, 443, 40000, []byte("x"))
+	// No probe in flight: one inner Write per batch, the batch itself.
+	if n, err := writeBatch(t, dev, other, other); err != nil || n != 2 || inner.writeN != 1 {
+		t.Fatalf("plain pass-through: n=%d err=%v writes=%d", n, err, inner.writeN)
+	}
+	tribeProbeStart(0)
+	query := readOne(t, dev)
+	// A batch that is only the reply: nothing is written to the OS, the device sees success.
+	before := inner.writeN
+	if n, err := writeBatch(t, dev, probeReply(query)); err != nil || n != 1 || inner.writeN != before {
+		t.Fatalf("reply-only batch: n=%d err=%v writes=%d", n, err, inner.writeN-before)
+	}
+	wantState(t, "answered")
+	// An inner error is passed on.
+	inner.failing = true
+	if _, err := writeBatch(t, dev, other); err == nil {
+		t.Fatal("the inner write error was swallowed")
+	}
+}
+
+func TestTribeProbeReadBlocksOnlyOnTheInnerTun(t *testing.T) {
+	inner, dev, _ := setupProbe(t)
+	got := make(chan []byte, 2)
+	go func() {
+		for i := 0; i < 2; i++ {
+			bufs := [][]byte{make([]byte, 2048)}
+			sizes := make([]int, 1)
+			if n, err := dev.Read(bufs, sizes, probeTestOffset); err == nil && n == 1 {
+				got <- append([]byte(nil), bufs[0][probeTestOffset:probeTestOffset+sizes[0]]...)
+			}
+		}
+	}()
+	time.Sleep(20 * time.Millisecond) // the device is now blocked inside the inner Read
+	tribeProbeStart(0)
+	select {
+	case <-got:
+		t.Fatal("the probe cannot leave while the device waits for the OS: there is no outbound demand")
+	case <-time.After(50 * time.Millisecond):
+	}
+	osPacket := buildUDP4(probeClient, netip.MustParseAddr("8.8.8.8"), 40000, 443, []byte("demand"))
+	inner.fromOS <- osPacket
+	first := <-got
+	second := <-got
+	if !bytes.Equal(first, osPacket) {
+		t.Fatal("the OS packet did not pass")
+	}
+	if m, ok := parseUDP4(second); !ok || m.dst != probeTarget {
+		t.Fatal("the probe did not leave with the next read")
+	}
+}
+
+func TestTribeProbeLeavesAtOnceThroughTheForwarder(t *testing.T) {
+	// With the split-DNS forwarder in the chain the probe does not wait for the OS: the
+	// forwarder's channel feeds the device, and the device is blocked on exactly that channel.
+	clock := &probeClock{now: time.Unix(1_800_000_000, 0)}
+	oldNow, oldResend := tribeProbeNow, tribeProbeResendAfter
+	tribeProbeNow = clock.Now
+	tribeProbeResendAfter = time.Hour
+	defer func() {
+		tribeProbeConfigure("", "", false)
+		tribeProbeMu.Lock()
+		tribeProbeTun = nil
+		tribeProbeMu.Unlock()
+		tribeProbeNow, tribeProbeResendAfter = oldNow, oldResend
+	}()
+	if rc := tribeProbeConfigure("10.8.1.7/32", "1.1.1.1", true); rc != 0 {
+		t.Fatalf("rc=%d", rc)
+	}
+	inner := newFakeProbeTun()
+	fwd := &fwdTun{
+		real: inner,
+		cfg: &splitDNSConfig{enabled: true, suffixes: []string{"ru"}, directSrv: netip.MustParseAddr("77.88.8.8"),
+			tunnelSrv: probeTarget, virtIP: netip.MustParseAddr("100.100.100.53"), clientIP: probeClient},
+		out:    make(chan []byte, fwdOutDepth),
+		closed: make(chan struct{}),
+		offset: -1,
+	}
+	dev := wrapTribeProbeIfEnabled(fwd, fwd, nil)
+	defer dev.Close()
+	got := make(chan []byte, 1)
+	go func() {
+		bufs := [][]byte{make([]byte, 2048)}
+		sizes := make([]int, 1)
+		if n, err := dev.Read(bufs, sizes, probeTestOffset); err == nil && n == 1 {
+			got <- append([]byte(nil), bufs[0][probeTestOffset:probeTestOffset+sizes[0]]...)
+		}
+	}()
+	time.Sleep(20 * time.Millisecond) // the device waits; the OS sends nothing
+	id := tribeProbeStart(0)
+	var query []byte
+	select {
+	case query = <-got:
+	case <-time.After(2 * time.Second):
+		t.Fatal("the probe did not leave without outbound demand")
+	}
+	if m, ok := parseUDP4(query); !ok || m.dst != probeTarget || m.src != probeClient {
+		t.Fatal("not the probe packet")
+	}
+	wantState(t, "pending")
+	// The reply is taken by the probe BEFORE the forwarder sees it (ports do not overlap anyway).
+	clock.Advance(90 * time.Millisecond)
+	if n, err := writeBatch(t, dev, probeReply(query)); err != nil || n != 1 {
+		t.Fatalf("Write n=%d err=%v", n, err)
+	}
+	if res := wantState(t, "answered"); !strings.Contains(res, " ms=90") || !strings.Contains(res, "id="+itoa(id)+" ") {
+		t.Fatalf("result %q", res)
+	}
+	if len(inner.delivered()) != 0 {
+		t.Fatal("the reply reached the OS")
+	}
+	// A full forwarder queue (the device is not reading) is not_sent, not silent.
+	for len(fwd.out) < cap(fwd.out) {
+		fwd.out <- []byte{0}
+	}
+	clock.Advance(10 * time.Second)
+	tribeProbeStart(2 * time.Second)
+	clock.Advance(2 * time.Second)
+	wantState(t, "not_sent")
+}
+
+func itoa(v uint32) string {
+	if v == 0 {
+		return "0"
+	}
+	var b []byte
+	for v > 0 {
+		b = append([]byte{byte('0' + v%10)}, b...)
+		v /= 10
+	}
+	return string(b)
+}
