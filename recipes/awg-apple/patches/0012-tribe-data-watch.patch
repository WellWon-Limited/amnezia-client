+// A resolver the tunnel does not carry cannot be probed.
+func TestTribeProbeTargetOutsideTheTunnel(t *testing.T) {
+	_, _, _, engine := setupProbeEngine(t)
+	engine.mu.Lock()
+	engine.allowed = []string{"10.0.0.0/8", "fd00::/8"}
+	engine.mu.Unlock()
+	if rc := tribeProbeStart(probeHandle, 0); rc != tribeProbeStartNoTarget {
+		t.Fatalf("the resolver is outside the allowed IPs: %d", rc)
+	}
+	engine.mu.Lock()
+	engine.allowed = []string{"0.0.0.0/0"}
+	engine.mu.Unlock()
+	tribeProbeIsDirect = func(a netip.Addr) bool { return a == probeTarget }
+	if rc := tribeProbeStart(probeHandle, 0); rc != tribeProbeStartNoTarget {
+		t.Fatalf("the resolver is in the direct-split list: %d", rc)
+	}
+	tribeProbeIsDirect = func(netip.Addr) bool { return false }
+	engine.mu.Lock()
+	engine.ok = false
+	engine.mu.Unlock()
+	if rc := tribeProbeStart(probeHandle, 0); rc != tribeProbeStartNoTarget {
+		t.Fatalf("the engine cannot be read: %d", rc)
+	}
+	wantState(t, "none")
+}
