@@ -0,0 +1,634 @@
+/* SPDX-License-Identifier: MIT
+ *
+ * Tribe data watch probe (awg-apple tribe.13).
+ *
+ * The data watch (TribeDataWatch.swift) decides from the device counters WHEN the tunnel looks
+ * dead; this probe is its judge. It sends a small packet THROUGH the tunnel and waits for the
+ * answer: a DNS query (root name, A/IN) from the client's tunnel address to the resolver the
+ * session already uses. The packet is handed to the WireGuard device as if the OS had sent it
+ * (the same idea as the split-DNS forwarder's warm-up, dnsfwd.go), so it is encrypted, goes to
+ * the node, leaves the node through its NAT, and the reply comes back the same way. The reply is
+ * taken off the device's write path and never reaches the OS.
+ *
+ * What an answer proves: transport packets pass phone -> node, the node forwards to the Internet
+ * and back, and transport packets pass node -> phone. With a node-local resolver it proves only
+ * phone <-> node. It says nothing about bulk transfer: a freeze that depends on the size of the
+ * answer is invisible to a 100-byte reply. The resolver answers the root query itself.
+ *
+ * What "silent" means, exactly. The device encrypts and sends a packet only while it holds a
+ * keypair that may still send (device/send.go SendStagedPackets: keypair != nil and its age below
+ * keychainExpireTime); otherwise the packet is only STAGED and a handshake is started. A staged
+ * packet never left the phone, so its silence proves nothing. The engine does not expose its
+ * keypair, but it exposes the moment the keypair was created: last_handshake_time (uapi.go,
+ * peer.lastHandshakeNano, written when the handshake completes) and the expiry it applies
+ * (reject_after_time, 180 s when not configured). So:
+ *   - a probe is started only when that timestamp says a keypair may send now; otherwise the
+ *     start itself answers "no session" and nothing is injected;
+ *   - "silent" is reported only when the device took the packet off the tunnel (this wrapper's
+ *     own Read handed it over) at a moment the keypair of that same handshake could still send,
+ *     and the timestamp is the same at the end of the wait (no new session in between);
+ *   - anything else is "no_session" (staged, cannot be judged) or "not_sent" (the device never
+ *     took the packet).
+ * The timestamp is read through the engine's own UAPI dump from the caller's queue (the same
+ * call the adapter makes every second), never from the device's goroutines.
+ *
+ * A reply that comes after the verdict is still credited: for a while the write path keeps
+ * looking for it and the result turns into "answered late=1". The look-out ends by itself (a
+ * deadline checked on the write path), whether or not anybody asks for the result again.
+ *
+ * The wrapper is its own outermost tun.Device and is a pass-through: no pump goroutine, no copy
+ * per packet; Read and Write look at packets only while a probe needs it. How the packet gets in:
+ *  - the split-DNS forwarder is on (the default): the forwarder already feeds the device from a
+ *    channel, the probe packet is put into that channel; it counts as taken only when it comes
+ *    back through this wrapper's Read (the device is reading, the direct split let it through);
+ *  - the forwarder is off (RU node, user setting): Read hands out a waiting probe packet first
+ *    and otherwise calls the inner Read, so the packet leaves with the next outbound packet of
+ *    the OS. If nothing reads the tunnel before the timeout the result is "not_sent".
+ *
+ * Inner IPv4 only: the client address of our configs is IPv4.
+ * amneziawg-go is not patched.
+ */
+package main
+
+import "C"
+
+import (
+	"encoding/binary"
+	"fmt"
+	"net/netip"
+	"strconv"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"github.com/amnezia-vpn/amneziawg-go/v3/tun"
+)
+
+const (
+	// Source ports of probe packets: outside the forwarder's mux range (61000-64999) and away
+	// from its warm-up port (50000), so the two wrappers never claim each other's replies.
+	tribeProbePortBase = 50100
+	tribeProbePortSpan = 100
+
+	// Results of a start that injected nothing.
+	tribeProbeStartNone      = 0  // no probe in this session
+	tribeProbeStartNoTarget  = -1 // the resolver cannot be reached through the tunnel in this session
+	tribeProbeStartNoSession = -2 // the engine holds no keypair that may send now
+
+	// The engine's own default (device/constants.go RejectAfterTime) when reject_after_time is
+	// not configured.
+	tribeProbeDefaultExpire = 180 * time.Second
+	// A keypair this close to its expiry is treated as gone: the read of the timestamp and the
+	// device's own check are not the same instant.
+	tribeProbeExpireMargin = 5 * time.Second
+)
+
+// Tunable in tests only.
+var (
+	tribeProbeResendAfter    = 1500 * time.Millisecond
+	tribeProbeDefaultTimeout = 4 * time.Second
+	// How long after its verdict a probe's reply is still looked for.
+	tribeProbeLateWindow = 30 * time.Second
+	tribeProbeNow        = time.Now
+)
+
+// Set by api-apple.go: the engine's UAPI dump of a tunnel handle, and whether an address is in
+// the direct-split list (such a packet is taken out of the tunnel below this wrapper).
+var (
+	tribeProbeEngineDump = func(handle int32) (string, bool) { return "", false }
+	tribeProbeIsDirect   = func(addr netip.Addr) bool { return false }
+)
+
+type tribeProbeConfig struct {
+	client netip.Addr // source of the probe: the client's address inside the tunnel
+	target netip.Addr // the resolver the session uses (dns1)
+}
+
+// What the engine says about the peer that routes the probe's target.
+type tribeEngineFacts struct {
+	ok        bool          // the dump was read
+	routed    bool          // the target is inside a peer's allowed IPs
+	handshake time.Time     // that peer's last completed handshake; zero = none yet
+	expire    time.Duration // how long a keypair may send
+}
+
+// usable: a keypair created at the handshake may still send at `at`.
+func (f tribeEngineFacts) usable(at time.Time) bool {
+	if !f.ok || !f.routed || f.handshake.IsZero() {
+		return false
+	}
+	age := at.Sub(f.handshake)
+	return age >= 0 && age < f.expire-tribeProbeExpireMargin
+}
+
+// tribeParseEngineFacts reads the UAPI dump (device/uapi.go IpcGetOperation).
+func tribeParseEngineFacts(dump string, target netip.Addr) tribeEngineFacts {
+	facts := tribeEngineFacts{ok: true, expire: tribeProbeDefaultExpire}
+	type peerFacts struct {
+		routed bool
+		bits   int
+		sec    int64
+		nsec   int64
+	}
+	var peers []peerFacts
+	for _, line := range strings.Split(dump, "\n") {
+		key, value, found := strings.Cut(strings.TrimSpace(line), "=")
+		if !found {
+			continue
+		}
+		switch key {
+		case "reject_after_time":
+			// A range "lo-hi" or one number; the engine applies the upper bound (keychainExpireTime).
+			hi := value
+			if i := strings.LastIndex(value, "-"); i >= 0 {
+				hi = value[i+1:]
+			}
+			if n, err := strconv.ParseInt(strings.TrimSpace(hi), 10, 64); err == nil && n > 0 {
+				facts.expire = time.Duration(n) * time.Second
+			}
+		case "public_key":
+			peers = append(peers, peerFacts{bits: -1})
+		case "last_handshake_time_sec":
+			if len(peers) > 0 {
+				peers[len(peers)-1].sec, _ = strconv.ParseInt(value, 10, 64)
+			}
+		case "last_handshake_time_nsec":
+			if len(peers) > 0 {
+				peers[len(peers)-1].nsec, _ = strconv.ParseInt(value, 10, 64)
+			}
+		case "allowed_ip":
+			if len(peers) == 0 {
+				continue
+			}
+			if prefix, err := netip.ParsePrefix(value); err == nil && prefix.Contains(target) && prefix.Bits() > peers[len(peers)-1].bits {
+				peers[len(peers)-1].routed = true
+				peers[len(peers)-1].bits = prefix.Bits()
+			}
+		}
+	}
+	best := -1
+	for i, p := range peers { // the engine routes by the longest prefix
+		if p.routed && (best < 0 || p.bits > peers[best].bits) {
+			best = i
+		}
+	}
+	if best < 0 {
+		return facts
+	}
+	facts.routed = true
+	if peers[best].sec > 0 || peers[best].nsec > 0 {
+		facts.handshake = time.Unix(peers[best].sec, peers[best].nsec)
+	}
+	return facts
+}
+
+func tribeProbeFacts(handle int32, target netip.Addr) tribeEngineFacts {
+	dump, ok := tribeProbeEngineDump(handle)
+	if !ok {
+		return tribeEngineFacts{}
+	}
+	return tribeParseEngineFacts(dump, target)
+}
+
+// One probe. Times are zero until the event happens.
+type tribeProbeState struct {
+	id         uint32
+	port       uint16
+	dnsID      uint16
+	timeout    time.Duration
+	startedAt  time.Time
+	hsAtStart  time.Time // the engine's last handshake when the probe was started
+	expire     time.Duration
+	consumedAt time.Time // the device took the first packet off the tunnel
+	answered   time.Time
+	// The verdict once the wait is over ("silent", "no_session", "not_sent"); it is told once and
+	// stays. An answer that comes later is told as answered with late=1.
+	final string
+	// The device went away (stop or in-place restart) before an answer: the probe cannot be
+	// judged any more. Reported as not_sent, never as silent.
+	aborted bool
+	resend  *time.Timer
+}
+
+var (
+	tribeProbeMu  sync.Mutex
+	tribeProbeCfg *tribeProbeConfig // nil = no probe in this session
+	tribeProbeTun *tribeProbeTunDev // the wrapper of the device that is up now
+	tribeProbeCur *tribeProbeState
+	tribeProbeSeq uint32
+	// Unix nanoseconds until which the write path looks for the probe's reply; 0 = it does not.
+	// A deadline, not a flag: the look-out ends by itself even when nobody polls the result.
+	tribeProbeUntil atomic.Int64
+	// The probe's packet has not been seen coming out of the forwarder yet: Read looks for it.
+	tribeProbeAwaitTake atomic.Bool
+)
+
+// wgSetTribeProbe configures the probe before wgTurnOn (like wgSetSplitDns). enabled == 0
+// switches it off. Returns 0 when the probe is available, -1 when it is not (an address is not
+// IPv4): the tunnel comes up either way and the watch reports its verdict as unconfirmed.
+//
+//export wgSetTribeProbe
+func wgSetTribeProbe(clientIp *C.char, target *C.char, enabled int32) int32 {
+	return tribeProbeConfigure(C.GoString(clientIp), C.GoString(target), enabled != 0)
+}
+
+func tribeProbeConfigure(clientIP, target string, enabled bool) int32 {
+	tribeProbeMu.Lock()
+	defer tribeProbeMu.Unlock()
+	tribeProbeAbortLocked()
+	tribeProbeCur = nil
+	tribeProbeCfg = nil
+	if !enabled {
+		return 0
+	}
+	client, err1 := netip.ParseAddr(strings.TrimSpace(strings.Split(clientIP, "/")[0]))
+	dst, err2 := netip.ParseAddr(strings.TrimSpace(target))
+	if err1 != nil || err2 != nil || !client.Is4() || !dst.Is4() || client.IsUnspecified() || dst.IsUnspecified() {
+		return -1
+	}
+	tribeProbeCfg = &tribeProbeConfig{client: client, target: dst}
+	return 0
+}
+
+// wgTribeProbeStart starts one probe on the device of `handle`. Returns its id (> 0), the id of
+// the probe already in flight, 0 when there is no probe in this session, -1 when the resolver
+// cannot be reached through the tunnel in this session (not routed into it, or taken out of it
+// by the direct split), -2 when the engine holds no keypair that may send now (nothing is
+// injected: the packet would only be staged). timeoutMs <= 0 = the default.
+//
+//export wgTribeProbeStart
+func wgTribeProbeStart(handle int32, timeoutMs int32) int32 {
+	return tribeProbeStart(handle, time.Duration(timeoutMs)*time.Millisecond)
+}
+
+func tribeProbeStart(handle int32, timeout time.Duration) int32 {
+	tribeProbeMu.Lock()
+	cfg := tribeProbeCfg
+	dev := tribeProbeTun
+	now := tribeProbeNow()
+	if cfg == nil || dev == nil {
+		tribeProbeMu.Unlock()
+		return tribeProbeStartNone
+	}
+	if cur := tribeProbeCur; cur != nil && tribeProbePendingLocked(cur, now) {
+		tribeProbeMu.Unlock()
+		return int32(cur.id)
+	}
+	tribeProbeMu.Unlock()
+
+	// The engine is asked outside our lock: its dump takes the device's own locks.
+	if tribeProbeIsDirect(cfg.target) {
+		return tribeProbeStartNoTarget
+	}
+	facts := tribeProbeFacts(handle, cfg.target)
+	if !facts.ok || !facts.routed {
+		return tribeProbeStartNoTarget
+	}
+	if !facts.usable(now) {
+		return tribeProbeStartNoSession
+	}
+
+	tribeProbeMu.Lock()
+	defer tribeProbeMu.Unlock()
+	if tribeProbeCfg != cfg || tribeProbeTun != dev {
+		return tribeProbeStartNone // the session changed while the engine was asked
+	}
+	tribeProbeAbortLocked()
+	if timeout <= 0 {
+		timeout = tribeProbeDefaultTimeout
+	}
+	tribeProbeSeq++
+	if tribeProbeSeq == 0 || tribeProbeSeq > 1<<30 {
+		tribeProbeSeq = 1
+	}
+	st := &tribeProbeState{
+		id:        tribeProbeSeq,
+		port:      tribeProbePortBase + uint16(tribeProbeSeq%tribeProbePortSpan),
+		dnsID:     uint16(now.UnixNano()>>8) | 1,
+		timeout:   timeout,
+		startedAt: now,
+		hsAtStart: facts.handshake,
+		expire:    facts.expire,
+	}
+	tribeProbeCur = st
+	// Until the wait can be over at the latest (taken at the very end of the first timeout, then
+	// a full timeout of silence) plus the late window.
+	tribeProbeUntil.Store(now.Add(2*timeout + tribeProbeLateWindow).UnixNano())
+	tribeProbeAwaitTake.Store(dev.fwd != nil)
+	dev.send(tribeProbePacket(cfg, st))
+	// One repeat: a single lost datagram must not read as a dead tunnel.
+	st.resend = time.AfterFunc(tribeProbeResendAfter, func() { tribeProbeResend(st) })
+	return int32(st.id)
+}
+
+func tribeProbeResend(st *tribeProbeState) {
+	tribeProbeMu.Lock()
+	defer tribeProbeMu.Unlock()
+	if tribeProbeCur != st || tribeProbeCfg == nil || tribeProbeTun == nil || !st.answered.IsZero() || st.aborted || st.final != "" {
+		return
+	}
+	tribeProbeTun.send(tribeProbePacket(tribeProbeCfg, st))
+}
+
+// wgTribeProbeResult returns "state=<s> id=<n> ms=<n> late=<0|1>": s is none | pending |
+// answered | silent | no_session | not_sent | unavailable; ms is the round trip of an answered
+// probe; late=1 marks an answer that came after the probe had already been told as silent or
+// no_session. The caller frees the string.
+//
+//export wgTribeProbeResult
+func wgTribeProbeResult(handle int32) *C.char {
+	return C.CString(tribeProbeResult(handle))
+}
+
+func tribeProbeFormat(state string, st *tribeProbeState, late bool) string {
+	id, ms, lateFlag := uint32(0), int64(0), 0
+	if st != nil {
+		id = st.id
+		if state == "answered" {
+			ms = st.answered.Sub(st.consumedAt).Milliseconds()
+		}
+	}
+	if late {
+		lateFlag = 1
+	}
+	return fmt.Sprintf("state=%s id=%d ms=%d late=%d", state, id, ms, lateFlag)
+}
+
+func tribeProbeResult(handle int32) string {
+	tribeProbeMu.Lock()
+	cfg := tribeProbeCfg
+	st := tribeProbeCur
+	if cfg == nil {
+		tribeProbeMu.Unlock()
+		return tribeProbeFormat("unavailable", nil, false)
+	}
+	if st == nil {
+		tribeProbeMu.Unlock()
+		return tribeProbeFormat("none", nil, false)
+	}
+	now := tribeProbeNow()
+	if state, done := tribeProbeSettledLocked(st, now); done {
+		tribeProbeMu.Unlock()
+		return state
+	}
+	if st.consumedAt.IsZero() || now.Sub(st.consumedAt) < st.timeout {
+		tribeProbeMu.Unlock()
+		return tribeProbeFormat("pending", st, false)
+	}
+	tribeProbeMu.Unlock()
+
+	// The wait is over without an answer. Did the packet really leave under a keypair? The engine
+	// is asked outside our lock.
+	facts := tribeProbeFacts(handle, cfg.target)
+
+	tribeProbeMu.Lock()
+	defer tribeProbeMu.Unlock()
+	if tribeProbeCur != st {
+		return tribeProbeFormat("not_sent", st, false) // replaced meanwhile: this one is never judged
+	}
+	if state, done := tribeProbeSettledLocked(st, now); done {
+		return state
+	}
+	started := tribeEngineFacts{ok: true, routed: true, handshake: st.hsAtStart, expire: st.expire}
+	if facts.ok && facts.routed && facts.handshake.Equal(st.hsAtStart) && started.usable(st.consumedAt) {
+		st.final = "silent"
+	} else {
+		st.final = "no_session"
+	}
+	tribeProbeUntil.Store(now.Add(tribeProbeLateWindow).UnixNano())
+	return tribeProbeFormat(st.final, st, false)
+}
+
+// tribeProbeSettledLocked: the result when no question to the engine is needed.
+func tribeProbeSettledLocked(st *tribeProbeState, now time.Time) (string, bool) {
+	switch {
+	case !st.answered.IsZero():
+		return tribeProbeFormat("answered", st, st.final != ""), true
+	case st.final != "":
+		return tribeProbeFormat(st.final, st, false), true
+	case st.aborted:
+		st.final = "not_sent"
+		return tribeProbeFormat(st.final, st, false), true
+	case st.consumedAt.IsZero() && now.Sub(st.startedAt) >= st.timeout:
+		st.final = "not_sent"
+		if st.resend != nil {
+			st.resend.Stop()
+		}
+		tribeProbeUntil.Store(0) // nothing left the phone: no reply can come
+		tribeProbeAwaitTake.Store(false)
+		return tribeProbeFormat(st.final, st, false), true
+	}
+	return "", false
+}
+
+func tribeProbePendingLocked(st *tribeProbeState, now time.Time) bool {
+	if !st.answered.IsZero() || st.final != "" || st.aborted {
+		return false
+	}
+	if st.consumedAt.IsZero() {
+		return now.Sub(st.startedAt) < st.timeout
+	}
+	return now.Sub(st.consumedAt) < st.timeout
+}
+
+// tribeProbeAbortLocked ends the probe in flight without a verdict (its state stays readable).
+func tribeProbeAbortLocked() {
+	if st := tribeProbeCur; st != nil {
+		if st.resend != nil {
+			st.resend.Stop()
+		}
+		if st.answered.IsZero() && st.final == "" {
+			st.aborted = true
+		}
+	}
+	tribeProbeUntil.Store(0)
+	tribeProbeAwaitTake.Store(false)
+	if tribeProbeTun != nil {
+		tribeProbeTun.drain()
+	}
+}
+
+func tribeProbePacket(cfg *tribeProbeConfig, st *tribeProbeState) []byte {
+	query := warmupDNSQuery()
+	binary.BigEndian.PutUint16(query[0:2], st.dnsID)
+	return buildUDP4(cfg.client, cfg.target, st.port, 53, query)
+}
+
+// tribeProbeTunDev is the pass-through wrapper.
+type tribeProbeTunDev struct {
+	tun.Device
+	// The split-DNS forwarder below, if this session has one: its channel feeds the device.
+	fwd *fwdTun
+	// Without a forwarder: probe packets waiting for the device's next Read (the packet and its repeat).
+	pending chan []byte
+}
+
+// wrapTribeProbeIfEnabled: called from wgTurnOn, outside every other wrapper. `fwd` is the
+// split-DNS forwarder of this device or nil. No-op when the probe is not configured: the device
+// then reads the inner tun exactly as before.
+func wrapTribeProbeIfEnabled(inner tun.Device, fwd *fwdTun, logf func(format string, args ...interface{})) tun.Device {
+	tribeProbeMu.Lock()
+	defer tribeProbeMu.Unlock()
+	if tribeProbeCfg == nil {
+		tribeProbeTun = nil
+		return inner
+	}
+	// A new device (start or in-place restart): a probe of the previous device cannot be answered.
+	tribeProbeAbortLocked()
+	dev := &tribeProbeTunDev{Device: inner, fwd: fwd, pending: make(chan []byte, 2)}
+	tribeProbeTun = dev
+	if logf != nil {
+		logf("Tribe probe: in-tunnel probe available (immediate=%v)", fwd != nil)
+	}
+	return dev
+}
+
+// send queues the packet for the device: into the forwarder's channel, or for this wrapper's
+// next Read. Queued is not taken: the probe counts as taken only in Read.
+func (d *tribeProbeTunDev) send(pkt []byte) {
+	if d.fwd != nil {
+		select {
+		case d.fwd.out <- pkt:
+		default: // the forwarder's queue is full or closed: the device is not reading
+		}
+		return
+	}
+	select {
+	case d.pending <- pkt:
+	default: // both slots taken: the device is not reading; the result will be not_sent
+	}
+}
+
+func (d *tribeProbeTunDev) drain() {
+	for {
+		select {
+		case <-d.pending:
+		default:
+			return
+		}
+	}
+}
+
+func (d *tribeProbeTunDev) Read(bufs [][]byte, sizes []int, offset int) (int, error) {
+	select {
+	case pkt := <-d.pending:
+		if len(bufs) > 0 && len(bufs[0]) >= offset+len(pkt) {
+			sizes[0] = copy(bufs[0][offset:], pkt)
+			tribeProbeConsumed(d)
+			return 1, nil
+		}
+	default:
+	}
+	n, err := d.Device.Read(bufs, sizes, offset)
+	if n > 0 && tribeProbeAwaitTake.Load() {
+		for i := 0; i < n; i++ {
+			if len(bufs[i]) >= offset+sizes[i] && tribeProbeIsOurs(d, bufs[i][offset:offset+sizes[i]]) {
+				tribeProbeConsumed(d)
+				break
+			}
+		}
+	}
+	return n, err
+}
+
+// tribeProbeIsOurs: the packet coming out of the forwarder is the probe's query.
+func tribeProbeIsOurs(d *tribeProbeTunDev, pkt []byte) bool {
+	m, ok := parseUDP4(pkt)
+	if !ok || m.dpt != 53 || m.sport < tribeProbePortBase || m.sport >= tribeProbePortBase+tribeProbePortSpan {
+		return false
+	}
+	tribeProbeMu.Lock()
+	defer tribeProbeMu.Unlock()
+	st := tribeProbeCur
+	return st != nil && tribeProbeCfg != nil && tribeProbeTun == d && m.sport == st.port &&
+		m.dst == tribeProbeCfg.target && len(m.payload) >= 2 && binary.BigEndian.Uint16(m.payload[0:2]) == st.dnsID
+}
+
+// tribeProbeConsumed: the device has just taken the probe's packet off the tunnel.
+func tribeProbeConsumed(d *tribeProbeTunDev) {
+	tribeProbeMu.Lock()
+	defer tribeProbeMu.Unlock()
+	st := tribeProbeCur
+	if tribeProbeTun != d || st == nil || st.aborted || st.final != "" {
+		return
+	}
+	if st.consumedAt.IsZero() {
+		st.consumedAt = tribeProbeNow()
+	}
+	tribeProbeAwaitTake.Store(false)
+}
+
+func (d *tribeProbeTunDev) Write(bufs [][]byte, offset int) (int, error) {
+	until := tribeProbeUntil.Load()
+	if until == 0 {
+		return d.Device.Write(bufs, offset)
+	}
+	if tribeProbeNow().UnixNano() > until {
+		tribeProbeUntil.CompareAndSwap(until, 0) // the look-out is over, asked for or not
+		return d.Device.Write(bufs, offset)
+	}
+	hit := -1
+	for i, b := range bufs {
+		if len(b) > offset && tribeProbeTakeReply(d, b[offset:]) {
+			hit = i
+			break
+		}
+	}
+	if hit < 0 {
+		return d.Device.Write(bufs, offset)
+	}
+	// Rare path: the reply is dropped here, the rest goes on in order (a fresh slice: the
+	// caller's batch is left as it was).
+	kept := make([][]byte, 0, len(bufs)-1)
+	for i, b := range bufs {
+		if i == hit || (i > hit && len(b) > offset && tribeProbeTakeReply(d, b[offset:])) {
+			continue
+		}
+		kept = append(kept, b)
+	}
+	if len(kept) == 0 {
+		return len(bufs), nil
+	}
+	n, err := d.Device.Write(kept, offset)
+	if n == len(kept) {
+		n = len(bufs)
+	}
+	return n, err
+}
+
+// tribeProbeTakeReply: true = this packet is the answer to the last probe (or to its repeat),
+// in time or late.
+func tribeProbeTakeReply(d *tribeProbeTunDev, pkt []byte) bool {
+	m, ok := parseUDP4(pkt)
+	if !ok || m.sport != 53 || m.dpt < tribeProbePortBase || m.dpt >= tribeProbePortBase+tribeProbePortSpan {
+		return false
+	}
+	tribeProbeMu.Lock()
+	defer tribeProbeMu.Unlock()
+	st := tribeProbeCur
+	if st == nil || st.aborted || tribeProbeCfg == nil || tribeProbeTun != d || m.dpt != st.port ||
+		m.src != tribeProbeCfg.target || m.dst != tribeProbeCfg.client {
+		return false
+	}
+	if len(m.payload) < 2 || binary.BigEndian.Uint16(m.payload[0:2]) != st.dnsID {
+		return false
+	}
+	if st.answered.IsZero() && !st.consumedAt.IsZero() {
+		st.answered = tribeProbeNow()
+		if st.resend != nil {
+			st.resend.Stop()
+		}
+	}
+	return true
+}
+
+func (d *tribeProbeTunDev) Close() error {
+	tribeProbeMu.Lock()
+	if tribeProbeTun == d {
+		tribeProbeAbortLocked()
+		tribeProbeTun = nil
+	}
+	tribeProbeMu.Unlock()
+	return d.Device.Close()
+}
diff --git a/Sources/WireGuardKitGo/tribeprobe_engine.go b/Sources/WireGuardKitGo/tribeprobe_engine.go
new file mode 100644
index 0000000..f06cfaf
--- /dev/null
+++ b/Sources/WireGuardKitGo/tribeprobe_engine.go
@@ -0,0 +1,33 @@
+/* SPDX-License-Identifier: MIT
+ *
+ * Tribe data watch probe: what it asks the engine and the direct split (awg-apple tribe.13).
+ * Kept apart from tribeprobe.go so that the probe's own tests need neither the device nor cgo.
+ */
+package main
+
+import "net/netip"
+
+func init() {
+	// The engine's UAPI dump of a tunnel handle (the call wgGetConfig makes). Called from the
+	// adapter's queue only, like every other use of the handle table.
+	tribeProbeEngineDump = func(handle int32) (string, bool) {
+		dev, ok := tunnelHandles[handle]
+		if !ok {
+			return "", false
+		}
+		dump, err := dev.IpcGet()
+		return dump, err == nil
+	}
+	// A destination inside the direct-split list never enters the tunnel (directsplit.go takes
+	// the packet out below the probe's wrapper): such a resolver cannot be probed.
+	tribeProbeIsDirect = func(addr netip.Addr) bool {
+		directMu.Lock()
+		set := directSet
+		directMu.Unlock()
+		if set == nil || !addr.Is4() {
+			return false
+		}
+		a := addr.As4()
+		return set.contains4(be32(a[:]))
+	}
+}
diff --git a/Sources/WireGuardKitGo/tribeprobe_test.go b/Sources/WireGuardKitGo/tribeprobe_test.go
new file mode 100644
index 0000000..7d4bfa0
--- /dev/null
+++ b/Sources/WireGuardKitGo/tribeprobe_test.go
@@ -0,0 +1,957 @@
+/* SPDX-License-Identifier: MIT
+ *
+ * Tribe data watch probe - tests with a fake tun (no device, no network): what the wrapper hands
+ * to the device, what it takes off the write path, and how the result is told apart.
+ */
+package main
+
+import (
+	"bytes"
+	"errors"
+	"net/netip"
+	"os"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/amnezia-vpn/amneziawg-go/v3/tun"
+)
+
+// fakeProbeTun is the inner device: Read blocks until the test feeds a packet "from the OS",
+// Write records what reached "the OS".
+type fakeProbeTun struct {
+	fromOS  chan []byte
+	mu      sync.Mutex
+	toOS    [][]byte
+	closed  chan struct{}
+	writeN  int
+	failing bool
+}
+
+func newFakeProbeTun() *fakeProbeTun {
+	return &fakeProbeTun{fromOS: make(chan []byte, 16), closed: make(chan struct{})}
+}
+
+func (f *fakeProbeTun) File() *os.File           { return nil }
+func (f *fakeProbeTun) MTU() (int, error)        { return 1280, nil }
+func (f *fakeProbeTun) Name() (string, error)    { return "utun-test", nil }
+func (f *fakeProbeTun) Events() <-chan tun.Event { return nil }
+func (f *fakeProbeTun) BatchSize() int           { return 4 }
+func (f *fakeProbeTun) Close() error {
+	select {
+	case <-f.closed:
+	default:
+		close(f.closed)
+	}
+	return nil
+}
+
+func (f *fakeProbeTun) Read(bufs [][]byte, sizes []int, offset int) (int, error) {
+	select {
+	case pkt := <-f.fromOS:
+		sizes[0] = copy(bufs[0][offset:], pkt)
+		return 1, nil
+	case <-f.closed:
+		return 0, os.ErrClosed
+	}
+}
+
+func (f *fakeProbeTun) Write(bufs [][]byte, offset int) (int, error) {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	f.writeN++
+	if f.failing {
+		return 0, errors.New("write failed")
+	}
+	for _, b := range bufs {
+		f.toOS = append(f.toOS, append([]byte(nil), b[offset:]...))
+	}
+	return len(bufs), nil
+}
+
+func (f *fakeProbeTun) delivered() [][]byte {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	return append([][]byte(nil), f.toOS...)
+}
+
+const probeTestOffset = 4
+
+var (
+	probeClient = netip.MustParseAddr("10.8.1.7")
+	probeTarget = netip.MustParseAddr("1.1.1.1")
+)
+
+// probeClock is the test's clock; the resend timer is real but set far away unless a test asks.
+type probeClock struct {
+	mu  sync.Mutex
+	now time.Time
+}
+
+func (c *probeClock) Now() time.Time {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	return c.now
+}
+
+func (c *probeClock) Advance(d time.Duration) {
+	c.mu.Lock()
+	c.now = c.now.Add(d)
+	c.mu.Unlock()
+}
+
+// probeEngine is what the engine would say in its UAPI dump (the hook tribeProbeEngineDump).
+type probeEngine struct {
+	mu        sync.Mutex
+	ok        bool
+	handshake time.Time // zero = no handshake yet
+	reject    string    // reject_after_time as the engine prints it; "" = not configured
+	allowed   []string
+	asked     int
+}
+
+func (e *probeEngine) dump(int32) (string, bool) {
+	e.mu.Lock()
+	defer e.mu.Unlock()
+	e.asked++
+	if !e.ok {
+		return "", false
+	}
+	var b strings.Builder
+	b.WriteString("private_key=00\nlisten_port=1\n")
+	if e.reject != "" {
+		b.WriteString("reject_after_time=" + e.reject + "\n")
+	}
+	b.WriteString("public_key=aa\nprotocol_version=1\nendpoint=203.0.113.9:585\n")
+	sec, nsec := int64(0), int64(0)
+	if !e.handshake.IsZero() {
+		sec, nsec = e.handshake.Unix(), int64(e.handshake.Nanosecond())
+	}
+	b.WriteString("last_handshake_time_sec=" + strconv.FormatInt(sec, 10) + "\n")
+	b.WriteString("last_handshake_time_nsec=" + strconv.FormatInt(nsec, 10) + "\n")
+	b.WriteString("tx_bytes=1\nrx_bytes=1\npersistent_keepalive_interval=25\n")
+	for _, a := range e.allowed {
+		b.WriteString("allowed_ip=" + a + "\n")
+	}
+	return b.String(), true
+}
+
+func (e *probeEngine) setHandshake(at time.Time) {
+	e.mu.Lock()
+	e.handshake = at
+	e.mu.Unlock()
+}
+
+const probeHandle = 7
+
+// setupProbe: a configured probe over a fake tun, a test clock, and an engine whose last handshake
+// completed 10 s ago (a keypair that may send).
+func setupProbe(t *testing.T) (*fakeProbeTun, tun.Device, *probeClock) {
+	inner, dev, clock, _ := setupProbeEngine(t)
+	return inner, dev, clock
+}
+
+func setupProbeEngine(t *testing.T) (*fakeProbeTun, tun.Device, *probeClock, *probeEngine) {
+	t.Helper()
+	clock := installProbeClock(t)
+	engine := installProbeEngine(t, clock)
+	if rc := tribeProbeConfigure("10.8.1.7/32", "1.1.1.1", true); rc != 0 {
+		t.Fatalf("configure rc=%d", rc)
+	}
+	inner := newFakeProbeTun()
+	return inner, wrapTribeProbeIfEnabled(inner, nil, nil), clock, engine
+}
+
+func installProbeClock(t *testing.T) *probeClock {
+	t.Helper()
+	clock := &probeClock{now: time.Unix(1_800_000_000, 0)}
+	oldNow, oldResend := tribeProbeNow, tribeProbeResendAfter
+	tribeProbeNow = clock.Now
+	tribeProbeResendAfter = time.Hour
+	t.Cleanup(func() {
+		tribeProbeConfigure("", "", false)
+		tribeProbeMu.Lock()
+		tribeProbeTun = nil
+		tribeProbeMu.Unlock()
+		tribeProbeNow, tribeProbeResendAfter = oldNow, oldResend
+	})
+	return clock
+}
+
+func installProbeEngine(t *testing.T, clock *probeClock) *probeEngine {
+	t.Helper()
+	engine := &probeEngine{ok: true, handshake: clock.Now().Add(-10 * time.Second), allowed: []string{"0.0.0.0/0", "::/0"}}
+	oldDump, oldDirect := tribeProbeEngineDump, tribeProbeIsDirect
+	tribeProbeEngineDump = engine.dump
+	t.Cleanup(func() { tribeProbeEngineDump, tribeProbeIsDirect = oldDump, oldDirect })
+	return engine
+}
+
+func startProbe(t *testing.T, timeout time.Duration) int32 {
+	t.Helper()
+	id := tribeProbeStart(probeHandle, timeout)
+	if id <= 0 {
+		t.Fatalf("probe not started: %d", id)
+	}
+	return id
+}
+
+// readOne is the device reading one batch from the tunnel.
+func readOne(t *testing.T, dev tun.Device) []byte {
+	t.Helper()
+	bufs := [][]byte{make([]byte, 2048), make([]byte, 2048)}
+	sizes := make([]int, 2)
+	n, err := dev.Read(bufs, sizes, probeTestOffset)
+	if err != nil || n != 1 {
+		t.Fatalf("Read n=%d err=%v", n, err)
+	}
+	return append([]byte(nil), bufs[0][probeTestOffset:probeTestOffset+sizes[0]]...)
+}
+
+// writeBatch is the device writing decrypted packets towards the OS.
+func writeBatch(t *testing.T, dev tun.Device, pkts ...[]byte) (int, error) {
+	t.Helper()
+	bufs := make([][]byte, 0, len(pkts))
+	for _, p := range pkts {
+		b := make([]byte, probeTestOffset+len(p))
+		copy(b[probeTestOffset:], p)
+		bufs = append(bufs, b)
+	}
+	return dev.Write(bufs, probeTestOffset)
+}
+
+func probeReply(query []byte) []byte {
+	m, _ := parseUDP4(query)
+	resp := append([]byte(nil), m.payload...)
+	resp[2] |= 0x80 // QR
+	return buildUDP4(m.dst, m.src, 53, m.sport, resp)
+}
+
+func wantState(t *testing.T, want string) string {
+	t.Helper()
+	got := tribeProbeResult(probeHandle)
+	if !strings.HasPrefix(got, "state="+want+" ") {
+		t.Fatalf("result %q, want state=%s", got, want)
+	}
+	return got
+}
+
+func TestTribeProbeUnavailable(t *testing.T) {
+	tribeProbeConfigure("", "", false)
+	wantState(t, "unavailable")
+	if id := tribeProbeStart(probeHandle, 0); id != 0 {
+		t.Fatalf("a probe started without a configuration: id=%d", id)
+	}
+	inner := newFakeProbeTun()
+	if got := wrapTribeProbeIfEnabled(inner, nil, nil); got != tun.Device(inner) {
+		t.Fatalf("not configured: the device must get the inner tun itself")
+	}
+	for _, bad := range [][2]string{
+		{"fd00::7/128", "1.1.1.1"}, {"10.8.1.7/32", "2606:4700:4700::1111"}, {"garbage", "1.1.1.1"},
+		{"10.8.1.7/32", ""}, {"0.0.0.0/0", "1.1.1.1"}, {"10.8.1.7", "0.0.0.0"},
+	} {
+		if rc := tribeProbeConfigure(bad[0], bad[1], true); rc != -1 {
+			t.Fatalf("configure(%q, %q) rc=%d, want -1", bad[0], bad[1], rc)
+		}
+		wantState(t, "unavailable")
+	}
+	// Configured but no device yet: still nothing to send into.
+	if rc := tribeProbeConfigure("10.8.1.7/32", "1.1.1.1", true); rc != 0 {
+		t.Fatalf("rc=%d", rc)
+	}
+	tribeProbeMu.Lock()
+	tribeProbeTun = nil
+	tribeProbeMu.Unlock()
+	if id := tribeProbeStart(probeHandle, 0); id != 0 {
+		t.Fatalf("a probe started without a device: id=%d", id)
+	}
+	wantState(t, "none")
+	tribeProbeConfigure("", "", false)
+}
