+// Device goroutines read and write while the caller starts and polls probes and the device is
+// closed and wrapped again (in-place restart): no user packet is lost or duplicated on the write
+// path. Run with -race when changing the wrapper.
+func TestTribeProbeConcurrentUse(t *testing.T) {
+	oldResend, oldDump := tribeProbeResendAfter, tribeProbeEngineDump
+	tribeProbeResendAfter = 2 * time.Millisecond
+	engine := &probeEngine{ok: true, handshake: time.Now().Add(-10 * time.Second), allowed: []string{"0.0.0.0/0"}}
+	tribeProbeEngineDump = engine.dump
+	defer func() {
+		tribeProbeConfigure("", "", false)
+		tribeProbeMu.Lock()
+		tribeProbeTun = nil
+		tribeProbeMu.Unlock()
+		tribeProbeResendAfter, tribeProbeEngineDump = oldResend, oldDump
+	}()
+	if rc := tribeProbeConfigure("10.8.1.7/32", "1.1.1.1", true); rc != 0 {
+		t.Fatalf("rc=%d", rc)
+	}
+	user := buildUDP4(probeClient, netip.MustParseAddr("8.8.8.8"), 40000, 443, []byte("user data"))
+	down := buildUDP4(netip.MustParseAddr("8.8.8.8"), probeClient, 443, 40000, []byte("download"))
+	var mu sync.Mutex
+	var sentDown, passedDown, answers int64
+	for round := 0; round < 12; round++ {
+		inner := newFakeProbeTun()
+		dev := wrapTribeProbeIfEnabled(inner, nil, nil)
+		stop := make(chan struct{})
+		var wg sync.WaitGroup
+		wg.Add(4)
+		go func() { // the device's TUN reader: answers every probe query through Write
+			defer wg.Done()
+			bufs := [][]byte{make([]byte, 2048), make([]byte, 2048)}
+			sizes := make([]int, 2)
+			for {
+				n, err := dev.Read(bufs, sizes, probeTestOffset)
+				if err != nil {
+					return
+				}
+				for i := 0; i < n; i++ {
+					pkt := bufs[i][probeTestOffset : probeTestOffset+sizes[i]]
+					if m, ok := parseUDP4(pkt); ok && m.dpt == 53 && m.dst == probeTarget {
+						reply := probeReply(append([]byte(nil), pkt...))
+						b := make([]byte, probeTestOffset+len(reply))
+						copy(b[probeTestOffset:], reply)
+						d := make([]byte, probeTestOffset+len(down))
+						copy(d[probeTestOffset:], down)
+						mu.Lock()
+						sentDown++
+						mu.Unlock()
+						dev.Write([][]byte{d, b}, probeTestOffset)
+					}
+				}
+			}
+		}()
+		go func() { // the device's TUN writer: plain download traffic
+			defer wg.Done()
+			for {
+				select {
+				case <-stop:
+					return
+				default:
+				}
+				d := make([]byte, probeTestOffset+len(down))
+				copy(d[probeTestOffset:], down)
+				mu.Lock()
+				sentDown++
+				mu.Unlock()
+				dev.Write([][]byte{d}, probeTestOffset)
+			}
+		}()
+		go func() { // the OS
+			defer wg.Done()
+			for {
+				select {
+				case <-stop:
+					return
+				case inner.fromOS <- user:
+				default:
+					time.Sleep(50 * time.Microsecond)
+				}
+			}
+		}()
+		go func() { // the adapter's queue
+			defer wg.Done()
+			for i := 0; i < 150; i++ {
+				tribeProbeStart(probeHandle, 5*time.Millisecond)
+				if strings.HasPrefix(tribeProbeResult(probeHandle), "state=answered") {
+					mu.Lock()
+					answers++
+					mu.Unlock()
+				}
+				time.Sleep(100 * time.Microsecond)
+			}
+		}()
+		time.Sleep(15 * time.Millisecond)
+		dev.Close()
+		close(stop)
+		wg.Wait()
+		mu.Lock()
+		for _, p := range inner.delivered() {
+			if m, ok := parseUDP4(p); ok && m.sport == 443 {
+				passedDown++
+			}
+		}
+		mu.Unlock()
+	}
+	if passedDown != sentDown {
+		t.Fatalf("user traffic lost or duplicated on the write path: sent %d, delivered %d", sentDown, passedDown)
+	}
+	if answers == 0 {
+		t.Fatal("not one probe was answered: the test did not exercise the reply path")
+	}
+}
+
+func itoa(v uint32) string {
+	if v == 0 {
+		return "0"
+	}
+	var b []byte
+	for v > 0 {
+		b = append([]byte{byte('0' + v%10)}, b...)
+		v /= 10
+	}
+	return string(b)
+}
