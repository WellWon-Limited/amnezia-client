+// User packets that only look like the probe: another port of the range, the probe's port with
+// another DNS id. They pass. (Same port and same id cannot be told from the answer.)
+func TestTribeProbeUserPacketsInItsPortRange(t *testing.T) {
+	inner, dev, _ := setupProbe(t)
+	startProbe(t, 0)
+	query := readOne(t, dev)
+	m, _ := parseUDP4(query)
+	other := uint16(tribeProbePortBase + (int(m.sport-tribeProbePortBase)+7)%tribeProbePortSpan)
+	answer := []byte{0xAA, 0xBB, 0x81, 0x80, 0, 1, 0, 0, 0, 0, 0, 0}
+	otherPort := buildUDP4(probeTarget, probeClient, 53, other, answer)
+	otherID := buildUDP4(probeTarget, probeClient, 53, m.sport, []byte{m.payload[0] ^ 0x40, m.payload[1], 0x81, 0x80, 0, 1, 0, 0, 0, 0, 0, 0})
+	if n, err := writeBatch(t, dev, otherPort, otherID); err != nil || n != 2 || len(inner.delivered()) != 2 {
+		t.Fatalf("user packets were not passed: n=%d err=%v delivered=%d", n, err, len(inner.delivered()))
+	}
+	wantState(t, "pending")
+}
