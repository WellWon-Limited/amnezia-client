+func setupProbeForwarder(t *testing.T) (*fakeProbeTun, *fwdTun, tun.Device, *probeClock) {
+	t.Helper()
+	clock := installProbeClock(t)
+	installProbeEngine(t, clock)
+	if rc := tribeProbeConfigure("10.8.1.7/32", "1.1.1.1", true); rc != 0 {
+		t.Fatalf("rc=%d", rc)
+	}
+	inner := newFakeProbeTun()
+	fwd := &fwdTun{
+		real: inner,
+		cfg: &splitDNSConfig{enabled: true, suffixes: []string{"ru"}, directSrv: netip.MustParseAddr("77.88.8.8"),
+			tunnelSrv: probeTarget, virtIP: netip.MustParseAddr("100.100.100.53"), clientIP: probeClient},
+		out:    make(chan []byte, fwdOutDepth),
+		closed: make(chan struct{}),
+		offset: -1,
+	}
+	return inner, fwd, wrapTribeProbeIfEnabled(fwd, fwd, nil), clock
+}
+
+// With the forwarder "queued" is not "taken": nobody reads the device (from the wire's point of
+// view the same as no keypair: the packet never leaves the phone). That is not_sent, not silent.
+func TestTribeProbeForwarderQueuedButNeverRead(t *testing.T) {
+	_, fwd, dev, clock := setupProbeForwarder(t)
+	defer dev.Close()
+	startProbe(t, 3*time.Second)
+	if len(fwd.out) != 1 {
+		t.Fatalf("queue depth %d", len(fwd.out))
+	}
+	clock.Advance(3 * time.Second)
+	wantState(t, "not_sent")
+	if tribeProbeUntil.Load() != 0 {
+		t.Fatal("nothing left the phone: there is no reply to look for")
+	}
+}
+
+func TestTribeProbeLeavesAtOnceThroughTheForwarder(t *testing.T) {
+	// With the split-DNS forwarder in the chain the probe does not wait for the OS: the
+	// forwarder's channel feeds the device, and the device is blocked on exactly that channel.
+	inner, fwd, dev, clock := setupProbeForwarder(t)
+	defer dev.Close()
+	got := make(chan []byte, 1)
+	go func() {
+		bufs := [][]byte{make([]byte, 2048)}
+		sizes := make([]int, 1)
+		if n, err := dev.Read(bufs, sizes, probeTestOffset); err == nil && n == 1 {
+			got <- append([]byte(nil), bufs[0][probeTestOffset:probeTestOffset+sizes[0]]...)
+		}
+	}()
+	time.Sleep(20 * time.Millisecond) // the device waits; the OS sends nothing
+	id := startProbe(t, 0)
+	var query []byte
+	select {
+	case query = <-got:
+	case <-time.After(2 * time.Second):
+		t.Fatal("the probe did not leave without outbound demand")
+	}
+	if m, ok := parseUDP4(query); !ok || m.dst != probeTarget || m.src != probeClient {
+		t.Fatal("not the probe packet")
+	}
+	wantState(t, "pending")
+	// The reply is taken by the probe BEFORE the forwarder sees it (ports do not overlap anyway).
+	clock.Advance(90 * time.Millisecond)
+	if n, err := writeBatch(t, dev, probeReply(query)); err != nil || n != 1 {
+		t.Fatalf("Write n=%d err=%v", n, err)
+	}
+	if res := wantState(t, "answered"); !strings.Contains(res, " ms=90") || !strings.Contains(res, "id="+itoa(uint32(id))+" ") {
+		t.Fatalf("result %q", res)
+	}
+	if len(inner.delivered()) != 0 {
+		t.Fatal("the reply reached the OS")
+	}
+	// A full forwarder queue (the device is not reading) is not_sent, not silent.
+	for len(fwd.out) < cap(fwd.out) {
+		fwd.out <- []byte{0}
+	}
+	clock.Advance(10 * time.Second)
+	startProbe(t, 2*time.Second)
+	clock.Advance(2 * time.Second)
+	wantState(t, "not_sent")
+}
