+// What "silent" needs: the device took the packet while a keypair could send, and the same
+// session is there at the end of the wait.
+func TestTribeProbeSilentNeedsAKeypair(t *testing.T) {
+	_, dev, clock, engine := setupProbeEngine(t)
+	// No completed handshake: nothing is injected, the start itself says "no session".
+	engine.setHandshake(time.Time{})
+	if rc := tribeProbeStart(probeHandle, 0); rc != tribeProbeStartNoSession {
+		t.Fatalf("start without a handshake: %d", rc)
+	}
+	tribeProbeMu.Lock()
+	queued := len(tribeProbeTun.pending)
+	tribeProbeMu.Unlock()
+	if queued != 0 || tribeProbeUntil.Load() != 0 {
+		t.Fatal("a probe was queued although the device could only stage it")
+	}
+	wantState(t, "none")
+	// A keypair past its life (180 s by default, 5 s of margin) cannot send either.
+	engine.setHandshake(clock.Now().Add(-176 * time.Second))
+	if rc := tribeProbeStart(probeHandle, 0); rc != tribeProbeStartNoSession {
+		t.Fatalf("start with an expired keypair: %d", rc)
+	}
+	engine.setHandshake(clock.Now().Add(-174 * time.Second))
+	startProbe(t, 3*time.Second)
+	// ... but the device takes the packet two seconds later: by then the keypair is gone and the
+	// packet was only staged. That is not silence.
+	clock.Advance(2 * time.Second)
+	readOne(t, dev)
+	clock.Advance(3 * time.Second)
+	wantState(t, "no_session")
+	// The engine's own expiry is honoured when the fleet configures it (upper bound of the range).
+	engine.mu.Lock()
+	engine.reject = "60-90"
+	engine.mu.Unlock()
+	engine.setHandshake(clock.Now().Add(-86 * time.Second))
+	if rc := tribeProbeStart(probeHandle, 0); rc != tribeProbeStartNoSession {
+		t.Fatalf("start past the configured expiry: %d", rc)
+	}
+	engine.setHandshake(clock.Now().Add(-80 * time.Second))
+	startProbe(t, 3*time.Second)
+	readOne(t, dev)
+	clock.Advance(3 * time.Second)
+	wantState(t, "silent")
+	// A handshake clock that runs ahead of ours is not a keypair we can reason about.
+	engine.setHandshake(clock.Now().Add(30 * time.Second))
+	if rc := tribeProbeStart(probeHandle, 0); rc != tribeProbeStartNoSession {
+		t.Fatalf("start with a handshake from the future: %d", rc)
+	}
+}
+
+// A new session during the wait (the device re-keyed, or was restarted in place and shook hands
+// again): the packet may have been staged, the silence is not judged.
+func TestTribeProbeHandshakeDuringTheWait(t *testing.T) {
+	_, dev, clock, engine := setupProbeEngine(t)
+	startProbe(t, 3*time.Second)
+	readOne(t, dev)
+	clock.Advance(time.Second)
+	engine.setHandshake(clock.Now())
+	clock.Advance(2 * time.Second)
+	got := wantState(t, "no_session")
+	// The verdict is told once and stays, whatever the engine says later.
+	engine.setHandshake(clock.Now().Add(-13 * time.Second))
+	if again := tribeProbeResult(probeHandle); again != got {
+		t.Fatalf("the verdict changed: %q then %q", got, again)
+	}
+	// The engine cannot be read at the end of the wait: not silence either.
+	engine.setHandshake(clock.Now().Add(-5 * time.Second))
+	startProbe(t, 3*time.Second)
+	readOne(t, dev)
+	clock.Advance(3 * time.Second)
+	engine.mu.Lock()
+	engine.ok = false
+	engine.mu.Unlock()
+	wantState(t, "no_session")
+}
