+func TestTribeProbeEngineFacts(t *testing.T) {
+	dump := "private_key=00\nlisten_port=5\nreject_after_time=100-140\n" +
+		"public_key=aa\nlast_handshake_time_sec=1700000000\nlast_handshake_time_nsec=5\nallowed_ip=0.0.0.0/0\n" +
+		"public_key=bb\nlast_handshake_time_sec=1700000100\nlast_handshake_time_nsec=0\nallowed_ip=1.1.1.0/24\nallowed_ip=::/0\n"
+	f := tribeParseEngineFacts(dump, probeTarget)
+	if !f.ok || !f.routed || f.expire != 140*time.Second || !f.handshake.Equal(time.Unix(1700000100, 0)) {
+		t.Fatalf("the longest prefix decides the peer: %+v", f)
+	}
+	f = tribeParseEngineFacts(dump, netip.MustParseAddr("8.8.8.8"))
+	if !f.routed || !f.handshake.Equal(time.Unix(1700000000, 5)) {
+		t.Fatalf("the other peer: %+v", f)
+	}
+	f = tribeParseEngineFacts("public_key=aa\nlast_handshake_time_sec=0\nlast_handshake_time_nsec=0\nallowed_ip=0.0.0.0/0\n", probeTarget)
+	if !f.routed || !f.handshake.IsZero() || f.expire != tribeProbeDefaultExpire || f.usable(time.Unix(1700000000, 0)) {
+		t.Fatalf("no handshake yet: %+v", f)
+	}
+	f = tribeParseEngineFacts("public_key=aa\nallowed_ip=10.0.0.0/8\nreject_after_time=junk\ngarbage\n=\n", probeTarget)
+	if !f.ok || f.routed || f.expire != tribeProbeDefaultExpire {
+		t.Fatalf("not routed, junk ignored: %+v", f)
+	}
+	if got := tribeParseEngineFacts("", probeTarget); got.routed || got.usable(time.Now()) {
+		t.Fatalf("an empty dump: %+v", got)
+	}
+	usable := tribeEngineFacts{ok: true, routed: true, handshake: time.Unix(1000, 0), expire: 180 * time.Second}
+	if !usable.usable(time.Unix(1000, 0)) || !usable.usable(time.Unix(1174, 0)) || usable.usable(time.Unix(1175, 0)) || usable.usable(time.Unix(999, 0)) {
+		t.Fatal("the keypair may send from its handshake until 5 s before its expiry")
+	}
+}
