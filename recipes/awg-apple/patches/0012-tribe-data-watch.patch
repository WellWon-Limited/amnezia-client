+// The timeout runs from the moment the device took the packet, not from the start.
+func TestTribeProbeTimeoutCountsFromTheTake(t *testing.T) {
+	_, dev, clock := setupProbe(t)
+	startProbe(t, 4*time.Second)
+	clock.Advance(3 * time.Second) // nothing read the tunnel for three seconds
+	readOne(t, dev)
+	clock.Advance(3999 * time.Millisecond)
+	wantState(t, "pending")
+	clock.Advance(time.Millisecond)
+	wantState(t, "silent")
+}
