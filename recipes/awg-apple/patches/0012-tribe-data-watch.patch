+func TestTribeProbeForeignPacketsPass(t *testing.T) {
+	inner, dev, _ := setupProbe(t)
+	startProbe(t, 0)
+	query := readOne(t, dev)
+	m, _ := parseUDP4(query)
+	reply := probeReply(query)
+	wrongSource := buildUDP4(netip.MustParseAddr("9.9.9.9"), probeClient, 53, m.sport, m.payload)
+	wrongPort := buildUDP4(probeTarget, probeClient, 53, m.sport+1, m.payload)
+	wrongID := append([]byte(nil), reply...)
+	wrongID[28] ^= 0xFF
+	wrongID = buildUDP4(probeTarget, probeClient, 53, m.sport, wrongID[28:])
+	forwarderReply := buildUDP4(probeTarget, probeClient, 53, fwdEphBase+5, m.payload)
+	tcp := append([]byte(nil), reply...)
+	tcp[9] = 6
+	short := []byte{0x45, 0, 0}
+	n, err := writeBatch(t, dev, wrongSource, wrongPort, wrongID, forwarderReply, tcp, short)
+	if err != nil || n != 6 {
+		t.Fatalf("Write n=%d err=%v", n, err)
+	}
+	if got := inner.delivered(); len(got) != 6 {
+		t.Fatalf("%d of 6 foreign packets reached the OS", len(got))
+	}
+	wantState(t, "pending")
+}
