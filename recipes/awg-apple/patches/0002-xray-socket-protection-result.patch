diff --git a/Sources/WireGuardKitGo/api-xray_callback_test.go b/Sources/WireGuardKitGo/api-xray_callback_test.go
index 6d26d07..b825e3a 100644
--- a/Sources/WireGuardKitGo/api-xray_callback_test.go
+++ b/Sources/WireGuardKitGo/api-xray_callback_test.go
@@ -64,6 +64,18 @@ func TestTribeXraySockCallbackSlotSingleton(t *testing.T) {
 	if armedConn.controlCalls != 1 {
 		t.Fatalf("armed callback invocation count=%d", armedConn.controlCalls)
 	}
+
+	if !tribeArmRejectingXraySockCallbackForTest() {
+		t.Fatal("arm rejecting callback slot failed")
+	}
+	rejectedConn := &tribeTestRawConn{}
+	if err := controller("tcp", "203.0.113.1:443", rejectedConn);
+		!errors.Is(err, errXraySockCallbackRejected) {
+		t.Fatalf("protect=false callback was not rejected: %v", err)
+	}
+	if rejectedConn.controlCalls != 1 {
+		t.Fatalf("rejecting callback invocation count=%d", rejectedConn.controlCalls)
+	}
 	if result := LibXraySetSockCallback(nil, nil); result != nil {
 		t.Fatal("final callback clear failed")
 	}
