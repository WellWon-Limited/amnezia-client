diff --git a/Sources/WireGuardKitGo/api-xray.go b/Sources/WireGuardKitGo/api-xray.go
index a84c8bd..404bd82 100644
--- a/Sources/WireGuardKitGo/api-xray.go
+++ b/Sources/WireGuardKitGo/api-xray.go
@@ -4,10 +4,10 @@ package main
 #include <stdint.h>
 #include <stdlib.h>
 
-typedef void (*libxray_sockcallback)(uintptr_t fd, void* ctx);
-static inline void libxray_invokesockcallback(libxray_sockcallback cb, uintptr_t fd, void* ctx)
+typedef int32_t (*libxray_sockcallback)(uintptr_t fd, void* ctx);
+static inline int32_t libxray_invokesockcallback(libxray_sockcallback cb, uintptr_t fd, void* ctx)
 {
-	cb(fd, ctx);
+	return cb(fd, ctx);
 }
 
 */
@@ -119,6 +119,7 @@ var (
 // clear (nil, nil), Swift can release the old context without a late-callback UAF.
 var (
 	errXraySockCallbackCleared       = errors.New("xray socket callback is cleared")
+	errXraySockCallbackRejected      = errors.New("xray socket protection callback rejected fd")
 	xraySockCallbackOnce            sync.Once
 	xraySockCallbackRegistrationErr error
 	xraySockCallbackMu              sync.RWMutex
@@ -135,10 +136,18 @@ func ensureXraySockController() error {
 				if xraySockCallback == nil {
 					return errXraySockCallbackCleared
 				}
-				return conn.Control(func(fd uintptr) {
-					C.libxray_invokesockcallback(
-						xraySockCallback, C.uintptr_t(fd), xraySockCallbackContext)
-				})
+				protected := false
+				if err := conn.Control(func(fd uintptr) {
+					protected = C.libxray_invokesockcallback(
+						xraySockCallback, C.uintptr_t(fd),
+						xraySockCallbackContext) != 0
+				}); err != nil {
+					return err
+				}
+				if !protected {
+					return errXraySockCallbackRejected
+				}
+				return nil
 			})
 	})
 	return xraySockCallbackRegistrationErr
