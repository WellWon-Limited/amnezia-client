+func TestDirectProtoClassification(t *testing.T) {
+	set, _ := parsePrefixSet(testPrefixes)
+	cases := []struct {
+		name string
+		pkt  []byte
+		want tcpip.NetworkProtocolNumber
+	}{
+		{"tcp4 direct", rawIPv4(6, "5.255.255.9"), header.IPv4ProtocolNumber},
+		{"udp4 direct", rawIPv4(17, "77.88.8.8"), header.IPv4ProtocolNumber},
+		{"icmp4 direct stays in tunnel", rawIPv4(1, "5.255.255.9"), 0},
+		{"tcp4 foreign", rawIPv4(6, "8.8.8.8"), 0},
+		{"tcp6 direct", rawIPv6(6, "2a02:6b8::feed:ff"), header.IPv6ProtocolNumber},
+		{"udp6 direct", rawIPv6(17, "2a02:6b8::1"), header.IPv6ProtocolNumber},
+		{"icmp6 direct stays in tunnel", rawIPv6(58, "2a02:6b8::1"), 0},
+		{"tcp6 foreign", rawIPv6(6, "2606:4700::1111"), 0},
+		{"short", []byte{0x45, 0, 0}, 0},
+		{"truncated v6", rawIPv6(6, "2a02:6b8::1")[:30], 0},
+	}
+	for _, c := range cases {
+		if got := set.directProto(c.pkt); got != c.want {
+			t.Errorf("%s: proto = %d, want %d", c.name, got, c.want)
+		}
+	}
+}
