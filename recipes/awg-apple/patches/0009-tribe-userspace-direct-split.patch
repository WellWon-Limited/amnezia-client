+func TestDirectTCPEcho(t *testing.T) {
+	b := newBench(t)
+	ln := echoTCP(t, "tcp4", "127.0.0.1:0")
+	b.route("5.255.255.10:443", ln.Addr())
+
+	c, err := b.ph.dialTCP(t, "5.255.255.10:443", 5*time.Second)
+	if err != nil {
+		t.Fatalf("dial through direct split: %v", err)
+	}
+	defer c.Close()
+	payload := make([]byte, 2<<20) // больше любых буферов: проверяет и управление потоком
+	rand.Read(payload)
+	go func() {
+		c.Write(payload)
+		c.CloseWrite()
+	}()
+	c.SetReadDeadline(time.Now().Add(20 * time.Second))
+	got, err := io.ReadAll(c)
+	if err != nil {
+		t.Fatalf("read echo: %v (got %d bytes)", err, len(got))
+	}
+	if !bytes.Equal(got, payload) {
+		t.Fatalf("echo mismatch: got %d bytes, want %d", len(got), len(payload))
+	}
+	b.expectNothingTunneled(t, "5.255.255.0/24")
+	line := b.engine.statsLine()
+	if !strings.Contains(line, "tcp=") || strings.Contains(line, "up=0 ") {
+		t.Fatalf("stats line does not show the flow: %q", line)
+	}
+}
