+func TestDirectUDPOneSocketManyServers(t *testing.T) {
+	b := newBench(t)
+	s1, s2 := echoUDP(t), echoUDP(t)
+	b.route("77.88.8.8:53", s1.conn.LocalAddr())
+	b.route("5.255.255.20:3478", s2.conn.LocalAddr())
+
+	local, _ := fullAddr(netip.AddrPortFrom(phoneV4, 40000))
+	c, err := gonet.DialUDP(b.ph.st, &local, nil, ipv4.ProtocolNumber)
+	if err != nil {
+		t.Fatalf("phone udp socket: %v", err)
+	}
+	defer c.Close()
+	for _, dst := range []string{"77.88.8.8:53", "5.255.255.20:3478"} {
+		ap := netip.MustParseAddrPort(dst)
+		msg := []byte("ping " + dst)
+		if _, err := c.WriteTo(msg, net.UDPAddrFromAddrPort(ap)); err != nil {
+			t.Fatalf("write to %s: %v", dst, err)
+		}
+		buf := make([]byte, 2048)
+		c.SetReadDeadline(time.Now().Add(5 * time.Second))
+		n, from, err := c.ReadFrom(buf)
+		if err != nil {
+			t.Fatalf("no reply from %s: %v", dst, err)
+		}
+		if string(buf[:n]) != string(msg) {
+			t.Fatalf("reply from %s = %q", dst, buf[:n])
+		}
+		// Ответ должен прийти от имени настоящего адресата, а не локального сервера.
+		if got := netip.MustParseAddrPort(from.String()); got != ap {
+			t.Fatalf("reply source = %v, want %v", got, ap)
+		}
+	}
+	s1.mu.Lock()
+	a := s1.from[0]
+	s1.mu.Unlock()
+	s2.mu.Lock()
+	c2 := s2.from[0]
+	s2.mu.Unlock()
+	if a.Port() != c2.Port() {
+		t.Fatalf("one app socket used two outer ports (%d, %d): mapping depends on destination", a.Port(), c2.Port())
+	}
+	if got := b.engine.stats.udpOpen.Load(); got != 1 {
+		t.Fatalf("udp sessions = %d, want 1", got)
+	}
+	b.expectNothingTunneled(t, "77.88.0.0/18")
+}
