+/* AVPN (Tribe): разделение «РФ мимо туннеля» внутри расширения, без системных маршрутов.
+ *
+ * Раньше список адресов РФ (10 850 префиксов) уходил в iOS как excludedRoutes и лежал в
+ * сохранённом профиле VPN: и то и другое держит системный демон nesessionmanager. Здесь система
+ * получает один маршрут по умолчанию, а решение «напрямую или в туннель» принимается по адресу
+ * назначения каждого пакета, прочитанного из TUN — так же делают клиенты на xray и sing-box
+ * (правило geoip:ru -> direct).
+ *
+ * Пакет к адресу из списка (TCP или UDP) отдаётся пользовательскому сетевому стеку gVisor: он
+ * завершает соединение приложения, а наружу открывается обычный сокет расширения. Сокеты
+ * расширения iOS в туннель не заворачивает (на этом же стоит dnsfwd.go и сокет самого WireGuard).
+ * Всё остальное проходит в устройство WireGuard без копирования, как раньше.
+ *
+ * Движок живёт дольше одного устройства: мягкий перезапуск туннеля (wgTurnOff + wgTurnOn на том
+ * же TUN) не рвёт прямые соединения, они переезжают на новую обёртку.
+ *
+ * amneziawg-go не патчится: обёртка реализует tun.Device и вставляется в wgTurnOn.
+ */
+package main
+
+import "C"
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"io"
+	"net"
+	"net/netip"
+	"os"
+	"runtime/debug"
+	"sort"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"github.com/amnezia-vpn/amneziawg-go/v3/tun"
+	"gvisor.dev/gvisor/pkg/buffer"
+	"gvisor.dev/gvisor/pkg/tcpip"
+	"gvisor.dev/gvisor/pkg/tcpip/adapters/gonet"
+	"gvisor.dev/gvisor/pkg/tcpip/header"
+	"gvisor.dev/gvisor/pkg/tcpip/link/channel"
+	"gvisor.dev/gvisor/pkg/tcpip/network/ipv4"
+	"gvisor.dev/gvisor/pkg/tcpip/network/ipv6"
+	"gvisor.dev/gvisor/pkg/tcpip/stack"
+	"gvisor.dev/gvisor/pkg/tcpip/transport/tcp"
+	"gvisor.dev/gvisor/pkg/tcpip/transport/udp"
+	"gvisor.dev/gvisor/pkg/waiter"
+)
+
+// ── множество префиксов ───────────────────────────────────────────────────────────────────────
+
+type u128 struct{ hi, lo uint64 }
+
+func (a u128) less(b u128) bool { return a.hi < b.hi || (a.hi == b.hi && a.lo < b.lo) }
+
+type range4 struct{ lo, hi uint32 }
+type range6 struct{ lo, hi u128 }
+
+// prefixSet: отсортированные непересекающиеся диапазоны; поиск двоичный (8,6 тыс. записей —
+// 14 сравнений на пакет).
+type prefixSet struct {
+	v4 []range4
+	v6 []range6
+}
+
+func be32(b []byte) uint32 {
+	return uint32(b[0])<<24 | uint32(b[1])<<16 | uint32(b[2])<<8 | uint32(b[3])
+}
+
+func be64(b []byte) uint64 {
+	return uint64(be32(b[0:4]))<<32 | uint64(be32(b[4:8]))
+}
+
+func u128From(b []byte) u128 { return u128{be64(b[0:8]), be64(b[8:16])} }
+
+// parsePrefixSet: по одному CIDR (или адресу) в строке; пустые строки и строки с # пропускаются.
+// Возвращает множество и число строк, которые не удалось разобрать.
+func parsePrefixSet(text string) (*prefixSet, int) {
+	set := &prefixSet{}
+	bad := 0
+	for _, line := range strings.Split(text, "\n") {
+		line = strings.TrimSpace(line)
+		if line == "" || strings.HasPrefix(line, "#") {
+			continue
+		}
+		p, err := netip.ParsePrefix(line)
+		if err != nil {
+			a, aerr := netip.ParseAddr(line)
+			if aerr != nil {
+				bad++
+				continue
+			}
+			p = netip.PrefixFrom(a, a.BitLen())
+		}
+		p = netip.PrefixFrom(p.Addr().Unmap(), p.Bits()).Masked()
+		if !p.IsValid() {
+			bad++
+			continue
+		}
+		if p.Addr().Is4() {
+			a := p.Addr().As4()
+			lo := be32(a[:])
+			hi := lo | uint32(uint64(1)<<(32-p.Bits())-1)
+			set.v4 = append(set.v4, range4{lo, hi})
+		} else {
+			a := p.Addr().As16()
+			lo := u128From(a[:])
+			hi := lo
+			host := 128 - p.Bits()
+			if host >= 64 {
+				hi.lo = ^uint64(0)
+				if host == 128 {
+					hi.hi = ^uint64(0)
+				} else {
+					hi.hi |= uint64(1)<<(host-64) - 1
+				}
+			} else {
+				hi.lo |= uint64(1)<<host - 1
+			}
+			set.v6 = append(set.v6, range6{lo, hi})
+		}
+	}
+	sort.Slice(set.v4, func(i, j int) bool { return set.v4[i].lo < set.v4[j].lo })
+	out4 := set.v4[:0]
+	for _, r := range set.v4 {
+		if n := len(out4); n > 0 && r.lo <= out4[n-1].hi {
+			if r.hi > out4[n-1].hi {
+				out4[n-1].hi = r.hi
+			}
+			continue
+		}
+		out4 = append(out4, r)
+	}
+	set.v4 = out4
+	sort.Slice(set.v6, func(i, j int) bool { return set.v6[i].lo.less(set.v6[j].lo) })
+	out6 := set.v6[:0]
+	for _, r := range set.v6 {
+		if n := len(out6); n > 0 && !out6[n-1].hi.less(r.lo) {
+			if out6[n-1].hi.less(r.hi) {
+				out6[n-1].hi = r.hi
+			}
+			continue
+		}
+		out6 = append(out6, r)
+	}
+	set.v6 = out6
+	return set, bad
+}
+
+func (s *prefixSet) size() int { return len(s.v4) + len(s.v6) }
+
+func (s *prefixSet) contains4(a uint32) bool {
+	i := sort.Search(len(s.v4), func(i int) bool { return s.v4[i].hi >= a })
+	return i < len(s.v4) && s.v4[i].lo <= a
+}
+
+func (s *prefixSet) contains6(a u128) bool {
+	i := sort.Search(len(s.v6), func(i int) bool { return !s.v6[i].hi.less(a) })
+	return i < len(s.v6) && !a.less(s.v6[i].lo)
+}
+
+// directProto: пакет TCP или UDP к адресу из множества — номер сетевого протокола для gVisor;
+// 0 = пакет идёт в туннель. Остальные протоколы (ICMP и т. п.) остаются в туннеле: стек их
+// наружу не выведет.
+func (s *prefixSet) directProto(pkt []byte) tcpip.NetworkProtocolNumber {
+	if len(pkt) < 20 {
+		return 0
+	}
+	switch pkt[0] >> 4 {
+	case 4:
+		if (pkt[9] == 6 || pkt[9] == 17) && s.contains4(be32(pkt[16:20])) {
+			return header.IPv4ProtocolNumber
+		}
+	case 6:
+		if len(pkt) >= 40 && (pkt[6] == 6 || pkt[6] == 17) && s.contains6(u128From(pkt[24:40])) {
+			return header.IPv6ProtocolNumber
+		}
+	}
+	return 0
+}
+
+// ── конфиг (ставится из Swift до wgTurnOn) ────────────────────────────────────────────────────
+
+const (
+	directListMaxBytes = 4 << 20
+	directNICID        = 1
+	directQueueDepth   = 1024
+	directDialTimeout  = 8 * time.Second
+	directTCPBuf       = 16 << 10
+	directTCPMaxFlows  = 384
+	directHalfCloseTTL = 2 * time.Minute
+	directUDPIdle      = 2 * time.Minute
+	directUDPBuf       = 16 << 10
+	directUDPMaxSess   = 256
+	directMemoryLimit  = 36 << 20
+	directFallbackMTU  = 1280
+)
+
+var (
+	directMu     sync.Mutex
+	directSet    *prefixSet   // nil = выключено
+	directEngine *splitEngine // nil до первого wgTurnOn со включённым разделением
+)
+
+// wgSetDirectSplit: путь к файлу со списком (CIDR построчно). Возвращает число диапазонов,
+// 0 при выключении, -1 если файл не прочитан или пуст (разделение тогда выключено — весь
+// трафик идёт в туннель).
+//
+//export wgSetDirectSplit
+func wgSetDirectSplit(listPath *C.char, enabled int32) int32 {
+	path := C.GoString(listPath)
+	if enabled == 0 {
+		setDirectSet(nil)
+		return 0
+	}
+	data, err := readLimited(path, directListMaxBytes)
+	if err != nil {
+		setDirectSet(nil)
+		return -1
+	}
+	set, _ := parsePrefixSet(string(data))
+	if set.size() == 0 {
+		setDirectSet(nil)
+		return -1
+	}
+	setDirectSet(set)
+	return int32(set.size())
+}
+
+func readLimited(path string, limit int64) ([]byte, error) {
+	f, err := os.Open(path)
+	if err != nil {
+		return nil, err
+	}
+	defer f.Close()
+	data, err := io.ReadAll(io.LimitReader(f, limit+1))
+	if err != nil {
+		return nil, err
+	}
+	if int64(len(data)) > limit {
+		return nil, errors.New("direct list too large")
+	}
+	return data, nil
+}
+
+func setDirectSet(set *prefixSet) {
+	directMu.Lock()
+	directSet = set
+	engine := directEngine
+	if set == nil {
+		directEngine = nil
+	}
+	directMu.Unlock()
+	if engine == nil {
+		return
+	}
+	if set == nil {
+		engine.shutdown()
+		return
+	}
+	engine.set.Store(set)
+}
+
+// wgDirectSplitStats: счётчики для строки `Tribe stats` (вызывающий освобождает строку).
+//
+//export wgDirectSplitStats
+func wgDirectSplitStats() *C.char {
+	directMu.Lock()
+	engine := directEngine
+	directMu.Unlock()
+	if engine == nil {
+		return C.CString("off")
+	}
+	return C.CString(engine.statsLine())
+}
+
+// wrapDirectSplitIfEnabled: точка входа из wgTurnOn (// AVPN в api-apple.go).
+func wrapDirectSplitIfEnabled(inner tun.Device, logf func(format string, args ...interface{})) tun.Device {
+	directMu.Lock()
+	set := directSet
+	engine := directEngine
+	directMu.Unlock()
+	if set == nil {
+		return inner
+	}
+	mtu, err := inner.MTU()
+	if err != nil || mtu < directFallbackMTU {
+		mtu = directFallbackMTU
+	}
+	if engine == nil {
+		engine = newSplitEngine(set, uint32(mtu))
+		// Мягкий предел кучи Go: расширение живёт в 50 МБ, предел заставляет сборщик работать
+		// чаще возле границы, а не расти до неё. Чужой предел (xray) не трогаем.
+		if debug.SetMemoryLimit(-1) > directMemoryLimit {
+			debug.SetMemoryLimit(directMemoryLimit)
+		}
+		directMu.Lock()
+		directEngine = engine
+		directMu.Unlock()
+	}
+	w := &splitTun{inner: inner, engine: engine}
+	engine.attach(inner)
+	if logf != nil {
+		logf("AVPN directsplit: userspace split enabled (%d ranges, mtu %d)", set.size(), mtu)
+	}
+	return w
+}
+
+// ── движок ────────────────────────────────────────────────────────────────────────────────────
+
+type splitStats struct {
+	tcpOpen, tcpTotal, tcpFail atomic.Int64
+	udpOpen, udpTotal          atomic.Int64
+	bytesUp, bytesDown         atomic.Int64
+}
+
+type splitEngine struct {
+	set    atomic.Pointer[prefixSet]
+	st     *stack.Stack
+	ep     *channel.Endpoint
+	ctx    context.Context
+	cancel context.CancelFunc
+	stats  splitStats
+
+	outMu sync.Mutex // текущая обёртка TUN для пакетов от стека к системе
+	out   tun.Device
+
+	udpMu   sync.Mutex
+	udpSess map[netip.AddrPort]*udpSession
+
+	// Швы для тестов: в бою обычные сокеты расширения и тождественное отображение адресов.
+	dialTCP   func(ctx context.Context, dst netip.AddrPort) (net.Conn, error)
+	listenUDP func(v4 bool) (*net.UDPConn, error)
+	mapOut    func(dst netip.AddrPort) netip.AddrPort
+	mapIn     func(from netip.AddrPort) netip.AddrPort
+}
+
+func newSplitEngine(set *prefixSet, mtu uint32) *splitEngine {
+	e := &splitEngine{udpSess: make(map[netip.AddrPort]*udpSession)}
+	e.set.Store(set)
+	e.ctx, e.cancel = context.WithCancel(context.Background())
+	e.dialTCP = func(ctx context.Context, dst netip.AddrPort) (net.Conn, error) {
+		network := "tcp6"
+		if dst.Addr().Is4() {
+			network = "tcp4"
+		}
+		// KeepAlive -1: своих проб не шлём — соединение ведёт себя как прямое.
+		d := net.Dialer{Timeout: directDialTimeout, KeepAlive: -1}
+		return d.DialContext(ctx, network, dst.String())
+	}
+	e.listenUDP = func(v4 bool) (*net.UDPConn, error) {
+		if v4 {
+			return net.ListenUDP("udp4", nil)
+		}
+		return net.ListenUDP("udp6", nil)
+	}
+	e.mapOut = func(dst netip.AddrPort) netip.AddrPort { return dst }
+	e.mapIn = func(from netip.AddrPort) netip.AddrPort { return from }
+
+	e.st = stack.New(stack.Options{
+		NetworkProtocols:   []stack.NetworkProtocolFactory{ipv4.NewProtocol, ipv6.NewProtocol},
+		TransportProtocols: []stack.TransportProtocolFactory{tcp.NewProtocol, udp.NewProtocol},
+	})
+	sack := tcpip.TCPSACKEnabled(true)
+	e.st.SetTransportProtocolOption(tcp.ProtocolNumber, &sack)
+	moderate := tcpip.TCPModerateReceiveBufferOption(true)
+	e.st.SetTransportProtocolOption(tcp.ProtocolNumber, &moderate)
+	// Буферы меньше умолчаний gVisor (1 МиБ): «сеть» между ядром iOS и стеком — память процесса,
+	// большие окна ничего не дают, а расширение ограничено 50 МБ. Потолок на соединение —
+	// 256 КиБ в каждую сторону: два десятка одновременно загруженных соединений остаются в 10 МБ.
+	rcv := tcpip.TCPReceiveBufferSizeRangeOption{Min: 4 << 10, Default: 64 << 10, Max: 256 << 10}
+	e.st.SetTransportProtocolOption(tcp.ProtocolNumber, &rcv)
+	snd := tcpip.TCPSendBufferSizeRangeOption{Min: 4 << 10, Default: 64 << 10, Max: 256 << 10}
+	e.st.SetTransportProtocolOption(tcp.ProtocolNumber, &snd)
+
+	e.ep = channel.New(directQueueDepth, mtu, "")
+	e.st.CreateNIC(directNICID, e.ep)
+	// Адреса назначения чужие: принимаем любой и отвечаем от его имени.
+	e.st.SetPromiscuousMode(directNICID, true)
+	e.st.SetSpoofing(directNICID, true)
+	e.st.SetRouteTable([]tcpip.Route{
+		{Destination: header.IPv4EmptySubnet, NIC: directNICID},
+		{Destination: header.IPv6EmptySubnet, NIC: directNICID},
+	})
+	e.st.SetTransportProtocolHandler(tcp.ProtocolNumber,
+		tcp.NewForwarder(e.st, 0, directTCPMaxFlows, e.handleTCP).HandlePacket)
+	e.st.SetTransportProtocolHandler(udp.ProtocolNumber,
+		udp.NewForwarder(e.st, e.handleUDP).HandlePacket)
+	go e.pumpToSystem()
+	return e
+}
+
+func (e *splitEngine) attach(out tun.Device) {
+	e.outMu.Lock()
+	e.out = out
+	e.outMu.Unlock()
+}
+
+func (e *splitEngine) detach(out tun.Device) {
+	e.outMu.Lock()
+	if e.out == out {
+		e.out = nil
+	}
+	e.outMu.Unlock()
+}
+
+func (e *splitEngine) shutdown() {
+	e.cancel()
+	e.udpMu.Lock()
+	sessions := make([]*udpSession, 0, len(e.udpSess))
+	for _, s := range e.udpSess {
+		sessions = append(sessions, s)
+	}
+	e.udpMu.Unlock()
+	for _, s := range sessions {
+		s.close()
+	}
+	e.ep.Close()
+	go e.st.Close()
+}
+
+func (e *splitEngine) statsLine() string {
+	s := &e.stats
+	return fmt.Sprintf("tcp=%d/%d fail=%d udp=%d/%d up=%d down=%d",
+		s.tcpOpen.Load(), s.tcpTotal.Load(), s.tcpFail.Load(),
+		s.udpOpen.Load(), s.udpTotal.Load(), s.bytesUp.Load(), s.bytesDown.Load())
+}
+
+// inject: пакет приложения — в стек (стек забирает копию).
+func (e *splitEngine) inject(proto tcpip.NetworkProtocolNumber, pkt []byte) {
+	pkb := stack.NewPacketBuffer(stack.PacketBufferOptions{Payload: buffer.MakeWithData(pkt)})
+	e.ep.InjectInbound(proto, pkb)
+	pkb.DecRef()
+}
+
+// pumpToSystem: пакеты стека — приложению через TUN. Один читатель, один буфер: Write у TUN
+// синхронный. Пока устройство перезапускается (обёртки нет), пакеты теряются — TCP их повторит.
+func (e *splitEngine) pumpToSystem() {
+	const offset = 4 // darwin utun: 4 байта семейства перед пакетом, их заполняет сам TUN
+	buf := make([]byte, offset+65535)
+	for {
+		pkb := e.ep.ReadContext(e.ctx)
+		if pkb == nil {
+			return
+		}
+		view := pkb.ToView()
+		pkb.DecRef()
+		n := copy(buf[offset:], view.AsSlice())
+		view.Release()
+		e.outMu.Lock()
+		out := e.out
+		e.outMu.Unlock()
+		if out == nil {
+			continue
+		}
+		out.Write([][]byte{buf[:offset+n]}, offset)
+	}
+}
+
+func addrPortOf(a tcpip.Address, port uint16) netip.AddrPort {
+	if a.Len() == 4 {
+		return netip.AddrPortFrom(netip.AddrFrom4(a.As4()), port)
+	}
+	return netip.AddrPortFrom(netip.AddrFrom16(a.As16()), port)
+}
+
+// ── TCP ───────────────────────────────────────────────────────────────────────────────────────
+
+var tcpBufPool = sync.Pool{New: func() any { b := make([]byte, directTCPBuf); return &b }}
+
+// handleTCP: SYN приложения к прямому адресу. Сначала наружное соединение, потом ответ
+// приложению: отказ снаружи приложение видит как обычный отказ (RST), а не как зависание.
+func (e *splitEngine) handleTCP(r *tcp.ForwarderRequest) {
+	id := r.ID()
+	dst := addrPortOf(id.LocalAddress, id.LocalPort)
+	e.stats.tcpTotal.Add(1)
+	if e.stats.tcpOpen.Load() >= directTCPMaxFlows {
+		e.stats.tcpFail.Add(1)
+		r.Complete(true)
+		return
+	}
+	ctx, cancel := context.WithTimeout(e.ctx, directDialTimeout)
+	remote, err := e.dialTCP(ctx, e.mapOut(dst))
+	cancel()
+	if err != nil {
+		e.stats.tcpFail.Add(1)
+		r.Complete(true)
+		return
+	}
+	var wq waiter.Queue
+	ep, terr := r.CreateEndpoint(&wq)
+	r.Complete(false)
+	if terr != nil {
+		e.stats.tcpFail.Add(1)
+		remote.Close()
+		return
+	}
+	// Приложение исчезло без FIN — соединение не висит вечно.
+	ep.SocketOptions().SetKeepAlive(true)
+	idle := tcpip.KeepaliveIdleOption(10 * time.Minute)
+	ep.SetSockOpt(&idle)
+	local := gonet.NewTCPConn(&wq, ep)
+	e.stats.tcpOpen.Add(1)
+	e.relayTCP(local, ep, &wq, remote)
+	e.stats.tcpOpen.Add(-1)
+}
+
+type closeWriter interface{ CloseWrite() error }
+
+func (e *splitEngine) relayTCP(local *gonet.TCPConn, ep tcpip.Endpoint, wq *waiter.Queue, remote net.Conn) {
+	type result struct {
+		up  bool
+		err error
+	}
+	done := make(chan result, 2)
+	stop := make(chan struct{})
+	var last atomic.Int64 // время последнего байта в любую сторону
+	last.Store(time.Now().UnixNano())
+
+	// приложение -> сеть: буфер берём только когда есть что читать (простой не держит память)
+	go func() {
+		entry, notify := waiter.NewChannelEntry(waiter.ReadableEvents | waiter.EventHUp | waiter.EventErr)
+		wq.EventRegister(&entry)
+		defer wq.EventUnregister(&entry)
+		for {
+			bp := tcpBufPool.Get().(*[]byte)
+			w := tcpip.SliceWriter(*bp)
+			res, rerr := ep.Read(&w, tcpip.ReadOptions{})
+			if rerr == nil {
+				_, werr := remote.Write((*bp)[:res.Count])
+				tcpBufPool.Put(bp)
+				if werr != nil {
+					done <- result{true, werr}
+					return
+				}
+				e.stats.bytesUp.Add(int64(res.Count))
+				last.Store(time.Now().UnixNano())
+				continue
+			}
+			tcpBufPool.Put(bp)
+			if _, ok := rerr.(*tcpip.ErrWouldBlock); ok {
+				select {
+				case <-notify:
+					continue
+				case <-stop:
+					return
+				case <-e.ctx.Done():
+					done <- result{true, context.Canceled}
+					return
+				}
+			}
+			if _, ok := rerr.(*tcpip.ErrClosedForReceive); ok {
+				if cw, ok := remote.(closeWriter); ok {
+					cw.CloseWrite()
+				}
+				done <- result{true, nil}
+				return
+			}
+			done <- result{true, errors.New(rerr.String())}
+			return
+		}
+	}()
+
+	// сеть -> приложение
+	go func() {
+		bp := tcpBufPool.Get().(*[]byte)
+		defer tcpBufPool.Put(bp)
+		for {
+			n, rerr := remote.Read(*bp)
+			if n > 0 {
+				if _, werr := local.Write((*bp)[:n]); werr != nil {
+					done <- result{false, werr}
+					return
+				}
+				e.stats.bytesDown.Add(int64(n))
+				last.Store(time.Now().UnixNano())
+			}
+			if rerr != nil {
+				if rerr == io.EOF {
+					local.CloseWrite()
+					done <- result{false, nil}
+				} else {
+					done <- result{false, rerr}
+				}
+				return
+			}
+		}
+	}()
+
+	first := <-done
+	if first.err == nil {
+		// Одна сторона закрыла запись штатно — вторая дорабатывает, пока по ней идут данные.
+		timer := time.NewTimer(directHalfCloseTTL)
+	wait:
+		for {
+			select {
+			case second := <-done:
+				if second.err != nil && !second.up {
+					abortTCP(ep)
+				}
+				break wait
+			case <-timer.C:
+				idle := time.Duration(time.Now().UnixNano() - last.Load())
+				if idle >= directHalfCloseTTL {
+					break wait
+				}
+				timer.Reset(directHalfCloseTTL - idle)
+			case <-e.ctx.Done():
+				break wait
+			}
+		}
+		timer.Stop()
+	} else if !first.up {
+		// Сеть оборвала соединение — приложению RST, а не «чистое» закрытие.
+		abortTCP(ep)
+	}
+	close(stop)
+	remote.Close()
+	local.Close()
+}
+
+func abortTCP(ep tcpip.Endpoint) {
+	ep.SocketOptions().SetLinger(tcpip.LingerOption{Enabled: true, Timeout: 0})
+}
+
+// ── UDP ───────────────────────────────────────────────────────────────────────────────────────
+
+// udpSession: один наружный сокет на порт приложения (как NAT с отображением, не зависящим от
+// адреса назначения). flows: адрес сервера -> конечная точка стека, от имени которой приложению
+// уходят ответы этого сервера.
+type udpSession struct {
+	engine *splitEngine
+	key    netip.AddrPort
+	out    *net.UDPConn
+	last   atomic.Int64
+
+	mu     sync.Mutex
+	flows  map[netip.AddrPort]*gonet.UDPConn
+	closed bool
+}
+
+func (s *udpSession) touch() { s.last.Store(time.Now().UnixNano()) }
+
+func (s *udpSession) idleFor() time.Duration {
+	return time.Duration(time.Now().UnixNano() - s.last.Load())
+}
+
+func (s *udpSession) close() {
+	s.mu.Lock()
+	if s.closed {
+		s.mu.Unlock()
+		return
+	}
+	s.closed = true
+	flows := s.flows
+	s.flows = nil
+	s.mu.Unlock()
+	s.engine.udpMu.Lock()
+	if s.engine.udpSess[s.key] == s {
+		delete(s.engine.udpSess, s.key)
+	}
+	s.engine.udpMu.Unlock()
+	s.out.Close()
+	for _, c := range flows {
+		c.Close()
+	}
+	s.engine.stats.udpOpen.Add(-1)
+}
+
+// removeFlow: поток закрыт; сессия без потоков закрывается целиком.
+func (s *udpSession) removeFlow(dst netip.AddrPort, c *gonet.UDPConn) {
+	s.mu.Lock()
+	empty := false
+	if !s.closed && s.flows[dst] == c {
+		delete(s.flows, dst)
+		empty = len(s.flows) == 0
+	}
+	s.mu.Unlock()
+	c.Close()
+	if empty {
+		s.close()
+	}
+}
+
+func (e *splitEngine) udpSessionFor(src netip.AddrPort) *udpSession {
+	e.udpMu.Lock()
+	defer e.udpMu.Unlock()
+	if s := e.udpSess[src]; s != nil {
+		return s
+	}
+	if len(e.udpSess) >= directUDPMaxSess {
+		// Место освобождает самая давняя по активности сессия.
+		var oldest *udpSession
+		for _, s := range e.udpSess {
+			if oldest == nil || s.last.Load() < oldest.last.Load() {
+				oldest = s
+			}
+		}
+		if oldest != nil {
+			delete(e.udpSess, oldest.key)
+			go oldest.close()
+		}
+	}
+	out, err := e.listenUDP(src.Addr().Is4())
+	if err != nil {
+		return nil
+	}
+	s := &udpSession{engine: e, key: src, out: out, flows: make(map[netip.AddrPort]*gonet.UDPConn)}
+	s.touch()
+	e.udpSess[src] = s
+	e.stats.udpOpen.Add(1)
+	e.stats.udpTotal.Add(1)
+	go s.pumpDown()
+	return s
+}
+
+// handleUDP вызывается стеком синхронно: конечную точку создаём сразу (она забирает первый
+// датаграмм), ввод-вывод — в горутинах.
+func (e *splitEngine) handleUDP(r *udp.ForwarderRequest) bool {
+	id := r.ID()
+	src := addrPortOf(id.RemoteAddress, id.RemotePort)
+	dst := addrPortOf(id.LocalAddress, id.LocalPort)
+	var wq waiter.Queue
+	ep, terr := r.CreateEndpoint(&wq)
+	if terr != nil {
+		return true
+	}
+	local := gonet.NewUDPConn(&wq, ep)
+	sess := e.udpSessionFor(src)
+	if sess == nil {
+		local.Close()
+		return true
+	}
+	sess.mu.Lock()
+	if sess.closed {
+		sess.mu.Unlock()
+		local.Close()
+		return true
+	}
+	old := sess.flows[dst]
+	sess.flows[dst] = local
+	sess.mu.Unlock()
+	if old != nil {
+		old.Close()
+	}
+	go sess.pumpUp(dst, local, ep, &wq)
+	return true
+}
+
+var udpBufPool = sync.Pool{New: func() any { b := make([]byte, 65535); return &b }}
+
+// pumpUp: приложение -> сервер. Буфер на полный датаграмм берётся только на время чтения.
+func (s *udpSession) pumpUp(dst netip.AddrPort, local *gonet.UDPConn, ep tcpip.Endpoint, wq *waiter.Queue) {
+	defer s.removeFlow(dst, local)
+	entry, notify := waiter.NewChannelEntry(waiter.ReadableEvents | waiter.EventHUp | waiter.EventErr)
+	wq.EventRegister(&entry)
+	defer wq.EventUnregister(&entry)
+	target := net.UDPAddrFromAddrPort(s.engine.mapOut(dst))
+	timer := time.NewTimer(directUDPIdle)
+	defer timer.Stop()
+	for {
+		bp := udpBufPool.Get().(*[]byte)
+		w := tcpip.SliceWriter(*bp)
+		res, rerr := ep.Read(&w, tcpip.ReadOptions{})
+		if rerr == nil {
+			_, werr := s.out.WriteToUDP((*bp)[:res.Count], target)
+			udpBufPool.Put(bp)
+			if werr != nil {
+				return
+			}
+			s.touch()
+			s.engine.stats.bytesUp.Add(int64(res.Count))
+			continue
+		}
+		udpBufPool.Put(bp)
+		if _, ok := rerr.(*tcpip.ErrWouldBlock); !ok {
+			return
+		}
+		select {
+		case <-notify:
+		case <-timer.C:
+			if s.idleFor() >= directUDPIdle {
+				return
+			}
+			timer.Reset(directUDPIdle)
+		case <-s.engine.ctx.Done():
+			return
+		}
+	}
+}
+
+// pumpDown: сервер -> приложение. Ответ принимается только от адреса, на который приложение
+// уже писало с этого порта.
+func (s *udpSession) pumpDown() {
+	defer s.close()
+	buf := make([]byte, directUDPBuf)
+	for {
+		n, from, err := s.out.ReadFromUDPAddrPort(buf)
+		if err != nil {
+			return
+		}
+		from = netip.AddrPortFrom(from.Addr().Unmap(), from.Port())
+		remote := s.engine.mapIn(from)
+		s.mu.Lock()
+		local := s.flows[remote]
+		s.mu.Unlock()
+		if local == nil {
+			continue
+		}
+		if _, werr := local.Write(buf[:n]); werr != nil {
+			continue
+		}
+		s.touch()
+		s.engine.stats.bytesDown.Add(int64(n))
+	}
+}
+
+// ── tun.Device ────────────────────────────────────────────────────────────────────────────────
+
+// splitTun стоит между TUN (или обёрткой dnsfwd) и устройством WireGuard.
+type splitTun struct {
+	inner  tun.Device
+	engine *splitEngine
+}
+
+func (t *splitTun) Read(bufs [][]byte, sizes []int, offset int) (int, error) {
+	for {
+		n, err := t.inner.Read(bufs, sizes, offset)
+		if err != nil {
+			return n, err
+		}
+		set := t.engine.set.Load()
+		kept := 0
+		for i := 0; i < n; i++ {
+			pkt := bufs[i][offset : offset+sizes[i]]
+			if proto := set.directProto(pkt); proto != 0 {
+				t.engine.inject(proto, pkt)
+				continue
+			}
+			if kept != i {
+				copy(bufs[kept][offset:], pkt)
+				sizes[kept] = sizes[i]
+			}
+			kept++
+		}
+		if kept > 0 {
+			return kept, nil
+		}
+	}
+}
+
+func (t *splitTun) Write(bufs [][]byte, offset int) (int, error) { return t.inner.Write(bufs, offset) }
+func (t *splitTun) MTU() (int, error)                            { return t.inner.MTU() }
+func (t *splitTun) Name() (string, error)                        { return t.inner.Name() }
+func (t *splitTun) File() *os.File                               { return t.inner.File() }
+func (t *splitTun) Events() <-chan tun.Event                     { return t.inner.Events() }
+func (t *splitTun) BatchSize() int                               { return t.inner.BatchSize() }
+func (t *splitTun) Close() error {
+	t.engine.detach(t.inner)
+	return t.inner.Close()
+}
