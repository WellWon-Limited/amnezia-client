+/* AVPN (Tribe): тесты разделения в расширении (directsplit.go). «Телефон» — второй стек gVisor
+ * с адресом клиента туннеля; между ним и обёрткой стоит поддельный TUN. Наружные серверы —
+ * обычные сокеты на 127.0.0.1 / ::1, адреса назначения переводятся швами mapOut/mapIn.
+ */
+package main
+
+import (
+	"bytes"
+	"context"
+	"crypto/rand"
+	"io"
+	"net"
+	"net/netip"
+	"os"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/amnezia-vpn/amneziawg-go/v3/tun"
+	"gvisor.dev/gvisor/pkg/buffer"
+	"gvisor.dev/gvisor/pkg/tcpip"
+	"gvisor.dev/gvisor/pkg/tcpip/adapters/gonet"
+	"gvisor.dev/gvisor/pkg/tcpip/header"
+	"gvisor.dev/gvisor/pkg/tcpip/link/channel"
+	"gvisor.dev/gvisor/pkg/tcpip/network/ipv4"
+	"gvisor.dev/gvisor/pkg/tcpip/network/ipv6"
+	"gvisor.dev/gvisor/pkg/tcpip/stack"
+	"gvisor.dev/gvisor/pkg/tcpip/transport/tcp"
+	"gvisor.dev/gvisor/pkg/tcpip/transport/udp"
+)
+
+const testMTU = 1420
+
+var (
+	phoneV4 = netip.MustParseAddr("10.8.0.2")
+	phoneV6 = netip.MustParseAddr("fd00::2")
+)
+
+// ── телефон ───────────────────────────────────────────────────────────────────────────────────
+
+type phone struct {
+	st *stack.Stack
+	ep *channel.Endpoint
+}
+
+func newPhone(t *testing.T) *phone {
+	t.Helper()
+	st := stack.New(stack.Options{
+		NetworkProtocols:   []stack.NetworkProtocolFactory{ipv4.NewProtocol, ipv6.NewProtocol},
+		TransportProtocols: []stack.TransportProtocolFactory{tcp.NewProtocol, udp.NewProtocol},
+	})
+	ep := channel.New(1024, testMTU, "")
+	if err := st.CreateNIC(1, ep); err != nil {
+		t.Fatalf("phone nic: %v", err)
+	}
+	for _, a := range []netip.Addr{phoneV4, phoneV6} {
+		proto := tcpip.NetworkProtocolNumber(ipv4.ProtocolNumber)
+		addr := tcpip.AddrFromSlice(a.AsSlice())
+		if a.Is6() {
+			proto = ipv6.ProtocolNumber
+		}
+		if err := st.AddProtocolAddress(1, tcpip.ProtocolAddress{Protocol: proto,
+			AddressWithPrefix: addr.WithPrefix()}, stack.AddressProperties{}); err != nil {
+			t.Fatalf("phone addr: %v", err)
+		}
+	}
+	st.SetRouteTable([]tcpip.Route{
+		{Destination: header.IPv4EmptySubnet, NIC: 1},
+		{Destination: header.IPv6EmptySubnet, NIC: 1},
+	})
+	t.Cleanup(func() { ep.Close(); go st.Close() })
+	return &phone{st: st, ep: ep}
+}
+
+func fullAddr(ap netip.AddrPort) (tcpip.FullAddress, tcpip.NetworkProtocolNumber) {
+	proto := tcpip.NetworkProtocolNumber(ipv4.ProtocolNumber)
+	if ap.Addr().Is6() {
+		proto = ipv6.ProtocolNumber
+	}
+	return tcpip.FullAddress{Addr: tcpip.AddrFromSlice(ap.Addr().AsSlice()), Port: ap.Port()}, proto
+}
+
+func (p *phone) dialTCP(t *testing.T, dst string, timeout time.Duration) (*gonet.TCPConn, error) {
+	t.Helper()
+	addr, proto := fullAddr(netip.MustParseAddrPort(dst))
+	ctx, cancel := context.WithTimeout(context.Background(), timeout)
+	defer cancel()
+	return gonet.DialContextTCP(ctx, p.st, addr, proto)
+}
+
+// ── поддельный TUN ────────────────────────────────────────────────────────────────────────────
+
+type fakeTun struct {
+	ph     *phone
+	ctx    context.Context
+	cancel context.CancelFunc
+	events chan tun.Event
+}
+
+func newFakeTun(ph *phone) *fakeTun {
+	ctx, cancel := context.WithCancel(context.Background())
+	return &fakeTun{ph: ph, ctx: ctx, cancel: cancel, events: make(chan tun.Event)}
+}
+
+func (f *fakeTun) Read(bufs [][]byte, sizes []int, offset int) (int, error) {
+	pkb := f.ph.ep.ReadContext(f.ctx)
+	if pkb == nil {
+		return 0, os.ErrClosed
+	}
+	view := pkb.ToView()
+	pkb.DecRef()
+	sizes[0] = copy(bufs[0][offset:], view.AsSlice())
+	view.Release()
+	return 1, nil
+}
+
+func (f *fakeTun) Write(bufs [][]byte, offset int) (int, error) {
+	for _, b := range bufs {
+		pkt := b[offset:]
+		proto := tcpip.NetworkProtocolNumber(ipv4.ProtocolNumber)
+		if pkt[0]>>4 == 6 {
+			proto = ipv6.ProtocolNumber
+		}
+		pkb := stack.NewPacketBuffer(stack.PacketBufferOptions{Payload: buffer.MakeWithData(pkt)})
+		f.ph.ep.InjectInbound(proto, pkb)
+		pkb.DecRef()
+	}
+	return len(bufs), nil
+}
+
+func (f *fakeTun) MTU() (int, error)        { return testMTU, nil }
+func (f *fakeTun) Name() (string, error)    { return "fake", nil }
+func (f *fakeTun) File() *os.File           { return nil }
+func (f *fakeTun) Events() <-chan tun.Event { return f.events }
+func (f *fakeTun) BatchSize() int           { return 1 }
+func (f *fakeTun) Close() error             { f.cancel(); return nil }
+
+// ── стенд ─────────────────────────────────────────────────────────────────────────────────────
+
+type bench struct {
+	ph       *phone
+	engine   *splitEngine
+	wrapped  tun.Device
+	tunneled chan []byte // пакеты, которые обёртка отдала «устройству WireGuard»
+
+	mu   sync.Mutex
+	out  map[netip.AddrPort]netip.AddrPort // адрес назначения -> локальный сервер
+	back map[netip.AddrPort]netip.AddrPort
+}
+
+const testPrefixes = "# test\n5.255.255.0/24\n77.88.0.0/18\n2a02:6b8::/32\nnot-a-prefix\n"
+
+func newBench(t *testing.T) *bench {
+	t.Helper()
+	set, bad := parsePrefixSet(testPrefixes)
+	if bad != 1 {
+		t.Fatalf("bad lines = %d, want 1", bad)
+	}
+	b := &bench{ph: newPhone(t), tunneled: make(chan []byte, 256),
+		out: map[netip.AddrPort]netip.AddrPort{}, back: map[netip.AddrPort]netip.AddrPort{}}
+	b.engine = newSplitEngine(set, testMTU)
+	b.engine.mapOut = func(dst netip.AddrPort) netip.AddrPort {
+		b.mu.Lock()
+		defer b.mu.Unlock()
+		if m, ok := b.out[dst]; ok {
+			return m
+		}
+		return netip.MustParseAddrPort("127.0.0.1:1") // закрытый порт
+	}
+	b.engine.mapIn = func(from netip.AddrPort) netip.AddrPort {
+		b.mu.Lock()
+		defer b.mu.Unlock()
+		return b.back[from]
+	}
+	t.Cleanup(b.engine.shutdown)
+	b.attach(newFakeTun(b.ph))
+	return b
+}
+
+// attach: новая обёртка над новым TUN + читатель, изображающий устройство WireGuard.
+func (b *bench) attach(ft *fakeTun) {
+	w := &splitTun{inner: ft, engine: b.engine}
+	b.engine.attach(ft)
+	b.wrapped = w
+	go func() {
+		bufs := [][]byte{make([]byte, 2048)}
+		sizes := make([]int, 1)
+		for {
+			n, err := w.Read(bufs, sizes, 16)
+			if err != nil {
+				return
+			}
+			for i := 0; i < n; i++ {
+				cp := append([]byte(nil), bufs[i][16:16+sizes[i]]...)
+				select {
+				case b.tunneled <- cp:
+				default:
+				}
+			}
+		}
+	}()
+}
+
+func (b *bench) route(dst string, server net.Addr) {
+	d := netip.MustParseAddrPort(dst)
+	s := netip.MustParseAddrPort(server.String())
+	s = netip.AddrPortFrom(s.Addr().Unmap(), s.Port())
+	b.mu.Lock()
+	b.out[d] = s
+	b.back[s] = d
+	b.mu.Unlock()
+}
+
+func (b *bench) expectNothingTunneled(t *testing.T, dstPrefix string) {
+	t.Helper()
+	p := netip.MustParsePrefix(dstPrefix)
+	for {
+		select {
+		case pkt := <-b.tunneled:
+			if dst, ok := packetDst(pkt); ok && p.Contains(dst) {
+				t.Fatalf("packet to direct destination %v leaked into the tunnel", dst)
+			}
+		default:
+			return
+		}
+	}
+}
+
+func packetDst(pkt []byte) (netip.Addr, bool) {
+	switch {
+	case len(pkt) >= 20 && pkt[0]>>4 == 4:
+		return netip.AddrFrom4([4]byte(pkt[16:20])), true
+	case len(pkt) >= 40 && pkt[0]>>4 == 6:
+		return netip.AddrFrom16([16]byte(pkt[24:40])), true
+	}
+	return netip.Addr{}, false
+}
+
+func echoTCP(t *testing.T, network, addr string) net.Listener {
+	t.Helper()
+	ln, err := net.Listen(network, addr)
+	if err != nil {
+		t.Skipf("listen %s %s: %v", network, addr, err)
+	}
+	t.Cleanup(func() { ln.Close() })
+	go func() {
+		for {
+			c, err := ln.Accept()
+			if err != nil {
+				return
+			}
+			go func() {
+				io.Copy(c, c)
+				c.(*net.TCPConn).CloseWrite()
+				time.Sleep(50 * time.Millisecond)
+				c.Close()
+			}()
+		}
+	}()
+	return ln
+}
+
+type udpEcho struct {
+	conn *net.UDPConn
+	mu   sync.Mutex
+	from []netip.AddrPort
+}
+
+func echoUDP(t *testing.T) *udpEcho {
+	t.Helper()
+	c, err := net.ListenUDP("udp4", &net.UDPAddr{IP: net.IPv4(127, 0, 0, 1)})
+	if err != nil {
+		t.Fatalf("udp listen: %v", err)
+	}
+	e := &udpEcho{conn: c}
+	t.Cleanup(func() { c.Close() })
+	go func() {
+		buf := make([]byte, 65535)
+		for {
+			n, from, err := c.ReadFromUDPAddrPort(buf)
+			if err != nil {
+				return
+			}
+			e.mu.Lock()
+			e.from = append(e.from, from)
+			e.mu.Unlock()
+			c.WriteToUDPAddrPort(buf[:n], from)
+		}
+	}()
+	return e
+}
