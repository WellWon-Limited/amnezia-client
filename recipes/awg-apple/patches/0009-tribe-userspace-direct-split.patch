+func rawIPv4(proto byte, dst string) []byte {
+	p := make([]byte, 40)
+	p[0] = 0x45
+	p[9] = proto
+	d := netip.MustParseAddr(dst).As4()
+	copy(p[16:20], d[:])
+	return p
+}
+
+func rawIPv6(next byte, dst string) []byte {
+	p := make([]byte, 60)
+	p[0] = 0x60
+	p[6] = next
+	d := netip.MustParseAddr(dst).As16()
+	copy(p[24:40], d[:])
+	return p
+}
