+func TestForeignTrafficGoesToTunnel(t *testing.T) {
+	b := newBench(t)
+	go b.ph.dialTCP(t, "8.8.8.8:443", 300*time.Millisecond)
+	deadline := time.After(3 * time.Second)
+	for {
+		select {
+		case pkt := <-b.tunneled:
+			dst, ok := packetDst(pkt)
+			if ok && dst == netip.MustParseAddr("8.8.8.8") {
+				if pkt[9] != 6 {
+					t.Fatalf("unexpected protocol %d", pkt[9])
+				}
+				if b.engine.stats.tcpTotal.Load() != 0 {
+					t.Fatal("foreign destination reached the direct engine")
+				}
+				return
+			}
+		case <-deadline:
+			t.Fatal("SYN to a foreign destination did not reach the tunnel")
+		}
+	}
+}
