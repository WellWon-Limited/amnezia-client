+// Мягкий перезапуск туннеля: устройство закрывает TUN и открывает новый, прямое соединение
+// приложения при этом не рвётся.
+func TestDirectFlowSurvivesDeviceRestart(t *testing.T) {
+	b := newBench(t)
+	ln := echoTCP(t, "tcp4", "127.0.0.1:0")
+	b.route("5.255.255.12:443", ln.Addr())
+	c, err := b.ph.dialTCP(t, "5.255.255.12:443", 5*time.Second)
+	if err != nil {
+		t.Fatalf("dial: %v", err)
+	}
+	defer c.Close()
+	roundTrip := func(msg string) {
+		t.Helper()
+		if _, err := c.Write([]byte(msg)); err != nil {
+			t.Fatalf("write %q: %v", msg, err)
+		}
+		buf := make([]byte, len(msg))
+		c.SetReadDeadline(time.Now().Add(10 * time.Second))
+		if _, err := io.ReadFull(c, buf); err != nil || string(buf) != msg {
+			t.Fatalf("echo %q = %q, %v", msg, buf, err)
+		}
+	}
+	roundTrip("before")
+	b.wrapped.Close()
+	time.Sleep(100 * time.Millisecond)
+	b.attach(newFakeTun(b.ph))
+	roundTrip("after")
+	if got := b.engine.stats.tcpTotal.Load(); got != 1 {
+		t.Fatalf("flow was re-established (%d dials): it must survive the restart", got)
+	}
+}
