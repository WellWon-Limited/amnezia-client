+func TestDirectTCPRefusedFailsFast(t *testing.T) {
+	b := newBench(t) // маршрута нет -> шов ведёт на закрытый порт
+	start := time.Now()
+	c, err := b.ph.dialTCP(t, "5.255.255.11:443", 5*time.Second)
+	if err == nil {
+		c.Close()
+		t.Fatal("dial to a refusing destination succeeded")
+	}
+	if d := time.Since(start); d > 2*time.Second {
+		t.Fatalf("refusal took %v: the app must see a reset, not a hang", d)
+	}
+	if got := b.engine.stats.tcpFail.Load(); got != 1 {
+		t.Fatalf("tcpFail = %d, want 1", got)
+	}
+}
