+func TestDirectSplitToggle(t *testing.T) {
+	dir := t.TempDir()
+	path := dir + "/list.txt"
+	if err := os.WriteFile(path, []byte(testPrefixes), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	data, err := readLimited(path, directListMaxBytes)
+	if err != nil {
+		t.Fatalf("read list: %v", err)
+	}
+	set, _ := parsePrefixSet(string(data))
+	if set.size() != 3 {
+		t.Fatalf("ranges = %d, want 3", set.size())
+	}
+	if _, err := readLimited(dir+"/missing.txt", directListMaxBytes); err == nil {
+		t.Fatal("missing list must be an error")
+	}
+	if _, err := readLimited(path, 8); err == nil {
+		t.Fatal("oversized list must be an error")
+	}
+
+	ph := newPhone(t)
+	ft := newFakeTun(ph)
+	setDirectSet(nil)
+	if got := wrapDirectSplitIfEnabled(ft, nil); got != tun.Device(ft) {
+		t.Fatal("disabled split must not wrap the TUN")
+	}
+	setDirectSet(set)
+	w := wrapDirectSplitIfEnabled(ft, nil)
+	if _, ok := w.(*splitTun); !ok {
+		t.Fatal("enabled split must wrap the TUN")
+	}
+	directMu.Lock()
+	engine := directEngine
+	directMu.Unlock()
+	if engine == nil {
+		t.Fatal("engine not created")
+	}
+	// Повторный старт устройства берёт тот же движок.
+	if w2 := wrapDirectSplitIfEnabled(newFakeTun(ph), nil).(*splitTun); w2.engine != engine {
+		t.Fatal("device restart must reuse the engine")
+	}
+	setDirectSet(nil)
+	directMu.Lock()
+	gone := directEngine == nil
+	directMu.Unlock()
+	if !gone {
+		t.Fatal("disabling the split must drop the engine")
+	}
+	select {
+	case <-engine.ctx.Done():
+	case <-time.After(time.Second):
+		t.Fatal("engine not shut down")
+	}
+}
