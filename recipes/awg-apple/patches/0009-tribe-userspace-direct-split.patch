+func TestDirectPrefixSet(t *testing.T) {
+	set, bad := parsePrefixSet("10.0.0.0/8\n10.1.0.0/16\n192.168.1.0/24\n192.168.2.0/24\n1.2.3.4\n" +
+		"2001:db8::/32\n2001:db8:1::/48\n::1\n\n# c\njunk\n")
+	if bad != 1 {
+		t.Fatalf("bad = %d", bad)
+	}
+	if len(set.v4) != 4 || len(set.v6) != 2 {
+		t.Fatalf("ranges v4=%d v6=%d, want 4 and 2 (nested prefixes merged)", len(set.v4), len(set.v6))
+	}
+	in4 := func(s string) bool { a := netip.MustParseAddr(s).As4(); return set.contains4(be32(a[:])) }
+	in6 := func(s string) bool { a := netip.MustParseAddr(s).As16(); return set.contains6(u128From(a[:])) }
+	for addr, want := range map[string]bool{
+		"10.0.0.0": true, "10.255.255.255": true, "9.255.255.255": false, "11.0.0.0": false,
+		"192.168.1.255": true, "192.168.3.0": false, "192.168.0.255": false,
+		"1.2.3.4": true, "1.2.3.5": false, "0.0.0.0": false, "255.255.255.255": false,
+	} {
+		if in4(addr) != want {
+			t.Errorf("contains4(%s) = %v, want %v", addr, !want, want)
+		}
+	}
+	for addr, want := range map[string]bool{
+		"2001:db8::1": true, "2001:db8:ffff:ffff:ffff:ffff:ffff:ffff": true, "2001:db9::": false,
+		"2001:db7:ffff:ffff:ffff:ffff:ffff:ffff": false, "::1": true, "::2": false, "::": false,
+	} {
+		if in6(addr) != want {
+			t.Errorf("contains6(%s) = %v, want %v", addr, !want, want)
+		}
+	}
+}
