+    // MARK: - Tribe seamless roaming helpers (workQueue only)
+
+    private func notePathLost() {
+        guard self.pathLostAt == nil else { return }
+        self.pathLostAt = Date()
+        self.roamCounters.pathLost += 1
+    }
+
+    /// One coalesced rebind per burst of path events (Proton: 100 ms). Keeps the device handle,
+    /// keys and endpoint; `BindUpdate` reopens the UDP socket on the SAME local port and sends a
+    /// keepalive with the current keypair, so the server learns the new outer address without a
+    /// handshake. Also re-arms the stall watchdog so it does not double-bump the fresh socket.
+    private func scheduleRoamRebind() {
+        guard !self.roamRebindPending else { return }
+        self.roamRebindPending = true
+        let delay = max(0, self.roamingPolicy.rebindCoalesceSeconds)
+        self.workQueue.asyncAfter(deadline: .now() + delay) { [weak self] in
+            guard let self = self else { return }
+            self.roamRebindPending = false
+            guard case .started(let handle, let settingsGenerator) = self.state else { return }
+            let (wgConfig, resolutionResults) = settingsGenerator.endpointUapiConfiguration()
+            self.logEndpointResolutionResults(resolutionResults)
+
+            wgSetConfig(handle, wgConfig)
+            wgDisableSomeRoamingForBrokenMobileSemantics(handle)
+            wgBumpSockets(handle)
+            self.roamCounters.roamBumps += 1
+            self.rearmStallTracker(handle: handle)
+        }
+    }
+
+    private func schedulePause(after seconds: TimeInterval) {
+        guard self.pendingPauseWork == nil else { return }
+        let work = DispatchWorkItem { [weak self] in
+            guard let self = self else { return }
+            self.pendingPauseWork = nil
+            guard case .started(let handle, let settingsGenerator) = self.state, !self.lastPathSatisfiable else { return }
+            self.logHandler(.verbose, "Tribe roaming: still offline after \(Int(seconds))s, pausing backend (long-offline fallback).")
+            self.pauseBackend(handle: handle, settingsGenerator: settingsGenerator)
+        }
+        self.pendingPauseWork = work
+        self.workQueue.asyncAfter(deadline: .now() + seconds, execute: work)
+    }
+
+    private func cancelPendingPause() {
+        self.pendingPauseWork?.cancel()
+        self.pendingPauseWork = nil
+    }
+
+    private func pauseBackend(handle: Int32, settingsGenerator: PacketTunnelSettingsGenerator) {
+        self.stopStallWatchdog()
+        self.cancelPendingPause()
+        self.roamCounters.pauses += 1
+        self.state = .temporaryShutdown(settingsGenerator)
+        wgTurnOff(handle)
+    }
+
+    // Stall watchdog: same-SSID roams sometimes produce NO path event at all, and a NAT/AP switch
+    // can leave outbound flowing into a black hole. Every second we read the device's own
+    // counters; outbound growing while inbound (rx bytes, handshake) is frozen on a satisfied path
+    // escalates: bump (same port) -> listen_port=0 (new 5-tuple) -> hand over to the app engine.
+    private func startStallWatchdog() {
+        self.stopStallWatchdog()
+        guard self.roamingPolicy.stallProbeSeconds > 0 else { return }
+        let timer = DispatchSource.makeTimerSource(queue: self.workQueue)
+        timer.schedule(deadline: .now() + 1, repeating: 1.0, leeway: .milliseconds(200))
+        timer.setEventHandler { [weak self] in
+            self?.stallTick()
+        }
+        self.stallTimer = timer
+        self.stallTracker = nil
+        timer.resume()
+    }
+
+    private func stopStallWatchdog() {
+        self.stallTimer?.cancel()
+        self.stallTimer = nil
+        self.stallTracker = nil
+    }
+
+    private func currentStallSample(handle: Int32) -> TribeStallSample? {
+        guard let settings = wgGetConfig(handle) else { return nil }
+        let config = String(cString: settings)
+        free(settings)
+        // systemUptime does not advance while the device sleeps: sleep is not a stall.
+        return TribeRoaming.parseSample(uapi: config, at: ProcessInfo.processInfo.systemUptime)
+    }
+
+    private func rearmStallTracker(handle: Int32) {
+        guard self.stallTimer != nil, let sample = self.currentStallSample(handle: handle) else { return }
+        if self.stallTracker == nil {
+            self.stallTracker = TribeStallTracker(first: sample)
+        } else {
+            self.stallTracker?.rearm(sample)
+        }
+    }
+
+    private func permitRecovery(handle: Int32, freshPort: Bool) -> Bool {
+        guard self.lastPathSatisfiable, let sample = self.currentStallSample(handle: handle) else { return false }
+        self.recoveryBudget.observe(sample)
+        return self.recoveryBudget.permit(at: sample.at, freshPort: freshPort)
+    }
+
+    private func stallTick() {
+        guard case .started(let handle, _) = self.state,
+              let sample = self.currentStallSample(handle: handle) else { return }
+        if !self.everHadHandshake && sample.lastHandshakeSec > 0 {
+            self.everHadHandshake = true
+            self.logHandler(.verbose, "Observed first handshake at last_handshake_time_sec=\(sample.lastHandshakeSec)")
+        }
+        // The NE owns bounded no-first-handshake recovery even while the GUI is suspended.
+        self.recoveryBudget.observe(sample)
+        let idle = self.previousWatchdogSample.map { $0.txBytes == sample.txBytes && $0.rxBytes == sample.rxBytes } ?? false
+        self.previousWatchdogSample = sample
+        let interval: Double = (!self.lastPathSatisfiable || idle) ? 5 : 1
+        self.stallTimer?.schedule(deadline: .now() + interval, repeating: interval, leeway: .milliseconds(300))
+        guard var tracker = self.stallTracker else {
+            self.stallTracker = TribeStallTracker(first: sample)
+            return
+        }
+        let action = tracker.observe(sample, pathSatisfied: self.lastPathSatisfiable, policy: self.roamingPolicy)
+        self.stallTracker = tracker
+        switch action {
+        case .none:
+            break
+        case .bumpSockets:
+            guard self.permitRecovery(handle: handle, freshPort: false) else { return }
+            self.roamCounters.stallBumps += 1
+            self.logHandler(.verbose, "Tribe roaming: inbound stalled (tx=\(sample.txBytes) rx=\(sample.rxBytes)), bumping socket on the same port (\(self.roamCounters.summary))")
+            wgBumpSockets(handle)
+        case .rebindPort:
+            guard self.permitRecovery(handle: handle, freshPort: true) else { return }
+            self.roamCounters.stallRebinds += 1
+            self.logHandler(.verbose, "Tribe roaming: still stalled after bump, rebinding to a new local port (\(self.roamCounters.summary))")
+            wgSetConfig(handle, "listen_port=0\n")
+            wgDisableSomeRoamingForBrokenMobileSemantics(handle)
+        }
     }
 
