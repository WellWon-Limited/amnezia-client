+// Production passes no roots: the platform verifier must refuse a self-signed server.
+func TestTribeHTTPSystemRootsRefuseUnknownCA(t *testing.T) {
+	api := newTribeTestHTTPS(t, http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {}))
+	socks := newTribeTestSocks(t, "u", "p", map[string]string{"example.com": "127.0.0.1"})
+	out, _ := tribeTestDecode(t, tribeHTTPRequest{SocksAddr: socks.addr(), User: "u", Pass: "p",
+		Method: "GET", URL: "https://example.com:" + api.port + "/", TimeoutMs: 5000})
+	if out.ErrorCode != tribeHTTPErrTLS {
+		t.Fatalf("want tls, got %+v", out)
+	}
+}
+
+func TestTribeHTTPConcurrentCalls(t *testing.T) {
+	api := newTribeTestHTTPS(t, http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Write([]byte(r.URL.Query().Get("n")))
+	}))
+	socks := newTribeTestSocks(t, "u", "p", map[string]string{"example.com": "127.0.0.1"})
+	var wg sync.WaitGroup
+	errs := make(chan string, 32)
+	for i := 0; i < 32; i++ {
+		wg.Add(1)
+		go func(i int) {
+			defer wg.Done()
+			out, body := tribeTestDecode(t, tribeHTTPRequest{SocksAddr: socks.addr(), User: "u", Pass: "p",
+				Method: "GET", URL: fmt.Sprintf("https://example.com:%s/?n=%d", api.port, i),
+				TimeoutMs: 5000, rootCAs: api.pool})
+			if out.ErrorCode != "" || body != fmt.Sprint(i) {
+				errs <- fmt.Sprintf("call %d: %+v %q", i, out, body)
+			}
+		}(i)
+	}
+	wg.Wait()
+	close(errs)
+	for e := range errs {
+		t.Fatal(e)
+	}
+}
