+JNIEXPORT jstring JNICALL Java_org_amnezia_awg_GoBackend_awgProtectedGetConfig(JNIEnv *env, jclass c, jint handle)
+{
+	char *config = awgProtectedGetConfig(handle);
+	if (!config)
+		return NULL;
+	jstring ret = (*env)->NewStringUTF(env, config);
+	free(config);
+	return ret;
