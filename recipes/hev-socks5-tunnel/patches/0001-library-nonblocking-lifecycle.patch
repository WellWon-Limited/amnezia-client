+
+int
+hev_socks5_tunnel_is_ready (void)
+{
+    int ready;
+
+    pthread_mutex_lock (&stop_mutex);
+    ready = !READ_ONCE (stop_requested) && READ_ONCE (run) &&
+            event_fds[1] >= 0;
+    pthread_mutex_unlock (&stop_mutex);
+
+    return ready;
 }
 
+int
+hev_socks5_tunnel_try_quit (void)
+{
+    unsigned char val = 0;
+    ssize_t res;
+    int fd;
+
+    /* Preserve a stop requested while async initialization is still in
+     * progress. hev_socks5_tunnel_run observes this flag before entering the
+     * task system, so the caller never needs the blocking stop API. */
+    WRITE_ONCE (stop_requested, 1);
+
+    pthread_mutex_lock (&stop_mutex);
+    if (!READ_ONCE (run)) {
+        pthread_mutex_unlock (&stop_mutex);
+        return -EAGAIN;
+    }
+
+    fd = event_fds[1];
+    if (fd < 0) {
+        pthread_mutex_unlock (&stop_mutex);
+        return -EAGAIN;
+    }
+
+    res = write (fd, &val, sizeof (val));
+    pthread_mutex_unlock (&stop_mutex);
+
+    if (res == sizeof (val))
+        return 0;
+    if (res < 0)
+        return -errno;
+
+    return -EIO;
+}
+
 void
+hev_socks5_tunnel_reset_stop (void)
+{
+    WRITE_ONCE (stop_requested, 0);
+}
