+int
+hev_socks5_tunnel_try_quit (void)
+{
+    int res;
+
+    /* The set-and-check of the stop request and hev_socks5_tunnel_run's
+     * publish-and-take are one critical section each, under stop_mutex. A
+     * request is kept only while a run is in progress (run_scope): it is taken
+     * when that run starts running, and it never survives that run. */
+    pthread_mutex_lock (&stop_mutex);
+    if (!run_scope) {
+        pthread_mutex_unlock (&stop_mutex);
+        return -ESRCH;
+    }
+
+    stop_requested = 1;
+    if (!run || event_fds[1] < 0) {
+        pthread_mutex_unlock (&stop_mutex);
+        return -EAGAIN;
+    }
+
+    res = stop_event_write_locked ();
+    pthread_mutex_unlock (&stop_mutex);
+
+    return res;
 }
 
