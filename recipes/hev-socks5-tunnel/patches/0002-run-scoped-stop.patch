 void
+hev_socks5_tunnel_scope_begin (void)
+{
+    pthread_mutex_lock (&stop_mutex);
+    run_scope = 1;
+    stop_requested = 0;
+    pthread_mutex_unlock (&stop_mutex);
+}
+
+void
+hev_socks5_tunnel_scope_end (void)
+{
+    pthread_mutex_lock (&stop_mutex);
+    run_scope = 0;
+    run = 0;
+    stop_requested = 0;
+    pthread_mutex_unlock (&stop_mutex);
+}
