#ifndef VERSION_H
#define VERSION_H

#ifndef APP_VERSION
#define APP_VERSION "@CMAKE_PROJECT_VERSION@"
#endif

#ifndef APP_MAJOR_VERSION
#define APP_MAJOR_VERSION "@APP_MAJOR_VERSION@"
#endif

#define APPLICATION_NAME    "AVPN"
// AVPN: имя ДОЛЖНО совпадать с бинарём root-демона (target AmneziaVPN-service):
// isServiceReady() ищет процесс по этому имени (pgrep -f, case-sensitive).
// "AVPN-service" не матчился → ErrorCode 103 при живом демоне. Бонус: на macOS-превью
// клиент работает через уже установленный демон официальной Amnezia (IPC совместим).
#define SERVICE_NAME        "AmneziaVPN-service"
#define ORGANIZATION_NAME   "AVPN.ORG"

#endif  // VERSION_H
