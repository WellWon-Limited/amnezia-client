# Exact directive inventory produced by the Tribe OpenVPN client template after
# variable substitution and macOS removal of block-outside-dns.
client
dev tun
proto udp
resolv-retry infinite
nobind
persist-key
persist-tun
ncp-disable
cipher AES-256-GCM
auth SHA512
verb 3
tls-client
tls-version-min 1.2
key-direction 1
remote-cert-tls server
redirect-gateway def1 bypass-dhcp
dhcp-option DNS 1.1.1.1
dhcp-option DNS 8.8.8.8
remote 203.0.113.7 1194
<ca>
-----BEGIN CERTIFICATE-----
QQ==
-----END CERTIFICATE-----
</ca>
<cert>
-----BEGIN CERTIFICATE-----
Qg==
-----END CERTIFICATE-----
</cert>
<key>
-----BEGIN PRIVATE KEY-----
Qw==
-----END PRIVATE KEY-----
</key>
<tls-auth>
-----BEGIN OpenVPN Static key V1-----
RA==
-----END OpenVPN Static key V1-----
</tls-auth>
